<UserControl x:Class="DwgTranslator.App.Views.LogViewerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DwgTranslator.App.ViewModels"
             xmlns:local="clr-namespace:DwgTranslator.App.Views"
             Background="{DynamicResource Brush.Surface}">

    <UserControl.Resources>
        <local:StringToVisibilityConverter x:Key="CategoryVis"/>
        <local:StringToVisibilityConverter x:Key="ExVis"/>
        <local:DurationToVisibilityConverter x:Key="DurationVis"/>
        <local:SourceFilterVisibilityConverter x:Key="SourceFilterVis"/>

        <!-- Log level badge style -->
        <Style x:Key="LevelBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="36"/>
        </Style>

        <!-- Source badge style -->
        <Style x:Key="SourceBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>

        <!-- Monospace text style for log entries -->
        <Style x:Key="LogText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.BackgroundAlt}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel>
                <!-- Left: Controls -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="运行日志" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               FontFamily="Cascadia Code, Consolas"/>

                    <ComboBox ItemsSource="{Binding LevelFilters}"
                              SelectedItem="{Binding SelectedLevelFilter}"
                              Width="75" FontSize="11" Margin="0,0,6,0"
                              Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                              BorderBrush="{DynamicResource Brush.Border}"
                              ToolTip="按日志级别筛选"/>

                    <ComboBox ItemsSource="{Binding SourceFilters}"
                              SelectedItem="{Binding SelectedSourceFilter}"
                              Width="65" FontSize="11" Margin="0,0,6,0"
                              Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                              BorderBrush="{DynamicResource Brush.Border}"
                              ToolTip="按来源筛选（应用/CAD/翻译）"/>

                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Height="24" FontSize="11"
                             Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                             BorderBrush="{DynamicResource Brush.Border}" Padding="6,0"
                             VerticalContentAlignment="Center"
                             ToolTip="搜索日志内容"/>

                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"
                              Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" VerticalAlignment="Center"
                              Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LevelSummary}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               FontFamily="Cascadia Code, Consolas"/>
                    <TextBlock Text="{Binding TotalLogCount, StringFormat='共 {0} 条'}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Command="{Binding TogglePauseCommand}" ToolTip="暂停或继续刷新日志"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="6,2" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Setter Property="Content" Value="暂停"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="继续"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding CopyLogsCommand}" ToolTip="复制日志到剪贴板"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="6,2" Cursor="Hand" Content="复制"/>
                    <Button Command="{Binding ExportLogsCommand}" ToolTip="导出日志文件"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="6,2" Cursor="Hand" Content="导出"/>
                    <Button Command="{Binding ClearLogsCommand}" ToolTip="清空当前日志"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="6,2" Cursor="Hand" Content="清空"/>
                    <Button Command="{Binding OpenLogFolderCommand}" ToolTip="打开日志文件夹"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="6,2" Cursor="Hand" Content="文件夹"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log entries list -->
        <ListView Grid.Row="1" ItemsSource="{Binding LogEntries}"
                  Background="{DynamicResource Brush.Surface}" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  x:Name="LogListView"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="1,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                   FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Level badge -->
                        <Border Grid.Column="1" Style="{StaticResource LevelBadge}"
                                Background="{Binding LevelColor}">
                            <TextBlock Text="{Binding LevelTag}" FontSize="10" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       FontFamily="Cascadia Code, Consolas"/>
                        </Border>

                        <!-- Source badge (hidden for APP to reduce noise) -->
                        <Border Grid.Column="2" Style="{StaticResource SourceBadge}"
                                Background="{Binding SourceColor}"
                                Visibility="{Binding LogSource, Converter={StaticResource SourceFilterVis}}">
                            <TextBlock Text="{Binding SourceTag}" FontSize="9" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       FontFamily="Cascadia Code, Consolas"/>
                        </Border>

                        <!-- Category (if present) -->
                        <TextBlock Grid.Column="3" Text="{Binding Category}"
                                   Foreground="{DynamicResource Brush.Info}" FontSize="11"
                                   FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding Category, Converter={StaticResource CategoryVis}}"/>

                        <!-- Message + Duration + Exception -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource LogText}"/>
                            <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"
                                       FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"
                                       Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DurationMs}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <Binding Path="DurationMs" StringFormat="({0:F0}ms)"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Exception -->
                        <TextBlock Grid.Column="5" Text="{Binding Exception}" Foreground="{DynamicResource Brush.Danger}" FontSize="11"
                                   FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding Exception, Converter={StaticResource ExVis}}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="MinHeight" Value="22"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
