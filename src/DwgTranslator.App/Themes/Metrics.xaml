<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ═══════════════════════════════════════════════════════════════════════
         尺码令牌 + 文本层级 + 表单/徽标/状态/分区等轻量组件样式。

         这一层存在的意义：页面里不再出现 15 种 FontSize、15 种 CornerRadius、
         7~14px 这类不规则间距。所有数值都从这里取：
           字号 → FontSize.*    间距 → Spacing.*    尺寸 → Size.*    圆角 → CornerRadius.*
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- ── 字号层级（页面标题最重 → 说明文字最浅）── -->
    <sys:Double x:Key="FontSize.PageTitle">24</sys:Double>
    <sys:Double x:Key="FontSize.PageSubtitle">14</sys:Double>
    <sys:Double x:Key="FontSize.SectionTitle">18</sys:Double>
    <sys:Double x:Key="FontSize.CardTitle">14</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">13</sys:Double>
    <sys:Double x:Key="FontSize.Table">14</sys:Double>
    <sys:Double x:Key="FontSize.TableHeader">13</sys:Double>
    <sys:Double x:Key="FontSize.Kpi">26</sys:Double>
    <sys:Double x:Key="FontSize.KpiLabel">13</sys:Double>
    <!-- ── 8pt 间距系统 ── -->
    <Thickness x:Key="Spacing.Page">32,24</Thickness>
    <Thickness x:Key="Spacing.PageTop">0,12,0,10</Thickness>
    <Thickness x:Key="Spacing.Card">20</Thickness>
    <Thickness x:Key="Spacing.CardHeader">20,16</Thickness>
    <Thickness x:Key="Spacing.CardGap">0,0,0,16</Thickness>
    <Thickness x:Key="Spacing.SectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="Spacing.RowGap">0,0,0,8</Thickness>
    <Thickness x:Key="Spacing.Inline">0,0,8,0</Thickness>

    <!-- ══ 方向性间距（统一节奏）══
         档位只有 4 / 8 / 12 / 16 / 20；方向由名字决定，禁止页面各写各的字面量。
         Inline*   = 元素之后的水平间隔（右外边距）
         Stack*    = 竖直堆叠元素之间的间隔（下外边距）
         BlockTop* = 区块起始的竖直间隔（上外边距）
    -->
    <Thickness x:Key="Spacing.InlineTight">0,0,4,0</Thickness>
    <Thickness x:Key="Spacing.InlineWide">0,0,12,0</Thickness>
    <Thickness x:Key="Spacing.InlineLoose">0,0,16,0</Thickness>
    <Thickness x:Key="Spacing.InlineLeading">0,0,20,0</Thickness>

    <Thickness x:Key="Spacing.StackTight">0,0,0,4</Thickness>
    <Thickness x:Key="Spacing.Stack">0,0,0,8</Thickness>
    <Thickness x:Key="Spacing.StackWide">0,0,0,12</Thickness>
    <Thickness x:Key="Spacing.StackLoose">0,0,0,16</Thickness>
    <Thickness x:Key="Spacing.StackSection">0,0,0,20</Thickness>

    <Thickness x:Key="Spacing.BlockTopTight">0,4,0,0</Thickness>
    <Thickness x:Key="Spacing.BlockTop">0,8,0,0</Thickness>
    <Thickness x:Key="Spacing.BlockTopWide">0,12,0,0</Thickness>
    <Thickness x:Key="Spacing.BlockTopLoose">0,16,0,0</Thickness>
    <Thickness x:Key="Spacing.BlockTopSection">0,20,0,0</Thickness>

    <Thickness x:Key="Spacing.Lead">0,6,0,0</Thickness>
    <Thickness x:Key="Spacing.CardInset">0,12,0,6</Thickness>
    <Thickness x:Key="Spacing.RowInset">0,16,0,8</Thickness>
    <Thickness x:Key="Spacing.Toolbar">0,4,0,8</Thickness>
    <Thickness x:Key="Spacing.LeftGap">8,0,0,0</Thickness>
    <!-- 选项说明文字的左缩进：对齐到单选框/复选框的文字起点，而不是圆点。 -->
    <Thickness x:Key="Spacing.LeftIndent">20,0,0,0</Thickness>
    <Thickness x:Key="Spacing.Vertical">0,8,0,8</Thickness>
    <!-- ── 控件尺寸（同一工具栏不再出现多种高度）── -->
    <sys:Double x:Key="Size.Control">36</sys:Double>
    <sys:Double x:Key="Size.Button">36</sys:Double>
    <sys:Double x:Key="Size.ButtonCompact">32</sys:Double>
    <sys:Double x:Key="Size.Toolbar">44</sys:Double>
    <sys:Double x:Key="Size.Header">44</sys:Double>
    <sys:Double x:Key="Size.TableRow">40</sys:Double>
    <sys:Double x:Key="Size.TableHeader">40</sys:Double>
    <sys:Double x:Key="Size.NavItem">42</sys:Double>
    <sys:Double x:Key="Size.Icon">18</sys:Double>
    <sys:Double x:Key="Size.IconInline">16</sys:Double>
    <sys:Double x:Key="Size.Stroke">1.5</sys:Double>
    <!-- ── 文本层级样式 ── -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock"><Setter Property="LineHeight" Value="32"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock"><Setter Property="LineHeight" Value="22"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageSubtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock"><Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.CardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BodyStyle" TargetType="TextBlock"><Setter Property="LineHeight" Value="22"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock"><Setter Property="LineHeight" Value="22"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="KpiNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Kpi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.KpiLabel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- 兼容旧键名（页面历史引用） -->
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="CardHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="InputLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="DescriptionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}" />
    <!-- 设置目录项：与侧栏导航同一套视觉语言 -->
    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource CornerRadius.Small}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ── 表单：标题 / 说明 / 控件 三段式（§21）── -->
    <Style x:Key="FormSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="FormRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FormRowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="FormRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- ── 分区（用留白 + 标题分组，而不是到处加线 / 加卡片）── -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.BorderLight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Divider.Vertical" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.BorderLight}" />
        <Setter Property="Margin" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="ToolbarDivider" TargetType="Border" BasedOn="{StaticResource Divider.Vertical}" />
    <!-- ── 徽标（Badge）：来源 / 会员 / 待确认；一律浅底 + 同色文字，不做高饱和胶囊 ── -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Pill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
    </Style>
    <Style x:Key="Badge.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Badge.User" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
    </Style>
    <Style x:Key="Badge.Enterprise" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessLight}" />
    </Style>
    <Style x:Key="Badge.System" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
    </Style>
    <Style x:Key="Badge.Warning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningLight}" />
    </Style>
    <Style x:Key="Badge.Accent" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentLight}" />
    </Style>
    <Style x:Key="Badge.AccentText" TargetType="TextBlock" BasedOn="{StaticResource Badge.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style x:Key="Badge.PrimaryText" TargetType="TextBlock" BasedOn="{StaticResource Badge.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style x:Key="Badge.SuccessText" TargetType="TextBlock" BasedOn="{StaticResource Badge.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style x:Key="Badge.WarningText" TargetType="TextBlock" BasedOn="{StaticResource Badge.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <!-- ── 状态：8px 圆点 + 同色文字（§25；不要每行一个彩色底）── -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- ── 空状态（§28）── -->
    <Style x:Key="EmptyState.Icon" TargetType="Path">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextDisabled}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource Size.Stroke}" />
    </Style>
    <Style x:Key="EmptyState.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="EmptyState.Description" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!-- ── Toggle 开关：二元系统行为用它（§22）── -->
    <Style x:Key="Toggle.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="1" x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Brush.BorderStrong}" SnapsToDevicePixels="True">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Margin="2,0,0,0" HorizontalAlignment="Left" Background="White" SnapsToDevicePixels="True" />
                        </Border>
                        <ContentPresenter Margin="0,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 多选规则用它（保护尺寸/公差…）-->
    <Style x:Key="CheckBox.Rule" TargetType="CheckBox">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,16,8" />
    </Style>
    <!-- ── 只读信息行：左标签右值（输出设置、账号信息等）── -->
    <Style x:Key="InfoLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="InfoValueStrong" TargetType="TextBlock" BasedOn="{StaticResource InfoValue}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
    </Style>
    <Thickness x:Key="Spacing.4">4</Thickness>
    <Thickness x:Key="Spacing.8">8</Thickness>
    <Thickness x:Key="Spacing.12">12</Thickness>
    <Thickness x:Key="Spacing.16">16</Thickness>
    <Thickness x:Key="Spacing.20">20</Thickness>
    <Thickness x:Key="Spacing.24">24</Thickness>
    <Thickness x:Key="Spacing.32">32</Thickness>
    <Thickness x:Key="Spacing.40">40</Thickness>
    <Thickness x:Key="Spacing.48">48</Thickness>
<GridLength x:Key="Size.Sidebar">200</GridLength><sys:Double x:Key="Size.PageHeader">86</sys:Double><GridLength x:Key="Size.SettingsNav">168</GridLength>
    <sys:Double x:Key="Size.Drawer">400</sys:Double>
    <sys:Double x:Key="Size.FormMax">800</sys:Double>
    <sys:Double x:Key="Size.WorkspaceMax">1600</sys:Double>
    <sys:Double x:Key="Size.IconButton">32</sys:Double>
    <!-- §L18 状态栏文本上限：1120 宽 + 224 侧栏时仍给进度条留下保底宽度 -->
    <sys:Double x:Key="Size.StatusTextMax">420</sys:Double>
    <sys:Double x:Key="Size.ProgressTextMax">260</sys:Double>
</ResourceDictionary>