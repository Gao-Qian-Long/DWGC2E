<UserControl x:Class="DwgTranslator.App.Views.Controls.MainToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- ═══ Group 1: File Actions ═══ -->
            <Button Style="{StaticResource RibbonSecondaryButton}"
                    Margin="3"
                    Command="{Binding ImportDwgCommand}"
                    ToolTip="{conv:Localize TipImportDwg}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C2;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnImportDwg}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonSecondaryButton}"
                    Margin="3"
                    Command="{Binding ExportDwgCommand}"
                    ToolTip="{conv:Localize TipExportDwg}"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4BE;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnExportDwg}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CompactDangerButton}"
                    Margin="3"
                    Command="{Binding CancelExportCommand}"
                    ToolTip="{conv:Localize TipCancelExport}"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25A0;" Margin="0,0,6,0" FontSize="11"/>
                    <TextBlock Text="{conv:Localize BtnCancelExport}"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource RibbonDivider}" Margin="14,4"/>

            <!-- ═══ Group 2: Translate (Primary CTA) ═══ -->
            <Button Style="{StaticResource RibbonPrimaryButton}"
                    Margin="3"
                    Command="{Binding TranslateCommand}"
                    ToolTip="{conv:Localize TipTranslate}"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B6;" Margin="0,0,6,0" FontSize="12"/>
                    <TextBlock Text="{conv:Localize BtnTranslate}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CompactDangerButton}"
                    Margin="3"
                    Command="{Binding CancelTranslateCommand}"
                    ToolTip="{conv:Localize TipStopTranslation}"
                    Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25A0;" Margin="0,0,6,0" FontSize="11"/>
                    <TextBlock Text="{conv:Localize BtnStop}"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource RibbonDivider}" Margin="14,4"/>

            <!-- ═══ Group 3: Glossary ═══ -->
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding OpenGlossaryManagerCommand}"
                    ToolTip="{conv:Localize TipGlossary}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4D6;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnGlossary}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding ImportGlossaryCommand}"
                    ToolTip="{conv:Localize TipImportGlossary}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4E5;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnImportGlossary}"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource RibbonDivider}" Margin="14,4"/>

            <!-- ═══ Group 4: Tools ═══ -->
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding MarkAllReviewedCommand}"
                    ToolTip="{conv:Localize TipMarkReviewed}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2714;" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Success}"/>
                    <TextBlock Text="{conv:Localize BtnMarkAllReviewed}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding RetryFailedCommand}"
                    ToolTip="{conv:Localize TipRetryFailed}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Warning}"/>
                    <TextBlock Text="{conv:Localize BtnRetryFailed}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding ExportExcelCommand}"
                    ToolTip="{conv:Localize TipExportExcel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CA;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnExportExcel}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding ImportExcelCommand}"
                    ToolTip="{conv:Localize TipImportExcel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C5;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnImportExcel}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding ToggleLogViewerCommand}"
                    ToolTip="{conv:Localize TipLog}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CB;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnLog}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding ShowHelpCommand}"
                    ToolTip="{conv:Localize TipHelp}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2753;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnHelp}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding ClearAllCommand}"
                    ToolTip="{conv:Localize TipClear}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnClear}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RibbonTertiaryButton}"
                    Margin="3"
                    Command="{Binding OpenLicenseDialogCommand}"
                    Visibility="{Binding IsLicensingEnabled, Converter={StaticResource BoolToVis}}"
                    ToolTip="{conv:Localize TipLicense}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F511;" Margin="0,0,6,0"/>
                    <TextBlock Text="{conv:Localize BtnLicense}"/>
                </StackPanel>
            </Button>

        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
