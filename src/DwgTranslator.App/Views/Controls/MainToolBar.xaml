<UserControl x:Class="DwgTranslator.App.Views.Controls.MainToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ActionIcon" TargetType="Path"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1.35"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
        <Style x:Key="ActionIconFill" TargetType="Path" BasedOn="{StaticResource ActionIcon}"><Setter Property="Stroke" Value="Transparent"/><Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
        <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource RibbonTertiaryButton}"><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="34"/></Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Surface}" Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource RibbonSecondaryButton}" Command="{Binding ImportDwgCommand}" ToolTip="选择或拖入 DWG/DXF">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIconFill}" Data="{StaticResource Icon.Import.Tray}"/><TextBlock Text="导入图纸"/></StackPanel>
                </Button>
                <Button Style="{StaticResource RibbonPrimaryButton}" Command="{Binding TranslateCommand}" Margin="8,0" ToolTip="翻译所有待处理文字">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIconFill}" Data="{StaticResource Icon.Translate}"/><TextBlock Text="开始翻译"/></StackPanel>
                </Button>
                <Button Style="{StaticResource RibbonSecondaryButton}" Command="{Binding ExportDwgCommand}" ToolTip="批量输出已勾选图纸" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIconFill}" Data="{StaticResource Icon.Export.Tray}"/><TextBlock Text="批量导出"/></StackPanel>
                </Button>
                <Button Style="{StaticResource CompactDangerButton}" Command="{Binding CancelTranslateCommand}" Content="停止" Margin="8,0,0,0" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource CompactDangerButton}" Command="{Binding CancelExportCommand}" Content="取消导出" Margin="8,0,0,0" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource RibbonDivider}" Margin="14,4"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource UtilityButton}" Command="{Binding OpenGlossaryManagerCommand}" ToolTip="维护专业术语"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.Glossary}"/><TextBlock Text="术语库"/></StackPanel></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding MarkAllReviewedCommand}" ToolTip="将已翻译条目标记为已审阅"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.Check}"/><TextBlock Text="全部审阅"/></StackPanel></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding RetryFailedCommand}" ToolTip="只重试失败条目"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.Refresh}"/><TextBlock Text="重试失败"/></StackPanel></Button>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource UtilityButton}" Command="{Binding ExportExcelCommand}" ToolTip="导出 Excel 校对表"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.Excel}"/><TextBlock Text="导出表格"/></StackPanel></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding ImportExcelCommand}" ToolTip="导入修改后的 Excel 校对表"><TextBlock Text="导入校对"/></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding ShowEnvironmentCheckCommand}" ToolTip="环境自检与插件安装"><TextBlock Text="环境"/></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding ToggleLogViewerCommand}" ToolTip="查看运行日志"><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.Log}" Margin="0"/></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding ShowHelpCommand}" ToolTip="使用帮助"><Grid><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.HelpRing}" Margin="0"/><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.HelpMark}" Margin="0"/></Grid></Button>
                <Button Style="{StaticResource UtilityButton}" Command="{Binding ClearAllCommand}" ToolTip="清空当前工作区"><Path Style="{StaticResource ActionIcon}" Data="{StaticResource Icon.Trash}" Margin="0" Stroke="{DynamicResource Brush.Danger}"/></Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
