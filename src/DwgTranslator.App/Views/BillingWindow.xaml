<Window x:Class="DwgTranslator.App.Views.BillingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:conv="clr-namespace:DwgTranslator.App.Converters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True" SnapsToDevicePixels="True" Title="会员购买与订单" Width="1020" Height="700" MinWidth="900" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Microsoft YaHei UI, Segoe UI">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BillingPresentationConverter x:Key="BillingDisplay"/>
        <Style x:Key="OrderActionHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="OrderActionCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- 单元格文本：一个共用的省略号基样式，每列再派生一份，好让 ToolTip 说明被截掉的是哪个值。
             订单／套餐是星号列（按 1 : 1.4 分配剩余宽度），状态／金额是 Auto 列（按内容取宽，
             金额因此永不被打点）；所以截断只可能发生在套餐名与订单号上——这里是它们的兜底，
             避免再出现「最后一个字被硬裁掉」（DataGridCellStyle 自身不裁剪也不打点）。 -->
        <Style x:Key="OrderCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OrderNoCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding OrderNo}"/>
        </Style>
        <Style x:Key="PlanCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding PlanName}"/>
        </Style>
        <Style x:Key="StateCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding DisplayState, Converter={StaticResource BillingDisplay}}"/>
        </Style>
        <Style x:Key="AmountCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding PayableCents, Converter={StaticResource BillingDisplay}, ConverterParameter=Amount}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><DockPanel><controls:TitleBarControl DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True"/><StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.LeftGap}"><Border Background="{DynamicResource Brush.Primary}" CornerRadius="4" Width="24" Height="24"><TextBlock Text="D" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="会员购买与订单" Margin="{DynamicResource Spacing.LeftGap}" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>

        <!-- 左栏购买、右栏订单历史。右栏按内容取高（不撑满整行），「更多订单」因此紧贴表格下方，
             不再孤零零悬在窗口底部；两栏之间用一条通高的分隔线明确分界。
             列宽核算（FontSize.Table = 14）：900(MinWidth) - 48(页边距) - 370(左栏) - 24(间隔) = 458，
             再减去表格内部竖滚动条 17 余 441。订单 * (MinWidth 84) + 套餐 1.4* (MinWidth 112)
             + 状态 Auto(≈66) + 金额 Auto(≈69~100) + 操作 80 = 最少 411 <= 441，
             所以最小宽度下金额不会被打点，也不会出现横向滚动条。
             无订单时表格由 code-behind 收起（BillingWindow.xaml.cs 的 LoadOrders）：
             只留居中的「暂无订单」，避免表头与空状态叠在一起。 -->
        <Grid Grid.Row="1" Margin="{DynamicResource Spacing.24}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="套餐与订单" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="Account" Margin="{DynamicResource Spacing.CardInset}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="Entitlements" Margin="{DynamicResource Spacing.StackLoose}" TextWrapping="Wrap" FontWeight="SemiBold" />

                    <TextBlock x:Name="Message" Text="正在加载…" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" FontWeight="SemiBold" />

                    <!-- 购买动作区：选套餐 → 取二维码。当前订单存在时这里不会覆盖原订单，只用于新单。
                         用户批注（2026-09-22）：「重构布局，不必要的文字不要显示」——原来这里的两段
                         长说明（支付方式说明、"套餐与金额以服务器为准"）与灰色可用状态框全部删除；
                         支付方式只留单选（微信未开通的说明挂在 ToolTip 上），服务不可用时才出现提示框。 -->
                    <TextBlock Text="选择新套餐并获取二维码" Style="{StaticResource FormRowLabel}" Margin="{DynamicResource Spacing.Stack}" />
                    <ComboBox x:Name="Plans" DisplayMemberPath="Label" Margin="{DynamicResource Spacing.StackTight}" />
                    <StackPanel x:Name="PaymentMethods" Orientation="Horizontal" Margin="{DynamicResource Spacing.Vertical}">
                        <RadioButton x:Name="Alipay" Content="支付宝" IsChecked="True" Margin="{DynamicResource Spacing.InlineLeading}" />
                        <RadioButton x:Name="WechatPay" Content="微信支付" IsEnabled="False" ToolTip="微信支付通道尚未接入，当前仅支持支付宝。" ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                    <WrapPanel Margin="{DynamicResource Spacing.Vertical}">
                        <Button Style="{StaticResource Button.Primary}" x:Name="Buy" Content="确认套餐并获取二维码" Click="Buy_Click" Padding="14,0" IsEnabled="False" />
                        <Button Style="{StaticResource Button.Secondary}" Content="刷新订单与会员" Click="Refresh_Click" Padding="14,0" Margin="{DynamicResource Spacing.LeftGap}" />
                    </WrapPanel>
                    <Border x:Name="PurchaseAvailabilityPanel" Background="{DynamicResource Brush.BackgroundAlt}" Padding="12" Margin="{DynamicResource Spacing.Vertical}">
                        <TextBlock x:Name="PurchaseAvailability" Text="正在检查购买服务…" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Brush.Border}" SnapsToDevicePixels="True" />

            <Grid Grid.Column="2" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 用户批注（2026-09-22）：「历史订单列表滑动很难滑动，可以做成一个按钮，点开弹出历史订单
                     列表，不要占用右边的空间」——常驻表格整块移入弹层（OrdersOverlay，折叠时不占布局），
                     右栏平时只显示当前订单卡；弹层内表格加高到 420，滚动空间比原来宽裕。 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" x:Name="ToggleOrders" Content="历史订单" Click="ToggleOrders_Click"
                            Style="{StaticResource Button.Compact.Secondary}" ToolTip="展开或收起历史订单列表" />
                </DockPanel>
                <!-- 套餐不一致提示（2026-09-22 用户批注「选的套餐和右边的金额对不上啊」）：
                     右侧二维码永远属于"当前订单"，而下拉框选的是"下一次购买"；两者不同时在这里明说，
                     不再藏在 Message 里。由 code-behind 的 UpdatePlanMismatch 控制。 -->
                <Border x:Name="PlanMismatchBar" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource Brush.WarningLight}" BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Small}" Padding="10" Margin="{DynamicResource Spacing.CardInset}">
                    <TextBlock x:Name="PlanMismatchText" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.Warning}" />
                </Border>
                <!-- 当前订单卡：付款时真正要看的只有"多少钱"和"扫哪个码"。二维码过展示期后整块塌缩、
                     不再显示，但金额与订单号保留以便核对；未付款记录可以在这里直接删除。 -->
                <Border x:Name="CurrentOrderCard" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="16" Margin="{DynamicResource Spacing.CardInset}">
                    <StackPanel>
                        <TextBlock x:Name="OrderPlanName" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="OrderAmount" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Margin="{DynamicResource Spacing.BlockTopTight}" />
                        <TextBlock x:Name="QrStatus" Text="尚未选择订单。可从历史订单查看付款状态。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.BlockTopTight}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <!-- 二维码框的可见性与图片同步：二维码隐藏或缺失时整块塌缩，不留固定占位高度。 -->
                        <Border x:Name="QrBox" Visibility="{Binding Visibility, ElementName=Qr}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="12" Margin="{DynamicResource Spacing.StackWide}" HorizontalAlignment="Center">
                            <Image x:Name="Qr" Width="220" Height="220" Stretch="Uniform" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.StackWide}">
                            <Button x:Name="CopyOrderNo" Content="复制订单号" Click="CopyOrder_Click" Style="{StaticResource Button.Compact.Secondary}" ToolTip="复制当前订单号，便于与客服核对" />
                            <Button x:Name="HideCurrentOrder" Content="删除该订单记录" Click="HideOrder_Click" Style="{StaticResource Button.Compact.Tertiary}" Margin="{DynamicResource Spacing.LeftGap}" Visibility="Collapsed" ToolTip="仅从列表移除记录，不会取消支付平台订单，请勿再支付旧二维码" />
                        </StackPanel>
                        <TextBlock x:Name="OrderDetails" TextWrapping="Wrap" Margin="{DynamicResource Spacing.StackWide}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <Border Background="{DynamicResource Brush.WarningLight}" Padding="10" Margin="{DynamicResource Spacing.StackWide}">
                            <TextBlock Text="二维码展示期限结束不代表平台关单。已付款请勿再次支付，系统将继续确认。" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 历史订单弹层：覆盖右栏（ZIndex=6），折叠时不占任何布局空间。 -->
                <Border x:Name="OrdersOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="6" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="12" Margin="{DynamicResource Spacing.CardInset}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="历史订单（选择可查看）" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="关闭" Click="ToggleOrders_Click" Style="{StaticResource Button.Compact.Tertiary}" MinWidth="64" />
                        </Grid>
                        <Button DockPanel.Dock="Bottom" x:Name="More" Content="更多订单" Click="More_Click" HorizontalAlignment="Left" Padding="12,0" IsEnabled="False" Margin="0,8,0,0" Style="{StaticResource Button.Tertiary}" />
                        <Grid>
                            <DataGrid x:Name="Orders" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Orders_SelectionChanged" MaxHeight="420" VerticalAlignment="Top">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="订单" Binding="{Binding OrderNo, Converter={StaticResource BillingDisplay}, ConverterParameter=Order}" Width="*" MinWidth="80" ElementStyle="{StaticResource OrderNoCellText}" />
                                    <DataGridTextColumn Header="套餐" Binding="{Binding PlanName}" Width="1.4*" MinWidth="112" ElementStyle="{StaticResource PlanCellText}" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding DisplayState, Converter={StaticResource BillingDisplay}}" Width="Auto" ElementStyle="{StaticResource StateCellText}" />
                                    <DataGridTextColumn Header="金额" Binding="{Binding PayableCents, Converter={StaticResource BillingDisplay}, ConverterParameter=Amount}" Width="Auto" ElementStyle="{StaticResource AmountCellText}" />
                                    <!-- 操作列 76 = 46 按钮 + 单元格 6×2 内边距（余 18）。复制按钮已移除：订单号在
                                         左栏当前订单卡内有明确语境（"复制订单号"），表格里逐行复制没有用途。 -->
                                    <DataGridTemplateColumn Header="操作" Width="76" MinWidth="76" HeaderStyle="{StaticResource OrderActionHeader}" CellStyle="{StaticResource OrderActionCell}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 仅未付款记录可移除；已付款订单必须留在列表里作为到账凭证（服务端同样拒绝）。 -->
                                                <Button Content="删除" AutomationProperties.Name="删除订单记录" ToolTip="仅从列表移除记录，不会取消支付平台订单，请勿再支付旧二维码" Click="HideOrder_Click" Tag="{Binding OrderNo}"
                                                        Visibility="{Binding CanHide, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource Button.Compact.Tertiary}" Width="46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <controls:EmptyState x:Name="EmptyOrders" Header="暂无订单" Description="当前账号尚无历史订单。" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
