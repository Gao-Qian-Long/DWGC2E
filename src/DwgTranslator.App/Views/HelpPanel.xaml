<UserControl x:Class="DwgTranslator.App.Views.HelpPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>
    </UserControl.Resources>

    <!-- §L19 与其它页面统一走 Spacing.Page 栅格；宽度上限交给宿主窗口(HelpWindow Width=900) -->
    <Grid Margin="{DynamicResource Spacing.Page}">

        <!-- §L22 CanContentScroll 让 StackPanel 以自己的 IScrollInfo 按「子元素」为单位滚动。
             默认的像素滚动下，段落行高 24 与视口高度不整除，滚到任意位置都会有一行被视口下沿
             切掉半行（用户报「末行被切」）。按子元素对齐后每段要么完整可见、要么完整在视口外。
             前提：没有任何单个子元素高于视口 —— HelpWindow 900x720(MinHeight 480)、视口最窄
             约 358 DIP，最长的入门段落实测约 96 DIP，余量充足。 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
            <StackPanel>

                <!-- ========== 快速入门 ========== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="快速入门"/>
                <TextBlock Style="{StaticResource BodyText}" Text="QLCAD 可识别 DWG/DXF 中的文字并生成译文。AI 翻译走云端服务，需要登录并联网；“本机直接写回”只表示不启动 CAD 修改文件，并不表示 AI 可以离线翻译。已有译文可不再调用翻译服务，直接在本机写回。"/>

                <TextBlock Style="{StaticResource BodyText}" Margin="{DynamicResource Spacing.BlockTop}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="四步完成翻译："/>
                <TextBlock Style="{StaticResource BodyText}" Text="1. 点击「导入 DWG」按钮，选择一个或多个 DWG/DXF 文件"/>
                <TextBlock Style="{StaticResource BodyText}" Text="2. 点击标题栏中间的语言按钮，选择「原文语言 → 目标语言」（含中文、英文、日文、韩文、俄文等 18 种），然后点击「翻译」或按 F5"/>
                <TextBlock Style="{StaticResource BodyText}" Text="3. 翻译完成后，可直接在列表中双击译文进行修改，或导出 Excel 批量校对"/>
                <TextBlock Style="{StaticResource BodyText}" Text="4. 点击「导出 DWG」（Ctrl+S），选择 CAD 宿主插件写回或本机直接写回，再选择输出位置。程序生成新文件，不覆盖源图。"/>

                <TextBlock Style="{StaticResource BodyText}" Margin="{DynamicResource Spacing.BlockTop}" Text="💡 首次使用前，请先登录账户并确认套餐额度。安装 CAD 插件请点「更多 ▾ → 环境自检与安装…」（Ctrl+E），那里还能看到 CAD 检测结果与运行环境自检。常用快捷键：Ctrl+O 导入、F5 翻译、Ctrl+S 导出、Ctrl+L 日志面板、F1 帮助。" Foreground="{DynamicResource Brush.Success}"/>

                <!-- ========== 主要功能 ========== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="主要功能"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="导入 DWG/DXF"/>
                <TextBlock Style="{StaticResource BodyText}" Text="支持 .dwg 和 .dxf 格式文件的导入，可一次选择多个文件。程序会自动扫描图纸中的所有文字实体（单行文字、多行文字、属性文字等），并以表格形式展示。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="AI 翻译"/>
                <TextBlock Style="{StaticResource BodyText}" Text="使用平台统一托管的大模型服务翻译，默认 12 路并发（可在设置中调整），并对相同文本自动去重，相同内容只翻译一次。支持智能去重和术语库匹配。模型 Provider、模型密钥和服务端提示词由后台统一管理，APP 不要求用户填写模型 API Key。翻译过程中可随时点击「停止」按钮中断。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="术语库"/>
                <TextBlock Style="{StaticResource BodyText}" Text="术语库确保专业术语翻译一致。点击工具栏「术语库」按钮可管理术语条目，支持从外部 JSON 文件导入。程序自带机械工程领域术语库。翻译时命中术语库的条目会在列表中标记。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="Excel 导出/导入"/>
                <TextBlock Style="{StaticResource BodyText}" Text="导出 Excel 后可在 Excel 中批量校对译文，修改完成后再导入回程序。适合大批量文字的校对工作。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="导出 DWG（回写模式）"/>
                <TextBlock Style="{StaticResource BodyText}" Text="• CAD 宿主插件写回：由应用调用本机安装的浩辰 GstarCAD 2024 或 AutoCAD 2025+ 处理图纸；应用会检查插件平台和版本，缺少时提示修复。插件随 APP 一起提供，不需要另行下载。写回本身在本机完成，不依赖云端。"/>
                <TextBlock Style="{StaticResource BodyText}" Text="• 本机直接写回：使用 ACadSharp 读写 DWG/DXF，不要求安装或启动 CAD。排版和避让使用本地几何估算；普通文字会尝试换行、微移或缩小，但块属性、复杂嵌套块、特殊字体等仍可能需要人工复核。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="CAD 插件与电脑要求"/>
                <TextBlock Style="{StaticResource BodyText}" Text="CAD 插件是随 APP 打包的 DwgTranslator.Cad.dll 和配套依赖，负责在 CAD 宿主中调用其图形接口。可在「更多 → 环境自检与安装」中检查、安装或修复；手动加载时使用 NETLOAD。当前发布目标为浩辰 GstarCAD 2024 或 AutoCAD 2025+，插件包内 cad-platform.txt 必须与所用 CAD 匹配。QLCAD 桌面版是 Windows x64 自包含程序，目标电脑无需另装 .NET；从源码构建才需要 .NET 8 SDK，构建插件还需对应 CAD 的托管 SDK。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="筛选与搜索"/>
                <TextBlock Style="{StaticResource BodyText}" Text="使用下拉菜单筛选状态（全部/待翻译/已翻译/翻译失败等），在搜索框输入关键词查找原文或译文。"/>

                <!-- ========== 常见问题 ========== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="常见问题"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Q: 翻译后文字间距太大怎么办？"/>
                <TextBlock Style="{StaticResource BodyText}" Text="A: 个别译文挤压或放不下时，可在表格中缩短译文后重新导出。写回会尽力调整排版，但无法安全放置的文字可能保留原文或跳过；请查看日志并在 CAD 中复核。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="Q: 翻译后文字与线条重叠怎么办？"/>
                <TextBlock Style="{StaticResource BodyText}" Text="A: 碰撞避让是尽力处理，不保证所有图纸都无重叠。CAD 插件模式能使用宿主的实际几何；本机直接写回依赖估算包围盒，对块属性和深层嵌套块覆盖有限。导出后请在 CAD 中检查问题区域；应用会在日志中记录无法安全排版的文字。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="Q: AutoCAD 弹出安全警告对话框？"/>
                <TextBlock Style="{StaticResource BodyText}" Text="A: 这是正常现象。请注意：该对话框可能在 AutoCAD 窗口后面！请点击任务栏的 AutoCAD 图标切换过去，然后点击「始终加载」(Always Load)。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="Q: 体验版用完了怎么办？"/>
                <TextBlock Style="{StaticResource BodyText}" Text="A: 云端翻译需要登录账户，翻译额度和会员权益以会员中心为准；本地术语整理和已保存草稿仍可继续使用。模型 Provider、模型密钥和服务端提示词由平台统一管理，APP 不要求用户填写模型 API Key。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="Q: 切换翻译方向后之前的译文还在吗？"/>
                <TextBlock Style="{StaticResource BodyText}" Text="A: 切换方向后，已翻译的条目会被重置为「待翻译」，需重新翻译。建议先导出 Excel 备份。"/>

                <!-- ========== 名词解释 ========== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="名词解释"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="DWG/DXF 文件"/>
                <TextBlock Style="{StaticResource BodyText}" Text="AutoCAD 软件使用的图纸文件格式。DWG 是二进制格式，DXF 是文本格式。本软件两种格式均支持导入和导出。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="多行文字（MText）/ 单行文字（Text）"/>
                <TextBlock Style="{StaticResource BodyText}" Text="AutoCAD 中的两种文字类型。MText 有多行内容和矩形边界框，Text 只有一行。程序会自动处理这两种类型。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="API Key（密钥）"/>
                <TextBlock Style="{StaticResource BodyText}" Text="由平台统一托管，用户无需申请或填写。若在自建部署中需要自带密钥，请由管理员在服务端配置。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="碰撞检测"/>
                <TextBlock Style="{StaticResource BodyText}" Text="翻译后文字可能变长。写回流程会尝试换行、调整字号或位置；是否能识别并消除干涉取决于文字类型、块变换、字体和宿主。碰撞检测不能代替人工检查，原图已有的拥挤区域也可能保留。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="回写"/>
                <TextBlock Style="{StaticResource BodyText}" Text="将翻译后的文字写回 DWG 图纸的过程，程序会找到原始文字位置用译文替换，并自动调整排版。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="翻译缓存"/>
                <TextBlock Style="{StaticResource BodyText}" Text="程序会复用符合当前语言、术语及翻译配置的成功结果，减少重复请求。修改启用术语或翻译规则后，旧缓存可能不再适用。"/>

                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="{DynamicResource Spacing.BlockTop}" Text="Handle（句柄）"/>
                <TextBlock Style="{StaticResource BodyText}" Text="DWG 文件中每个图形对象的唯一编号，类似身份证号。程序用 Handle 精确匹配原文和译文。"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
