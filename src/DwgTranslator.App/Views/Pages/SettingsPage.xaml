<UserControl x:Class="DwgTranslator.App.Views.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DwgTranslator.App.Views">
    <UserControl.Resources>
        <Style x:Key="Settings.ValidatedInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 分区导航格：竖排列表项（G 组由双排 3×2 区块改回左卡竖排），选中态沿用 Primary/PrimaryLight 配色 + 琥珀编号角章。
             水平内边距由 14 收到 12：列宽 168 - 卡内边距 10×2 - 卡边框 2 - 格外边距 4×2 - 格边框 2 - 格内边距 12×2 = 112，
             而最长标题「CAD 与环境」= 编号角章 20 + 9 间距 + 文字约 72 ≈ 101，留 11 DIP 余量；沿用 14 只剩 7，太贴边。 -->
        <Style x:Key="Settings.SectionTile" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="{DynamicResource Size.NavItem}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="{DynamicResource Spacing.4}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 编号角章：杂志编号卡片语言，选中分区时点亮为琥珀 -->
        <Style x:Key="Settings.NumberChip" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Amber}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Settings.NumberChip.Text" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
<controls:PageHeader x:Name="WorkspaceHeader" Header="设置" Description="常用选项集中在这一页；按分区调整后统一保存。" WaveVariant="5" />
        <!-- G 主从双卡片（用户确认方案：设置页 = 左右主从双卡片）。
             本 Grid 由「三行单列」改为「三行 × 三列」：
               列 0 = 左卡（01-06 竖排分区导航），宽度用 Metrics.xaml 既有的 Size.SettingsNav(168) 令牌；
               列 1 = 槽列，用 f1 为 §C6 新增的 Size.CardGutter(16)——两卡之间只靠这一个槽分隔，不必再动 Metrics.xaml；
               列 2 = 右卡（分区内容）与其下的操作条。
             行 0 = 右列上方的分区选择/生效提示条；行 1 = 两张卡（左卡 Stretch 到行高、右卡 MinHeight 绑视口高，
             于是两卡恒等高、顶底齐平，任何分区都不会出现一侧留白）；行 2 = 操作条。
             历史沿革：这里最早就是 168 DIP 左侧竖排导航列 → 上一批改成页内双排 3×2 区块（理由"页面只保留设置
             这一个一级入口"）→ 本批按用户确认改回左右主从。Size.SettingsNav 令牌当时并未删除，正好复用。
             窄窗降级见 SettingsPage.xaml.cs UpdateLayoutMode()：左卡与槽列一起收为 0，右卡独占整行。 -->
        <Grid x:Name="SettingsBody" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsNavColumn" Width="{DynamicResource Size.SettingsNav}" />
                <ColumnDefinition x:Name="SettingsNavGutter" Width="{DynamicResource Size.CardGutter}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左卡：分区导航。Padding 用 10 而非 Section.Surface 默认的 Spacing.Card(20)——
                 168 的列宽扣掉 20 内边距、再扣格子自身的边距与内边距后放不下最长的「CAD 与环境」。
                 整卡与右卡同源 Section.Surface，H 组柔化阴影后两卡自动一致。 -->
            <Border x:Name="SettingsNavCard" Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource Section.Surface}" Padding="10" VerticalAlignment="Stretch">
                <!-- 竖排列表：去掉原先的 UniformGrid Rows=2 Columns=3 面板，回到 ListBox 默认纵向堆叠。
                     6 个固定项总高约 300 DIP，在全部受支持窗口高度下都放得下，故纵向滚动条保持 Disabled
                     （改 Auto 会在极端矮窗多出 10 DIP 滚动条、把最长标题挤成省略号）。 -->
                <ListBox x:Name="SettingsNav" AutomationProperties.Name="设置分区" SelectedIndex="{Binding SettingsSection}" SelectionChanged="SettingsSection_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource Settings.SectionTile}" AutomationProperties.Name="常规">
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Settings.NumberChip}"><TextBlock Text="01" Style="{StaticResource Settings.NumberChip.Text}" /></Border><TextBlock Text="常规" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource Settings.SectionTile}" AutomationProperties.Name="翻译与保护">
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Settings.NumberChip}"><TextBlock Text="02" Style="{StaticResource Settings.NumberChip.Text}" /></Border><TextBlock Text="翻译与保护" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource Settings.SectionTile}" AutomationProperties.Name="文件与输出">
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Settings.NumberChip}"><TextBlock Text="03" Style="{StaticResource Settings.NumberChip.Text}" /></Border><TextBlock Text="文件与输出" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource Settings.SectionTile}" AutomationProperties.Name="CAD 与环境">
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Settings.NumberChip}"><TextBlock Text="04" Style="{StaticResource Settings.NumberChip.Text}" /></Border><TextBlock Text="CAD 与环境" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource Settings.SectionTile}" AutomationProperties.Name="日志">
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Settings.NumberChip}"><TextBlock Text="05" Style="{StaticResource Settings.NumberChip.Text}" /></Border><TextBlock Text="日志" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource Settings.SectionTile}" AutomationProperties.Name="关于与帮助">
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Settings.NumberChip}"><TextBlock Text="06" Style="{StaticResource Settings.NumberChip.Text}" /></Border><TextBlock Text="关于与帮助" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- 分区选择条 + 生效时机提示，放在右卡上方（行 0 / 列 2）。
                 CompactSections 必须留在这一列、不能塞进左卡：RefinementSmoke.cs:34 与 :385 断言它的 IsVisible
                 必须严格等于 compact，而窄窗时左卡整张 Collapsed，下拉若在卡内会被连带隐藏而踩红。 -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="{DynamicResource Spacing.Stack}">
                <ComboBox x:Name="CompactSections" Visibility="Collapsed" SelectedIndex="{Binding SettingsSection}" SelectionChanged="SettingsSection_Changed" Margin="{DynamicResource Spacing.StackWide}" AutomationProperties.Name="设置分类"><ComboBoxItem Content="常规"/><ComboBoxItem Content="翻译与保护"/><ComboBoxItem Content="文件与输出"/><ComboBoxItem Content="CAD 与环境"/><ComboBoxItem Content="日志"/><ComboBoxItem Content="关于与帮助"/></ComboBox>
                <TextBlock Text="{Binding SettingsSectionApplyHint}" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
            <!-- 右卡。MinHeight 绑到外层 ScrollViewer 的 ViewportHeight：分区内容比视口矮时卡片仍铺满，
                 与左卡（Stretch 到同一行高）恒等高，不会出现"左卡长右卡短"的缺口。该绑定不会自激振荡——
                 ViewportHeight 不受纵向滚动条影响、横向滚动条已 Disabled（与 TranslatePage 右栏 E10 同一手法）。
                 MaxWidth 1080 必须保留：UI 冒烟 Program.cs:636 断言 SettingsContent.ActualWidth 落在 (400, 1080]。 -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" controls:ResponsiveLayout.HandoffMouseWheelAtBoundary="True">
                <Border x:Name="SettingsContent" HorizontalAlignment="Stretch" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Section.Surface}"><Setter Property="MaxWidth" Value="1080"/></Style></Border.Style>
                    <StackPanel>
                        <!-- 每个分区块内部是同一套两列表单骨架：20 DIP 中缝把 * / * 两列分开，左右两列各自独立堆叠，
                             行数不等也不会留空洞，且不覆盖 SettingsRow 自带的行距；需要整行宽度的路径输入跨三列。 -->
                        <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource IndexToVis}, ConverterParameter=0}">
                            <TextBlock Text="SECTION 01 · GENERAL" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                            <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackLoose}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <!-- 常规：原「界面语言」与「应用行为」两张宽窄不一的卡片合并成同一张表单，统一 220 DIP 标签列。 -->
                                    <controls:SettingsRow>
                                        <TextBlock Text="界面语言" Style="{StaticResource FormRowLabel}" />
                                        <ComboBox MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding SettingsDraft.Language}" MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="界面语言" ToolTip="界面语言在下次启动时生效。">
                                            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                            <ComboBoxItem Content="English" Tag="en-US" />
                                        </ComboBox>
                                    </controls:SettingsRow>
                                    <controls:SettingsRow>
                                        <TextBlock Text="开机启动" Style="{StaticResource FormRowLabel}" />
                                        <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Left" AutomationProperties.Name="开机启动" IsChecked="{Binding SettingsDraft.StartWithWindows}" />
                                    </controls:SettingsRow>
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="启动时恢复上次工作区" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="恢复上次的语言方向和已打开图纸；关闭后每次启动都是空工作区。" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Left" AutomationProperties.Name="启动时恢复上次工作区" IsChecked="{Binding SettingsDraft.RestoreLastWorkspace}" />
                                    </controls:SettingsRow>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <controls:SettingsRow>
                                        <TextBlock Text="自动检查更新" Style="{StaticResource FormRowLabel}" />
                                        <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Left" AutomationProperties.Name="自动检查更新" IsChecked="{Binding SettingsDraft.AutoCheckUpdate}" />
                                    </controls:SettingsRow>
                                    <controls:SettingsRow>
                                        <TextBlock Text="导出后打开输出目录" Style="{StaticResource FormRowLabel}" />
                                        <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Left" AutomationProperties.Name="导出后打开输出目录" IsChecked="{Binding SettingsDraft.OpenOutputFolderAfterExport}" />
                                    </controls:SettingsRow>
                                </StackPanel>
                            </Grid>
                            <!-- 生效时机由页头 SettingsSectionApplyHint 统一说明，这里不再重复一遍。 -->
                        </StackPanel>
                        <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource IndexToVis}, ConverterParameter=1}">
                            <TextBlock Text="SECTION 02 · TRANSLATION" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                            <TextBlock Text="翻译与保护" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackLoose}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="图纸保护" Style="{StaticResource FormRowLabel}" Margin="{DynamicResource Spacing.Stack}" />
                                    <CheckBox Content="保护尺寸" IsChecked="{Binding SettingsDraft.ProtectDimensions}" Margin="{DynamicResource Spacing.Vertical}" />
                                    <CheckBox Content="保护公差" IsChecked="{Binding SettingsDraft.ProtectTolerances}" Margin="{DynamicResource Spacing.Vertical}" />
                                    <CheckBox Content="保护型号" IsChecked="{Binding SettingsDraft.ProtectModels}" Margin="{DynamicResource Spacing.Vertical}" />
                                    <CheckBox Content="内存优化" IsChecked="{Binding SettingsDraft.MemoryOptimization}" Margin="{DynamicResource Spacing.Vertical}" ToolTip="降低大图纸翻译时的内存峰值，代价是解析略慢。" />
                                    <TextBlock Text="已启用术语始终优先于 AI 和旧缓存；请在术语库中启用或停用条目。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.BlockTop}" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="性能" Style="{StaticResource FormRowLabel}" Margin="{DynamicResource Spacing.Stack}" />
                                    <controls:SettingsRow><TextBlock Text="同时处理的图纸数" Style="{StaticResource FormRowLabel}"/><TextBox x:Name="LocalWorkerCountInput" Width="120" HorizontalAlignment="Left" Style="{StaticResource Settings.ValidatedInput}" MinHeight="{DynamicResource Size.Control}" Padding="8,4"><TextBox.Text><Binding Path="SettingsDraft.LocalWorkerCount" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:IntegerRangeValidationRule Minimum="1" Maximum="6" FieldName="图纸并发"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></controls:SettingsRow>
                                    <controls:SettingsRow><TextBlock Text="单图翻译并发" Style="{StaticResource FormRowLabel}"/><TextBox x:Name="AiConcurrencyInput" Width="120" HorizontalAlignment="Left" Style="{StaticResource Settings.ValidatedInput}" MinHeight="{DynamicResource Size.Control}" Padding="8,4"><TextBox.Text><Binding Path="SettingsDraft.AiConcurrency" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:IntegerRangeValidationRule Minimum="1" Maximum="8" FieldName="单图翻译并发"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></controls:SettingsRow>
                                    <controls:SettingsRow><TextBlock Text="翻译请求上限" Style="{StaticResource FormRowLabel}"/><TextBox x:Name="MaxTranslationConcurrencyInput" Width="120" HorizontalAlignment="Left" Style="{StaticResource Settings.ValidatedInput}" MinHeight="{DynamicResource Size.Control}" Padding="8,4"><TextBox.Text><Binding Path="SettingsDraft.MaxTranslationConcurrency" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:IntegerRangeValidationRule Minimum="1" Maximum="20" FieldName="翻译请求上限"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></controls:SettingsRow>
                                    <controls:SettingsRow><TextBlock Text="失败重试次数" Style="{StaticResource FormRowLabel}"/><TextBox x:Name="MaxRetryCountInput" Width="120" HorizontalAlignment="Left" Style="{StaticResource Settings.ValidatedInput}" MinHeight="{DynamicResource Size.Control}" Padding="8,4"><TextBox.Text><Binding Path="SettingsDraft.MaxRetryCount" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:IntegerRangeValidationRule Minimum="0" Maximum="5" FieldName="重试次数"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></controls:SettingsRow>
                                    <TextBlock Text="推荐：2 个图纸、单图 4 路、请求上限 12、失败重试 3 次。配置过高可能增加内存占用或触发服务限流。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTop}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource IndexToVis}, ConverterParameter=2}">
                            <TextBlock Text="SECTION 03 · FILES &amp; OUTPUT" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                            <TextBlock Text="文件与输出" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackLoose}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <!-- 输出目录是用户会填长路径的输入框，跨三列保留整行宽度。 -->
                                <controls:SettingsRow Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                    <StackPanel>
                                        <TextBlock Text="输出目录" Style="{StaticResource FormRowLabel}" />
                                        <!-- M13 改写（队长批准）：原文案「可暂时留空并在首次导出时选择」与实现相反——
                                             MainViewModel.ImportExport.cs:277 直接取 ResolveExportDirectory()/OutputDirectoryFor 的
                                             结果、首次导出并不弹目录选择框。改为与已交付行为一致的表述：
                                             留空 = <安装目录>\exports，安装区不可写才退回源图纸旁（AccountWorkspace.cs:29-48 的回退顺序）。 -->
                                        <TextBlock Text="留空则默认输出到 &lt;安装目录&gt;\exports（安装区不可写时退回源图纸旁的输出目录）；填写时必须是可写的绝对目录。" Style="{StaticResource FormRowDescription}" />
                                    </StackPanel>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="BrowseOutput_Click" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.LeftGap}"/><TextBox x:Name="ExportDirectoryInput" Style="{StaticResource Settings.ValidatedInput}" MinHeight="{DynamicResource Size.Control}" Padding="8,4" ToolTip="{Binding SettingsDraft.ExportDirectory}"><TextBox.Text><Binding Path="SettingsDraft.ExportDirectory" UpdateSourceTrigger="PropertyChanged"><Binding.ValidationRules><controls:AbsoluteDirectoryValidationRule/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></DockPanel>
                                </controls:SettingsRow>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="命名规则" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="可用 {name} / {lang} / {date}" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <TextBox x:Name="OutputNamingPatternInput" TextChanged="NamingChanged" Style="{StaticResource Settings.ValidatedInput}" MinHeight="{DynamicResource Size.Control}" Padding="8,4"><TextBox.Text><Binding Path="SettingsDraft.OutputNamingPattern" UpdateSourceTrigger="PropertyChanged"><Binding.ValidationRules><controls:OutputNamingPatternValidationRule/></Binding.ValidationRules></Binding></TextBox.Text></TextBox>
                                    </controls:SettingsRow>
                                    <controls:SettingsRow>
                                        <TextBlock Text="文件名预览" Style="{StaticResource FormRowLabel}" />
                                        <StackPanel>
                                            <Button Content="预览文件名" Click="PreviewNaming_Click" Style="{StaticResource Button.Tertiary}" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="NamingPreview" TextWrapping="Wrap" Margin="{DynamicResource Spacing.BlockTopTight}" />
                                        </StackPanel>
                                    </controls:SettingsRow>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <controls:SettingsRow>
                                        <TextBlock Text="遇到同名文件" Style="{StaticResource FormRowLabel}" />
                                        <ComboBox MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding SettingsDraft.DuplicatePolicy}" MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="遇到同名文件">
                                            <ComboBoxItem Content="跳过已有文件" Tag="skip" />
                                            <ComboBoxItem Content="覆盖输出文件" Tag="overwrite" />
                                            <ComboBoxItem Content="自动重命名" Tag="rename" />
                                        </ComboBox>
                                    </controls:SettingsRow>
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="写回前备份源文件" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="建议保留备份，以便在 CAD 写回冲突或异常时恢复原图。" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Left" AutomationProperties.Name="写回前备份源文件" IsChecked="{Binding SettingsDraft.BackupSourceBeforeWrite}" />
                                    </controls:SettingsRow>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource IndexToVis}, ConverterParameter=3}">
                            <TextBlock Text="SECTION 04 · CAD &amp; ENV" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                            <TextBlock Text="CAD 与环境" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackLoose}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="CAD 安装目录" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="修改路径后请先保存，再重新检测环境。" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="BrowseCad_Click" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.LeftGap}"/><TextBox Text="{Binding SettingsDraft.AutoCadInstallPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" MinHeight="{DynamicResource Size.Control}" Padding="8,4" ToolTip="{Binding SettingsDraft.AutoCadInstallPath}" /></DockPanel>
                                    </controls:SettingsRow>
                                    <controls:SettingsRow>
                                        <TextBlock Text="路径检测" Style="{StaticResource FormRowLabel}" />
                                        <Button Content="自动检测路径" Command="{Binding DetectSettingsCadCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
                                    </controls:SettingsRow>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="CAD 插件文件路径" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="通常由自动检测填写，无需手动修改。" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="BrowsePlugin_Click" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.LeftGap}"/><TextBox Text="{Binding SettingsDraft.CadPluginPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" MinHeight="{DynamicResource Size.Control}" Padding="8,4" ToolTip="{Binding SettingsDraft.CadPluginPath}" /></DockPanel>
                                    </controls:SettingsRow>
                                </StackPanel>
                            </Grid>
                            <ContentControl x:Name="EnvironmentHost" Margin="{DynamicResource Spacing.BlockTopSection}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource IndexToVis}, ConverterParameter=4}">
                            <TextBlock Text="日志" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackLoose}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="日志级别" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="保存后立即调整新产生的日志；已有日志不会被删除。" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <ComboBox MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" SelectedValuePath="Content" SelectedValue="{Binding SettingsDraft.MinimumLogLevel}" MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="日志级别">
                                            <ComboBoxItem Content="Verbose" /><ComboBoxItem Content="Debug" /><ComboBoxItem Content="Information" /><ComboBoxItem Content="Warning" /><ComboBoxItem Content="Error" /><ComboBoxItem Content="Fatal" />
                                        </ComboBox>
                                    </controls:SettingsRow>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <controls:SettingsRow>
                                        <StackPanel>
                                            <TextBlock Text="诊断工具" Style="{StaticResource FormRowLabel}" />
                                            <TextBlock Text="日志目录存放运行记录；排查问题时把最近的文件一并发给支持人员。" Style="{StaticResource FormRowDescription}" />
                                        </StackPanel>
                                        <Button Content="打开日志目录" Click="OpenLogs_Click" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" ToolTip="Debug 会记录详细运行信息，主要用于问题排查；商用运行推荐 Information。" />
                                    </controls:SettingsRow>
                                </StackPanel>
                            </Grid>
                            <!-- 实时日志（2026-10-02 用户反馈：「日志」分区标题下方空出一大块，版面失衡）。
                                 补一张滚动日志卡填满分区：绑定与折叠日志面板同一份 LogViewModel.LogEntries，
                                 新条目自动滚到底（SettingsPage.xaml.cs LiveLogAutoScroll）。只读预览，
                                 完整记录仍在日志目录（上方「打开日志目录」）。 -->
                            <Border Style="{StaticResource Section.Surface}" Margin="{DynamicResource Spacing.StackWide}" Padding="14,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="LIVE LOG" Style="{StaticResource Kicker}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="实时滚动 · 仅显示最近条目，完整记录见日志目录" Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox x:Name="LiveLogList" ItemsSource="{Binding LogViewModel.LogEntries}" DisplayMemberPath="DisplayText"
                                             Height="240" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1"
                                             FontFamily="{DynamicResource FontFamily.Mono}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="实时运行日志">
                                        <ListBox.ItemContainerStyle>
                                            <!-- 默认 ListBoxItem 选中/悬停是系统蓝，与杂志风冲突；收敛为纸面琥珀系。 -->
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="6,2" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" /></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource IndexToVis}, ConverterParameter=5}">
                            <StackPanel.Resources>
                                <Style x:Key="About.ShortcutCard" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Height" Value="Auto" />
                                    <Setter Property="MinHeight" Value="60" />
                                    <Setter Property="Padding" Value="14,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="SECTION 06 · ABOUT" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                            <TextBlock Text="关于与帮助" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AboutSubtitle" Text="查看版本、软件更新、使用帮助与服务状态" Style="{StaticResource PageSubtitleStyle}" />

                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Large}" Padding="16" Margin="{DynamicResource Spacing.Stack}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="AboutUpdateColumn" Width="236" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="56" Height="56" Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Image Source="pack://application:,,,/DwgTranslator;component/icon.ico" Width="36" Height="36" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineLeading}">
                                        <TextBlock Text="DWGC2E" FontFamily="{DynamicResource FontFamily.Display}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="DWG TRANSLATION · 图纸翻译工作台" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" Margin="{DynamicResource Spacing.StackTight}" />
                                        <WrapPanel>
                                            <TextBlock Text="{Binding AppReleaseVersionText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="16" FontWeight="SemiBold" Margin="{DynamicResource Spacing.InlineWide}" />
                                            <TextBlock Text="{Binding AppBuildText, StringFormat=构建 {0}}" FontFamily="{DynamicResource FontFamily.Mono}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" ToolTip="{Binding AppVersionText}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="AboutUpdatePanel" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" MinHeight="64">
                                        <!-- 更新状态文字受 AboutUpdateColumn 约束：长文案换行显示而不是被静默裁掉，ToolTip 兜底给全文。 -->
                                        <DockPanel x:Name="AboutStatusPanel" Margin="{DynamicResource Spacing.Stack}">
                                            <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding UpdateCheckSucceeded}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HasAvailableUpdate}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding UpdateCheckFailed}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Center" ToolTip="{Binding UpdateStatusText}" />
                                        </DockPanel>
                                        <Button x:Name="AboutUpdateButton" Content="{Binding UpdateCheckButtonText}" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" MinWidth="112" IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" />
                                        <Button Content="查看更新详情" Command="{Binding ShowUpdateDetailsCommand}" Style="{StaticResource Button.Tertiary}" HorizontalAlignment="Left" Margin="{DynamicResource Spacing.BlockTopTight}" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 快捷入口与版本详情并排：1366x768 下把纵向占用压到视口以内，同时消掉网格右侧的成片留白。
                                 窄窗由 SettingsPage.xaml.cs 的 compact 分支把版本详情落回第二行。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="AboutDetailsGap" Width="16" />
                                    <ColumnDefinition x:Name="AboutDetailsColumn" Width="380" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="快捷入口" Style="{StaticResource FormRowLabel}" Margin="{DynamicResource Spacing.StackTight}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Command="{Binding OpenHelpCommand}" Style="{StaticResource About.ShortcutCard}" AutomationProperties.Name="使用帮助">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="2" Background="{DynamicResource Brush.PrimaryLight}" HorizontalAlignment="Left"><Path Data="{DynamicResource Icon.HelpRing}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}"><TextBlock Text="使用帮助" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="查看软件使用说明和常见操作" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="0" Grid.Column="2" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource About.ShortcutCard}" AutomationProperties.Name="问题反馈">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="2" Background="{DynamicResource Brush.PrimaryLight}" HorizontalAlignment="Left"><Path Data="{DynamicResource Icon.HelpMark}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}"><TextBlock Text="问题反馈" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="提交问题、建议或错误信息" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="0" Command="{Binding OpenWebsiteCommand}" Style="{StaticResource About.ShortcutCard}" AutomationProperties.Name="官方网站">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="2" Background="{DynamicResource Brush.PrimaryLight}" HorizontalAlignment="Left"><Path Data="{DynamicResource Icon.Monitor}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}"><TextBlock Text="官方网站" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="查看公告和产品信息" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="2" Command="{Binding CheckServiceCommand}" IsEnabled="{Binding IsCheckingService, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource About.ShortcutCard}" AutomationProperties.Name="服务状态">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="2" Background="{DynamicResource Brush.PrimaryLight}" HorizontalAlignment="Left"><Path Data="{DynamicResource Icon.Refresh}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}"><TextBlock Text="服务状态" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="检测后台服务连接状态" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Border x:Name="AboutDetailsCard" Grid.Row="0" Grid.Column="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="{DynamicResource Spacing.InlineLoose}">
                                            <TextBlock Text="版本详情" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{Binding AppBuildText, StringFormat=构建：{0}}" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}" />
                                            <TextBlock Text="{Binding AppBuildDateText, StringFormat=构建时间：{0}}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding AppRuntimeText, StringFormat=运行环境：{0}}" Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="复制版本信息" Command="{Binding CopyVersionInfoCommand}" Style="{StaticResource Button.Compact.Secondary}" VerticalAlignment="Top" ToolTip="构建时间、运行环境等诊断信息随版本一起复制，便于反馈问题。" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Text="© DWGC2E · DWG TRANSLATION" FontFamily="{DynamicResource FontFamily.Mono}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="{DynamicResource Spacing.BlockTop}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <!-- 操作条：草稿状态徽标 + 说明文字与按钮同排，提示不再单独漂浮在页面中部。
                 必须与右卡同列（Grid.Column=2）：Width 绑 SettingsContent.ActualWidth + HorizontalAlignment=Center
                 只保证"同宽且居中"，而居中的参照是**所在列**——若让它跨三列，它会按整页宽度居中，
                 与只占列 2 的表单错开 (168+16)/2 = 92 DIP，直接踩红 UI 冒烟 Program.cs:640
                 「settings footer aligns with form」（断言两者 ActualWidth 差 < 2）。 -->
            <DockPanel x:Name="SettingsSaveBar" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" Width="{Binding ActualWidth, ElementName=SettingsContent}" MaxWidth="1080" Margin="{DynamicResource Spacing.BlockTopWide}" MinHeight="48" Background="{DynamicResource Brush.SurfaceAlt}"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding SettingsSection}" Value="5"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RestoreSettingsButton" Content="恢复本节推荐值" Command="{Binding RestoreSettingsSectionDefaultsCommand}" Style="{StaticResource Button.Tertiary}" Margin="{DynamicResource Spacing.Inline}" />
                    <Button x:Name="DiscardSettingsButton" Content="放弃更改" Command="{Binding DiscardSettingsChangesCommand}" IsEnabled="{Binding CanDiscardSettings}" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline}" />
                    <Button x:Name="SaveSettingsButton" Content="保存更改" Command="{Binding SaveSettingsChangesCommand}" IsEnabled="{Binding CanSaveSettings}" Style="{StaticResource Button.Primary}" />
                </StackPanel>
                <Grid VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineWide}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="SettingsDraftStatus" CornerRadius="2" Padding="9,3" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessLight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedSettings}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.WarningLight}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasPendingSettingsApplication}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.InfoLight}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasSettingsValidationErrors}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.DangerLight}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SettingsStateText}" FontFamily="{DynamicResource FontFamily.Mono}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding SettingsFeedback}" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsFeedback}" />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
