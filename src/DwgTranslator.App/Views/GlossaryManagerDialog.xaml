<Window x:Class="DwgTranslator.App.Views.GlossaryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Title="{conv:Localize GlossaryManagerTitle}"
        Width="650" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}"
        MaxHeight="800">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 自绘窗口按钮：与主窗口的窗口按钮同一套观感 -->
        <Style x:Key="DialogWindowButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadius.Small}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header（标题在左，关闭按钮在布局内右上角；不再用系统工具窗口那个孤立红叉） -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Text="{conv:Localize GlossaryDesc}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#x2715;"
                    Width="34" FontSize="12" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand" ToolTip="关闭"
                    AutomationProperties.Name="关闭"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" x:Name="GlossaryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  SelectionMode="Extended"
                  Margin="0,0,0,8"
                  FontSize="12"
                  RowHeight="28"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Brush.BorderLight}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <!-- 与主界面表格表头一致（浅灰蓝底 + 深字）；原来是深板岩蓝底白字，和其它页面不搭 -->
                    <Setter Property="Background" Value="{DynamicResource Brush.DataGridHeader}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{conv:Localize GlossaryColSource}" Binding="{Binding Source}" Width="220"/>
                <DataGridTextColumn Header="{conv:Localize GlossaryColTarget}" Binding="{Binding Target}" Width="220"/>
                <DataGridTextColumn Header="{conv:Localize GlossaryColCategory}" Binding="{Binding Category}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="+ 新增术语" Padding="10,5" Margin="0,0,6,0"
                    Click="AddRow_Click" Cursor="Hand" FontSize="12"
                    Background="{DynamicResource Brush.Success}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button x:Name="DeleteSelectedButton" Content="删除选中" Padding="10,5"
                    Click="DeleteSelected_Click" Cursor="Hand" FontSize="12"
                    Background="{DynamicResource Brush.Danger}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="{conv:Localize BtnSaveGlossary}" Padding="14,6" Margin="0,0,8,0"
                    Background="{DynamicResource Brush.Primary}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                    Click="Save_Click" Cursor="Hand" BorderThickness="0"/>
            <Button Content="{conv:Localize BtnCancel}" Padding="14,6" FontSize="12"
                    Click="Cancel_Click" Cursor="Hand" Background="{DynamicResource Brush.BackgroundAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
