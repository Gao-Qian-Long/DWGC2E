<UserControl x:Class="DwgTranslator.App.Views.Pages.BatchTasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
<StackPanel>
            <controls:PageHeader x:Name="WorkspaceHeader" Header="批量任务" Description="查看和管理图纸任务，在详情中检查并校对翻译结果。" />
            <Border x:Name="RecoveryNotice" Visibility="{Binding HasTaskRecoveryWarning, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.WarningLight}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" AutomationProperties.Name="任务恢复警告">
                <TextBlock Text="{Binding TaskRecoveryWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </StackPanel>
        <Grid Grid.Row="1" Visibility="{Binding IsProofreading, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Style="{StaticResource Workspace.Toolbar}">
                <TextBox Style="{StaticResource Search.Input}" Tag="搜索图纸名称或任务" Width="260" Text="{Binding BatchSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索任务文件名" AutomationProperties.Name="搜索任务" Margin="0,0,8,4" />
                <ComboBox Width="120" SelectedIndex="{Binding BatchStatusFilter}" Margin="0,0,8,4" AutomationProperties.Name="任务状态">
                    <ComboBoxItem Content="全部状态" />
                    <ComboBoxItem Content="运行中" />
                    <ComboBoxItem Content="等待中" />
                    <ComboBoxItem Content="已完成" />
                    <ComboBoxItem Content="失败" />
                    <ComboBoxItem Content="已暂停" />
                    <ComboBoxItem Content="已取消" />
                    <ComboBoxItem Content="已跳过" />
                </ComboBox>
                <ComboBox Width="120" SelectedIndex="{Binding BatchDateFilter}" Margin="0,0,8,4" AutomationProperties.Name="创建时间">
                    <ComboBoxItem Content="全部时间" />
                    <ComboBoxItem Content="今天" />
                    <ComboBoxItem Content="最近七天" />
                </ComboBox>
                <Button Content="重试失败" IsEnabled="{Binding HasFailedDrawingTasks}" Command="{Binding RetryFailedCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,4" />
                <Button Content="取消任务" Command="{Binding CancelTranslateCommand}" Style="{StaticResource Button.Danger}" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock Grid.Row="1" Text="{Binding BatchCountText}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,12" />
            <Grid Grid.Row="2">
                <DataGrid x:Name="TaskTable" ItemsSource="{Binding BatchView}" SelectedItem="{Binding SelectedBatchTask}" SelectionMode="Single" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column" RowHeight="{DynamicResource Size.TableRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="任务 / 图纸" Binding="{Binding FileName}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtText}" Width="145" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="105" />
                        <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="85" />
                        <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="80" />
                        <DataGridTemplateColumn Header="操作" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="详情" Style="{StaticResource Button.Tertiary}" Command="{Binding DataContext.ShowTaskDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:EmptyState><controls:EmptyState.Style><Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}"><Setter Property="Header" Value="暂无翻译任务"/><Setter Property="Description" Value="添加图纸后，任务会显示在这里；仅显示当前会话的任务。"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=TaskTable}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasDrawingFiles}" Value="True"><Setter Property="Header" Value="没有符合当前条件的任务"/><Setter Property="Description" Value="请清除或调整上方筛选条件。"/></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style><StackPanel Orientation="Horizontal"><Button Content="添加图纸" Command="{Binding ImportDwgCommand}" Style="{StaticResource Button.Primary}" Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}, ConverterParameter=false}"/><Button Content="清除筛选" Click="ClearFilters_Click" Style="{StaticResource Button.Secondary}" Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}}"/></StackPanel></controls:EmptyState>
            </Grid>
            <Border Grid.RowSpan="3" Style="{StaticResource Drawer.Surface}" Visibility="{Binding IsTaskDetailOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="关闭" DockPanel.Dock="Right" Command="{Binding CloseTaskDetailCommand}" Style="{StaticResource Button.Tertiary}" />
                            <TextBlock Text="任务详情" Style="{StaticResource SectionTitleStyle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedBatchTask.FileName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,8" />
                        <TextBlock Text="{Binding SelectedBatchTask.StatusText}" />
                        <ProgressBar Height="4" Value="{Binding SelectedBatchTask.ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,12" />
                        <TextBlock Text="{Binding SelectedBatchTask.SummaryText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedBatchTask.ElapsedText, StringFormat=耗时：{0}}" Margin="0,8" />
                        <TextBlock Text="{Binding SelectedBatchTask.ErrorText}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8" />
                        <TextBlock Text="{Binding SelectedBatchTask.OutputText}" TextWrapping="Wrap" />
                        <Button Content="打开输出文件" Command="{Binding OpenDrawingOutputCommand}" CommandParameter="{Binding SelectedBatchTask}" Style="{StaticResource Button.Secondary}" Margin="0,12" Visibility="{Binding SelectedBatchTask.HasOutput, Converter={StaticResource BoolToVis}}" />
                        <Button Content="进入译文校对" Command="{Binding OpenTaskProofreadingCommand}" Style="{StaticResource Button.Primary}" Margin="0,12" />
                        <Button Content="查看运行日志" Command="{Binding ToggleLogViewerCommand}" Style="{StaticResource Button.Tertiary}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Visibility="{Binding IsProofreading, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="返回任务列表" Command="{Binding BackToTaskListCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding SelectedDrawingFile.FileName}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="全部标为已校对" Command="{Binding MarkAllReviewedCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,4" />
                <Button Content="保存更改" Command="{Binding SaveProofreadingCommand}" IsEnabled="{Binding HasUnsavedProofreading}" Style="{StaticResource Button.Primary}" Margin="0,0,8,4" />
                <Button Content="取消编辑" Command="{Binding DiscardProofreadingCommand}" IsEnabled="{Binding HasUnsavedProofreading}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,4" />
                <Button Content="导出校对结果" Command="{Binding ExportDwgCommand}" Style="{StaticResource Button.Primary}" />
                <TextBlock Text="Enter 确认单元格，Esc 取消；完成后保存更改。" VerticalAlignment="Center" Margin="12,0" />
            </WrapPanel>
            <DataGrid Grid.Row="1" ToolTip="双击译文编辑；Enter 确认单元格，完成后保存更改。" ItemsSource="{Binding FilteredEntities}" AutoGenerateColumns="False" IsReadOnly="{Binding IsProcessing}" CellEditEnding="TranslationGrid_CellEditEnding" CanUserAddRows="False" BorderThickness="0" MinRowHeight="{DynamicResource Size.TableRow}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="句柄" ElementStyle="{StaticResource CenteredCellStyle}" IsReadOnly="True" Binding="{Binding Handle}" Width="90" />
                    <DataGridTextColumn Header="原文" IsReadOnly="True" Binding="{Binding PlainText}" Width="*" ElementStyle="{StaticResource WrapCellStyle}" />
                    <DataGridTextColumn Header="译文" Binding="{Binding TranslatedText, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Width="*" ElementStyle="{StaticResource WrapCellStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>