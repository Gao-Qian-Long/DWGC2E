<Window x:Class="DwgTranslator.App.Views.ExportModeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择图纸导出方式" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource Brush.Surface}">
  <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1" Padding="24">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Content="×" ToolTip="取消并关闭" Width="34" Height="34" Click="Cancel_Click" Style="{StaticResource Button.Tertiary}" />
        <TextBlock Text="选择图纸导出方式" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Text="确认导出方式后继续。不会修改当前图纸队列。" TextWrapping="Wrap" Margin="0,0,0,18" />
      <RadioButton x:Name="CadOption" Content="使用 CAD 精确写回" GroupName="Mode" Margin="0,8" />
      <TextBlock x:Name="CadStatus" TextWrapping="Wrap" Margin="22,0,0,16" Foreground="{DynamicResource Brush.TextSecondary}" />
      <RadioButton x:Name="OfflineOption" Content="离线导出" GroupName="Mode" Margin="0,8" />
      <TextBlock Text="不启动 CAD；复杂图纸建议使用 CAD 精确写回。" TextWrapping="Wrap" Margin="22,0,0,24" Foreground="{DynamicResource Brush.TextSecondary}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" Click="Cancel_Click" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
        <Button Content="确认导出" IsDefault="True" Click="Confirm_Click" Style="{StaticResource Button.Primary}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>