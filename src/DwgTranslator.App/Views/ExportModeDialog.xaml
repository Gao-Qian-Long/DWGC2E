<Window x:Class="DwgTranslator.App.Views.ExportModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导出模式" Height="440" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="选择 DWG 导出模式" FontWeight="Bold" FontSize="18" Foreground="#1976D2"/>
            <TextBlock Text="根据您的环境选择合适的回写方式" FontSize="12" Foreground="#78909C" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Mode Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- AutoCAD Mode -->
            <Border Grid.Column="0" x:Name="AutoCadCard"
                    BorderBrush="#1976D2" BorderThickness="2" CornerRadius="8"
                    Background="White" Padding="16" Margin="0,0,8,0"
                    Cursor="Hand" MouseLeftButtonDown="AutoCadCard_Click">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#x1F3AF;" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="AutoCAD 精确回写" FontWeight="Bold" FontSize="14" Foreground="#1565C0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#4CAF50" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="推荐" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="&#x2022; 在 AutoCAD 进程内精确替换文字"
                               TextWrapping="Wrap" Foreground="#546E7A" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x2022; 自动检测图框，防止文字溢出"
                               TextWrapping="Wrap" Foreground="#546E7A" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x2022; 碰撞检测，避免与其他图形干涉"
                               TextWrapping="Wrap" Foreground="#546E7A" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x2022; 智能调整文字宽度和字高"
                               TextWrapping="Wrap" Foreground="#546E7A" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock x:Name="AutoCadStatusText"
                               Text="&#x26A0; 需要 AutoCAD 正在运行" FontSize="11"
                               Foreground="#FF9800" Margin="0,8,0,0" FontWeight="Medium"/>
                </StackPanel>
            </Border>

            <!-- Offline Mode -->
            <Border Grid.Column="1" x:Name="OfflineCard"
                    BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="8"
                    Background="White" Padding="16" Margin="8,0,0,0"
                    Cursor="Hand" MouseLeftButtonDown="OfflineCard_Click">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#x1F4BE;" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="离线回写" FontWeight="Bold" FontSize="14" Foreground="#616161" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#9E9E9E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="无需 AutoCAD" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="&#x2022; 直接修改 DWG 文件，无需 AutoCAD"
                               TextWrapping="Wrap" Foreground="#757575" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x2022; 排版为估算值，可能需要微调"
                               TextWrapping="Wrap" Foreground="#757575" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x2022; 适合没有安装 AutoCAD 的场景"
                               TextWrapping="Wrap" Foreground="#757575" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x2022; 智能宽度和字高缩放"
                               TextWrapping="Wrap" Foreground="#757575" FontSize="12" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" Margin="0,0,0,0" Click="Cancel_Click"
                    Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
