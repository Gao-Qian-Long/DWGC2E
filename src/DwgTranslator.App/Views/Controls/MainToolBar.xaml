<UserControl x:Class="DwgTranslator.App.Views.Controls.MainToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
        <WrapPanel Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportDwgCommand}"
                    Background="#1976D2" ToolTip="{conv:Localize TipImportDwg}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C2;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnImportDwg}"/>
                </StackPanel>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource PrimaryButton}"
                    Background="#FF9800" Command="{Binding ToggleLanguageDirectionCommand}"
                    ToolTip="{conv:Localize TipToggleDirection}" Margin="2">
                <TextBlock TextAlignment="Center">
                    <Run Text="&#x21C4; " FontSize="14"/><Run Text="{Binding LanguageDirection}" FontSize="12"/>
                </TextBlock>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource PrimaryButton}" Command="{Binding TranslateCommand}"
                    Background="#4CAF50" ToolTip="{conv:Localize TipTranslate}"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B6;" Margin="0,0,4,0" FontSize="11"/>
                    <TextBlock Text="{conv:Localize BtnTranslate}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CancelTranslateCommand}"
                    Background="#E53935" ToolTip="{conv:Localize TipStopTranslation}"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25A0;" Margin="0,0,4,0" FontSize="11"/>
                    <TextBlock Text="{conv:Localize BtnStop}"/>
                </StackPanel>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource ToolButton}" Command="{Binding ExportExcelCommand}"
                    ToolTip="{conv:Localize TipExportExcel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CA;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnExportExcel}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding ImportExcelCommand}"
                    ToolTip="{conv:Localize TipImportExcel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C5;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnImportExcel}"/>
                </StackPanel>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportDwgCommand}"
                    Background="#2E7D32" ToolTip="{conv:Localize TipExportDwg}"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4BE;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnExportDwg}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CancelExportCommand}"
                    Background="#E53935" ToolTip="{conv:Localize TipCancelExport}"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25A0;" Margin="0,0,4,0" FontSize="11"/>
                    <TextBlock Text="{conv:Localize BtnCancelExport}"/>
                </StackPanel>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource ToolButton}" Command="{Binding MarkAllReviewedCommand}"
                    ToolTip="{conv:Localize TipMarkReviewed}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2714;" Margin="0,0,4,0" Foreground="#4CAF50"/>
                    <TextBlock Text="{conv:Localize BtnMarkAllReviewed}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding RetryFailedCommand}"
                    ToolTip="{conv:Localize TipRetryFailed}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" Margin="0,0,4,0" Foreground="#FF9800"/>
                    <TextBlock Text="{conv:Localize BtnRetryFailed}"/>
                </StackPanel>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenGlossaryManagerCommand}"
                    ToolTip="{conv:Localize TipGlossary}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4D6;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnGlossary}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding ImportGlossaryCommand}"
                    ToolTip="{conv:Localize TipImportGlossary}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4E5;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnImportGlossary}"/>
                </StackPanel>
            </Button>
            <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenLicenseDialogCommand}"
                    ToolTip="{conv:Localize TipLicense}" BorderBrush="#FF9800" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F511;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnLicense}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding SettingsCommand}"
                    ToolTip="{conv:Localize TipSettings}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2699;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnSettings}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleLogViewerCommand}"
                    ToolTip="{conv:Localize TipLog}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CB;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnLog}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding ShowHelpCommand}"
                    ToolTip="{conv:Localize TipHelp}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2753;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnHelp}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding ClearAllCommand}"
                    ToolTip="{conv:Localize TipClear}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" Margin="0,0,4,0"/>
                    <TextBlock Text="{conv:Localize BtnClear}"/>
                </StackPanel>
            </Button>
        </WrapPanel>
    </Border>
</UserControl>
