<Window x:Class="DwgTranslator.App.Views.ExportModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导出模式" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="选择 DWG 导出模式" FontWeight="Bold" FontSize="16"
                   Foreground="#1976D2" Margin="0,0,0,15"/>

        <!-- Mode Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- AutoCAD Mode -->
            <Border Grid.Column="0" x:Name="AutoCadCard"
                    BorderBrush="#1976D2" BorderThickness="2" CornerRadius="6"
                    Background="#E3F2FD" Padding="14" Margin="0,0,8,0"
                    Cursor="Hand" MouseLeftButtonDown="AutoCadCard_Click">
                <StackPanel>
                    <TextBlock Text="AutoCAD 精确回写" FontWeight="Bold" FontSize="14"
                               Foreground="#1565C0" Margin="0,0,0,6"/>
                    <TextBlock Text="推荐" FontSize="11" FontWeight="Bold"
                               Foreground="White" Background="#4CAF50"
                               Padding="4,1" HorizontalAlignment="Left"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="&#x2022; 在 AutoCAD 进程内精确替换文字"
                               TextWrapping="Wrap" Foreground="#37474F" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="&#x2022; 自动检测图框，防止文字溢出"
                               TextWrapping="Wrap" Foreground="#37474F" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="&#x2022; 保留原始排版和字体映射"
                               TextWrapping="Wrap" Foreground="#37474F" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="&#x2022; 需要 AutoCAD 正在运行"
                               TextWrapping="Wrap" Foreground="#37474F" FontSize="12" Margin="0,0,0,0"/>
                    <TextBlock x:Name="AutoCadStatusText"
                               Text="状态：检测中..." FontSize="11"
                               Foreground="#757575" Margin="0,8,0,0" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Offline Mode -->
            <Border Grid.Column="1" x:Name="OfflineCard"
                    BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="6"
                    Background="#FAFAFA" Padding="14" Margin="8,0,0,0"
                    Cursor="Hand" MouseLeftButtonDown="OfflineCard_Click">
                <StackPanel>
                    <TextBlock Text="离线回写" FontWeight="Bold" FontSize="14"
                               Foreground="#616161" Margin="0,0,0,6"/>
                    <TextBlock Text="无需 AutoCAD" FontSize="11" FontWeight="Bold"
                               Foreground="White" Background="#9E9E9E"
                               Padding="4,1" HorizontalAlignment="Left"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="&#x2022; 直接修改 DWG 文件，不依赖 AutoCAD"
                               TextWrapping="Wrap" Foreground="#616161" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="&#x2022; 排版为估算值，可能需要微调"
                               TextWrapping="Wrap" Foreground="#616161" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="&#x2022; 适合没有安装 AutoCAD 的场景"
                               TextWrapping="Wrap" Foreground="#616161" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="&#x2022; 兼容性好，但精度稍低"
                               TextWrapping="Wrap" Foreground="#616161" FontSize="12" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Width="75" Height="28" Margin="0,0,8,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
