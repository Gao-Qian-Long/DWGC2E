<Window x:Class="DwgTranslator.App.Views.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Title="{conv:Localize LicenseTitle}" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource FontFamily.Body}"
        FontSize="{DynamicResource FontSize.Body}"
        MaxHeight="700">
    <Grid Margin="{DynamicResource Spacing.20}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource Spacing.StackWide}">
            <TextBlock Text="{conv:Localize LicenseHeader}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="{conv:Localize LicenseManageDesc}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" Margin="{DynamicResource Spacing.BlockTopTight}"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource Spacing.StackWide}">
            <StackPanel>
                <!-- Current Status Panel -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="{DynamicResource Spacing.Stack}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{conv:Localize LicenseCurrentStatus}" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Inline}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatusText" Text="{conv:Localize LicenseLoading}" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Margin="{DynamicResource Spacing.StackTight}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{conv:Localize LicenseMachineId}" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Inline}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MachineIdBox" IsReadOnly="True" Background="{DynamicResource Brush.BackgroundAlt}" Padding="4,2" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" Margin="{DynamicResource Spacing.StackTight}" VerticalAlignment="Center" BorderBrush="{DynamicResource Brush.Border}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{conv:Localize LicenseTrialRemaining}" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Inline}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TrialText" Text="-" Margin="{DynamicResource Spacing.StackTight}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{conv:Localize LicenseType}" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Inline}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseTypeText" Text="{conv:Localize LicenseTrial}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Activation Input -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="{DynamicResource Spacing.Stack}">
                    <StackPanel>
                        <TextBlock Text="{conv:Localize LicenseEnterCode}" FontWeight="Bold" Margin="{DynamicResource Spacing.StackTight}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBox x:Name="ActivationCodeBox" Padding="8,6" FontSize="{DynamicResource FontSize.Body}" FontFamily="{DynamicResource FontFamily.Mono}"
                                 TextWrapping="NoWrap" AcceptsReturn="False" BorderBrush="{DynamicResource Brush.Border}"
                                 ToolTip="输入 gql119871 或 DwgTranslator-P-XXXX..."/>
                        <TextBlock x:Name="ResultText" Text="" Margin="{DynamicResource Spacing.BlockTopTight}" FontSize="{DynamicResource FontSize.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Pricing Info -->
                <Border Style="{StaticResource Card.Inset}" Background="{DynamicResource Brush.InfoLight}" Padding="12">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.Info}" LineHeight="17">
                        <Run FontWeight="Bold" Text="{conv:Localize LicensePricing}"/><LineBreak/>
                        <Run Text="{conv:Localize LicenseTrialDesc}"/><LineBreak/>
                        <Run Text="{conv:Localize LicensePerpetualDesc}"/><LineBreak/>
                        <Run Text="{conv:Localize LicenseSubscriptionDesc}"/><LineBreak/>
                        <Run Text="{conv:Localize LicenseMachineNote}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons - ALWAYS VISIBLE at bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyMachineIdButton" Content="{conv:Localize BtnCopyMachineId}" Margin="{DynamicResource Spacing.Inline}"
                    Click="CopyMachineId_Click" Style="{StaticResource Button.Secondary}" />
            <Button x:Name="ActivateButton" Content="{conv:Localize BtnActivate}" Margin="{DynamicResource Spacing.Inline}"
                    Click="Activate_Click" Style="{StaticResource Button.Primary}" />
            <Button Content="{conv:Localize BtnOk}" Click="Close_Click" IsDefault="True" Style="{StaticResource Button.Secondary}" />
        </StackPanel>
    </Grid>
</Window>
