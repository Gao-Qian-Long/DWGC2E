<Window x:Class="DwgTranslator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls"
        xmlns:views="clr-namespace:DwgTranslator.App.Views"
        Title="{conv:Localize AppTitle}" Height="780" Width="1280"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F0F4F8">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Custom Title Bar -->
        <controls:TitleBarControl Grid.Row="0"/>

        <!-- Row 1: Toolbar -->
        <controls:MainToolBar Grid.Row="1"/>

        <!-- Row 2: Filter + Stats -->
        <controls:FilterStatsBar Grid.Row="2"/>

        <!-- Row 3: Progress Bar -->
        <Grid Grid.Row="3" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="0" Padding="8,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding OperationLabel}" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="..." FontSize="11" Foreground="#1565C0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCancellationRequested}" Value="True">
                                        <Setter Property="Text" Value="{conv:Localize ProgressCancelling}"/>
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <ProgressBar Grid.Column="1" Height="4"
                         Value="{Binding ProgressValue}" Maximum="100"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Foreground="#4CAF50" Background="#E8E8E8"/>
            <TextBlock Grid.Column="2" Margin="6,0" FontSize="11" Foreground="#78909C" VerticalAlignment="Center">
                <TextBlock.Text>
                    <Binding Path="ProgressValue" StringFormat="{}{0:0}%"/>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <!-- Row 4: Data Grid -->
        <controls:TranslationDataGrid Grid.Row="4"/>

        <!-- Row 5: Log Viewer Panel (collapsible) -->
        <views:LogViewerPanel Grid.Row="5" x:Name="LogPanel"
                              DataContext="{Binding LogViewModel}"
                              MaxHeight="280"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- Row 6: Status Bar -->
        <Border Grid.Row="6" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="0">
            <StatusBar Background="Transparent" Margin="0">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#FF9800"/>
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                            From="#FF9800" To="#1976D2" Duration="0:0:0.8"
                                                            AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#546E7A"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock Text="{Binding GlossaryStatsText}" Foreground="#90A4AE" FontSize="11" Margin="0,0,15,0"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock Text="{Binding LicenseStatusText}" Foreground="#E65100" FontSize="11" Margin="0,0,15,0" FontWeight="SemiBold"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="3">
                    <TextBlock Text="DWG Translator v2.1" Foreground="#B0BEC5" FontSize="10"/>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>
