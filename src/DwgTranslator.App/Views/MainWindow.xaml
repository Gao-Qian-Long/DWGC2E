<Window x:Class="DwgTranslator.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:DwgTranslator.App.Converters" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:pages="clr-namespace:DwgTranslator.App.Views.Pages" xmlns:views="clr-namespace:DwgTranslator.App.Views" Title="{conv:Localize AppTitle}" Height="820" Width="1500" MinHeight="640" MinWidth="1120" FontFamily="{DynamicResource FontFamily.Body}" FontSize="{DynamicResource FontSize.Body}" UseLayoutRounding="True" Icon="pack://application:,,,/QLCAD;component/icon.ico" WindowStartupLocation="CenterScreen" Topmost="False" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDragLeave="OnPreviewDragLeave" PreviewDrop="OnPreviewDrop" PreviewKeyDown="OnPreviewKeyDown" Background="{DynamicResource Brush.Background}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <!-- Keyboard shortcuts: F1 帮助 / Ctrl+E 环境自检 / Ctrl+L 日志 … -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ShowEnvironmentCheckCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLogViewerCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- 墨色侧栏导航项（暖色手作杂志风）：反白文字＋琥珀选中条＋等宽编号 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{DynamicResource Size.NavItem}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInkMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 保留键盘焦点提示。 -->
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Margin="-8,2,0,2" CornerRadius="2" Background="Transparent" />
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.InkAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.InkAlt}" />
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Brush.Amber}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 导航等宽编号：01/02/…，杂志编号卡片语言 -->
        <Style x:Key="NavIndexStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Width" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="{StaticResource Size.Sidebar}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- §L20 公告与用户入口各自占列，不再靠 Left/Right 对齐挤在同一列 -->
                <controls:AnnouncementBanner x:Name="SiteAnnouncement" Grid.Column="0" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineWide}">
                    <!-- 会员卡 chip（2026-10-02 重设计）：原先"琥珀浅底 + 两个裸文本 + 按钮"贴在奶白顶栏上，
                         用户反馈突兀、数字冗长（剩余 1,007,989,932 / 1,008,000,000）。改为墨色小卡：
                         星芒 + 套餐名 + 剩余比例迷你进度条 + 紧凑数字（10.08 亿），完整数字留在 ToolTip；
                         「查看套餐」改成墨底琥珀链接按钮，整块看起来像一张会员卡片，信息密度不变但更收敛。
                         未登录（IsAccountLoggedIn=false）或还没拿到额度快照（OnlineUsage=null）时整块收起。
                         整个 chip 标记为可命中，否则它在 44 DIP 拖拽标题栏里只当作拖动区，按钮点不动。 -->
                    <Border x:Name="ShellQuotaChip" Height="28" Padding="10,0" CornerRadius="3" Margin="{DynamicResource Spacing.InlineWide}" ToolTip="{Binding OnlineQuotaText}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.InkBorder}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountLoggedIn}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OnlineUsage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Deco.SparkSmall}" Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OnlinePlanText}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnInk}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <Border Width="1" Height="14" Background="{DynamicResource Brush.InkBorder}" Margin="9,0" VerticalAlignment="Center" />
                            <ProgressBar Value="{Binding OnlineQuotaRatio, Mode=OneWay}" Maximum="100" Width="56" Height="4" BorderThickness="0" Foreground="{DynamicResource Brush.Amber}" Background="{DynamicResource Brush.OnInkTrack}" VerticalAlignment="Center" ToolTip="{Binding OnlineQuotaText}" />
                            <TextBlock Text="{Binding OnlineQuotaCompactText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="11" Foreground="{DynamicResource Brush.OnInkMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Button Content="查看套餐" Command="{Binding NavigateToCommand}" CommandParameter="account" Height="22" Margin="8,0,0,0" Cursor="Hand" ToolTip="打开会员中心查看套餐与订单" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.OnInkAccent}" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ChipLinkSurface" Background="Transparent" CornerRadius="2" Padding="7,0">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipLinkSurface" Property="Background" Value="{DynamicResource Brush.OnInkTrack}" /></Trigger>
                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChipLinkSurface" Property="Background" Value="{DynamicResource Brush.InkBorder}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- 会员状态：只显示真实授权状态（后端未接通时不伪造套餐/额度） -->
                    <Border Style="{StaticResource Badge.Accent}" Padding="9,3" Margin="{DynamicResource Spacing.InlineWide}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.StatPin}" Width="12" Height="12" Stretch="Uniform" Fill="Transparent" Margin="{DynamicResource Spacing.InlineTight}" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
                            <TextBlock Text="{Binding LicenseStatusText}" Style="{StaticResource Badge.AccentText}" />
                        </StackPanel>
                    </Border>
                    <!-- 用户入口：账号 / 置顶 / 环境自检 / 帮助 -->
                    <Button Content="建议更新" Command="{Binding ShowUpdateDetailsCommand}" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}" ToolTip="{Binding UpdateSummary}" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline}" Height="30" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="TopmostButton" Command="{Binding ToggleTopmostCommand}" Width="36" Height="36" WindowChrome.IsHitTestVisibleInChrome="True" >
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.TitleBarIcon}">
                            <Setter Property="ToolTip" Value="固定窗口"/>
                            <Setter Property="AutomationProperties.Name" Value="固定窗口"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                <Setter Property="ToolTip" Value="取消固定"/>
                                <Setter Property="AutomationProperties.Name" Value="取消固定"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                        <Grid Width="16" Height="18"><Path Data="M 3,1 L 13,1 L 11,4 L 11,8 L 15,12 L 1,12 L 5,8 L 5,4 Z M 8,12 L 8,17" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent" /><Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path></Grid>
                    </Button>

                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Divider.Vertical}" />
                <controls:TitleBarControl Grid.Column="3" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Brush.StatusBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,0" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="{DynamicResource Spacing.Inline}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <!-- 2026-10-02：运行中状态点加呼吸脉冲（用户要求"正在转换"要有可见的过程动画） -->
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="StatusPulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="StatusPulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ShellStatusLabel" Text="{Binding ShellStatusText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource Size.StatusTextMax}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" ToolTip="{Binding ShellStatusText}" />
                    <!-- 任务层当前阶段（例：[3/6] 总装配图.dwg 正在翻译文本 42%）：状态栏直接说清
                             "在做什么"，而不是只给一个百分比。无任务阶段时自动隐藏。 -->
                    <!-- §L18 上限从 460 收到 260，保证 1120 宽窗口下进度条仍有保底宽度 -->
                    <TextBlock x:Name="ShellProgressLabel" Text="{Binding ProgressDetailText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="{DynamicResource Size.ProgressTextMax}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" ToolTip="{Binding ProgressDetailText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressDetailText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- "正在转换"过程小动画（2026-10-02 用户要求：运行阶段要有明显的动态提示）：
                         三个琥珀圆点依次呼吸，仅 IsProcessing 时运行。
                         重要：动画时钟必须只在处理中启动、结束后彻底移除——常驻的 Forever 故事板会让
                         Dispatcher 永远到不了 ApplicationIdle/Background 优先级，UI 冒烟的
                         Dispatcher.InvokeAsync(…, ApplicationIdle) 等待会被饿死（2026-10-02 实测挂起 20 分钟）。 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="正在转换">
                        <Ellipse x:Name="ActivityDot1" Width="4" Height="4" Margin="0,0,3,0" Opacity="0.2" Fill="{DynamicResource Brush.Amber}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Dot1Board">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="Dot1Board" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse x:Name="ActivityDot2" Width="4" Height="4" Margin="0,0,3,0" Opacity="0.2" Fill="{DynamicResource Brush.Amber}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Dot2Board">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="Dot2Board" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse x:Name="ActivityDot3" Width="4" Height="4" Opacity="0.2" Fill="{DynamicResource Brush.Amber}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Dot3Board">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="Dot3Board" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </StackPanel>
                <ProgressBar Grid.Column="1" Margin="20,0" MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center" Value="{Binding ProgressValue}" Maximum="100" Foreground="{DynamicResource Brush.Amber}" Background="{DynamicResource Brush.BackgroundAlt}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="2" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" Text="{Binding EtaText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" Margin="{DynamicResource Spacing.InlineLoose}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ShellVersionLabel" Text="{Binding AppReleaseVersionText}" ToolTip="{Binding AppVersionText}" TextTrimming="CharacterEllipsis" MaxWidth="120" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- ═══════════ 左侧导航 ═══════════ -->
        <!-- Sidebar height is independent of notifications in the right content column. -->
        <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource Brush.Ink}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 品牌（墨底反白：琥珀 logo＋衬线刊名＋等宽副标） -->
                <StackPanel x:Name="SidebarBrand" Grid.Row="0" Orientation="Horizontal" Margin="16,18,16,16">
                    <Border Width="32" Height="32" CornerRadius="{DynamicResource CornerRadius.Medium}" Margin="{DynamicResource Spacing.InlineWide}" Background="{DynamicResource Brush.Amber}">
                        <TextBlock Text="D" FontFamily="{DynamicResource FontFamily.Display}" Foreground="{DynamicResource Brush.Ink}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="BrandLabel" VerticalAlignment="Center">
                        <TextBlock Text="QLCAD" FontFamily="{DynamicResource FontFamily.Display}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnInk}" />
                        <TextBlock Text="DWG TRANSLATION" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="9.5" Margin="{DynamicResource Spacing.BlockTopTight}" Foreground="{DynamicResource Brush.OnInkMuted}" />
                    </StackPanel>
                </StackPanel>
                <!-- 页面导航 -->
                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0" SelectedValuePath="Tag" SelectedValue="{Binding CurrentPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="translate" AutomationProperties.Name="图纸翻译">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIndexStyle}" Text="01" Margin="0,0,8,0" />
                            <Path Data="{StaticResource Icon.NavTranslate}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="{DynamicResource Size.Stroke}" />
                            <TextBlock Text="图纸翻译" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="batch" AutomationProperties.Name="任务中心">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIndexStyle}" Text="02" Margin="0,0,8,0" />
                            <Path Data="{StaticResource Icon.NavBatch}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="{DynamicResource Size.Stroke}" />
                            <TextBlock Text="任务中心" VerticalAlignment="Center" />
                            <!-- 未完成任务的红点：启动不再弹窗打断，用这个标记提示还有没跑完的图纸；
                                 详细清单与「继续处理 / 清除」在任务中心页内。 -->
                            <Ellipse x:Name="PendingTasksDot" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Danger}"
                                     Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolToVis}}"
                                     ToolTip="{Binding PendingTasksNotice}"
                                     AutomationProperties.Name="有未完成的任务" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="glossary" AutomationProperties.Name="术语库">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIndexStyle}" Text="03" Margin="0,0,8,0" />
                            <Path Data="{StaticResource Icon.NavGlossary}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="{DynamicResource Size.Stroke}" />
                            <TextBlock Text="术语库" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="account" AutomationProperties.Name="会员中心">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIndexStyle}" Text="04" Margin="0,0,8,0" />
                            <Path Data="{StaticResource Icon.NavAccount}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="{DynamicResource Size.Stroke}" />
                            <TextBlock Text="会员中心" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIndexStyle}" Text="05" Margin="0,0,8,0" />
                            <Path Data="{StaticResource Icon.NavSettings}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="{DynamicResource Spacing.InlineWide}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="{DynamicResource Size.Stroke}" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <Border x:Name="AccountEntryBorder" Grid.Row="2" BorderBrush="{DynamicResource Brush.InkBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,12">
                    <Button x:Name="AccountMenuButton" ToolTip="{Binding AccountEntryText}" Style="{StaticResource Button.Tertiary}" Height="60" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,0" Click="GlobalAccount_Click">
                        <Button.Content>
                            <Grid x:Name="AccountEntryContent" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Brush.InkAlt}" Width="28" Height="28" CornerRadius="2"><TextBlock Text="{Binding AccountAvatarText}" Foreground="{DynamicResource Brush.OnInk}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <!-- 用户名不再常驻显示（用户要求：头像首字母旁边有套餐徽标就够了）。
                                     全名仍可通过 Tooltip 看到——徽标自己补了一个，因为它正好盖住
                                     Button 的 Tooltip 区域；未登录时徽标隐藏，Button 的 Tooltip 照常生效。 -->
                                <StackPanel x:Name="AccountEntryLabels" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="2" Padding="6,0" Height="20" HorizontalAlignment="Left" ToolTip="{Binding AccountEntryText}" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding OnlinePlanText}" FontFamily="{DynamicResource FontFamily.Mono}" Foreground="{Binding MembershipTierColor}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110"/></Border>
                                </StackPanel>
                                <Path x:Name="AccountChevron" Grid.Column="2" Data="M 1,1 L 6,6 L 1,11" Stroke="{DynamicResource Brush.OnInkMuted}" StrokeThickness="1.5" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="会员中心" Command="{Binding LoginAccountCommand}" />
                                <MenuItem Header="退出登录" Command="{Binding LogoutAccountCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <!-- ═══════════ 内容列（纸面 + 纸纹噪点 + 右上角暖光斑） ═══════════ -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}">
            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Brush.PaperNoise}" />
            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Brush.WarmGlow}" />
            <!-- 顶部 Header（52px）：会员状态 · 用户入口 · 窗口控制（§9） -->
            <!-- Only the active page is attached to the visual tree. Each page owns exactly one
                 primary scrolling surface, which keeps mouse-wheel routing and virtualization stable. -->
            <ContentControl x:Name="PageHost" SizeChanged="PageViewport_SizeChanged"
                            MaxWidth="1600" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <!-- 通知浮层：挂在 shell 行上而不是页面列里，所以它出现/消失都不会改变 PageHost 的高度
             （此前 ToastHost 是页面列的第 2 行，每来一条提示就把页面整体挤矮一截）。
             底部对齐 + Spacing.Stack 让它停在状态栏正上方：既不遮住状态栏文本，也不挤压页面。
             声明位置保持在 ModalScrim 之前、内容列之后，绘制层级与改造前一致。 -->
        <controls:ToastHost x:Name="Toasts" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="{DynamicResource Spacing.Stack}" MaximumVisible="1" />
        <Border x:Name="ModalScrim" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#660F172A" Panel.ZIndex="99" Visibility="Collapsed" />


        <!-- 拖入提示覆盖层（IsHitTestVisible=False 保证拖放事件回到窗口本身） -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Color.DropScrim}" Opacity="0.55" />
            </Border.Background>
            <Border Width="540" Padding="30,26" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2">
                <StackPanel>
                    <Path x:Name="DropOverlayIcon" Data="{StaticResource Icon.EmptySheet}" Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" Margin="{DynamicResource Spacing.StackWide}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock Text="{conv:Localize DropHintTitle}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Margin="{DynamicResource Spacing.Stack}" />
                    <TextBlock Text="{conv:Localize DropHintDesc}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                    <TextBlock x:Name="DropOverlayFiles" FontSize="{DynamicResource FontSize.Secondary}" Margin="{DynamicResource Spacing.BlockTopWide}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>