<UserControl x:Class="DwgTranslator.App.Views.Pages.TranslatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls">
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题即工作区身份；"下一步该做什么"和步骤顺序都收在工作区上方的操作条里，
             页头不再叠一行会随状态变化的说明（那是原先"两条互相竞争的横幅"之一）。 -->
        <controls:PageHeader x:Name="WorkspaceHeader"
                             Header="图纸翻译"
                             Description="添加图纸、翻译、校对并导出；每个阶段都有独立状态。">
            <Button Content="添加图纸" Command="{Binding ImportDwgCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDrawingFiles}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </controls:PageHeader>

        <!-- 一条统计带：7 项指标等宽一行，标签在上、数值在下，分隔线用 1px 竖线而不是两张面板。
             内容行本身只有约 47 DIP（14px 标签 + 4 DIP 间距 + 18px 数值），加 Padding 12 后约 59，
             够不到 RefinementSmoke.cs:64 要求的下界 64。MinHeight 是这条下界的唯一保障，
             不是装饰属性——删掉它会立刻让 UI 冒烟变红。 -->
        <Border Grid.Row="1" x:Name="TranslationSummaryBar"
                Style="{StaticResource Section.Surface}" Margin="{DynamicResource Spacing.Vertical}"
                MinHeight="64" Padding="0,10,0,2">
            <UniformGrid x:Name="TranslationSummaryMetrics" Rows="1" Columns="7">
                <!-- 每格内容居中：用户标了「都没居中」。七格由 UniformGrid 等分，
                     格内的外边距/内边距只会把文字推离格心；分隔线仍画在格边界上，
                     所以 Border 保留、只把它的 Padding 归零。 -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="图纸" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WorkspaceFileCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1,0,0,0" Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="运行状态" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WorkspaceRunStateText}" Style="{StaticResource InfoValueStrong}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceRunStateText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1,0,0,0" Padding="0">
                    <StackPanel>
                        <TextBlock Text="整体进度" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Height="4" VerticalAlignment="Center" Maximum="100"
                                         Value="{Binding WorkspaceOverallProgress, Mode=OneWay}"
                                         Foreground="{DynamicResource Brush.Amber}"
                                         Background="{DynamicResource Brush.BackgroundAlt}" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkspaceProgressText}"
                                       FontFamily="{DynamicResource FontFamily.Mono}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1,0,0,0" Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="翻译成功" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WorkspaceSuccessfulCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1,0,0,0" Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="失败" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WorkspaceFailedCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1,0,0,0" Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="待校对" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WorkspaceReviewCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1,0,0,0" Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="待导出" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WorkspacePendingExportCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- 操作条从页面底部上移到工作区上方：按钮与它们作用的队列同屏，长页面底部不再留一条空带。
             行序固定为 页头 / 统计带 / 操作条 / 工作区，统计带与操作条都在队列之前，
             TranslationActionBar 这个 x:Name 被 UI 冒烟用于测量（ActualHeight ≥ 40）。 -->
        <Border x:Name="TranslationActionBar" Grid.Row="2" Style="{StaticResource Section.Surface}"
                Margin="{DynamicResource Spacing.Vertical}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ExportSelectionButton" Content="导出已校对图纸"
                            Command="{Binding ExportDwgCommand}" IsEnabled="{Binding CanExportWorkspace}"
                            Style="{StaticResource Button.Secondary}" MinWidth="136" Margin="{DynamicResource Spacing.Inline}" />
                    <Button x:Name="RetryFailedButton" Content="仅重试失败项"
                            Command="{Binding RetryFailedCommand}" IsEnabled="{Binding CanRetryFailedDrawingTasks}"
                            Style="{StaticResource Button.Secondary}" MinWidth="120" Margin="{DynamicResource Spacing.Inline}" />
                    <Button Content="取消导出" Command="{Binding CancelExportCommand}" Style="{StaticResource Button.Danger}"
                            MinWidth="104"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- 常驻文案（2026-10-02 重排）：原「等宽步骤提示 + 下一步 + 输出摘要」三段混排
                     被用户反馈"太乱、样式不对、没有上下居中"——步骤提示与页头说明重复且字体不一，整段删除。
                     现在只保留两块：琥珀"下一步"胶囊（Auto 列，宽度上限 280）+ 「张数 · 输出」弱字
                     （星号列，空间不足时先省略号让位，任何受支持宽度都不会挤进右侧按钮区）。
                     Border Padding 同步改为上下对称的 12,8，全部内容在条内垂直居中。
                     WorkspaceNextStepTextBlock 被 UI 冒烟用几何断言测量（ActualWidth ≥ 80），
                     重排时保留它，不要改成随状态折叠的元素。 -->
                <Grid Grid.Column="1" Margin="12,0" VerticalAlignment="Center" AutomationProperties.Name="导出摘要">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border VerticalAlignment="Center" MaxWidth="280" Padding="9,3" Margin="0,0,10,0"
                            Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber}"
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Small}">
                        <TextBlock x:Name="WorkspaceNextStepTextBlock" Text="{Binding WorkspaceNextStepText}"
                                   Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize.Secondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceNextStepText}" />
                    </Border>
                    <!-- M14 弱字摘要「光学偏高 ~3px」根因：CaptionStyle(Metrics.xaml:116) 给 13px 文本挂了
                         LineHeight=22，默认 LineStackingStrategy=MaxHeight 把多出的 4.7 DIP 行距全部加在基线
                         **下方**，于是字形中心比行框中心高约 2.4 DIP（150% 缩放下≈3.5px）；本元素又是
                         VerticalAlignment=Center 紧贴琥珀胶囊排的，这点偏差直接可见。
                         修法：只在本元素覆盖 LineHeight=17（LicenseDialog.xaml:66 已有同值同法先例），
                         max(17, 自然行高 17.3) = 17.3 → 行框收回自然高度，字形回到正中。
                         刻意不动 CaptionStyle 本体：CardHeader(Metrics.xaml:136) / FormRowDescription(:187) /
                         PageSubtitleStyle / BodyStyle(:111) 全都 BasedOn 它，改本体等于全局回归。
                         顺带补 TextWrapping=NoWrap：CaptionStyle 的 Wrap 会让本行已经声明的
                         TextTrimming=CharacterEllipsis 永不生效（Wrap 先折行、只裁最后一行），
                         与紧邻胶囊「单行 + 省略号 + ToolTip」的既定语义相矛盾。 -->
                    <TextBlock x:Name="OutputDirectoryTextBlock" Grid.Column="1" Text="{Binding WorkspaceActionHintText}"
                               Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               LineHeight="17" TextWrapping="NoWrap"
                               ToolTip="{Binding WorkspaceOutputLocationText}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="开始翻译" Command="{Binding TranslateCommand}"
                            IsEnabled="{Binding CanStartWorkspaceTranslation}" Style="{StaticResource Button.Primary}"
                            MinWidth="112"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}, ConverterParameter=false}" />
                    <Button Content="正在翻译…" IsEnabled="False" Style="{StaticResource Button.Primary}" MinWidth="112"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}" />
                    <Button Content="取消任务" Command="{Binding CancelTranslateCommand}" Style="{StaticResource Button.Danger}"
                            MinWidth="104" Margin="{DynamicResource Spacing.LeftGap}"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="TranslationWorkspace" Grid.Row="3" MinHeight="300">
            <!-- 两列的最小宽度和必须 <= 最小窗口下的内容宽：1120 - 200(侧栏) - 40(页边距) = 880。
                 520 + 360 = 880 刚好卡住；这里不能再插入任何占宽的列，否则最小窗口会横向溢出。
                 分区感靠右栏补上与左栏相同的外边距（见下方 ScrollViewer 的 Margin）来实现。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="400" MinWidth="360" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Section.Surface}" Padding="0" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Stretch">
                <Grid x:Name="TranslationScroll">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="QueueAreaRow" Height="*" />
                    </Grid.RowDefinitions>

                    <!-- MaxHeight 是产品意图：空队列的拖放入口不该在宽屏上无限拉伸成一块空白。
                         断言语义不变（Program.cs:281 "empty drop zone capped at 360 DIP"）。
                         重构后这个 * 行更高了（页头 102 + 统计条 64 + 操作条 60 之后仍有约 382），
                         没有上限时它会把整行吃掉。 -->
                    <!-- §W1-D2 用户批注：「没必要有这个小框吧，外面的大框就够了」。
                         原先这层 Border 自带 Background=Brush.Surface + 1px Brush.Border，
                         于是空态在外层 Section.Surface 卡片里又画了一个同色同边的小方框（双层框）。
                         这里只去掉它的可视框（背景转透明、边框归零），**元素本身保留**：
                         x:Name/Visibility/MinHeight/MaxHeight 与 4 行 Grid 结构一字未动，
                         因此 Program.cs:294-297 的居中、:301 可见、:314 ActualHeight<=360、:329 收起
                         四条断言语义全部不变。MinHeight=180/MaxHeight=360 的产品意图（空队列拖放入口
                         不在宽屏上无限拉伸）继续由本元素承担。 -->
                    <Border x:Name="EmptyDropZone" MinHeight="180" MaxHeight="360"
                            Background="Transparent" BorderThickness="0"
                            Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                        <Grid x:Name="DropZoneCenter" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 手作空状态：虚线圆环托住图纸图标，右上角一枚琥珀火花 -->
                            <Grid HorizontalAlignment="Center" Margin="{DynamicResource Spacing.StackWide}">
                                <Ellipse Style="{StaticResource Deco.DashedRing}" Width="64" Height="64" />
                                <Path Data="{StaticResource Icon.Log}" Width="26" Height="26" Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Data="{StaticResource Icon.Deco.SparkSmall}" Width="9" Height="9" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Amber}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="将 DWG / DXF 文件拖到此处"
                                       FontFamily="{DynamicResource FontFamily.Display}"
                                       FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="支持一次添加多个文件；添加后可直接批量翻译"
                                       Style="{StaticResource CaptionStyle}" TextAlignment="Center" Margin="0,7,0,14" />
                            <Button x:Name="EmptySelectFileButton" Grid.Row="3" Content="选择文件"
                                    HorizontalAlignment="Center" MinWidth="120" Command="{Binding ImportDwgCommand}"
                                    Style="{StaticResource Button.Secondary}" AutomationProperties.Name="选择文件" />
                        </Grid>
                    </Border>

                    <Grid x:Name="QueueWorkspace"
                          Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="{DynamicResource Spacing.TableHeaderInset}">
                            <Button DockPanel.Dock="Right" Content="队列操作" Click="QueueMenu_Click"
                                    Style="{StaticResource Button.Tertiary}" ToolTip="选择与清空队列">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="全部选为导出" Command="{Binding SelectAllDrawingOutputsCommand}" />
                                        <MenuItem Header="取消全部导出选择" Command="{Binding ClearDrawingOutputsCommand}" />
                                        <Separator />
                                        <MenuItem Header="清空队列…" Command="{Binding ClearAllCommand}"
                                                  Foreground="{DynamicResource Brush.Danger}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WorkspaceFileCount, StringFormat=共 {0} 张}"
                                       Style="{StaticResource CaptionStyle}" FontFamily="{DynamicResource FontFamily.Mono}" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineWide}" />
                            <TextBlock Text="文件队列" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <DataGrid Grid.Row="1" x:Name="DrawingQueue" ItemsSource="{Binding DrawingFiles}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                  HeadersVisibility="Column" RowHeight="{DynamicResource Size.TableRow}" FontSize="13"
                                  GridLinesVisibility="Horizontal" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  CanUserResizeColumns="False" CanUserSortColumns="True"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="导出"
                                                        Binding="{Binding IsIncludedForExport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="48" />
                                <DataGridTemplateColumn Header="文件名" Width="*" MinWidth="150" IsReadOnly="True" SortMemberPath="FileName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="104" IsReadOnly="True" SortMemberPath="WorkflowStatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding SummaryText}">
                                                <Ellipse Width="7" Height="7" Margin="{DynamicResource Spacing.InlineTight}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="解析中"><Setter Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="提取文本"><Setter Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="翻译中"><Setter Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="排版优化"><Setter Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="写回中"><Setter Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="待校对"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="待导出"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding WorkflowStatusText}" Value="已导出"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding WorkflowStatusText}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- §L8 5 位数（"12,345"）加 Padding 需要 80 DIP，原 68 会溢出 -->
                                <DataGridTextColumn Header="文本" Binding="{Binding TextCountText}" Width="80"
                                                    IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}" />
                                <DataGridTemplateColumn Header="进度" Width="118" IsReadOnly="True" SortMemberPath="ProgressPercent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="4" VerticalAlignment="Center" Maximum="100"
                                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                                             Foreground="{DynamicResource Brush.Amber}"
                                                             Background="{DynamicResource Brush.BackgroundAlt}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12"
                                                           FontFamily="{DynamicResource FontFamily.Mono}"
                                                           Margin="{DynamicResource Spacing.LeftGap}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="148" MinWidth="144" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- §L7 按钮不再锁死 Width，交给内容撑开；列宽已按"两个按钮 + 单元格内边距"重算 -->
                                                <Button Content="校对" Style="{StaticResource Button.Compact.Secondary}" MinWidth="44"
                                                        Command="{Binding DataContext.OpenDrawingFileItemsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="查看该图纸的文本条目" />
                                                <Button Content="打开" Style="{StaticResource Button.Compact.Secondary}" MinWidth="44" Margin="{DynamicResource Spacing.LeftGap}"
                                                        Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.OpenDrawingOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- E8 右缘对齐（用户批注「卡片右边没对齐」，红圈圈在操作条的「开始翻译」上）。
                 本元素原先挂 Margin=Spacing.InlineWide(0,0,12,0) 再加 Padding 右 2，旧注释说这是为了
                 「给右栏补上同样的外边距让间隔翻倍」——那是误用：栏间距由左栏卡片自己的**右**外边距(12)
                 产生，给右栏再加一个**右**外边距对间距毫无影响，只把整列从页面右缘往里推了 14 DIP。
                 于是上方操作条 TranslationActionBar 的 Margin=Spacing.Vertical 没有右外边距、右缘落在
                 页面内容右缘，而下方右栏卡片内缩 14 DIP，两者对不齐。
                 像素取证（用户截图 1882x1112 @150%，1 DIP=1.5px；该比例由「开始翻译」按钮实测 168px
                 = MinWidth 112 DIP 反推确认）：操作条外右缘 x=1843、开始翻译按钮右缘 x=1824、
                 翻译设置卡外右缘 x=1823 —— 差 20px≈14 DIP，与代码算得的 12+2 完全吻合。
                 修法：右栏不再带任何右向外边距/内边距，外右缘与操作条齐平。栏间距仍是 12（左栏右外边距），
                 与本次修改前的**实际渲染值**一致，所以「左右分区不明显」那条历史修复并未回退。
                 Padding 右 2 原意是给纵向滚动条留位，但本项目 ScrollBar 宽仅 10 DIP
                 (MainWindowStyles.xaml:668)，且本栏在 1280x720 以上都不出滚动条，留 2 反而让右缘永久差
                 2 DIP —— 归零才是精确对齐。 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          controls:ResponsiveLayout.HandoffMouseWheelAtBoundary="True">
                <!-- E10 右栏底部大片留白（用户批注：右栏底部比左侧「文件队列」卡高 150-200px，头重脚轻）
                     根因：下面三行原本全是 Auto，Grid 在 ScrollViewer 里按内容高测量后顶端对齐，而左栏卡片
                     (:172) 是 VerticalAlignment=Stretch 铺满整行 —— 于是右栏底边悬在半空。
                     两步修：① 本 Grid 的 MinHeight 绑到外层 ScrollViewer 的 ViewportHeight，至少铺满视口
                     （该绑定不会自激振荡：ViewportHeight 不受纵向滚动条影响；内容高于视口时 MinHeight 小于
                     自然高，Grid 取自然高并出现滚动条，视口高不变 → 收敛）；
                     ② 第 3 行（运行日志）由 Auto 改 *，把剩余高度全部交给它 —— 正是用户批注给出的方向
                     「如运行日志区吸收剩余高度」。左栏高度不变，两栏底边从此齐平。
                     UI 冒烟 Program.cs:298-300 断言 TranslationSettingsSection 与 OutputSection 必须同为
                     TranslationSettingsColumn 的直接子元素、且分别落在 Row 0 / Row 1 —— 该结构不能动。 -->
                <Grid x:Name="TranslationSettingsColumn"
                      MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- E9 下内边距由 0 补到 16，完整根因见下方 OutputSection 的注释。 -->
                    <Border x:Name="TranslationSettingsSection" Grid.Row="0"
                            Style="{StaticResource Section.Surface}" Padding="16,14,16,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="{DynamicResource Spacing.StackWide}">
                                <TextBlock Text="TRANSLATION · SETTINGS" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                                <TextBlock Text="翻译设置" FontFamily="{DynamicResource FontFamily.Display}" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="104" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" MinWidth="104" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="源语言" Style="{StaticResource InfoLabel}" />
                                    <ComboBox Height="34" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName"
                                              SelectedValuePath="Code" SelectedValue="{Binding CurrentSourceLang, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="⇄" ToolTip="交换语言" Command="{Binding SwapLanguagesCommand}"
                                        Style="{StaticResource Button.Tertiary}" Width="38" Height="34"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="目标语言" Style="{StaticResource InfoLabel}" />
                                    <ComboBox Height="34" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName"
                                              SelectedValuePath="Code" SelectedValue="{Binding CurrentTargetLang, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="{DynamicResource Spacing.BlockTopWide}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="术语库" FontFamily="{DynamicResource FontFamily.Display}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding GlossaryStatsText}" Style="{StaticResource CaptionStyle}" FontFamily="{DynamicResource FontFamily.Mono}" Margin="{DynamicResource Spacing.BlockTopTight}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="管理术语库" Command="{Binding NavigateToCommand}"
                                        CommandParameter="glossary" Style="{StaticResource Button.Secondary}"
                                        MinWidth="96" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- E9 输出卡片按钮「下半被截断、底部圆角失效」根因：Padding 原为 "16,14,16,0"，
                         **下内边距是 0**。Button.Secondary 的底色就是 Brush.Surface(#FFFCF5)，与卡片底色
                         完全同色，按钮全靠 1px 的 Brush.Border 描边才成形；下内边距为 0 时按钮下边框距卡片
                         下边框只剩 ~1px，两条浅棕线几乎重合，肉眼就读成「按钮被卡片底边切掉一截」。
                         （像素取证：卡片下边框 y≈932，按钮白体止于 y≈925，中间仅 ~4px。）
                         补回 16 的对称下内边距后按钮完整落在卡内，圆角与 Shadow.Hard 都有了落点。
                         同样的 0 下内边距也在翻译设置卡与运行日志卡上，一并补齐。 -->
                    <Border x:Name="OutputSection" Grid.Row="1" Style="{StaticResource Section.Surface}"
                            Margin="{DynamicResource Spacing.BlockTop}" Padding="16,14,16,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="{DynamicResource Spacing.Stack}">
                                <TextBlock Text="OUTPUT" Style="{StaticResource Kicker}" Margin="0,0,0,2" />
                                <TextBlock Text="输出" FontFamily="{DynamicResource FontFamily.Display}" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- 未导出过时给出明确规则，而不是留一格空白。路径文本一律由 WorkspaceOutputLocationText 绑定给出，
                                     不在 XAML 里写死。M13 更正陈旧注释：本处原先断言默认落在源图纸旁边的
                                     "<图纸名>_translated" 目录、AppData 下不再有任何默认输出 —— 那是 2026-10-02 之前的旧规则，与现行实现相反。
                                     现行规则见 MainViewModel.Config.cs:133-139 ResolveExportDirectory()：
                                     没有历史选择时默认落到 <安装目录>\exports（发布即生效、无需重装）；
                                     安装区不可写才退回源图纸旁的 DefaultOutputFolderName；
                                     用户显式选过的目录（AccountOutputDirectories）始终优先。
                                     设置页的同一句说明已在 SettingsPage.xaml:197 同步补齐。 -->
                                <TextBlock Text="{Binding WorkspaceOutputLocationText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding WorkspaceOutputLocationText}" VerticalAlignment="Center" />
                                <!-- E9 输出路径文字与按钮间距过近（用户批注 <8px）：BlockTop(8) 在 13px 等宽字下留白不足，
                                     提到 BlockTopWide(12) —— 与卡片内其它块级间距同档，仍走既有令牌。 -->
                                <Grid Grid.Row="1" Margin="{DynamicResource Spacing.BlockTopWide}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="打开输出目录" Command="{Binding OpenOutputFolderCommand}"
                                            Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.InlineTight}" />
                                    <Button Grid.Column="1" Content="输出设置" Command="{Binding NavigateToCommand}"
                                            CommandParameter="output-settings" Style="{StaticResource Button.Secondary}"
                                            Margin="{DynamicResource Spacing.LeftGap}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Section.Surface}" Margin="{DynamicResource Spacing.BlockTop}" Padding="16,14,16,16">
                        <Expander x:Name="WorkspaceLogLauncher" Header="运行日志"
                                  AutomationProperties.Name="打开运行日志">
                        <!-- E10 运行日志卡吃掉右栏剩余高度（上面第 3 行已由 Auto 改 *）。折叠时 Expander 模板里承载内容的
                             那一行是 * 行，卡片照样铺满、底边与左侧「文件队列」卡齐平，不再留大片页面底色；
                             展开时日志区跟着长高 —— 这正是 §L11 原本想要的「右侧栏高时日志能显示更多行」，
                             所以去掉把内容钉死在 320 的 MaxHeight，只保留 MinHeight 下限。
                             x:Name="WorkspaceLogLauncher" 被 UI 冒烟按 FindName 取用（Program.cs:303），
                             不要改名或删除。 -->
                        <Grid MinHeight="160" Background="{DynamicResource Brush.BackgroundAlt}" DataContext="{Binding LogViewModel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="复制" Command="{Binding CopyLogsCommand}" Style="{StaticResource Button.Tertiary}" />
                                <Button Content="清空" Command="{Binding ClearLogsCommand}" Style="{StaticResource Button.Tertiary}" />
                            </StackPanel>
                            <!-- §L11 与 LogViewerPanel 一致开启虚拟化，长日志滚动不掉帧 -->
                            <!-- §L12 横向 Disabled（同 LogViewerPanel）：Auto 会让行随最长日志
                                 无限变宽、在视口边缘硬裁切；Disabled+省略号+ToolTip 才是完整可读。 -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" BorderThickness="0"
                                     Background="Transparent" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CompactDisplayText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CompactDisplayText}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        </Expander>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
