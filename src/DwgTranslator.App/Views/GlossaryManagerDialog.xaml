<Window x:Class="DwgTranslator.App.Views.GlossaryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="术语库管理"
        Width="650" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="#F5F7FA"
        MaxHeight="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="#1976D2"/>
            <TextBlock Text="直接在表格中编辑术语条目，支持增删改" FontSize="11" Foreground="#78909C" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" x:Name="GlossaryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  Margin="0,0,0,8"
                  FontSize="12"
                  RowHeight="28"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECEFF1"
                  BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#37474F"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="源语言" Binding="{Binding Source}" Width="220"/>
                <DataGridTextColumn Header="目标语言" Binding="{Binding Target}" Width="220"/>
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="保存术语库" Padding="14,6" Margin="0,0,8,0"
                    Background="#1976D2" Foreground="White" FontWeight="SemiBold" FontSize="12"
                    Click="Save_Click" Cursor="Hand" BorderThickness="0"/>
            <Button Content="取消" Padding="14,6" FontSize="12"
                    Click="Cancel_Click" Cursor="Hand" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
