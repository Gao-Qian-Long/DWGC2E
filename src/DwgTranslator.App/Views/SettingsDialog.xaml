<Window x:Class="DwgTranslator.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DeepSeek API Settings -->
        <TextBlock Grid.Row="0" Text="DeepSeek API 设置" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="API Key:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="ApiKeyBox" Width="360" Padding="3" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="API 地址:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="BaseUrlBox" Width="360" Padding="3" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="模型:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="ModelBox" Width="270" Padding="3" VerticalContentAlignment="Center"/>
            <Button Content="测试连接" Width="75" Height="26" Margin="5,0,0,0" Click="TestConnection_Click"/>
        </StackPanel>

        <TextBlock x:Name="ResultText" Grid.Row="4" Text="" FontSize="11" Margin="90,0,0,5"/>

        <!-- Separator -->
        <Separator Grid.Row="5" Margin="0,5,0,10"/>

        <!-- AutoCAD Configuration -->
        <TextBlock Grid.Row="6" Text="AutoCAD 配置（精确回写模式需要）" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="安装路径:" VerticalAlignment="Center"/>
            <TextBox x:Name="AutoCadPathBox" Grid.Column="1" Padding="3" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="浏览" Width="50" Height="26" Margin="0,0,3,0" Click="BrowseAutoCad_Click"/>
                <Button Content="自动检测" Width="70" Height="26" Click="DetectAutoCad_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="插件路径:" VerticalAlignment="Center"/>
            <TextBox x:Name="CadPluginPathBox" Grid.Column="1" Padding="3" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
            <Button Grid.Column="2" Content="浏览" Width="50" Height="26" Click="BrowseCadPlugin_Click"/>
        </Grid>

        <TextBlock x:Name="AutoCadStatusText" Grid.Row="9" Text="" FontSize="11" Margin="90,0,0,5"
                   Foreground="Gray" TextWrapping="Wrap"/>

        <!-- Footer -->
        <TextBlock Grid.Row="9" Text="设置保存后立即生效，存储在 %APPDATA%\DwgTranslator\settings.json"
                   Foreground="Gray" FontSize="11" Margin="0,30,0,0" VerticalAlignment="Bottom"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="75" Height="28" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="取消" Width="75" Height="28" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
