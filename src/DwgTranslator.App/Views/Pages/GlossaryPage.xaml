<UserControl x:Class="DwgTranslator.App.Views.Pages.GlossaryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,18">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsGlossaryLoading}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="术语库" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,14" />
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBox Width="190" MinHeight="34" Padding="8" Text="{Binding TermSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索原文、译文、分类或文件夹" Margin="0,0,8,6" />
      <Button Content="新增术语" Command="{Binding AddTermCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,6" />
      <Button Content="导入" Command="{Binding ImportGlossaryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
      <Button Content="导出" Command="{Binding ExportTermsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
      <Button Content="上传云端" Command="{Binding UploadTermsCommand}" Style="{StaticResource Button.Tertiary}" Margin="0,0,8,6" />
      <Button Content="下载云端" Command="{Binding DownloadTermsCommand}" Style="{StaticResource Button.Tertiary}" Margin="0,0,8,6" />
      <CheckBox Content="只看冲突" IsChecked="{Binding TermConflictsOnly}" VerticalAlignment="Center" Margin="0,0,8,6" />
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="TermList" ItemsSource="{Binding TermView}" SelectedItem="{Binding SelectedTerm}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="Terms_SizeChanged">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Width="{Binding DataContext.TermWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Brush.Surface}" Padding="12,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                  <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource Brush.TextMuted}" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                  <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Width="285" Style="{StaticResource Card}" Margin="12,0,0,0" Visibility="{Binding IsEditingTerm, Converter={StaticResource BoolToVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="编辑术语" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="原文" Margin="0,14,0,5" />
            <TextBox Text="{Binding SelectedTerm.Source, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
            <TextBlock Text="译文" Margin="0,14,0,5" />
            <TextBox Text="{Binding SelectedTerm.Target, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
            <TextBlock Text="分类" Margin="0,14,0,5" />
            <TextBox Text="{Binding SelectedTerm.Category, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
            <TextBlock Text="文件夹（输入名称即可创建）" Margin="0,14,0,5" />
            <TextBox Text="{Binding SelectedTerm.Folder, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
            <CheckBox Content="启用此术语" IsChecked="{Binding SelectedTerm.Enabled}" Margin="0,14" />
            <Button Content="完成编辑" Command="{Binding FinishTermEditCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,0,8" />
            <Button Content="删除术语" Command="{Binding DeleteTermCommand}" Style="{StaticResource Button.Danger}" />
            <TextBlock Text="修改先保留为草稿，点击下方保存后生效。冲突译法可在此修改或停用。" TextWrapping="Wrap" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding TermCountText}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding TermFeedback}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="放弃更改" Command="{Binding DiscardTermsCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0" />
        <Button Content="保存到本机" Command="{Binding SaveTermsCommand}" Style="{StaticResource Button.Primary}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>