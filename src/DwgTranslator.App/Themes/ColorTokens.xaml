<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DWG Translator — Color Tokens (Light Theme)
         Inspired by VS Code / JetBrains aesthetics
         ============================================================ -->

    <!-- ── Primary ── -->
    <SolidColorBrush x:Key="Brush.Primary"        Color="#4F46E5" />
    <SolidColorBrush x:Key="Brush.PrimaryHover"   Color="#4338CA" />
    <SolidColorBrush x:Key="Brush.PrimaryLight"   Color="#EEF2FF" />

    <!-- ── Surface ── -->
    <SolidColorBrush x:Key="Brush.Surface"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"     Color="#F8FAFC" />

    <!-- ── Background ── -->
    <SolidColorBrush x:Key="Brush.Background"     Color="#F1F5F9" />
    <SolidColorBrush x:Key="Brush.BackgroundAlt"  Color="#E2E8F0" />

    <!-- ── Text ── -->
    <SolidColorBrush x:Key="Brush.TextPrimary"    Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.TextSecondary"  Color="#475569" />
    <SolidColorBrush x:Key="Brush.TextMuted"      Color="#94A3B8" />
    <SolidColorBrush x:Key="Brush.TextDisabled"   Color="#CBD5E1" />

    <!-- ── Border ── -->
    <SolidColorBrush x:Key="Brush.Border"         Color="#E2E8F0" />
    <SolidColorBrush x:Key="Brush.BorderLight"    Color="#F1F5F9" />

    <!-- ── Status: Success ── -->
    <SolidColorBrush x:Key="Brush.Success"        Color="#059669" />
    <SolidColorBrush x:Key="Brush.SuccessLight"   Color="#ECFDF5" />

    <!-- ── Status: Warning ── -->
    <Color x:Key="Color.Warning">#D97706</Color>
    <SolidColorBrush x:Key="Brush.Warning"        Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningLight"   Color="#FFFBEB" />

    <!-- ── Status: Danger ── -->
    <SolidColorBrush x:Key="Brush.Danger"         Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerLight"    Color="#FEF2F2" />

    <!-- ── Status: Info ── -->
    <SolidColorBrush x:Key="Brush.Info"           Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.InfoLight"      Color="#EFF6FF" />

    <!-- ── Semantic: Title Bar ── -->
    <LinearGradientBrush x:Key="Brush.TitleBarBackground"
                         StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0" />
        <GradientStop Color="#6366F1" Offset="1" />
    </LinearGradientBrush>

    <!-- ── Semantic: DataGrid Header ── -->
    <SolidColorBrush x:Key="Brush.DataGridHeader" Color="#334155" />

    <!-- ── Semantic: Status Bar ── -->
    <SolidColorBrush x:Key="Brush.StatusBar"      Color="#F8FAFC" />

    <!-- ── Semantic: Tool Bar ── -->
    <SolidColorBrush x:Key="Brush.ToolBar"        Color="#FFFFFF" />

    <!-- ── Semantic: Card ── -->
    <SolidColorBrush x:Key="Brush.Card"           Color="#FFFFFF" />

    <!-- ── CornerRadius Constants ── -->
    <CornerRadius x:Key="CornerRadius.Small"  TopLeft="4" TopRight="4" BottomLeft="4" BottomRight="4" />
    <CornerRadius x:Key="CornerRadius.Medium" TopLeft="6" TopRight="6" BottomLeft="6" BottomRight="6" />
    <CornerRadius x:Key="CornerRadius.Large"  TopLeft="8" TopRight="8" BottomLeft="8" BottomRight="8" />

</ResourceDictionary>
