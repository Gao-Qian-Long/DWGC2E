<UserControl x:Class="DwgTranslator.App.Views.Controls.FilterStatsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters">

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Inline stats -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0">
                    <Run Text="{conv:Localize StatsTotal}" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextPrimary}"
                         FontFamily="Consolas" FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock Text="&#x2002;" Margin="2,0"/>

                <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0">
                    <Run Text="&#x2713;" Foreground="{DynamicResource Brush.Success}"/>
                    <Run Text="{Binding TranslatedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Success}"
                         FontFamily="Consolas" FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock Text="&#x2002;" Margin="2,0"/>

                <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0">
                    <Run Text="&#x26A0;" Foreground="{DynamicResource Brush.Danger}"/>
                    <Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Danger}"
                         FontFamily="Consolas" FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock Text="&#x2002;" Margin="2,0"/>

                <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0">
                    <Run Text="&#x1F4D6;" Foreground="{DynamicResource Brush.Info}"/>
                    <Run Text="{Binding GlossaryHitCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Info}"
                         FontFamily="Consolas" FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock Text="&#xB7;" Margin="4,0" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>

                <TextBlock VerticalAlignment="Center" FontSize="13">
                    <Run Text="{conv:Localize StatsCache}" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Run Text="{Binding CacheHitCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"
                         FontFamily="Consolas" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="1" Width="1" Height="20"
                    Background="{DynamicResource Brush.Border}"
                    Margin="10,0" VerticalAlignment="Center"/>

            <!-- Right: Search + Filter -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.Background}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,6,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Height="30"
                             ToolTip="{conv:Localize TipSearch}" FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="8,0" Background="Transparent" BorderThickness="0"
                             KeyDown="SearchBox_KeyDown"/>
                </Border>
                <ComboBox ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding FilterStatusText, UpdateSourceTrigger=PropertyChanged}"
                          Width="90" Height="30" FontSize="13"
                          Background="{DynamicResource Brush.Background}"
                          BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>