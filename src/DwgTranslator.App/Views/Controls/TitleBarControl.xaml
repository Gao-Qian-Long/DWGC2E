<UserControl x:Class="DwgTranslator.App.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1565C0" Offset="0"/>
                <GradientStop Color="#1976D2" Offset="0.5"/>
                <GradientStop Color="#1E88E5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="DWG" Foreground="White" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" Opacity="0.9"/>
                <TextBlock Text=" Translator" Foreground="White" FontSize="13"
                           VerticalAlignment="Center" Opacity="0.9"/>
                <TextBlock Foreground="#BBDEFB" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,0,0">
                    <Run Text=" — "/><Run Text="{conv:Localize AppTitleShort}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ToggleTopmostCommand}"
                        ToolTip="{conv:Localize TipTopmostToggle}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="46" Height="36"
                        Foreground="White" BorderThickness="0" FontSize="14"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Background="Transparent">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Content" Value="&#x1F4CC;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                    <Setter Property="Background" Value="#FF9800"/>
                                    <Setter Property="Content" Value="&#x1F4CD;"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="MinimizeButton" Content="&#x2013;"
                        Click="MinimizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="46" Height="36" Background="Transparent"
                        Foreground="White" BorderThickness="0" FontSize="16"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="MaximizeButton" Content="&#x25A1;"
                        Click="MaximizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="46" Height="36" Background="Transparent"
                        Foreground="White" BorderThickness="0" FontSize="14"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#x2715;"
                        Click="CloseButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="46" Height="36" Background="Transparent"
                        Foreground="White" BorderThickness="0" FontSize="14"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E81123"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
