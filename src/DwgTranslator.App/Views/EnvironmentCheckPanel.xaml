<UserControl x:Class="DwgTranslator.App.Views.EnvironmentCheckPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        FontFamily="{DynamicResource FontFamily.Body}"
        FontSize="{DynamicResource FontSize.Body}">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="132"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxWidth" Value="360"/>
        </Style>
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="环境状态" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackSection}"/>

        <!-- Two columns: the left one reports the application itself, the right one reports the CAD
             side. Every row keeps the same lamp + label + value triple it had in the stacked
             layout; only the container changed, so six rows now occupy three row-heights. -->
        <Grid x:Name="EnvironmentStatusGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="AppStatusRow" Grid.Row="0" Grid.Column="0" Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Ellipse x:Name="AppLamp" Style="{StaticResource Lamp}"/><TextBlock Text="QLCAD" Style="{StaticResource RowLabel}"/><TextBlock x:Name="AppVersionText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
            <DockPanel x:Name="RuntimeStatusRow" Grid.Row="1" Grid.Column="0" Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Ellipse x:Name="RuntimeLamp" Style="{StaticResource Lamp}"/><TextBlock Text="运行环境" Style="{StaticResource RowLabel}"/><TextBlock x:Name="RuntimeText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
            <DockPanel x:Name="DataPathStatusRow" Grid.Row="2" Grid.Column="0" Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Button DockPanel.Dock="Right" Content="打开" Click="OpenDataDir_Click" Style="{StaticResource Button.Tertiary}" Margin="{DynamicResource Spacing.LeftGap}"/><Ellipse x:Name="PathsLamp" Style="{StaticResource Lamp}"/><TextBlock Text="数据目录" Style="{StaticResource RowLabel}"/><TextBlock x:Name="DataPathText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>

            <DockPanel x:Name="CadProductStatusRow" Grid.Row="0" Grid.Column="2" Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Button DockPanel.Dock="Right" Content="重新检测" Click="Detect_Click" Style="{StaticResource Button.Tertiary}" Margin="{DynamicResource Spacing.LeftGap}"/><Ellipse x:Name="CadLamp" Style="{StaticResource Lamp}"/><TextBlock Text="CAD" Style="{StaticResource RowLabel}"/><TextBlock x:Name="CadProductText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
            <DockPanel x:Name="PluginStatusRow" Grid.Row="1" Grid.Column="2" Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Ellipse x:Name="PluginLamp" Style="{StaticResource Lamp}"/><TextBlock Text="CAD 插件" Style="{StaticResource RowLabel}"/><TextBlock x:Name="PluginStatusText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
            <DockPanel x:Name="AutoLoadStatusRow" Grid.Row="2" Grid.Column="2" Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Ellipse x:Name="AutoLoadLamp" Style="{StaticResource Lamp}"/><TextBlock Text="自动加载" Style="{StaticResource RowLabel}"/><TextBlock x:Name="AutoLoadText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
        </Grid>

        <WrapPanel Margin="{DynamicResource Spacing.StackWide}"><Button x:Name="InstallButton" Content="安装 / 修复插件" Click="Install_Click" Style="{StaticResource Button.Secondary}"/><Button x:Name="UninstallButton" Content="卸载插件" Click="Uninstall_Click" Style="{StaticResource Button.Tertiary}" Margin="{DynamicResource Spacing.LeftGap}"/></WrapPanel>
        <Expander Header="检测与安装记录"><TextBox x:Name="LogText" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}"/></Expander>
        <!-- 用户批注「布局太丑了」（2026-09-21 截图）：标签与值文本逐字重复（「云端翻译服务」出现两次），按钮又独立悬在下一行——标签改为「服务」，按钮右停靠进状态行，与环境状态六行同一骨架。 -->
        <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,1,0,0" Margin="{DynamicResource Spacing.BlockTopSection}" Padding="0,20,0,0"><StackPanel><TextBlock Text="翻译服务" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackLoose}"/><DockPanel Margin="{DynamicResource Spacing.StackWide}" LastChildFill="True"><Button DockPanel.Dock="Right" Content="重新检测服务" Command="{Binding CheckServiceCommand}" Style="{StaticResource Button.Tertiary}" Margin="{DynamicResource Spacing.LeftGap}"/><Ellipse x:Name="ApiLamp" Style="{StaticResource Lamp}"/><TextBlock Text="服务" Style="{StaticResource RowLabel}"/><TextBlock x:Name="ApiEndpointText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><TextBlock Text="{Binding AccountFeedback}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
    </StackPanel>
</UserControl>
