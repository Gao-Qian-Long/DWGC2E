<UserControl x:Class="DwgTranslator.App.Views.Pages.GlossaryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18,14,18,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <TextBlock Text="术语库" Style="{StaticResource PageTitleStyle}"/>
   <TextBlock Text="统一专业词汇，让译文保持一致。" Style="{StaticResource PageSubtitleStyle}"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="导入术语" Command="{Binding ImportGlossaryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
    <Button Content="管理术语" Command="{Binding OpenGlossaryManagerCommand}" Style="{StaticResource Button.Primary}"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding GlossaryEntryCount, StringFormat='全部术语  {0}'}" FontWeight="SemiBold" Margin="0,0,24,0"/>
    <TextBlock Text="{Binding GlossaryConflictPendingCount, StringFormat='待确认冲突  {0}'}" Style="{StaticResource CaptionStyle}"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="2" Style="{StaticResource CardNoPad}">
   <DataGrid ItemsSource="{Binding GlossaryEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
    ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="原文" Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="译文" Binding="{Binding Target}" Width="2*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="110" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource CenteredCellStyle}"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <Border Grid.Row="3" Style="{StaticResource Card.Inset}" Margin="0,10,0,0">
   <TextBlock Text="{Binding GlossaryPriorityChain, StringFormat='匹配优先级：{0}'}" Style="{StaticResource CaptionStyle}"/>
  </Border>
 </Grid>
</UserControl>

