<Window x:Class="DwgTranslator.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="320" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DeepSeek API 设置" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="API Key:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="ApiKeyBox" Width="330" Padding="3" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="API 地址:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="BaseUrlBox" Width="330" Padding="3" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="模型:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="ModelBox" Width="250" Padding="3" VerticalContentAlignment="Center"/>
            <Button Content="测试连接" Width="75" Height="26" Margin="5,0,0,0" Click="TestConnection_Click"/>
        </StackPanel>

        <TextBlock x:Name="ResultText" Grid.Row="4" Text="" FontSize="11" Margin="0,5,0,0"/>

        <TextBlock Grid.Row="5" Text="设置保存后立即生效，存储在 %APPDATA%\DwgTranslator\settings.json"
                   Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="75" Height="28" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="取消" Width="75" Height="28" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
