<UserControl x:Class="DwgTranslator.App.Views.Pages.AccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:PageHeader x:Name="WorkspaceHeader" Header="会员中心" Description="查看当前套餐、剩余额度、有效期与订单。" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left">
            <Border Style="{StaticResource Section.Surface}" HorizontalAlignment="Left" Width="430" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                <StackPanel>
                    <TextBlock Text="登录账号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="可以先浏览软件；云端翻译需要登录。" TextWrapping="Wrap" Margin="0,0,0,20" />
                    <TextBlock Text="账号" Margin="0,0,0,6" />
                    <TextBox x:Name="AccountInput" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="登录账号" />
                    <TextBlock Text="密码" Margin="0,16,0,8" />
                    <PasswordBox x:Name="PasswordInput" MinHeight="{DynamicResource Size.Control}" Padding="8" KeyDown="Password_KeyDown" AutomationProperties.Name="登录密码" />
                    <Button x:Name="LoginButton" Content="登录" Style="{StaticResource Button.Primary}" Margin="0,20,0,0" Click="Login_Click" IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
            </Border>
            <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsAccountRefreshing, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding AccountFeedback}" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource Brush.TextSecondary}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding AccountFeedback}" Value="账户信息已同步。"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Content="重新验证会话" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Tertiary}" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=false}" />
            <StackPanel Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}">
<Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="24">
 <StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Secondary}"/><Button Content="···" ToolTip="账号操作" Click="AccountMenu_Click" Style="{StaticResource Button.Tertiary}"><Button.ContextMenu><ContextMenu><MenuItem Header="重新验证会话" Command="{Binding RefreshAccountCommand}"/><MenuItem Header="退出登录" Command="{Binding LogoutAccountCommand}"/></ContextMenu></Button.ContextMenu></Button></StackPanel><StackPanel><TextBlock Text="{Binding AccountDisplayNameText}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding AccountEmailText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"/></StackPanel></DockPanel>
 <WrapPanel Margin="0,24,0,0"><StackPanel MinWidth="150" Margin="0,0,24,12"><TextBlock Text="当前套餐" Style="{StaticResource InfoLabel}"/><TextBlock Text="{Binding OnlinePlanText}" Style="{StaticResource InfoValueStrong}"/></StackPanel><StackPanel MinWidth="260" Margin="0,0,24,12"><TextBlock Text="剩余额度" Style="{StaticResource InfoLabel}"/><TextBlock Text="{Binding OnlineQuotaText}" Style="{StaticResource InfoValueStrong}" Foreground="{DynamicResource Brush.Primary}"/><ProgressBar x:Name="QuotaProgress" Minimum="0" Maximum="{Binding OnlineUsage.MonthlyQuota}" Value="{Binding OnlineUsage.Remaining, Mode=OneWay}" Height="4" Margin="0,12,0,0">
 <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers>
 <DataTrigger Binding="{Binding OnlineUsage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 <DataTrigger Binding="{Binding OnlineUsage.MonthlyQuota}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="有效期" Style="{StaticResource InfoLabel}"/><TextBlock Text="{Binding OnlineMembershipExpiryText}" TextWrapping="Wrap"/></StackPanel></WrapPanel></StackPanel>
</Border>
<Border Style="{StaticResource Section.Surface}" Margin="0,24,0,0"><StackPanel><TextBlock Text="套餐与订单" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="管理续费、升级和历史订单" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,16"/><Button Content="购买 / 续费与订单" Command="{Binding OpenMembershipCheckoutCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"/><TextBlock Text="购买成功后，会员权益会自动同步至当前账号。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="0,12,0,0"/></StackPanel></Border>
                <TextBlock Text="登录设备" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
                <TextBlock Text="{Binding DeviceCountText}" Margin="0,0,0,8" />
                <controls:EmptyState Header="暂无设备记录" Description="刷新账户信息后查看已绑定设备。"><controls:EmptyState.Style><Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DeviceCountText}" Value="已绑定 0 台设备"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style></controls:EmptyState>
                <ItemsControl ItemsSource="{Binding OnlineDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Section.Surface}" Padding="12" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="移除设备" IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource Button.Secondary}" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                        <TextBlock Text="当前设备" Foreground="{DynamicResource Brush.Primary}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/><TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>