<Window x:Class="DwgTranslator.App.Views.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="授权管理" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="DWG Translator 授权管理" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,12"/>

        <!-- Status Panel -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前状态:" FontWeight="Bold" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatusText" Text="加载中..." Foreground="#1976D2" FontWeight="Bold" Margin="0,0,0,5" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="机器标识:" FontWeight="Bold" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MachineIdBox" IsReadOnly="True" Background="#F5F5F5" Padding="4,2" FontFamily="Consolas" FontSize="11" Margin="0,0,0,5" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="剩余体验:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TrialText" Text="-" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Activation Input -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="输入激活码" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="ActivationCodeBox" Padding="8,6" FontSize="13" FontFamily="Consolas"
                         TextWrapping="NoWrap" AcceptsReturn="False"
                         ToolTip="格式示例: Pocketter 或 DwgTranslator-P-XXXX..."/>
                <TextBlock x:Name="ResultText" Text="" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Info -->
        <Border Grid.Row="3" Background="#E3F2FD" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1565C0" LineHeight="18">
                <Run FontWeight="Bold">激活说明:</Run><LineBreak/>
                - 体验版可完整使用 5 次翻译导出功能<LineBreak/>
                - 买断制: 一次性付费，永久使用当前大版本<LineBreak/>
                - 订阅制: 按月/年付费，持续获得更新和技术支持<LineBreak/>
                - 激活码绑定当前机器，更换机器请联系客服重新激活
            </TextBlock>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyMachineIdButton" Content="复制机器码" Padding="12,6" Margin="0,0,10,0"
                    Click="CopyMachineId_Click" FontSize="12"/>
            <Button x:Name="ActivateButton" Content="立即激活" Padding="12,6" Margin="0,0,10,0"
                    Background="#1976D2" Foreground="White" FontWeight="Bold" FontSize="12"
                    Click="Activate_Click"/>
            <Button Content="确定" Padding="12,6" Margin="0,0,0,0" FontSize="12" FontWeight="Bold"
                    Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
