<UserControl x:Class="DwgTranslator.App.Views.Pages.AccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:pages="clr-namespace:DwgTranslator.App.Views.Pages" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 环形用量图中心的比例文案（已用占比；低于 0.1% 显示 <0.1%，不伪造成 0%） -->
        <pages:UsagePercentTextConverter x:Key="Account.UsagePercentText"/>
        <Style x:Key="Account.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}"/>
            <Setter Property="Padding" Value="{DynamicResource Spacing.16}"/>
        </Style>
        <!-- 用户反馈「更换布局思路」：常用入口由一行裸文字按钮改成一整块可点的导航磁贴
             （圆形图标 + 标题 + 一行说明 + 悬停反馈），三块等宽成组，读起来是导航而不是残留按钮。
             颜色一律沿用现有 Brush.* 令牌，不新增色值。 -->
        <Style x:Key="Account.NavTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="{DynamicResource Spacing.16}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:PageHeader x:Name="WorkspaceHeader" Header="会员中心" Description="查看当前套餐、剩余额度、有效期与订单。" />
        <!-- 用户反馈「在这个上面显示就行了」：套餐 / 字符额度 / 会员有效期三项不再单独占一排卡片，
             全部并入身份卡成为一条「身份 + 权益」卡；下半页用环形用量图与圆形导航图标补足可视化。
             合并后的结构约 222 + 详情 194 + 导航 80 ≈ 512 DIP，1500×820（可用体高约 606）与
             1366×768（约 554）都不出现纵向滚动。 -->
        <Grid Grid.Row="1">
        <ScrollViewer x:Name="AccountScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left">
            <Border Style="{StaticResource Section.Surface}" HorizontalAlignment="Left" Width="560" MaxWidth="560" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                <StackPanel>
                    <TextBlock Text="登录账号" FontSize="16" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Stack}" />
                    <TextBlock Text="可以先浏览软件；云端翻译需要登录。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.StackSection}" />
                    <TextBlock Text="账号" Margin="{DynamicResource Spacing.StackTight}" />
                    <TextBox x:Name="AccountInput" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="登录账号" />
                    <TextBlock Text="密码" Margin="{DynamicResource Spacing.RowInset}" />
                    <PasswordBox x:Name="PasswordInput" MinHeight="{DynamicResource Size.Control}" Padding="8" KeyDown="Password_KeyDown" AutomationProperties.Name="登录密码" />
                    <Button x:Name="LoginButton" Content="登录" Margin="{DynamicResource Spacing.BlockTopSection}" Click="Login_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsAccountRefreshing}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Margin="{DynamicResource Spacing.BlockTopLoose}" Padding="12,8" Background="{DynamicResource Brush.InfoLight}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Small}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding AccountFeedback}" Value="账户信息已同步。"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AccountFeedback}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <Button x:Name="SavedSessionRecoveryButton" Content="{Binding SavedSessionRecoveryButtonText}" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Tertiary}" HorizontalAlignment="Left" Margin="{DynamicResource Spacing.BlockTop}" IsEnabled="{Binding IsAccountRefreshing, Converter={StaticResource InverseBoolConverter}}" Visibility="{Binding HasSavedAccountSession, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}">
                <!-- 身份 + 权益卡（用户标注：三项权益显示在账户卡上）：
                     上行 = 头像 + 名称 + 邮箱 + 账号操作；下行 = 三项权益明细（原三张指标卡） + 额度环形用量图。
                     分组靠留白（§26 不加分隔线），卡片阴影向外溢出 3 DIP 由 Spacing.StackWide 的余量吸收。 -->
                <Border Style="{StaticResource Account.Card}" Margin="{DynamicResource Spacing.StackWide}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <!-- 头像：圆形底 + 首字母，替代原来的 40×40 方圆角块 -->
                            <Grid Width="46" Height="46" Margin="{DynamicResource Spacing.InlineLoose}">
                                <Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/>
                                <TextBlock Text="{Binding AccountAvatarText}" Foreground="{DynamicResource Brush.Primary}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountDisplayNameText}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountDisplayNameText}"/>
                                <TextBlock Text="{Binding AccountEmailText}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountEmailText}" Margin="{DynamicResource Spacing.BlockTopTight}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding RefreshAccountButtonText}" Command="{Binding RefreshAccountCommand}" IsEnabled="{Binding IsAccountRefreshing, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline}"/>
                                <Button Content="账号操作" ToolTip="重新验证会话或退出登录" Click="AccountMenu_Click" Style="{StaticResource Button.Tertiary}"><Button.ContextMenu><ContextMenu><MenuItem Header="重新验证会话" Command="{Binding RefreshAccountCommand}"/><MenuItem Header="退出登录" Command="{Binding LogoutAccountCommand}"/></ContextMenu></Button.ContextMenu></Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="{DynamicResource Spacing.BlockTopLoose}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <!-- 三项权益：标签固定列宽，数值列吃掉剩余宽度；超额时省略号 + ToolTip 兜底 -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="当前套餐" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineLoose}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OnlinePlanText}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" TextTrimming="CharacterEllipsis" ToolTip="以当前账号同步权益为准" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="字符额度" Style="{StaticResource InfoLabel}" VerticalAlignment="Top" Margin="{DynamicResource Spacing.InlineLoose}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="{Binding OnlineQuotaText}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="离线翻译按原文字符的 30% 计量" VerticalAlignment="Center"/>
                                    <!-- 额度条固定 360 DIP 并靠左：ProgressBar 自身 desired width 近 0，
                                         必须由外层给出确定宽度，否则轨道会被压成 0 宽。 -->
                                    <Grid Width="360" HorizontalAlignment="Left" Margin="{DynamicResource Spacing.BlockTopTight}">
                                        <ProgressBar x:Name="QuotaProgress" Minimum="0" Maximum="{Binding OnlineUsage.MonthlyQuota}" Value="{Binding OnlineUsage.Remaining, Mode=OneWay}" Height="5"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding OnlineUsage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding OnlineUsage.MonthlyQuota}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="会员有效期" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineLoose}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnlineMembershipExpiryText}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="购买后刷新，可同步最新权益" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 额度环形用量图：已用占比；额度未知（OnlineUsage 为空或额度为 0）时整块收起 -->
                            <Grid x:Name="QuotaRingPanel" Grid.Column="1" Margin="{DynamicResource Spacing.InlineLeading}" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OnlineUsage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding OnlineUsage.MonthlyQuota}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <pages:QuotaRing x:Name="QuotaRingChart" Width="136" Height="136" RingThickness="11" Used="{Binding OnlineUsage.Used}" Quota="{Binding OnlineUsage.MonthlyQuota}" TrackBrush="{DynamicResource Brush.BackgroundAlt}" FillBrush="{DynamicResource Brush.Primary}" ToolTip="{Binding OnlineQuotaText}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding OnlineUsage, Converter={StaticResource Account.UsagePercentText}}" FontSize="{DynamicResource FontSize.Kpi}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="额度已用" FontSize="{DynamicResource FontSize.KpiLabel}" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Grid x:Name="MembershipDetails" SizeChanged="MembershipDetails_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="PlansCard" Style="{StaticResource Account.Card}" Margin="{DynamicResource Spacing.StackLoose}">
                        <!-- 主按钮贴卡片底边，与右侧设备卡等高时不留下半空的卡片 -->
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="套餐与订单" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="选择会员或补充额度" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/>
                            </StackPanel>
                            <Button x:Name="MembershipPlansButton" Grid.Row="1" Content="查看套餐价格 / 续费与订单" Command="{Binding OpenMembershipCheckoutCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="{DynamicResource Spacing.BlockTopSection}"/>
                        </Grid>
                    </Border>
                    <Border x:Name="DevicesCard" Grid.Column="1" Style="{StaticResource Account.Card}" Margin="{DynamicResource Spacing.StackLoose}"><StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DeviceCountText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBlock Text="登录设备" Style="{StaticResource SectionTitleStyle}"/></DockPanel>
                        <TextBlock Text="设备绑定超过 20 天后才可解绑换绑；不认识的设备请及时核查，退出登录不会自动解绑。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.StackLoose}"/>
                        <controls:EmptyState Header="暂无设备记录" Description="刷新账户信息后查看已绑定设备。"><controls:EmptyState.Style><Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DeviceCountText}" Value="已绑定 0 台设备"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style></controls:EmptyState>
                        <ItemsControl ItemsSource="{Binding OnlineDevices}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,1,0,0" Padding="0,12" Margin="{DynamicResource Spacing.StackTight}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="{DynamicResource Spacing.InlineWide}"><TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"/><TextBlock Text="当前设备" Foreground="{DynamicResource Brush.Primary}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" Margin="{DynamicResource Spacing.BlockTopTight}"/><TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                                <Button Grid.Column="1" Content="移除设备" VerticalAlignment="Center" IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource Button.Secondary}" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="仅可移除满足解绑条件的非当前设备" ToolTipService.ShowOnDisabled="True"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                </Grid>
                <!-- 导航磁贴：三块等宽，整块可点，圆形图标 + 一行职责说明（Command / CommandParameter 与原按钮完全一致）。 -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Account.NavTile}" Command="{Binding NavigateToCommand}" CommandParameter="translate" Margin="{DynamicResource Spacing.InlineLoose}" ToolTip="打开图纸翻译">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/><Path Data="{StaticResource Icon.NavTranslate}" Width="{DynamicResource Size.IconInline}" Height="{DynamicResource Size.IconInline}" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="{DynamicResource Size.Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="图纸翻译" FontWeight="SemiBold"/><TextBlock Text="导入图纸 · 翻译 · 写回" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource Account.NavTile}" Command="{Binding NavigateToCommand}" CommandParameter="glossary" Margin="{DynamicResource Spacing.InlineLoose}" ToolTip="打开术语库">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/><Path Data="{StaticResource Icon.NavGlossary}" Width="{DynamicResource Size.IconInline}" Height="{DynamicResource Size.IconInline}" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="{DynamicResource Size.Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="管理术语" FontWeight="SemiBold"/><TextBlock Text="术语库、分类与云端核对" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Account.NavTile}" Command="{Binding NavigateToCommand}" CommandParameter="output-settings" ToolTip="打开输出设置">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/><Path Data="{StaticResource Icon.NavSettings}" Width="{DynamicResource Size.IconInline}" Height="{DynamicResource Size.IconInline}" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="{DynamicResource Size.Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="输出设置" FontWeight="SemiBold"/><TextBlock Text="导出模式与文件命名" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <!-- 刷新指示器是覆盖层：与 ScrollViewer 同级、贴顶 4 DIP，不占布局高度
             （冒烟断言要求刷新前后内容高度差 < 0.5） -->
        <Border x:Name="AccountRefreshIndicator" Panel.ZIndex="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="4" Background="{DynamicResource Brush.SurfaceAlt}" IsHitTestVisible="False" Visibility="{Binding IsAccountRefreshing, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Height="4" />
        </Border>
        </Grid>
    </Grid>
</UserControl>
