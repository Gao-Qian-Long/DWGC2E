<Window x:Class="DwgTranslator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls"
        xmlns:views="clr-namespace:DwgTranslator.App.Views"
        Title="{conv:Localize AppTitle}" Height="780" Width="1280"
        MinHeight="680" MinWidth="1050"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop"
        Background="{DynamicResource Brush.Background}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Keyboard shortcuts. A delivered desktop tool is expected to have them, and they are the
         fastest way to reach the dialogs that otherwise hide behind the toolbar's overflow menu. -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportDwgCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportDwgCommand}"/>
        <KeyBinding Key="F5" Command="{Binding TranslateCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ShowEnvironmentCheckCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLogViewerCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Custom Title Bar ═══ -->
        <controls:TitleBarControl Grid.Row="0"/>

        <!-- ═══ Rows 1-2: actions and translation stats share ONE card, so the header reads as a
             single control strip instead of two stacked bordered bars. ═══ -->
        <Border Grid.Row="1" Grid.RowSpan="2" Margin="10,8,10,0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.Medium}">
            <StackPanel>
                <controls:MainToolBar/>
                <controls:FilterStatsBar/>
            </StackPanel>
        </Border>

        <!-- ═══ Row 3: Progress Bar card ═══ -->
        <Border Grid.Row="3" Margin="10,6,10,0"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource StripCard}" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Operation label + cancelling indicator -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.PrimaryLight}"
                        CornerRadius="{DynamicResource CornerRadius.Small}" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OperationLabel}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="..." FontSize="11" Foreground="{DynamicResource Brush.Primary}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCancellationRequested}" Value="True">
                                            <Setter Property="Text" Value="{conv:Localize ProgressCancelling}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Progress bar -->
                <ProgressBar Grid.Column="1" Height="4" Margin="8,0"
                             Value="{Binding ProgressValue}" Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Foreground="{DynamicResource Brush.Primary}"
                             Background="{DynamicResource Brush.BackgroundAlt}"/>

                <!-- Percentage -->
                <TextBlock Grid.Column="2" Margin="4,0" FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="ProgressValue" StringFormat="{}{0:0}%"/>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══ Row 4: DataGrid card ═══ -->
        <controls:TranslationDataGrid Grid.Row="4" Margin="10,6,10,10"/>

        <!-- ═══ Row 5: Log Viewer Panel (collapsible) ═══ -->
        <views:LogViewerPanel Grid.Row="5" x:Name="LogPanel"
                              DataContext="{Binding LogViewModel}"
                              MaxHeight="280" Margin="10,0,10,0"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- ═══ Row 6: Status Bar card ═══ -->
        <Border Grid.Row="6" Style="{StaticResource StripCard}"
                BorderThickness="0,1,0,0"
                CornerRadius="0"
                Padding="10,4"
                Background="{DynamicResource Brush.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status message + processing indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource Color.Warning}"/>
                        </Border.Background>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                        From="#D97706" To="#2563EB" Duration="0:0:0.8"
                                                        AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Glossary stats + Version + License -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlossaryStatsText}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersionText}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               ToolTip="DWG Translator 版本"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="&#xB7;" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LicenseStatusText}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Visibility="{Binding IsLicensingEnabled, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Drag & drop import hint (covers the whole window while dragging) ═══ -->
        <!-- IsHitTestVisible=False keeps the drag events flowing to the window itself,
             so the drop never gets swallowed by this overlay. The size is bound to the
             window rather than to the grid: the toolbar can be wider than the window, which
             would make the grid wider than the visible area and shift the centred card. -->
        <Border x:Name="DropOverlay"
                Grid.Row="0" Grid.RowSpan="7"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Color.DropScrim}" Opacity="0.55"/>
            </Border.Background>
            <Border Width="540" Padding="30,26" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2">
                <StackPanel>
                    <!-- Vector icon: the folder emoji renders as a box on fonts that lack it. -->
                    <Path x:Name="DropOverlayIcon" Data="{StaticResource Icon.EmptySheet}"
                          Width="46" Height="46" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,12"
                          Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Text="{conv:Localize DropHintTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{conv:Localize DropHintDesc}" FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                    <TextBlock x:Name="DropOverlayFiles" FontSize="12" Margin="0,12,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
