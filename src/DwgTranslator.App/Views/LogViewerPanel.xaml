<UserControl x:Class="DwgTranslator.App.Views.LogViewerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DwgTranslator.App.ViewModels"
             xmlns:local="clr-namespace:DwgTranslator.App.Views"
             Background="{DynamicResource Brush.Surface}">

    <UserControl.Resources>
        <local:StringToVisibilityConverter x:Key="CategoryVis"/>
        <local:StringToVisibilityConverter x:Key="ExVis"/>
        <local:DurationToVisibilityConverter x:Key="DurationVis"/>
        <local:SourceFilterVisibilityConverter x:Key="SourceFilterVis"/>

        <!-- Log level badge style -->
        <Style x:Key="LevelBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="36"/>
        </Style>

        <!-- Source badge style -->
        <Style x:Key="SourceBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>

        <!-- Monospace text style for log entries -->
        <Style x:Key="LogText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.BackgroundAlt}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <!-- §L2 工具栏自适应两行：筛选控件在上一行，统计与操作按钮在下一行，
                 窄窗口（LogViewerWindow MinWidth=700）下按钮不再被裁掉。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Left: Controls -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="运行日志" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource FontSize.Secondary}" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineWide}"
                               FontFamily="Cascadia Code, Consolas"/>

                    <ComboBox ItemsSource="{Binding LevelFilters}"
                              SelectedItem="{Binding SelectedLevelFilter}"
                              Width="75" FontSize="{DynamicResource FontSize.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"
                              Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                              BorderBrush="{DynamicResource Brush.Border}"
                              ToolTip="按日志级别筛选"/>

                    <ComboBox ItemsSource="{Binding SourceFilters}"
                              SelectedItem="{Binding SelectedSourceFilter}"
                              Width="65" FontSize="{DynamicResource FontSize.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"
                              Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                              BorderBrush="{DynamicResource Brush.Border}"
                              ToolTip="按来源筛选（应用/CAD/翻译）"/>

                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Height="24" FontSize="{DynamicResource FontSize.Secondary}"
                             Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                             BorderBrush="{DynamicResource Brush.Border}" Padding="6,0"
                             VerticalContentAlignment="Center"
                             ToolTip="搜索日志内容"/>

                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"
                              Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource FontSize.Secondary}" VerticalAlignment="Center"
                              Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Spacing.BlockTopTight}">
                    <TextBlock Text="{Binding LevelSummary}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource FontSize.Secondary}"
                               VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineWide}"
                               FontFamily="Cascadia Code, Consolas"/>
                    <TextBlock Text="{Binding TotalLogCount, StringFormat='共 {0} 条'}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Secondary}" VerticalAlignment="Center"
                               Margin="{DynamicResource Spacing.InlineWide}"/>

                    <Button Command="{Binding TogglePauseCommand}" ToolTip="暂停或继续刷新日志"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="{DynamicResource FontSize.Secondary}" Padding="6,2" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Setter Property="Content" Value="暂停"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="继续"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding CopyLogsCommand}" ToolTip="复制日志到剪贴板"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="{DynamicResource FontSize.Secondary}" Padding="6,2" Cursor="Hand" Content="复制"/>
                    <Button Command="{Binding ExportLogsCommand}" ToolTip="导出日志文件"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="{DynamicResource FontSize.Secondary}" Padding="6,2" Cursor="Hand" Content="导出"/>
                    <Button Command="{Binding ClearLogsCommand}" ToolTip="清空当前日志"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="{DynamicResource FontSize.Secondary}" Padding="6,2" Cursor="Hand" Content="清空"/>
                    <Button Command="{Binding OpenLogFolderCommand}" ToolTip="打开日志文件夹"
                            Background="Transparent" Foreground="{DynamicResource Brush.TextSecondary}" BorderThickness="0"
                            FontSize="{DynamicResource FontSize.Secondary}" Padding="6,2" Cursor="Hand" Content="文件夹"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log entries and stable empty/paused state -->
        <Grid Grid.Row="1">
        <!-- §L12 Disabled（非 Auto）：Auto 让列测量宽度为无限大，星号列随最长日志膨胀，
             整行在视口边缘被硬裁切且横向滚动条实际不可见（只能 Shift+滚轮）。
             Disabled 恢复视口约束，星号列收缩，CharacterEllipsis+ToolTip 才能生效。 -->
        <ListView ItemsSource="{Binding LogEntries}"
                  Background="{DynamicResource Brush.Surface}" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.ScrollChanged="LogListView_ScrollChanged"
                  x:Name="LogListView"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="1,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- §L1 Message 占满剩余宽度（Auto 会被长日志撑爆并把异常列压成 0） -->
                            <ColumnDefinition Width="*"/>
                            <!-- §L1 异常列改为 Auto，短异常不再被裁掉 -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Secondary}"
                                   FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}"/>

                        <!-- Level badge -->
                        <Border Grid.Column="1" Style="{StaticResource LevelBadge}"
                                Background="{Binding LevelColor}">
                            <TextBlock Text="{Binding LevelTag}" FontSize="{DynamicResource FontSize.Secondary}" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       FontFamily="Cascadia Code, Consolas"/>
                        </Border>

                        <!-- Source badge (hidden for APP to reduce noise) -->
                        <Border Grid.Column="2" Style="{StaticResource SourceBadge}"
                                Background="{Binding SourceColor}"
                                Visibility="{Binding LogSource, Converter={StaticResource SourceFilterVis}}">
                            <TextBlock Text="{Binding SourceTag}" FontSize="9" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       FontFamily="Cascadia Code, Consolas"/>
                        </Border>

                        <!-- Category (if present) -->
                        <TextBlock Grid.Column="3" Text="{Binding Category}"
                                   Foreground="{DynamicResource Brush.Info}" FontSize="{DynamicResource FontSize.Secondary}"
                                   FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}"
                                   Visibility="{Binding Category, Converter={StaticResource CategoryVis}}"/>

                        <!-- Message + Duration + Exception -->
                        <!-- §L13 必须是 Grid（* + Auto）而非水平 StackPanel：StackPanel 测量时
                             给子元素无限宽度，TextTrimming 永不触发，长消息整行硬裁到视口边缘。
                             星号列受视口约束后省略号+ToolTip 才真正生效，耗时钉在右侧。 -->
                        <Grid Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Message}" Style="{StaticResource LogText}" ToolTip="{Binding Message}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Secondary}"
                                       FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"
                                       Margin="{DynamicResource Spacing.LeftGap}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- 默认 Visible：只有 DurationMs 为 null 才折叠。
                                             原来默认 Collapsed 且没有回正的分支，耗时永远不显示。 -->
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DurationMs}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <Binding Path="DurationMs" StringFormat="({0:F0}ms)"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- Exception -->
                        <TextBlock Grid.Column="5" Text="{Binding Exception}" Foreground="{DynamicResource Brush.Danger}" FontSize="{DynamicResource FontSize.Secondary}"
                                   FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"
                                   Margin="{DynamicResource Spacing.LeftGap}"
                                   MaxWidth="480" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Exception}"
                                   Visibility="{Binding Exception, Converter={StaticResource ExVis}}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="MinHeight" Value="22"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border x:Name="LogEmptyState" Background="{DynamicResource Brush.Surface}"
                Visibility="{Binding HasVisibleLogEntries, Converter={StaticResource BoolToVis}, ConverterParameter=false}"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.BackgroundAlt}" HorizontalAlignment="Center">
                    <TextBlock Text="≡" FontSize="24" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="LogEmptyStateTitle" Text="{Binding EmptyStateTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock Text="{Binding EmptyStateDescription}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
