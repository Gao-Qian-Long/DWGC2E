<UserControl x:Class="DwgTranslator.App.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters" Height="48">
    <UserControl.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DCE9E5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bg" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#294B45"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#0F766E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C94B4B"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.TitleBarBackground}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Brush.Primary}">
                    <TextBlock Text="D" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="图纸翻译工作台" Foreground="#F5FAF8" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="DWG TRANSLATOR" Foreground="#8FB0A8" FontSize="9" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ChooseLanguagesCommand}" ToolTip="选择原文与目标语言"
                    AutomationProperties.AutomationId="LanguagePairButton" WindowChrome.IsHitTestVisibleInChrome="True"
                    Cursor="Hand" Background="#263F3A" BorderBrush="#42615A" BorderThickness="1"
                    Height="34" VerticalAlignment="Center" VerticalContentAlignment="Center">
                <Button.Template><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="17,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LanguageDirection}" Foreground="#F3F8F6" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Path Data="M 0,0 L 8,0 L 4,4.8 Z" Fill="#83C5B8" Margin="10,0,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#315049"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ToggleTopmostCommand}" ToolTip="窗口置顶" Style="{StaticResource TitleBarButton}">
                    <Path Data="M 8,1 L 12,5 L 11,6 L 11,9 L 13,11 L 13,12 L 8.6,12 L 8.6,15 L 8,16 L 7.4,15 L 7.4,12 L 3,12 L 3,11 L 5,9 L 5,6 L 4,5 Z" Fill="#DCE9E5"/>
                </Button>
                <Button Command="{Binding SettingsCommand}" ToolTip="设置" Style="{StaticResource TitleBarButton}">
                    <Path Data="M 8,5.2 A 2.8,2.8 0 1 1 7.99,5.2 Z M 8,6.4 A 1.6,1.6 0 1 0 8.01,6.4 Z M 7.2,1 L 8.8,1 L 9.1,2.6 L 10.4,3.1 L 11.7,2.1 L 12.8,3.2 L 11.8,4.5 L 12.3,5.8 L 13.9,6.1 L 13.9,7.7 L 12.3,8 L 11.8,9.3 L 12.8,10.6 L 11.7,11.7 L 10.4,10.7 L 9.1,11.2 L 8.8,12.8 L 7.2,12.8 L 6.9,11.2 L 5.6,10.7 L 4.3,11.7 L 3.2,10.6 L 4.2,9.3 L 3.7,8 L 2.1,7.7 L 2.1,6.1 L 3.7,5.8 L 4.2,4.5 L 3.2,3.2 L 4.3,2.1 L 5.6,3.1 L 6.9,2.6 Z" Fill="#DCE9E5"/>
                </Button>
                <Button x:Name="MinimizeButton" Content="—" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButton}"/>
                <Button x:Name="MaxRestoreButton" Click="MaximizeButton_Click" Style="{StaticResource TitleBarButton}"><Path x:Name="MaximizeGlyph" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="#DCE9E5" StrokeThickness="1" Fill="Transparent"/></Button>
                <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
