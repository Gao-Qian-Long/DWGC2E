<UserControl x:Class="DwgTranslator.App.Views.Pages.TranslatePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18,14,18,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <TextBlock Text="图纸翻译" Style="{StaticResource PageTitleStyle}"/>
   <TextBlock Text="添加图纸，选择语言，开始翻译。" Style="{StaticResource PageSubtitleStyle}"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel Grid.Column="0">
     <Button Content="添加图纸" Command="{Binding ImportDwgCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
     <Button Content="开始翻译" Command="{Binding TranslateCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
     <Button Content="停止" Command="{Binding CancelTranslateCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"/>
     <Button Content="导出图纸" Command="{Binding ExportDwgCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
     <Button Content="取消导出" Command="{Binding CancelExportCommand}" Style="{StaticResource Button.Secondary}" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
     <Button Content="打开输出目录" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource Button.Tertiary}"/>
    </WrapPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="翻译语言" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
     <ComboBox Width="168" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding CurrentSourceLang, Mode=TwoWay}"/>
     <Button Content="⇄" ToolTip="交换语言" Command="{Binding SwapLanguagesCommand}" Style="{StaticResource Button.Tertiary}" Margin="8,0"/>
     <ComboBox Width="168" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding CurrentTargetLang, Mode=TwoWay}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource CardNoPad}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardHeaderBar}">
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DrawingFiles.Count, StringFormat='共 {0} 张'}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="图纸队列" Style="{StaticResource CardTitleStyle}"/></DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <DataGrid ItemsSource="{Binding DrawingFiles}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                      HeadersVisibility="Column" RowHeight="36" FontSize="13"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46" IsReadOnly="True"
                                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*" MinWidth="180"
                                                        IsReadOnly="True" ElementStyle="{StaticResource WrapCellStyle}"/>

                                    <DataGridTemplateColumn Header="状态" Width="120" IsReadOnly="True"
                                                            SortMemberPath="StatusText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
                                                                <Style.Triggers>
                                                                    <!-- 任务层的 10 态：处理中的阶段统一主色，失败/取消/暂停用告警色，
                                                                         用户一眼能看出「在跑 / 跑完了 / 出问题了」，不必逐字读状态名。 -->
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="解析中">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="提取文本">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="翻译中">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="排版优化">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="写回中">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="部分失败">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="完成（含失败）">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已暂停">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已取消">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="导入失败">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                                               ToolTip="{Binding SummaryText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="文本数量" Binding="{Binding TextCountText}" Width="90"
                                                        IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>

                                    <DataGridTemplateColumn Header="进度" Width="150" IsReadOnly="True"
                                                            SortMemberPath="ProgressPercent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="6" VerticalAlignment="Center"
                                                                 Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Brush.Primary}"
                                                                 Background="{DynamicResource Brush.BackgroundAlt}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                               FontSize="12" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="80"
                                                        IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>

                                    <DataGridTemplateColumn Header="操作" Width="150" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsIncludedForExport, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              ToolTip="勾选的图纸参与批量导出"
                                                              AutomationProperties.Name="参与导出"/>
                                                    <Button Style="{StaticResource CompactToolButton}"
                                                            Command="{Binding DataContext.OpenDrawingFileItemsCommand,
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="查看该图纸的文本条目">
                                                        <TextBlock Text="条目"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
     <Border Background="{DynamicResource Brush.Surface}" Margin="1,0,1,8" Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <Path Data="{StaticResource Icon.EmptySheet}" Style="{StaticResource EmptyState.Icon}" Margin="0,0,0,8"/>
       <TextBlock Text="从第一张图纸开始" Style="{StaticResource EmptyState.Title}"/>
       <TextBlock Text="拖入 DWG / DXF 文件，或点击「添加图纸」。" Style="{StaticResource EmptyState.Description}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>
  <Border Grid.Row="3" Style="{StaticResource Card.Inset}" Margin="0,10,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
     <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,20,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="查看日志" Command="{Binding ToggleLogViewerCommand}" Style="{StaticResource Button.Tertiary}"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>



