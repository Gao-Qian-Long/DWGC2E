<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DWG Translator — Icon geometry
         Vector shapes instead of emoji or symbol characters: the console fonts on a Chinese
         Windows install lack 📂 💾 📊 📅 📋 🗑 glyphs and silently substitute another face, which
         is what made the toolbar and the stats row look inconsistent.
         All shapes are drawn in a 14 x 14 box; stroke-based icons expect a 1.3 stroke.
         ============================================================ -->

    <!-- Import: tray with a down arrow -->
    <PathGeometry x:Key="Icon.Import.Tray"
                  Figures="M 1,9 L 4.2,9 L 5.4,11.2 L 8.6,11.2 L 9.8,9 L 13,9 L 13,13.6 L 1,13.6 Z" />
    <PathGeometry x:Key="Icon.Import.Arrow"
                  Figures="M 7,0.6 L 7,7.4 M 3.9,4.4 L 7,7.6 L 10.1,4.4" />

    <!-- Export: tray with an up arrow -->
    <PathGeometry x:Key="Icon.Export.Tray"
                  Figures="M 1,9 L 4.2,9 L 5.4,11.2 L 8.6,11.2 L 9.8,9 L 13,9 L 13,13.6 L 1,13.6 Z" />
    <PathGeometry x:Key="Icon.Export.Arrow"
                  Figures="M 7,0.6 L 7,7.4 M 3.9,3.6 L 7,0.4 L 10.1,3.6" />

    <!-- Translate: solid play triangle -->
    <PathGeometry x:Key="Icon.Translate" Figures="M 1,0.4 L 11.6,7 L 1,13.6 Z" />

    <!-- Glossary: table of terms -->
    <PathGeometry x:Key="Icon.Glossary"
                  Figures="M 0.6,2.6 L 13.4,2.6 M 0.6,7 L 13.4,7 M 0.6,11.4 L 13.4,11.4" />

    <!-- Review: check mark -->
    <PathGeometry x:Key="Icon.Check" Figures="M 1.6,7.4 L 5.4,11.2 L 12.6,2.4" />

    <!-- Retry: circular arrow -->
    <PathGeometry x:Key="Icon.Refresh"
                  Figures="M 12.4,7 A 5.4,5.4 0 1 0 7,12.4 M 12.4,2.2 L 12.4,7.4 L 7.2,7.4" />

    <!-- Spreadsheet -->
    <PathGeometry x:Key="Icon.Excel"
                  Figures="M 1,1 L 13,1 L 13,13 L 1,13 Z M 1,4.6 L 13,4.6 M 1,8.6 L 13,8.6 M 5.2,1 L 5.2,13 M 9.4,1 L 9.4,13" />
    <PathGeometry x:Key="Icon.ExcelArrow" Figures="M 4.2,10 L 9.8,4.4 M 6,4.4 L 9.8,4.4 L 9.8,8.2" />

    <!-- Log panel: window with lines -->
    <PathGeometry x:Key="Icon.Log"
                  Figures="M 1,1.6 L 13,1.6 L 13,12.4 L 1,12.4 Z M 1,4.6 L 13,4.6 M 3,7.2 L 11,7.2 M 3,9.8 L 8,9.8" />

    <!-- Help: circled question mark stem -->
    <PathGeometry x:Key="Icon.HelpRing"
                  Figures="M 7,1 A 6,6 0 1 1 6.99,1 Z" />
    <PathGeometry x:Key="Icon.HelpMark"
                  Figures="M 4.9,5.4 A 2.1,2.1 0 1 1 7.1,7.6 L 7.1,8.7 M 7.1,11 L 7.1,11.9" />

    <!-- Clear: trash can -->
    <PathGeometry x:Key="Icon.Trash"
                  Figures="M 1.4,3.2 L 12.6,3.2 M 5,3.2 L 5,1 L 9,1 L 9,3.2 M 2.8,3.2 L 3.8,13.2 L 10.2,13.2 L 11.2,3.2 M 5.6,5.6 L 5.9,11 M 8.4,5.6 L 8.1,11" />

    <!-- Licence: padlock -->
    <PathGeometry x:Key="Icon.Lock"
                  Figures="M 3.2,6.2 L 3.2,4.2 A 3.8,3.8 0 0 1 10.8,4.2 L 10.8,6.2 M 1.6,6.2 L 12.4,6.2 L 12.4,13 L 1.6,13 Z" />

    <!-- Search / clear -->
    <PathGeometry x:Key="Icon.Search"
                  Figures="M 6,1.4 A 4.6,4.6 0 1 1 5.99,1.4 Z M 9.4,9.4 L 13,13" />
    <PathGeometry x:Key="Icon.Close" Figures="M 1.4,1.4 L 8.6,8.6 M 8.6,1.4 L 1.4,8.6" />

    <!-- Chevron used by menu buttons -->
    <PathGeometry x:Key="Icon.Caret" Figures="M 0,0 L 8,0 L 4,4.8 Z" />

    <!-- Empty state: sheet of drawings -->
    <PathGeometry x:Key="Icon.EmptySheet"
                  Figures="M 2,1 L 12,1 L 12,15 L 2,15 Z M 2,5 L 12,5 M 4.6,8 L 9.4,8 M 4.6,11 L 9.4,11" />

    <!-- Stats row: failure warning triangle -->
    <PathGeometry x:Key="Icon.Warning"
                  Figures="M 7,1 L 13.4,12.4 L 0.6,12.4 Z M 7,5 L 7,8.8 M 7,10.6 L 7,11.3" />

    <!-- Stats row: translation cache (stacked discs) -->
    <PathGeometry x:Key="Icon.Cache"
                  Figures="M 1.2,3.4 A 5.8,2.6 0 1 1 1.19,3.4 Z M 1.2,3.4 L 1.2,10.6 A 5.8,2.6 0 0 0 12.8,10.6 L 12.8,3.4 M 1.2,7 A 5.8,2.6 0 0 0 12.8,7" />

    <!-- CAD drawing sheet: frame with a triangular boss and a hole, i.e. a part drawing -->
    <PathGeometry x:Key="Icon.Cad"
                  Figures="M 1,1.5 L 13,1.5 L 13,12.5 L 1,12.5 Z M 3.6,9.8 L 6.5,4.4 L 9.4,9.8 Z M 11.1,6.4 A 1.5,1.5 0 1 1 11.09,6.4 Z" />

    <!-- ═══ Sidebar navigation (all drawn in a 14 x 14 box) ═══ -->
    <!-- 图纸翻译: sheet with text lines -->
    <PathGeometry x:Key="Icon.NavTranslate"
                  Figures="M 2,1.2 L 12,1.2 L 12,12.8 L 2,12.8 Z M 4.4,4.6 L 9.6,4.6 M 4.4,7.2 L 9.6,7.2 M 4.4,9.8 L 7.4,9.8" />
    <!-- 批量任务: stacked sheets -->
    <PathGeometry x:Key="Icon.NavBatch"
                  Figures="M 4.4,0.8 L 13.2,0.8 L 13.2,9.6 M 0.8,4.4 L 9.6,4.4 L 9.6,13.2 L 0.8,13.2 Z M 3.2,7.4 L 7.2,7.4 M 3.2,10.2 L 7.2,10.2" />
    <!-- 术语库: open book -->
    <PathGeometry x:Key="Icon.NavGlossary"
                  Figures="M 1.2,1.6 L 6.2,1.6 L 7,3 L 7.8,1.6 L 12.8,1.6 L 12.8,12.4 L 7.8,12.4 L 7,11 L 6.2,12.4 L 1.2,12.4 Z M 7,3 L 7,11" />
    <!-- 会员中心: crowned user -->
    <PathGeometry x:Key="Icon.NavAccount"
                  Figures="M 7,1.2 L 9,3.4 L 11.6,1.8 L 11,6.4 L 3,6.4 L 2.4,1.8 L 5,3.4 Z M 3.4,8.6 L 10.6,8.6 L 11.4,13.2 L 2.6,13.2 Z" />
    <!-- 设置: gear -->
    <PathGeometry x:Key="Icon.NavSettings"
                  Figures="M 7,4.6 A 2.4,2.4 0 1 1 6.99,4.6 Z M 6.4,0.8 L 7.6,0.8 L 7.9,2.2 L 9.1,2.6 L 10.2,1.7 L 11.1,2.6 L 10.2,3.7 L 10.7,4.9 L 12.2,5.2 L 12.2,6.4 L 10.7,6.7 L 10.2,7.9 L 11.1,9 L 10.2,9.9 L 9.1,9 L 7.9,9.4 L 7.6,10.8 L 6.4,10.8 L 6.1,9.4 L 4.9,9 L 3.8,9.9 L 2.9,9 L 3.8,7.9 L 3.3,6.7 L 1.8,6.4 L 1.8,5.2 L 3.3,4.9 L 3.8,3.7 L 2.9,2.6 L 3.8,1.7 L 4.9,2.6 L 6.1,2.2 Z" />
    <!-- 添加图纸: folder with a plus -->
    <PathGeometry x:Key="Icon.FolderPlus"
                  Figures="M 0.8,2.6 L 5.2,2.6 L 6.4,4 L 13.2,4 L 13.2,12.4 L 0.8,12.4 Z M 7,6.2 L 7,10.6 M 4.8,8.4 L 9.2,8.4" />
    <!-- 打开输出目录: folder with a down arrow -->
    <PathGeometry x:Key="Icon.FolderOpen"
                  Figures="M 0.8,2.6 L 5.2,2.6 L 6.4,4 L 13.2,4 L 13.2,12.4 L 0.8,12.4 Z M 7,6 L 7,10.6 M 5,8.6 L 7,10.6 L 9,8.6" />
    <!-- 停止任务 -->
    <PathGeometry x:Key="Icon.StopSquare" Figures="M 0.4,0.4 L 9.6,0.4 L 9.6,9.6 L 0.4,9.6 Z" />
    <!-- Statistics cards -->
    <PathGeometry x:Key="Icon.StatText"
                  Figures="M 2.2,1 L 11.8,1 L 11.8,13 L 2.2,13 Z M 4.6,4.2 L 9.4,4.2 M 4.6,7 L 9.4,7 M 4.6,9.8 L 7.4,9.8" />
    <PathGeometry x:Key="Icon.StatPie" Figures="M 7,1 L 13,7 L 7,13 Z M 7,1 A 6,6 0 0 0 1,7 L 7,7 Z" />
    <PathGeometry x:Key="Icon.StatPin"
                  Figures="M 7,1.2 L 9.4,5.6 L 12.8,6.2 L 10.4,8.6 L 11,12.8 L 7,10.8 L 3,12.8 L 3.6,8.6 L 1.2,6.2 L 4.6,5.6 Z" />
    <PathGeometry x:Key="Icon.Monitor"
                  Figures="M 1,2 L 13,2 L 13,10.4 L 1,10.4 Z M 4.6,12.6 L 9.4,12.6 M 7,10.4 L 7,12.6" />
    <PathGeometry x:Key="Icon.Clock"
                  Figures="M 7,1 A 6,6 0 1 1 6.99,1 Z M 7,3.4 L 7,7.4 L 9.8,8.8" />

</ResourceDictionary>
