<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DwgTranslator.App</RootNamespace>
    <AssemblyName>DwgTranslator</AssemblyName>
    <Version>2.1.1</Version>
    <FileVersion>2.1.1.0</FileVersion>
    <InformationalVersion>2.1.1</InformationalVersion>
    <Product>DWG Translator</Product>
    <Company>DWG Translator</Company>
    <ApplicationIcon>..\..\assets\icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the WPF window icon. A loose Content file is not reliable in
         compressed single-file publishes because no physical base path exists. -->
    <Resource Include="..\..\assets\icons\icon.ico" Link="icon.ico" />
    <!-- 纸纹噪点贴图（暖色手作杂志风）：同样必须以 Resource 内嵌，单文件发布才可靠。 -->
    <Resource Include="Assets\paper-noise.png" />
    <Content Include="..\..\settings.json.example" Link="settings.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\glossaries\mechanical_zh_en.json" Link="assets\default-glossaries\mechanical_zh_en.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Self-contained publish profile -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Pin the serviced .NET 8 JSON package; 8.0.0 has two high-severity advisories. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DwgTranslator.Core\DwgTranslator.Core.csproj" />
    <!-- Build the in-CAD plugin together with the desktop app without linking it
         into the WPF process. Its complete private dependency set is copied below. -->
  </ItemGroup>

  <!-- A solution build already builds Cad first through the .sln dependency below. Standalone App
       builds/publishes still invoke it here so the packaged plugin is never stale. -->
  <Target Name="BuildCadPlugin" BeforeTargets="AssignTargetPaths" Condition="'$(BuildingSolutionFile)' != 'true'">
    <MSBuild Projects="..\DwgTranslator.Cad\DwgTranslator.Cad.csproj"
             Targets="Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir"
             Properties="Configuration=$(Configuration);NuGetAudit=false" />
  </Target>

  <!-- Use this build's complete private plugin payload, never a manually copied source DLL.
       Add items after the plugin build so clean builds can discover generated files. -->
  <Target Name="EmbedCurrentCadPlugin" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildCadPlugin">
    <ItemGroup>
      <_CadEmbeddedPayload Include="..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\**\*"
                        Exclude="..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\**\*.pdb" />
      <_CadEmbeddedPayload>
        <LogicalName>DwgTranslator.App.Embedded.CadPlugin.%(_CadEmbeddedPayload.RecursiveDir)%(_CadEmbeddedPayload.Filename)%(_CadEmbeddedPayload.Extension)</LogicalName>
        <WithCulture>false</WithCulture>
      </_CadEmbeddedPayload>
      <EmbeddedResource Remove="@(_CadEmbeddedPayload)" />
      <EmbeddedResource Include="@(_CadEmbeddedPayload)" />
    </ItemGroup>
    <Error Condition="!Exists('..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\DwgTranslator.Core.dll')" Text="CAD plugin private dependencies are missing." />
  </Target>

  <Target Name="CopyCadPluginToBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <_CadPluginBuildFiles Include="..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\**\*"
                            Exclude="..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\**\*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)CadPlugin" />
    <Copy SourceFiles="@(_CadPluginBuildFiles)"
          DestinationFiles="@(_CadPluginBuildFiles->'$(OutDir)CadPlugin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCadPluginToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_CadPluginPublishFiles Include="..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\**\*"
                              Exclude="..\DwgTranslator.Cad\bin\$(Configuration)\$(CadPluginTargetFramework)\**\*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)CadPlugin" />
    <Copy SourceFiles="@(_CadPluginPublishFiles)"
          DestinationFiles="@(_CadPluginPublishFiles->'$(PublishDir)CadPlugin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
