                                <TextBlock Text="输出文件" Style="{StaticResource SectionTitleStyle}"
                                           Margin="{DynamicResource Spacing.StackTight}" />
                                <TextBlock Text="{Binding SelectedBatchTask.OutputPathText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- 滚到底时让最后一张卡与底栏分隔线之间隔出与卡片间距一致的 12 DIP，
                             否则内容末端紧贴分隔线，看起来像被裁断。 -->
                        <Border Margin="{DynamicResource Spacing.BlockTopWide}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
