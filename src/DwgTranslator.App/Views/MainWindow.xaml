<Window x:Class="DwgTranslator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls"
        xmlns:views="clr-namespace:DwgTranslator.App.Views"
        Title="{conv:Localize AppTitle}" Height="780" Width="1280"
        MinHeight="680" MinWidth="1050"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Custom Title Bar ═══ -->
        <controls:TitleBarControl Grid.Row="0"/>

        <!-- ═══ Row 1: Toolbar — card-grouped action buttons ═══ -->
        <controls:MainToolBar Grid.Row="1" Margin="10,6,10,0"/>

        <!-- ═══ Row 2: Filter + Stats card ═══ -->
        <controls:FilterStatsBar Grid.Row="2" Margin="10,6,10,0"/>

        <!-- ═══ Row 3: Progress Bar card ═══ -->
        <Border Grid.Row="3" Margin="10,6,10,0"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource StripCard}" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Operation label + cancelling indicator -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.PrimaryLight}"
                        CornerRadius="{DynamicResource CornerRadius.Small}" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OperationLabel}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="..." FontSize="11" Foreground="{DynamicResource Brush.Primary}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCancellationRequested}" Value="True">
                                            <Setter Property="Text" Value="{conv:Localize ProgressCancelling}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Progress bar -->
                <ProgressBar Grid.Column="1" Height="4" Margin="8,0"
                             Value="{Binding ProgressValue}" Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Foreground="{DynamicResource Brush.Primary}"
                             Background="{DynamicResource Brush.BackgroundAlt}"/>

                <!-- Percentage -->
                <TextBlock Grid.Column="2" Margin="4,0" FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="ProgressValue" StringFormat="{}{0:0}%"/>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══ Row 4: DataGrid card ═══ -->
        <controls:TranslationDataGrid Grid.Row="4" Margin="10,6,10,10"/>

        <!-- ═══ Row 5: Log Viewer Panel (collapsible) ═══ -->
        <views:LogViewerPanel Grid.Row="5" x:Name="LogPanel"
                              DataContext="{Binding LogViewModel}"
                              MaxHeight="280" Margin="10,0,10,0"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- ═══ Row 6: Status Bar card ═══ -->
        <Border Grid.Row="6" Style="{StaticResource StripCard}"
                BorderThickness="0,1,0,0"
                CornerRadius="0"
                Padding="10,4"
                Background="{DynamicResource Brush.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status message + processing indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource Color.Warning}"/>
                        </Border.Background>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                        From="#D97706" To="#2563EB" Duration="0:0:0.8"
                                                        AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Glossary stats + Version + License -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlossaryStatsText}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DWG Translator v2.1"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="&#xB7;" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LicenseStatusText}"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Visibility="{Binding IsLicensingEnabled, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
