<Window x:Class="DwgTranslator.App.Views.LanguagePairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译语言"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="{DynamicResource FontSize.Body}">

    <Border Padding="22,20,22,18">
        <!-- Width is fixed on the window, which keeps the measure constraint finite for the picker
             grid; the content therefore sizes itself instead of carrying a magic width. -->
        <StackPanel>
            <TextBlock Text="翻译语言" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}" />
            <TextBlock Text="选择图纸上的原文语言，以及要翻译成的目标语言。"
                       Margin="{DynamicResource Spacing.BlockTopTight}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}" />

            <!-- Source / target pickers with a swap control between them -->
            <Grid Margin="{DynamicResource Spacing.BlockTopLoose}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="原文语言" Style="{StaticResource InputLabel}" />
                    <ComboBox x:Name="SourceCombo"
                              Margin="{DynamicResource Spacing.BlockTopTight}"

                              MaxWidth="212"
                              HorizontalAlignment="Left"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="NativeName"
                              SelectedValuePath="Code"
                              SelectionChanged="PairSelectionChanged" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="SwapButton"
                        Margin="{DynamicResource Spacing.InlineWide}"
                        VerticalAlignment="Bottom"
                        Width="40"
                        ToolTip="交换原文语言与目标语言"
                        AutomationProperties.Name="交换语言"
                        Style="{StaticResource ToolButton}"
                        Click="Swap_Click">
                    <!-- Vector arrows: the ⇄ glyph is missing from the console fonts on some
                         machines and rendered as a dot. -->
                    <Grid Width="17" Height="12">
                        <Path Data="M 0,3.2 L 10,3.2 M 7.4,0.6 L 10,3.2 L 7.4,5.8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="M 17,8.8 L 7,8.8 M 9.6,6.2 L 7,8.8 L 9.6,11.4"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="目标语言" Style="{StaticResource InputLabel}" />
                    <ComboBox x:Name="TargetCombo"
                              Margin="{DynamicResource Spacing.BlockTopTight}"

                              MaxWidth="212"
                              HorizontalAlignment="Left"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="NativeName"
                              SelectedValuePath="Code"
                              SelectionChanged="PairSelectionChanged" />
                </StackPanel>
            </Grid>

            <!-- Live preview of the resulting direction -->
            <Border x:Name="PreviewBorder"
                    Margin="{DynamicResource Spacing.BlockTopLoose}"
                    Padding="14,11"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.PrimaryLight}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 9,0 A 9,9 0 1 1 8.99,0 Z M 9,2.6 A 6.4,6.4 0 1 0 9.01,2.6 Z M 9,0 A 4.2,9 0 0 1 9,18 A 4.2,9 0 0 1 9,0 Z M 0.6,6.4 L 17.4,6.4 L 17.4,8.4 L 0.6,8.4 Z"
                          Fill="{DynamicResource Brush.Primary}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="PreviewText"
                               Margin="{DynamicResource Spacing.LeftGap}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}" />
                </StackPanel>
            </Border>

            <TextBlock Text="常用组合" Style="{StaticResource InputLabel}" Margin="{DynamicResource Spacing.BlockTopLoose}" />
            <!-- The window width is fixed, so the panel gets a real measure constraint and wraps on
                 its own; an explicit chip width would only fight the available space. -->
            <WrapPanel x:Name="PresetPanel" Margin="{DynamicResource Spacing.BlockTop}" />

            <Border Margin="{DynamicResource Spacing.BlockTopLoose}"
                    Padding="13,11"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.WarningLight}">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="切换语言后会清空当前图纸上已有的译文，需要用新语言重新翻译。已经翻译过的句子保存在本地缓存中，不会重复消耗接口额度。" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Spacing.BlockTopSection}">
                <Button Content="取消" MinWidth="92"
                        IsCancel="True"
                        Style="{StaticResource DialogCancelButton}"
                        Click="Cancel_Click" />
                <Button x:Name="ApplyButton" Content="应用" MinWidth="92" Margin="{DynamicResource Spacing.LeftGap}"
                        IsDefault="True"
                        Style="{StaticResource DialogSaveButton}"
                        Click="Apply_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
