<Window x:Class="DwgTranslator.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DeepSeek API Settings -->
        <TextBlock Grid.Row="0" Text="DeepSeek API 设置" FontWeight="Bold" FontSize="14" Foreground="#1976D2" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="API Key:" Width="90" VerticalAlignment="Center" Foreground="#546E7A"/>
            <PasswordBox x:Name="ApiKeyBox" Width="300" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#E0E0E0"/>
            <Button x:Name="ToggleApiKeyVisibility" Content="显示" Width="50" Height="26" Margin="5,0,0,0"
                    Click="ToggleApiKeyVisibility_Click" FontSize="10" Cursor="Hand"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="API 地址:" Width="90" VerticalAlignment="Center" Foreground="#546E7A"/>
            <TextBox x:Name="BaseUrlBox" Width="360" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#E0E0E0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="模型:" Width="90" VerticalAlignment="Center" Foreground="#546E7A"/>
            <TextBox x:Name="ModelBox" Width="270" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#E0E0E0"/>
            <Button Content="测试连接" Width="75" Height="26" Margin="5,0,0,0" Click="TestConnection_Click"
                    Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
        </StackPanel>

        <TextBlock x:Name="ResultText" Grid.Row="4" Text="" FontSize="11" Margin="90,0,0,5"/>

        <!-- Separator -->
        <Separator Grid.Row="5" Margin="0,5,0,10" Background="#E0E0E0"/>

        <!-- AutoCAD Configuration -->
        <TextBlock Grid.Row="6" Text="AutoCAD 配置（精确回写模式需要）" FontWeight="Bold" FontSize="14" Foreground="#1976D2" Margin="0,0,0,10"/>

        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="安装路径:" VerticalAlignment="Center" Foreground="#546E7A"/>
            <TextBox x:Name="AutoCadPathBox" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,5,0" BorderBrush="#E0E0E0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="浏览" Width="50" Height="26" Margin="0,0,3,0" Click="BrowseAutoCad_Click" Cursor="Hand" FontSize="11"/>
                <Button Content="自动检测" Width="70" Height="26" Click="DetectAutoCad_Click" Cursor="Hand" FontSize="11"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="插件路径:" VerticalAlignment="Center" Foreground="#546E7A"/>
            <TextBox x:Name="CadPluginPathBox" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,5,0" BorderBrush="#E0E0E0"/>
            <Button Grid.Column="2" Content="浏览" Width="50" Height="26" Click="BrowseCadPlugin_Click" Cursor="Hand" FontSize="11"/>
        </Grid>

        <TextBlock x:Name="AutoCadStatusText" Grid.Row="9" Text="" FontSize="11" Margin="90,0,0,5"
                   Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <!-- Footer -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="80" Height="32" Margin="0,0,10,0" Click="Save_Click"
                    Background="#1976D2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="80" Height="32" Click="Cancel_Click"
                    Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
