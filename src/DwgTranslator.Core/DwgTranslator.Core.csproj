<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems Condition="'$(TargetFramework)' == 'net48'">false</EnableDefaultCompileItems>
    <RootNamespace>DwgTranslator.Core</RootNamespace>
    <!-- This product is Windows-only; registry and DPAPI calls are intentional. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!--
    This is a shared, feature-organized Core assembly, not a pure Domain project.
    ACadSharp/ClosedXML and storage/networking code are retained here for compatibility.
    CommunityToolkit.Mvvm supplies observable models; it does not require WPF/WinForms.
    Keep Core independent of App and UI types. The net48 CAD subset below intentionally
    excludes the desktop infrastructure stack. Do not split assemblies or change model
    identity solely to match directory names; preserve CAD and serialization contracts.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Compatibility\TextEntity.NetFramework.cs" />
    <!-- Direct provider clients and bundled prompt loaders exist only for legacy debug tests.
         Production binaries are Worker-only and must not expose provider plumbing or prompts. -->
    <Compile Remove="Api\DirectApiClient.cs" Condition="'$(Configuration)' == 'Release'" />
    <Compile Remove="Application\Translation\SettingsBackedDeepSeekClient.cs" Condition="'$(Configuration)' == 'Release'" />
    <Compile Remove="Application\Translation\TranslationPrompt.cs" Condition="'$(Configuration)' == 'Release'" />
    <Compile Remove="Infrastructure\Api\DeepSeekClient.cs" Condition="'$(Configuration)' == 'Release'" />
    <Compile Remove="Infrastructure\Api\DeepSeekClientFactory.cs" Condition="'$(Configuration)' == 'Release'" />
    <PackageReference Include="ACadSharp" Version="3.6.12" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- The CLR 4.x CAD host only needs the writeback contract and layout helpers.
       Keeping this surface small avoids shipping the WPF app's offline DWG/Excel stack in-process. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Include="Compatibility\IsExternalInit.cs" />
    <Compile Include="Translation\CadUnicodeText.cs" />
    <Compile Include="Compatibility\TextEntity.NetFramework.cs" />
    <Compile Include="Models\CadWriteResult.cs" />
    <Compile Include="Models\WritebackOptions.cs" />
    <Compile Include="Infrastructure\Files\SafeFileCommit.cs" />
    <Compile Include="Models\AttributeTranslationPolicy.cs" />
    <Compile Include="Models\WritebackConstants.cs" />
    <Compile Include="Drawing\Layout\FontMapper.cs" />
    <Compile Include="Drawing\Layout\TextWidthEstimator.cs" />
    <Compile Include="Drawing\Layout\VerticalTextLayout.cs" />
    <Compile Include="Drawing\Layout\TextEnvelopeGeometry.cs" />
  </ItemGroup>
</Project>
