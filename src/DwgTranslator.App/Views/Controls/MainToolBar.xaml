<UserControl x:Class="DwgTranslator.App.Views.Controls.MainToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <UserControl.Resources>
        <!-- Icons inherit the button foreground, so a filled primary button gets a white icon and a
             tertiary button a muted one without a style per button. -->
        <Style x:Key="ToolIconFill" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="ToolIconStroke" TargetType="Path" BasedOn="{StaticResource ToolIconFill}">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- Compact menu used by the grouped buttons; the default WPF look is too heavy next to
             the flat toolbar buttons. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="12,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ═══ 文件 ═══ -->
                <Button Style="{StaticResource RibbonSecondaryButton}"
                        Margin="0,0,6,0"
                        Command="{Binding ImportDwgCommand}"
                        ToolTip="{conv:Localize TipImportDwg}"
                        AutomationProperties.Name="{conv:Localize TipImportDwg}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconFill}" Data="{StaticResource Icon.Import.Tray}"/>
                        <Path Style="{StaticResource ToolIconStroke}" Data="{StaticResource Icon.Import.Arrow}" Margin="-21,0,7,0"/>
                        <TextBlock Text="{conv:Localize BtnImportDwg}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource RibbonSecondaryButton}"
                        Margin="0,0,6,0"
                        Command="{Binding ExportDwgCommand}"
                        ToolTip="{conv:Localize TipExportDwg}"
                        AutomationProperties.Name="{conv:Localize TipExportDwg}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconFill}" Data="{StaticResource Icon.Export.Tray}"/>
                        <Path Style="{StaticResource ToolIconStroke}" Data="{StaticResource Icon.Export.Arrow}" Margin="-21,0,7,0"/>
                        <TextBlock Text="{conv:Localize BtnExportDwg}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CompactDangerButton}"
                        Margin="0,0,6,0"
                        Command="{Binding CancelExportCommand}"
                        ToolTip="{conv:Localize TipCancelExport}"
                        AutomationProperties.Name="{conv:Localize TipCancelExport}"
                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconFill}" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z"/>
                        <TextBlock Text="{conv:Localize BtnCancelExport}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource RibbonDivider}" Margin="9,2"/>

                <!-- ═══ 翻译（主操作）═══ -->
                <Button Style="{StaticResource RibbonPrimaryButton}"
                        Margin="0,0,6,0"
                        Command="{Binding TranslateCommand}"
                        ToolTip="{conv:Localize TipTranslate}"
                        AutomationProperties.Name="{conv:Localize TipTranslate}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconFill}" Data="{StaticResource Icon.Translate}"/>
                        <TextBlock Text="{conv:Localize BtnTranslate}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CompactDangerButton}"
                        Margin="0,0,6,0"
                        Command="{Binding CancelTranslateCommand}"
                        ToolTip="{conv:Localize TipStopTranslation}"
                        AutomationProperties.Name="{conv:Localize TipStopTranslation}"
                        Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconFill}" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z"/>
                        <TextBlock Text="{conv:Localize BtnStop}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource RibbonDivider}" Margin="9,2"/>

                <!-- ═══ 术语表（两个入口合成一个下拉）═══ -->
                <Button Style="{StaticResource RibbonTertiaryButton}"
                        Margin="0,0,6,0"
                        Click="MenuButton_Click"
                        ToolTip="{conv:Localize TipGlossary}"
                        AutomationProperties.Name="{conv:Localize TipGlossary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconStroke}" Data="{StaticResource Icon.Glossary}"/>
                        <TextBlock Text="{conv:Localize BtnGlossary}" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource ToolIconFill}" Data="{StaticResource Icon.Caret}"
                              Width="8" Height="5" Margin="7,1,0,0" Opacity="0.65"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{conv:Localize BtnGlossary}" Command="{Binding OpenGlossaryManagerCommand}"/>
                            <MenuItem Header="{conv:Localize BtnImportGlossary}" Command="{Binding ImportGlossaryCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- ═══ 列表审阅 ═══ -->
                <Button Style="{StaticResource RibbonTertiaryButton}"
                        Margin="0,0,6,0"
                        Command="{Binding MarkAllReviewedCommand}"
                        ToolTip="{conv:Localize TipMarkReviewed}"
                        AutomationProperties.Name="{conv:Localize TipMarkReviewed}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconStroke}" Data="{StaticResource Icon.Check}"
                              Stroke="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="{conv:Localize BtnMarkAllReviewed}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource RibbonTertiaryButton}"
                        Margin="0,0,6,0"
                        Command="{Binding RetryFailedCommand}"
                        ToolTip="{conv:Localize TipRetryFailed}"
                        AutomationProperties.Name="{conv:Localize TipRetryFailed}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconStroke}" Data="{StaticResource Icon.Refresh}"
                              Stroke="{DynamicResource Brush.Warning}"/>
                        <TextBlock Text="{conv:Localize BtnRetryFailed}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource RibbonTertiaryButton}"
                        Margin="0,0,6,0"
                        Command="{Binding ExportExcelCommand}"
                        ToolTip="{conv:Localize TipExportExcel}"
                        AutomationProperties.Name="{conv:Localize TipExportExcel}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIconStroke}" Data="{StaticResource Icon.Excel}"/>
                        <TextBlock Text="{conv:Localize BtnExportExcel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ═══ 低频操作收进"更多"，避免十几个按钮平铺没有主次 ═══ -->
            <Button Grid.Column="1"
                    Style="{StaticResource RibbonTertiaryButton}"
                    Click="MenuButton_Click"
                    ToolTip="更多命令"
                    AutomationProperties.Name="更多命令">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="更多" VerticalAlignment="Center"/>
                    <Path Style="{StaticResource ToolIconFill}" Data="{StaticResource Icon.Caret}"
                          Width="8" Height="5" Margin="7,1,0,0" Opacity="0.65"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="环境自检与安装…" Command="{Binding ShowEnvironmentCheckCommand}"
                                  InputGestureText="Ctrl+E"/>
                        <MenuItem Header="{conv:Localize BtnImportExcel}" Command="{Binding ImportExcelCommand}"/>
                        <MenuItem Header="{conv:Localize BtnLog}" Command="{Binding ToggleLogViewerCommand}"
                                  InputGestureText="Ctrl+L"/>
                        <MenuItem Header="{conv:Localize BtnHelp}" Command="{Binding ShowHelpCommand}"
                                  InputGestureText="F1"/>
                        <Separator/>
                        <MenuItem Header="{conv:Localize BtnClear}" Command="{Binding ClearAllCommand}"/>
                        <MenuItem Header="{conv:Localize BtnLicense}" Command="{Binding OpenLicenseDialogCommand}"
                                  Visibility="{Binding IsLicensingEnabled, Converter={StaticResource BoolToVis}}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
    </Border>
</UserControl>
