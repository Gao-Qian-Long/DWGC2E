<UserControl x:Class="DwgTranslator.App.Views.Pages.GlossaryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18,12,18,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="术语库" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="统一专业词汇，让译文保持一致。" Style="{StaticResource PageSubtitleStyle}" Margin="0,1,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="导入术语" Command="{Binding ImportGlossaryCommand}" Style="{StaticResource Button.Secondary}" Padding="12,5" Margin="0,0,6,0" ToolTip="导入 JSON、CSV 或 Excel 术语文件"/>
    <Button Content="管理术语" Command="{Binding OpenGlossaryManagerCommand}" Style="{StaticResource Button.Primary}" Padding="12,5" ToolTip="新增、编辑、删除和处理术语冲突"/>
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Style="{StaticResource Card.Inset}" Padding="12,6" Margin="0,0,0,8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
     <TextBlock Text="全部术语" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding GlossaryEntryCount}" Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" Margin="7,0,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceSubtle}" CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal"><TextBlock Text="待确认冲突" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding GlossaryConflictPendingCount}" Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel>
    </Border>
    <TextBlock Grid.Column="3" Text="匹配顺序：用户术语  ›  企业术语  ›  系统术语  ›  AI 默认" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <Border Grid.Row="2" Style="{StaticResource CardNoPad}" Clip="{x:Null}">
   <DataGrid ItemsSource="{Binding GlossaryEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="True" SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0" RowHeight="34" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Brush.BorderLight}" AlternationCount="2" Background="Transparent" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle}">
    <DataGrid.RowStyle>
     <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Style.Triggers>
       <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="#FAFBFD"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5FF"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F0FF"/></Trigger>
      </Style.Triggers>
     </Style>
    </DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTextColumn Header="原文" Binding="{Binding Source}" Width="2.4*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="译文" Binding="{Binding Target}" Width="2.4*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="1.25*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="1.05*" ElementStyle="{StaticResource WrapCellStyle}"/>
     <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="82" ElementStyle="{StaticResource CenteredCellStyle}"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>

  <TextBlock Grid.Row="3" Text="术语只在 Windows 客户端中参与翻译，不会把术语内容上传到官网。" Style="{StaticResource CaptionStyle}" Margin="2,8,0,0"/>
 </Grid>
</UserControl>

