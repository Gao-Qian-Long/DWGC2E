<UserControl x:Class="DwgTranslator.App.Views.Controls.FilterStatsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,1,0,0" Padding="14,8">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource MetricCard}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MetricLabel}" Text="全部"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding TotalCount}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Background="{DynamicResource Brush.SuccessLight}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource MetricLabel}" Text="已完成"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding TranslatedCount}" Foreground="{DynamicResource Brush.Success}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" Background="{DynamicResource Brush.DangerLight}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Danger}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource MetricLabel}" Text="失败"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding FailedCount}" Foreground="{DynamicResource Brush.Danger}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MetricLabel}" Text="术语命中"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding GlossaryHitCount}" Foreground="{DynamicResource Brush.Primary}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MetricLabel}" Text="缓存"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding CacheHitCount}"/></StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Width="270" Height="34" Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                    <Grid>
                        <Path Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.3"/>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="32,0,30,0" FontSize="12" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                        <TextBlock Text="搜索原文、译文或类型" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextDisabled}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <Button x:Name="ClearSearchButton" Click="ClearSearch_Click" Width="22" Height="22" HorizontalAlignment="Right" Margin="0,0,5,0" Background="Transparent" BorderThickness="0" ToolTip="清除搜索"><Path Data="{StaticResource Icon.Close}" Width="9" Height="9" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"/></Button>
                    </Grid>
                </Border>
                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterStatusText, UpdateSourceTrigger=PropertyChanged}" Width="112" Height="34" Padding="8,0" FontSize="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
