<UserControl x:Class="DwgTranslator.App.Views.Pages.BatchTasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
<StackPanel>
            <controls:PageHeader x:Name="WorkspaceHeader" Header="任务中心" WaveVariant="2" Description="所有翻译任务的进度与结果都在这里；点「查看详情」可直接导出该图纸，需要复核时再进入校对。" />
            <Border x:Name="RecoveryNotice" Visibility="{Binding HasTaskRecoveryWarning, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.WarningLight}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="{DynamicResource Spacing.StackWide}" AutomationProperties.Name="任务恢复警告">
                <TextBlock Text="{Binding TaskRecoveryWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <!-- 未完成任务（2026-09-22 用户反馈「软件打开时不要跳出未完成弹窗」）：
                 启动不再弹模态框，改由导航红点和这张卡片呈现，续跑与清除都在这里由用户主动选择。 -->
            <Border x:Name="PendingTasksCard" Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.WarningLight}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="{DynamicResource Spacing.StackWide}" AutomationProperties.Name="未完成任务">
                <StackPanel>
                    <TextBlock Text="{Binding PendingTasksNotice}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="继续处理会接着上次的进度跑；清除只删除任务记录，不会删除图纸文件，也不影响已完成或已取消的历史。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}" />
                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.BlockTop}">
                        <Button x:Name="ResumePendingTasksButton" Content="继续处理" Command="{Binding ResumePendingTasksCommand}" Style="{StaticResource Button.Primary}" />
                        <Button x:Name="ClearPendingTasksButton" Content="清除未完成记录" Command="{Binding ClearPendingTasksCommand}" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.LeftGap}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="1" Visibility="{Binding IsProofreading, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 用户批注（2026-09-21）：「不要改变左边的布局 从右到左弹出来就行了」——抽屉改为纯覆盖层，
                 不再保留任何让位列：左侧统计条/筛选卡/表格在抽屉打开时宽度、位置一律不变，
                 抽屉以 Panel.ZIndex=10 悬浮于页面之上（DrawerFocusBehavior 负责焦点圈定）。
                 原让位 Border（宽度 0↔Size.Drawer 的占位格）已整体删除。 -->
            <Border Grid.Row="0" x:Name="BatchSummaryBar" Style="{StaticResource Section.Surface}"
                    Margin="{DynamicResource Spacing.Stack}" Padding="14,10" AutomationProperties.Name="任务阶段摘要">
                <!-- 每格内容居中：用户标了「都没居中」「没对齐」。UniformGrid 已经把七格等分，
                     再给每格挂右外边距只会让文字整体偏左，看上去就像没对齐。 -->
                <UniformGrid x:Name="BatchSummaryMetrics" Rows="1" Columns="7">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="全部" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchTotalCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="运行中" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchActiveCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="待处理" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchPendingCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- “待校对”改叫“未校对”（2026-09-22）：它是可选的校对进度，不是导出前必须清掉的关卡。 -->
                        <TextBlock Text="未校对" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchReviewCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="待导出" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchPendingExportCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="已导出" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchExportedCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="失败" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BatchFailedCount}" Style="{StaticResource InfoValueStrong}" HorizontalAlignment="Center" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Section.Surface}" Margin="{DynamicResource Spacing.Stack}" Padding="16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" AutomationProperties.Name="任务筛选">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- ⑦ 筛选下拉列宽（2026-10-02）：126/116 时「全部阶段/全部时间」四字被下拉箭头截掉右缘。
                                 闭合框开销 = 内边距 10 + 条目内边距 10 + 箭头列 28 + 边框 2 ≈ 50，四字 13px ≈ 56，
                                 再加两侧 Spacing.Inline 外边距，132/130 才放得下。 -->
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Search.Input}" Tag="搜索图纸名称"
                                 Text="{Binding BatchSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按图纸文件名搜索" AutomationProperties.Name="搜索任务" Margin="{DynamicResource Spacing.Inline}" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding BatchStatusFilter}" Margin="{DynamicResource Spacing.Inline}"
                                  AutomationProperties.Name="任务阶段">
                            <ComboBoxItem Content="全部阶段" />
                            <ComboBoxItem Content="运行中" />
                            <ComboBoxItem Content="待处理" />
                            <ComboBoxItem Content="未校对" />
                            <ComboBoxItem Content="待导出" />
                            <ComboBoxItem Content="已导出" />
                            <ComboBoxItem Content="失败" />
                            <ComboBoxItem Content="已暂停" />
                            <ComboBoxItem Content="已取消" />
                            <ComboBoxItem Content="已跳过" />
                        </ComboBox>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding BatchDateFilter}" Margin="{DynamicResource Spacing.Inline}"
                                  AutomationProperties.Name="最近更新时间">
                            <ComboBoxItem Content="全部时间" />
                            <ComboBoxItem Content="今天" />
                            <ComboBoxItem Content="最近七天" />
                        </ComboBox>
                        <Button Grid.Column="3" Content="重试失败" IsEnabled="{Binding HasFailedDrawingTasks}"
                                Command="{Binding RetryFailedCommand}" Style="{StaticResource Button.Secondary}"
                                MinWidth="94" Margin="{DynamicResource Spacing.Inline}" ToolTip="仅重试失败或部分失败的图纸" />
                        <Button Grid.Column="4" Content="停止队列" Command="{Binding CancelTranslateCommand}"
                                Style="{StaticResource Button.Danger}" MinWidth="94"
                                Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="{DynamicResource Spacing.BlockTop}" AutomationProperties.Name="翻译项目操作">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="翻译项目" FontWeight="SemiBold" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}" />
                        <TextBox Grid.Column="1" Style="{StaticResource Search.Input}" Tag="搜索项目"
                                 Text="{Binding ProjectSearch, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="搜索翻译项目" Margin="{DynamicResource Spacing.Inline}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding TranslationProjects}"
                                  SelectedItem="{Binding SelectedTranslationProject}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="历史翻译项目" Margin="{DynamicResource Spacing.Inline}" />
                        <Button Grid.Column="3" Content="打开项目" Command="{Binding OpenTranslationProjectCommand}"
                                CommandParameter="{Binding SelectedTranslationProject}" Style="{StaticResource Button.Secondary}" />
                        <TextBlock Grid.Column="5" Text="项目名称" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTranslationProject}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="6" Tag="当前项目名称" Text="{Binding ProjectRenameName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="项目名称" Margin="{DynamicResource Spacing.Inline}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTranslationProject}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="7" Content="重命名" Command="{Binding RenameSelectedProjectCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Tertiary}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTranslationProject}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- F11a/f 列表装进与上方统计条(:42)、筛选卡(:78)完全同一套 Section.Surface 语言的白卡：
                 Brush.Surface 白底 + 1px Brush.Border 浅棕细边框 + CornerRadius.Medium 圆角令牌 + Shadow.Hard，
                 四边外框闭合，底边与右侧不再悬空 —— 用户批注「这个列表的样式很奇怪啊，不能统一一下吗？」。
                 F11b 表头其实早就有底色与字重区分（DataGridHeaderStyle，MainWindowStyles.xaml:304-315：
                 Brush.DataGridHeader #F7F5F0 + FontFamily.Mono + SemiBold + FontSize.TableHeader +
                 底部 1px Brush.Border 分隔线）；缺的不是表头样式，而是这张白卡 —— 装上卡之后表头底色
                 才第一次落在白底之上，读出「表头」而不是「一条悬空的灰带」。
                 Padding 必须显式归零：Section.Surface 默认 Padding=Spacing.Card(20)，两侧就吃掉 40 DIP；
                 本表最小列宽合计 990 DIP，而 1280 宽下可用只有 1004 DIP
                 （1280 - 侧栏 200 - Spacing.Page 左右 64 - 卡片边框 2 - 纵向滚动条 10，
                 滚动条宽 10 见 MainWindowStyles.xaml:668），星号列会跌破 MinWidth 240、操作列被挤出表外，
                 直接踩红 RefinementSmoke.cs:206（操作表头右缘必须落在表宽内）。
                 Border 不会把子元素裁成圆角，但半径只有 2 DIP；TranslatePage 左侧队列卡(:172)
                 早已是「Section.Surface + Padding=0 包 DataGrid」的同款做法。
                 EmptyState 一并留在卡内：空态与列表共用同一张白卡，风格不再割裂。 -->
            <Border Grid.Row="2" Style="{StaticResource Section.Surface}" Padding="0">
            <Grid>
                <!-- F11c 行高：原先 RowHeight 锁死 Size.TableRow(40)，行内只有单行文本，比上方筛选卡
                 （Padding 16,10 + 36 高控件）紧一档，这也是「列表和上面不像一套」的一部分。
                 §W1-D3 修正（运行时取证推翻只写 MinRowHeight 的做法）：
                 本表 DataGrid 从 MainWindowStyles.xaml:398-401 的隐式 DataGrid 样式继承
                 RowHeight=Size.TableRow(40)。WPF 里显式 RowHeight 一旦有值就定死行高，
                 此时再设 MinRowHeight=48 只会抬高**单元格**，行本身仍是 40 ——
                 实测 DataGridRow=40.0/DataGridCell=48.0/查看详情按钮=36.0 且按钮纵向跨
                 y 402.3..438.3 而行底在 437.1，按钮下缘越出行界约 1.1 DIP，
                 被后绘制的下一行覆盖（row.ClipToBounds=False，不是被自身裁剪）——
                 这就是用户批注的「下部分被截断了」。
                 改法：RowHeight="NaN" 让行高回到「由内容决定」（DataGrid.RowHeight 是 double，
                 其默认值 NaN 即自动；不能写 "Auto"——那是 GridLength 的语法，会抛
                 ArgumentException: Auto is not a valid value for Double），MinRowHeight=48 继续给下限，
                 二者都保留原注释「给下限而不锁死」的意图；此时行会按内容撑满，
                 36 高按钮 + 单元格内边距 12,4 完全落在行内。
                 48 没有对应的 Double 令牌（Metrics.xaml 只有 Size.TableRow=40；Spacing.48 是 Thickness，
                 不能赋给 RowHeight/MinRowHeight），而 Metrics.xaml 不在本任务允许改动的文件清单内，
                 故此处继续用字面量；日后若要令牌化，建议加 Size.TableRowComfortable=48 再替换本值。 -->
                <DataGrid x:Name="TaskTable" ItemsSource="{Binding BatchView}" SelectedItem="{Binding SelectedBatchTask}"
                          SelectionMode="Single" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="True"
                          IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column"
                          RowHeight="NaN" MinRowHeight="48" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}" EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True" AutomationProperties.Name="任务列表">
                    <!-- §W1-D3 真正的行高杠杆：本表从 MainWindowStyles.xaml:419 继承 RowStyle=TranslationRowStyle，
                         而该样式 :381 自己写了 Setter Height=Size.TableRow(40)。行样式上的显式 Height 优先于
                         DataGrid.RowHeight / MinRowHeight —— 实测把 grid.RowHeight 设 48、把 MinRowHeight 设 90，
                         行仍恒为 40.0（row MinHeight 始终 0.0），但单元格已被抬到 48.0，
                         于是 36 高的「查看详情」按钮(纵向 y 402.3..438.3)下缘越出行底(437.1)约 1.1 DIP，
                         被后绘制的下一行盖住 —— 用户看到的「下部分被截断了」。
                         故只在本页把行样式派生一份：Height=NaN(自动) + MinHeight=48，
                         与其它表格共用 TranslationRowStyle 的配色/字号不变，影响范围仅限任务中心这张表。 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource TranslationRowStyle}">
                            <Setter Property="Height" Value="NaN" />
                            <Setter Property="MinHeight" Value="48" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- F11d 列宽重分配。用户批注：「任务/图纸」过宽、「最近更新」过窄导致时间被截成 2026-09-20 14:2…。
                     像素取证（用户截图 1950x1119 @150%，1 DIP=1.5px；比例由「查看详情」按钮实测 112px
                     = Button.Compact.Secondary 的 4×13+Padding 10×2+边框 2 = 74 DIP 反推确认）：
                     最近更新列的内容框 = x 1548..1725，日期文本暗像素实测跨 x 1552..1721 ——
                     只剩 4px(2.7 DIP) 余量；字形分组数 10 + 空格 + 5 恰好等于完整的 "2026-09-20 14:25"，
                     说明这张截图上尚未真截断，但已经贴边：窗口再窄一点、字体回退或系统字号放大就会裁掉末位。
                     故 142→152（内容框 128 DIP=192px，对 170px 文本留 22px 余量）。
                     「阶段」116→104：最长文案 4 个汉字（DrawingFileItem.cs:124 WorkflowStatusText 可返回
                     「导入失败」「部分失败」，其回落的 StatusText 另有「提取文本」「排版优化」），
                     4×14 + 状态点 7 + Spacing.Inline 8 + 单元格内边距 24 = 95，104 留 9 DIP；
                     TranslatePage.xaml:261 同一绑定、同一单元格结构早已用 104 且冒烟常绿，是现成先例。
                     「进度」128→122：内容框 98 = 进度条 60 + 文本列 38（等宽 12px "100%"≈29 + LeftGap 8）。
                     「操作」106→118：F11e 换成 Button.Secondary 后需 4×14 + Padding 16×2 + 边框 2 = 90，
                     加单元格内边距 24 = 114，118 留 4 DIP。
                     「结果」260→254：:229 记录最坏文案实测 226，加内边距 24 = 250，254 留 4 DIP，
                     且该列本就有 CharacterEllipsis + ToolTip 兜底。
                     固定列合计 752→750，比改前小 2；表最小总宽 992→990，星号列在 1280 下反而多 2 DIP 余量，
                     RefinementSmoke.cs:206 的安全边际只增不减。 -->
                        <!-- 用户批注（2026-09-22）：「左边的文件名没必要占用那么大宽度」，两张表要一致。
                                     原来这是本表唯一的星号列，最大化下能吃掉 1100+ DIP，把阶段/结果/进度/操作
                                     全挤到中间偏右，中间留一大片空。
                                     取 240 = 它原先的 MinWidth：**最小宽度下的列总和不增一分**，
                                     所以 RefinementSmoke 里"1280 下操作表头不出界"的安全边际原样保留；
                                     富余宽度改落到表尾的空白星号列（见 DataGrid.Columns 末尾）。 -->
                        <DataGridTemplateColumn Header="任务 / 图纸" Width="240" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="阶段" Width="104" SortMemberPath="WorkflowStatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="{DynamicResource Spacing.Inline}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                        <!-- "待校对"这条触发器已删除：WorkflowStatusText 不再产出该值（2026-09-22 校对降级为可选）。 -->
                                                        <DataTrigger Binding="{Binding WorkflowStatusText}" Value="待导出"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding WorkflowStatusText}" Value="已导出"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding WorkflowStatusText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- §L3 "已译 1,234/5,678 · 失败 12" 实测约 226px，原 168 会把失败段静默裁掉 -->
                        <DataGridTextColumn Header="结果" Binding="{Binding BatchResultText}" Width="254">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding BatchResultText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="进度" Width="122" SortMemberPath="ProgressPercent">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Height="4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     VerticalAlignment="Center" Foreground="{DynamicResource Brush.Amber}"
                                                     Background="{DynamicResource Brush.BackgroundAlt}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="12"
                                                   Margin="{DynamicResource Spacing.LeftGap}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- F11d 152 宽完整显示 yyyy-MM-dd HH:mm（DrawingFileItem.cs:304-307 的格式串本来就是 16 字符，
                             只是列宽不够）。F11 样式统一：本列原先是全表唯一没有 ElementStyle 的文本列，
                             于是既不垂直居中、也没有省略号与 ToolTip，和「结果」列明显是两套；补齐成同款。 -->
                        <DataGridTextColumn Header="最近更新" Binding="{Binding LastUpdatedText}" Width="152">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
