<Window x:Class="DwgTranslator.App.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Title="{conv:Localize HelpTitle}" Height="850" Width="780"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
    <Window.Resources>
        <!-- Tab item style -->
        <Style x:Key="HelpTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E0E0E0" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Margin="2,0,2,0"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Body text style -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <!-- Step number badge -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Tip card style -->
        <Style x:Key="TipCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{conv:Localize HelpTitle}" FontWeight="Bold" FontSize="20" Foreground="#1976D2"/>
            <TextBlock FontSize="12" Foreground="#78909C" Margin="0,4,0,0">
                <Run Text="{conv:Localize HelpVersion}"/>
            </TextBlock>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource HelpTabItem}"
                    Background="Transparent" BorderThickness="0">

            <!-- ==================== Tab 1: Quick Start ==================== -->
            <TabItem Header="{conv:Localize HelpTabQuickStart}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
                    <StackPanel>
                        <!-- What is DWG Translator -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="DWG Translator 是什么？"/>
                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="DWG Translator 是一款图纸翻译工具，能够自动识别 DWG 格式图纸中的文字内容，并利用 AI 技术进行中文与英文之间的互译。翻译完成后，译文会自动写回原图纸，保持排版整洁。&#x0a;&#x0a;您不需要懂任何代码，只需按照以下 4 个步骤操作即可完成翻译。"/>
                        </Border>

                        <!-- Step 1 -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="四步完成翻译"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Step 1 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="导入 DWG 文件" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,3"/>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="点击工具栏上的「导入 DWG」按钮，在弹出的文件选择窗口中找到您的 DWG 图纸文件，可以一次选择多个文件。导入后，程序会自动读取图纸中所有文字内容并显示在列表中。"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Step 2 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="选择翻译方向并开始翻译" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,3"/>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="点击 &#x21C4; 按钮选择翻译方向：中文翻译成英文，或英文翻译成中文。然后点击「翻译」按钮，程序会自动调用 AI 进行翻译。翻译过程中可以看到进度条和实时状态。"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Step 3 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="检查和修改译文" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,3"/>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="翻译完成后，您可以直接在列表中双击译文进行修改。如果需要批量校对，可以点击「导出 Excel」将译文导出为 Excel 文件，在 Excel 中修改后再通过「导入 Excel」将修改后的译文导入回来。"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Step 4 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="导出翻译后的图纸" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,3"/>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="确认译文无误后，点击「导出 DWG」按钮。程序会弹出导出模式选择窗口，您可以选择「AutoCAD 精确回写」或「离线回写」模式。导出完成后，翻译后的图纸会保存在您指定的位置。"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- First time setup tip -->
                        <Border Background="#E8F5E9" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="&#x2705; 首次使用提示" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="首次使用前，请先点击工具栏的「设置」按钮，在「DeepSeek API 设置」中填入您的 API Key。如果选择 AutoCAD 精确回写模式，还需要在「AutoCAD 配置」中设置 AutoCAD 的安装路径和插件路径。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Tab 2: Features ==================== -->
            <TabItem Header="{conv:Localize HelpTabFeatures}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
                    <StackPanel>
                        <!-- Import DWG -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="导入 DWG"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击「导入 DWG」按钮，选择一个或多个 DWG 格式的图纸文件。程序会自动扫描图纸中的所有文字实体（包括单行文字、多行文字、属性文字等），并以表格形式展示。"/>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="#1565C0">
                                        <Run FontWeight="Bold">提示：</Run>导入的文件必须是 .dwg 格式。如果您有 .dxf 格式的文件，需要先在 AutoCAD 中另存为 .dwg 格式。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Translation -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="AI 翻译"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="程序使用 DeepSeek AI 模型进行翻译，支持中英互译。翻译采用 5 路并发方式，速度约为逐条翻译的 5 倍。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="翻译方向切换："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击工具栏上的 &#x21C4; 按钮，可以在「中文 → 英文」和「英文 → 中文」之间切换。切换后状态栏会显示当前翻译方向。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="智能去重："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="如果图纸中有大量重复文字，程序会自动去重，相同内容只翻译一次，然后将译文应用到所有相同文本上，既节省时间又节省 API 费用。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="停止翻译："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="翻译过程中，「翻译」按钮会变成红色的「停止」按钮，点击可以随时中断翻译。已完成的翻译结果会保留。"/>
                            </StackPanel>
                        </Border>

                        <!-- Glossary -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="术语库"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="术语库用于确保专业术语的翻译一致性。例如，您可以将「轴承」固定翻译为「Bearing」，这样在所有翻译中都会使用这个统一的译法。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="管理术语库："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击工具栏的「术语库」按钮，打开术语库管理窗口。您可以直接在表格中添加、修改或删除术语条目。每条术语包含「源语言」「目标语言」和「分类」三个字段。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="导入术语："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击「导入术语」按钮，可以从外部 JSON 文件导入术语库。程序自带机械工程领域的术语库，您也可以自行创建。"/>
                                <Border Background="#FFFDE7" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="#E65100">
                                        <Run FontWeight="Bold">术语匹配标记：</Run>翻译时如果某条文本命中了术语库，列表中该行的「术语」列会显示绿色勾号，行背景会变为浅黄色。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Excel import/export -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Excel 导出/导入"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="对于大量文本的校对工作，直接在 Excel 中修改会更加方便。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="导出 Excel："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击「导出 Excel」按钮，将当前列表中的所有文本（包括原文和译文）导出为 Excel 文件。您可以在 Excel 中修改译文列的内容。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#37474F" Text="导入 Excel："/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="在 Excel 中修改完译文后，点击「导入 Excel」按钮，选择修改后的 Excel 文件。程序会自动将修改后的译文更新到列表中。"/>
                            </StackPanel>
                        </Border>

                        <!-- Export DWG - Writeback Modes -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="导出 DWG（回写模式）"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击「导出 DWG」后，程序会弹出模式选择窗口，提供两种回写方式："/>

                                <!-- AutoCAD mode -->
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="12,8" Margin="0,10,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="&#x1F3AF;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="AutoCAD 精确回写（推荐）" FontWeight="Bold" Foreground="#2E7D32" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="通过 COM 接口控制正在运行的 AutoCAD 进程，在 AutoCAD 内部完成精确的文字替换。支持图框检测、几何碰撞避免、智能宽度调整和自动缩放排版。效果最佳，但需要 AutoCAD 处于运行状态。"/>
                                        <Border Background="#FFF3E0" CornerRadius="4" Padding="8,4" Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource BodyText}" Foreground="#E65100" FontWeight="Bold">
                                                <Run Text="&#x26A0; 使用前必须先启动 AutoCAD！"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Offline mode -->
                                <Border Background="#FFF3E0" CornerRadius="6" Padding="12,8" Margin="0,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="&#x1F4BE;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="离线回写" FontWeight="Bold" Foreground="#E65100" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="使用 ACadSharp 库直接修改 DWG 文件，不需要安装 AutoCAD。包含智能宽度和字高缩放功能，但无法进行碰撞检测。适用于没有安装 AutoCAD 的电脑，排版结果可能需要在 AutoCAD 中手动微调。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Text Layout Optimization -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="文字排版优化"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="DWG Translator v2.1 对文字排版进行了全面优化，确保翻译后的图纸整洁美观："/>
                                <StackPanel Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="固定宽度 MText：翻译后自动调整矩形宽度，防止单词间距过大"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="自由宽度 MText：保守设置宽度，保持紧凑排列"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="碰撞检测（AutoCAD 模式）：自动检测翻译后文字与线条/图形的干涉，缩小字高避免重叠"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="图框约束（AutoCAD 模式）：在图框内自动寻找最佳字高，防止文字溢出图框边界"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Filter & Search -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="筛选与搜索"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="当图纸包含大量文字时，可以使用筛选和搜索功能快速定位："/>
                                <StackPanel Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">状态筛选：</Run>使用下拉菜单筛选显示「全部」「待翻译」「已翻译」「翻译失败」「已审阅」「术语命中」「已跳过」等状态的条目
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">关键词搜索：</Run>在搜索框中输入关键词，点击「查找」可以在原文、译文和类型中搜索
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">列排序：</Run>点击表格列标题可以按该列排序（升序/降序切换）
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Status Bar & Stats -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="状态栏与统计信息"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="窗口顶部第二行和底部状态栏显示实时统计信息，帮助您掌握翻译进度："/>
                                <StackPanel Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">总数：</Run>导入的文本实体总数
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">已翻译：</Run>成功翻译的条目数
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">失败：</Run>翻译失败的条目数（可使用「重试失败」按钮重新翻译）
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">术语：</Run>命中术语库的条目数
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">缓存：</Run>命中翻译缓存的条目数（无需再次调用 API）
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run FontWeight="SemiBold" Foreground="#37474F">显示：</Run>当前筛选条件下可见的条目数
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Window Pin -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="窗口置顶"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="点击标题栏左侧的图钉按钮，可以将 DWG Translator 窗口固定在所有窗口的最前面。"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                           Text="这在同时使用 AutoCAD 和 DWG Translator 时特别有用：您可以一边在 AutoCAD 中查看图纸，一边在 DWG Translator 中翻译和编辑文字，无需频繁切换窗口。"/>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="#1565C0">
                                        <Run FontWeight="Bold">提示：</Run>图钉按钮变为橙色时表示窗口已置顶，再次点击可取消置顶。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Review & Retry -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="审阅与重试"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">全部审阅：</Run>点击「全部审阅」按钮，将所有已翻译的条目标记为「已审阅」状态（行变为深绿色）
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="&#x2022; " Foreground="#1976D2" FontWeight="Bold"/>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">重试失败：</Run>点击「重试失败」按钮，重新翻译所有标记为「翻译失败」的条目
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Log Viewer -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="日志查看器"/>
                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="点击工具栏的「日志」按钮，可以在窗口底部展开日志查看面板。日志记录了程序运行的详细信息，包括翻译进度、API 调用、错误信息等。如果遇到问题，可以将日志复制后发给技术支持人员协助排查。&#x0a;&#x0a;日志面板支持按级别筛选（INFO/WARN/ERROR）、关键词搜索、自动滚动、复制到剪贴板等功能。"/>
                        </Border>

                        <!-- Tips & Tricks -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="实用技巧"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" MinWidth="60" HorizontalAlignment="Left">
                                        <TextBlock Text="技巧 1" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">先测试再批量：</Run>处理重要图纸时，建议先用一张图纸测试翻译和导出效果，确认满意后再批量处理其他图纸。
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" MinWidth="60" HorizontalAlignment="Left">
                                        <TextBlock Text="技巧 2" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">善用术语库：</Run>如果您经常翻译同类图纸（如机械图纸），建议先建立术语库，确保「轴承」「阀门」等专业词汇的翻译一致。
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" MinWidth="60" HorizontalAlignment="Left">
                                        <TextBlock Text="技巧 3" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">Excel 校对工作流：</Run>对于大批量文字，导出 Excel 后在 Excel 中使用查找替换、筛选等功能批量校对效率更高，修改完成后再导入回程序。
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" MinWidth="60" HorizontalAlignment="Left">
                                        <TextBlock Text="技巧 4" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">利用缓存省钱：</Run>翻译缓存会自动保存已翻译的内容。重新翻译相同文本时会直接使用缓存，不消耗 API 费用。状态栏的「缓存」数字越高说明省的钱越多。
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" MinWidth="60" HorizontalAlignment="Left">
                                        <TextBlock Text="技巧 5" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run FontWeight="SemiBold" Foreground="#37474F">分批处理大文件：</Run>如果图纸文件非常大（超过 500 个文字实体），建议分批导入翻译，避免程序长时间占用或网络超时。
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Tab 3: FAQ ==================== -->
            <TabItem Header="{conv:Localize HelpTabFAQ}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="常见问题解答"/>

                        <!-- FAQ 1 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 首次使用需要做什么准备？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 首次使用前，请点击工具栏的「设置」按钮，完成以下配置：&#x0a;1. 在「DeepSeek API 设置」中填入您的 API Key（这是翻译功能必需的）&#x0a;2. 如果需要使用 AutoCAD 精确回写模式，在「AutoCAD 配置」中设置 AutoCAD 安装路径&#x0a;3. 可选：点击「测试连接」按钮验证 API 是否正常工作"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 2 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 翻译后文字间距太大怎么办？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: v2.1 已优化固定宽度 MText 的处理逻辑，会自动缩小过宽的矩形宽度。如果仍有问题，可以在 AutoCAD 中手动调整 MText 的定义宽度，或者使用 AutoCAD 精确回写模式获得更好的排版效果。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 3 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 翻译后文字与线条重叠怎么办？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: AutoCAD 精确回写模式下，程序会自动检测碰撞并缩小字高。如果仍然重叠，说明空间确实不足，建议在 AutoCAD 中手动调整文字位置。离线回写模式暂不支持碰撞检测，建议优先使用 AutoCAD 模式。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 4 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 导出 DWG 时提示「找不到 DwgTranslator.Cad.dll」？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 请在「设置」→「AutoCAD 配置」→「插件路径」中指定 DwgTranslator.Cad.dll 的完整路径。可以点击「浏览」按钮选择文件，或点击「自动检测」让程序尝试自动查找。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 5 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: AutoCAD 弹出「是否加载来自非信任路径的程序集」？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 这是 AutoCAD 的安全提示，首次加载 .NET 插件时会出现。请按以下步骤操作："/>
                                <Border Background="#FFEBEE" CornerRadius="4" Padding="10,6" Margin="0,6,0,4">
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="#D32F2F" FontWeight="Bold">
                                        <Run Text="&#x26A0; 重要：该对话框可能在 AutoCAD 窗口后面！请点击任务栏的 AutoCAD 图标切换到 AutoCAD 窗口查看。"/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="1. 切换到 AutoCAD 窗口，找到安全提示对话框&#x0a;2. 点击「始终加载」(Always Load) 按钮&#x0a;3. 如果只点击「加载」(Load)，下次使用仍会弹出此对话框&#x0a;&#x0a;提示：DWG Translator 会在发送命令前弹窗提醒您注意此对话框。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 6 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 导出 DWG 时如何取消？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 导出过程中，工具栏会出现红色的「取消导出」按钮，点击即可取消。如果 AutoCAD 正在处理命令，取消可能需要等待当前操作完成。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 7 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 翻译速度很慢怎么办？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 翻译速度取决于：&#x0a;1. 文本数量：图纸中文字越多，翻译时间越长&#x0a;2. 网络速度：程序需要连接 DeepSeek API 服务器&#x0a;3. API 服务器负载：高峰期可能稍慢&#x0a;&#x0a;程序会自动去重，相同文本只翻译一次。如果文本量特别大，建议分批导入翻译。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 8 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 翻译结果不准确怎么办？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 您可以采取以下措施：&#x0a;1. 直接在列表中双击译文进行手动修改&#x0a;2. 使用术语库固定专业术语的翻译&#x0a;3. 导出 Excel 后批量校对，再导入回来&#x0a;4. 对于特定条目，可以点击「重试失败」重新翻译"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 9 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 什么是术语库？我需要使用吗？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 术语库是一个「词典」，告诉程序某些专业词汇应该如何翻译。例如，您可以规定「轴承」必须翻译为「Bearing」而不是其他译法。&#x0a;&#x0a;如果您对翻译一致性要求较高（如工程图纸），建议使用术语库。程序自带机械工程领域的术语库，您也可以自行添加。普通用户可以不使用术语库。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 10 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 如何切换界面语言？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 点击「设置」按钮，在「界面语言」部分选择您需要的语言，然后重启程序即可生效。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 11 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 体验版用完了怎么办？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 体验版提供 3 次免费翻译导出。用完后，您可以：&#x0a;1. 购买买断授权（¥699），永久使用当前大版本&#x0a;2. 选择订阅制（¥49/月 或 ¥399/年），持续获得更新和技术支持&#x0a;&#x0a;点击工具栏的「授权」按钮，输入激活码即可升级。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 12 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 可以翻译 DXF 格式的文件吗？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 导入时支持 .dwg 和 .dxf 格式。但导出时仅支持 .dwg 格式。如果您导入的是 .dxf 文件，导出时程序会自动保存为 .dwg 格式。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 13 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 切换翻译方向后，之前的译文还在吗？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 切换翻译方向时，程序会提示您确认。确认后，之前已翻译的条目会被重置为「待翻译」状态，需要重新翻译。如果您还需要之前的译文，建议先导出 Excel 保存一份备份。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 14 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 「清空」按钮会删除我的原始图纸吗？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 不会。「清空」按钮只会清除程序内部列表中的翻译数据，不会对您的原始 DWG 文件做任何修改。原始图纸始终安全。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 15 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 导入 Excel 时需要注意什么？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 导入的 Excel 文件必须包含「Handle」列，用于匹配原始文字。建议先通过「导出 Excel」生成模板，然后在模板基础上修改译文，再导入回来。不要修改 Handle 列的内容。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 16 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 程序支持哪些 AutoCAD 版本？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: AutoCAD 精确回写模式建议使用 AutoCAD 2018 及以上版本。AutoCAD LT 不支持此模式（因为不支持 .NET 插件加载）。如果您的 AutoCAD 版本较旧或使用 LT 版本，请选择「离线回写」模式。"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 17 -->
                        <Border Background="#FFF8E1" Style="{StaticResource TipCard}">
                            <StackPanel>
                                <TextBlock Text="Q: 翻译缓存会占用多少空间？如何清理？" FontWeight="Bold" Margin="0,0,0,4" FontSize="13" Foreground="#37474F"/>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="A: 翻译缓存文件很小，通常只有几百 KB 到几 MB，不会占用大量磁盘空间。缓存保存在程序的配置目录中。如果您想清理缓存，可以删除程序目录下的缓存文件，但这会导致之前翻译过的内容需要重新调用 API 翻译。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Tab 4: Troubleshooting ==================== -->
            <TabItem Header="{conv:Localize HelpTabTroubleshooting}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="常见问题排查"/>

                        <!-- Problem: API connection failed -->
                        <Border Background="White" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#x26A0;" FontSize="14" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="翻译失败：API 连接失败" FontWeight="Bold" FontSize="13" Foreground="#E53935"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Text="可能原因及解决方案："/>
                                <StackPanel Margin="10,4,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Text="1. API Key 未设置或填写错误 → 打开「设置」，检查 API Key 是否正确"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="2. 网络连接问题 → 检查电脑是否能正常上网"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="3. API 地址被修改 → 在设置中点击「测试连接」验证，必要时恢复默认地址"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="4. API 账户余额不足 → 登录 DeepSeek 官网检查账户余额"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Problem: AutoCAD not found -->
                        <Border Background="White" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#x26A0;" FontSize="14" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="导出失败：找不到 AutoCAD" FontWeight="Bold" FontSize="13" Foreground="#E53935"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Text="可能原因及解决方案："/>
                                <StackPanel Margin="10,4,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Text="1. AutoCAD 未启动 → 先启动 AutoCAD，再进行导出操作"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="2. AutoCAD 安装路径未配置 → 在「设置」→「AutoCAD 配置」中设置正确的安装路径"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="3. 使用了不兼容的 AutoCAD 版本 → 建议使用 AutoCAD 2018 及以上版本"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="4. 如果不需要 AutoCAD，可以选择「离线回写」模式"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Problem: CAD plugin load prompt -->
                        <Border Background="White" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#x26A0;" FontSize="14" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="AutoCAD 弹出安全警告对话框" FontWeight="Bold" FontSize="13" Foreground="#FF9800"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Text="这是正常现象，首次使用时 AutoCAD 会询问是否加载插件。"/>
                                <Border Background="#FFEBEE" CornerRadius="4" Padding="10,6" Margin="0,6,0,4">
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="#D32F2F" FontWeight="Bold">
                                        <Run Text="&#x26A0; 该对话框可能在 AutoCAD 窗口后面，看不到！请点击任务栏的 AutoCAD 图标切换过去。"/>
                                    </TextBlock>
