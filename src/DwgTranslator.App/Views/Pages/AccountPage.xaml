<UserControl x:Class="DwgTranslator.App.Views.Pages.AccountPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
 MinWidth="640">
 <UserControl.Resources><conv:BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid Margin="18,12,18,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,0,9">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="会员中心" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="账号、套餐与设备管理" Style="{StaticResource PageSubtitleStyle}" Margin="0,1,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
    <TextBlock Text="DWGC2E" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
   </Border>
  </Grid>

  <!-- 账号状态：页面只保留一个入口，避免登录卡片重复出现 -->
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="11,8" Margin="0,0,0,9">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.PrimarySoft}" VerticalAlignment="Center">
     <TextBlock Text="{Binding AccountAvatarText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding AccountDisplayNameText}" Style="{StaticResource CardTitleStyle}" FontSize="13"/>
     <TextBlock Text="{Binding AccountEmailText}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,1,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="登录账号" Command="{Binding LoginAccountCommand}" Style="{StaticResource Button.Primary}" Padding="12,4" Margin="0,0,4,0" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
     <Button Content="刷新" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Tertiary}" Padding="8,4" Margin="0,0,2,0" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolVisibility}}"/>
     <Button Content="退出" Command="{Binding LogoutAccountCommand}" Style="{StaticResource Button.Tertiary}" Padding="8,4" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,4,4">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="当前套餐" Style="{StaticResource CardTitleStyle}" FontSize="13"/>
     <TextBlock Grid.Row="1" Text="{Binding OnlinePlanText}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Text="{Binding OnlineQuotaText}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </Border>
   <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="4,0,0,4">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="当前设备" Style="{StaticResource CardTitleStyle}" FontSize="13"/>
     <TextBlock Grid.Row="1" Text="{Binding MachineName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Text="{Binding DeviceCountText}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </Border>
   <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,4,4,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="授权与服务" Style="{StaticResource CardTitleStyle}" FontSize="13"/>
     <TextBlock Grid.Row="1" Text="{Binding AccountSessionText}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Row="2" Content="打开设置" Command="{Binding NavigateToCommand}" CommandParameter="settings" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Padding="10,4" Margin="0,7,0,0"/>
    </Grid>
   </Border>
   <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="4,4,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="设备管理" Style="{StaticResource CardTitleStyle}" FontSize="13"/>
     <TextBlock Grid.Row="1" Text="查看已登录设备并管理授权" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Row="2" Content="环境检查" Command="{Binding ShowEnvironmentCheckCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Padding="10,4" Margin="0,7,0,0"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
