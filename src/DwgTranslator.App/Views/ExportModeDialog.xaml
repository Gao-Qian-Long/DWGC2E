<Window x:Class="DwgTranslator.App.Views.ExportModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Title="{conv:Localize ExportModeTitle}" Height="440" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{conv:Localize ExportModeSelectTitle}" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="{conv:Localize ExportModeSelectDesc}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Mode Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- AutoCAD Mode -->
            <Border Grid.Column="0" x:Name="AutoCadCard"
                    BorderBrush="{DynamicResource Brush.Info}" BorderThickness="2" CornerRadius="8"
                    Background="{DynamicResource Brush.Surface}" Padding="16" Margin="0,0,8,0"
                    Cursor="Hand" MouseLeftButtonDown="AutoCadCard_Click">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="{StaticResource Icon.Cad}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock Text="{conv:Localize ExportModeAutoCad}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.Success}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="{conv:Localize ExportModeRecommended}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{conv:Localize ExportModeAutoCadFeature1}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{conv:Localize ExportModeAutoCadFeature2}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{conv:Localize ExportModeAutoCadFeature3}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{conv:Localize ExportModeAutoCadFeature4}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock x:Name="AutoCadStatusText"
                               Text="{conv:Localize ExportModeAutoCadWarning}" FontSize="11"
                               Foreground="{DynamicResource Brush.Warning}" Margin="0,8,0,0" FontWeight="Medium"/>
                </StackPanel>
            </Border>

            <!-- Offline Mode -->
            <Border Grid.Column="1" x:Name="OfflineCard"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource Brush.Surface}" Padding="16" Margin="8,0,0,0"
                    Cursor="Hand" MouseLeftButtonDown="OfflineCard_Click">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="{StaticResource Icon.Cache}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock Text="{conv:Localize ExportModeOffline}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.TextDisabled}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="{conv:Localize ExportModeNoAutoCad}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{conv:Localize ExportModeOfflineFeature1}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{conv:Localize ExportModeOfflineFeature2}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{conv:Localize ExportModeOfflineFeature3}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{conv:Localize ExportModeOfflineFeature4}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{conv:Localize BtnCancel}" Width="80" Height="32" Margin="0,0,0,0" Click="Cancel_Click"
                    Background="{DynamicResource Brush.BackgroundAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
