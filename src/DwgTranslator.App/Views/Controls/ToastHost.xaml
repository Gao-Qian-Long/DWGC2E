<UserControl x:Class="DwgTranslator.App.Views.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <!-- Dedicated bounded layout region, never an overlay on table actions. -->
    <ItemsControl x:Name="ToastItems" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                  Margin="0,0,16,0">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border ToolTip="{Binding Message}" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.Medium}"
                        Padding="12,8" Margin="0,0,0,8" MaxWidth="340">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#0F1F3A"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Fill="{Binding Accent}"/>
                        <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"
                                   MaxWidth="290" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
