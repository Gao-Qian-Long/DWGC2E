<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DwgTranslator.Cad</RootNamespace>
    <!-- Ensure NuGet package DLLs are copied to output (needed for NETLOAD in AutoCAD) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!--
      AutoCAD .NET API references — uses $(AutoCadDir) from Directory.Build.props.
      If build fails with "DLL not found", set AutoCadDir via:
        - Environment variable: set AUTO_CAD_DIR=C:\Program Files\Autodesk\AutoCAD 2026
        - Command line: dotnet build -p:AutoCadDir="C:\Program Files\Autodesk\AutoCAD 2026"
        - Create Directory.Build.props.user with <AutoCadDir> override
    -->
    <Reference Include="AcCoreMgd" Condition="'$(AutoCadDir)' != ''">
      <HintPath>$(AutoCadDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd" Condition="'$(AutoCadDir)' != ''">
      <HintPath>$(AutoCadDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMgd" Condition="'$(AutoCadDir)' != ''">
      <HintPath>$(AutoCadDir)\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcCui" Condition="'$(AutoCadDir)' != ''">
      <HintPath>$(AutoCadDir)\AcCui.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- Fail build early with a clear message if AutoCAD directory is not configured -->
  <Target Name="CheckAutoCadDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(AutoCadDir)' == '' Or !Exists('$(AutoCadDir)')"
           Text="AutoCAD directory not found. Please set AutoCadDir in Directory.Build.props, via environment variable AUTO_CAD_DIR, or command line: dotnet build -p:AutoCadDir='C:\Program Files\Autodesk\AutoCAD 2026'" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\DwgTranslator.Core\DwgTranslator.Core.csproj" />
  </ItemGroup>
</Project>
