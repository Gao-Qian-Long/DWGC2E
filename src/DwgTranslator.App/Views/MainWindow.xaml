<Window x:Class="DwgTranslator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DwgTranslator.App.ViewModels"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        xmlns:views="clr-namespace:DwgTranslator.App.Views"
        Title="{conv:Localize AppTitle}" Height="780" Width="1280"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F0F4F8">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <!-- DataContext is set from DI container in MainWindow.xaml.cs -->
    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="1" BlurRadius="6" Opacity="0.12" Direction="270"/>

        <!-- Modern Button Style -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B0BEC5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B0BEC5"/>
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row style: base colors + status overrides -->
        <Style x:Key="TranslationRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="0">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Translated">
                    <Setter Property="Background" Value="#F1F8E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Reviewed">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="TranslationFailed">
                    <Setter Property="Background" Value="#FFF0F0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Background" Value="#F2F2F2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GlossaryHit}" Value="True">
                    <Setter Property="Background" Value="#FFFDE7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="WrapCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with gradient -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#1976D2" Offset="0.5"/>
                    <GradientStop Color="#1E88E5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="DWG" Foreground="White" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Opacity="0.9"/>
                    <TextBlock Text=" Translator" Foreground="White" FontSize="13"
                               VerticalAlignment="Center" Opacity="0.9"/>
                    <TextBlock Foreground="#BBDEFB" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text=" — "/><Run Text="{conv:Localize AppTitleShort}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ToggleTopmostCommand}"
                            ToolTip="{conv:Localize TipTopmostToggle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="36"
                            Foreground="White" BorderThickness="0" FontSize="14"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Background="Transparent">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Content" Value="&#x1F4CC;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                        <Setter Property="Background" Value="#FF9800"/>
                                        <Setter Property="Content" Value="&#x1F4CD;"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="MinimizeButton" Content="&#x2013;"
                            Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="36" Background="Transparent"
                            Foreground="White" BorderThickness="0" FontSize="16"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;"
                            Click="MaximizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="36" Background="Transparent"
                            Foreground="White" BorderThickness="0" FontSize="14"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#x2715;"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="36" Background="Transparent"
                            Foreground="White" BorderThickness="0" FontSize="14"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar Row 1 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportDwgCommand}"
                        Background="#1976D2" ToolTip="{conv:Localize TipImportDwg}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C2;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnImportDwg}"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource PrimaryButton}"
                        Background="#FF9800" Command="{Binding ToggleLanguageDirectionCommand}"
                        ToolTip="{conv:Localize TipToggleDirection}" Margin="2">
                    <TextBlock TextAlignment="Center">
                        <Run Text="&#x21C4; " FontSize="14"/><Run Text="{Binding LanguageDirection}" FontSize="12"/>
                    </TextBlock>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding TranslateCommand}"
                        Background="#4CAF50" ToolTip="{conv:Localize TipTranslate}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" Margin="0,0,4,0" FontSize="11"/>
                        <TextBlock Text="{conv:Localize BtnTranslate}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CancelTranslateCommand}"
                        Background="#E53935" ToolTip="{conv:Localize TipStopTranslation}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25A0;" Margin="0,0,4,0" FontSize="11"/>
                        <TextBlock Text="{conv:Localize BtnStop}"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportExcelCommand}"
                        ToolTip="{conv:Localize TipExportExcel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4CA;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnExportExcel}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ImportExcelCommand}"
                        ToolTip="{conv:Localize TipImportExcel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C5;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnImportExcel}"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportDwgCommand}"
                        Background="#2E7D32" ToolTip="{conv:Localize TipExportDwg}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4BE;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnExportDwg}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CancelExportCommand}"
                        Background="#E53935" ToolTip="{conv:Localize TipCancelExport}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25A0;" Margin="0,0,4,0" FontSize="11"/>
                        <TextBlock Text="{conv:Localize BtnCancelExport}"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding MarkAllReviewedCommand}"
                        ToolTip="{conv:Localize TipMarkReviewed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2714;" Margin="0,0,4,0" Foreground="#4CAF50"/>
                        <TextBlock Text="{conv:Localize BtnMarkAllReviewed}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RetryFailedCommand}"
                        ToolTip="{conv:Localize TipRetryFailed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BB;" Margin="0,0,4,0" Foreground="#FF9800"/>
                        <TextBlock Text="{conv:Localize BtnRetryFailed}"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenGlossaryManagerCommand}"
                        ToolTip="{conv:Localize TipGlossary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4D6;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnGlossary}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ImportGlossaryCommand}"
                        ToolTip="{conv:Localize TipImportGlossary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4E5;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnImportGlossary}"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenLicenseDialogCommand}"
                        ToolTip="{conv:Localize TipLicense}" BorderBrush="#FF9800" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F511;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnLicense}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SettingsCommand}"
                        ToolTip="{conv:Localize TipSettings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2699;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnSettings}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleLogViewerCommand}"
                        ToolTip="{conv:Localize TipLog}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4CB;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnLog}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ShowHelpCommand}"
                        ToolTip="{conv:Localize TipHelp}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2753;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnHelp}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearAllCommand}"
                        ToolTip="{conv:Localize TipClear}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F5D1;" Margin="0,0,4,0"/>
                        <TextBlock Text="{conv:Localize BtnClear}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Toolbar Row 2: Filter + Stats -->
        <Border Grid.Row="2" Background="White" Padding="10,6" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{conv:Localize StatsFilter}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#78909C"/>
                <ComboBox ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding FilterStatusText, UpdateSourceTrigger=PropertyChanged}"
                          Width="95" Height="28" Margin="0,0,15,0" FontSize="12"/>
                <TextBlock Text="{conv:Localize StatsSearch}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#78909C"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="28"
                         ToolTip="{conv:Localize TipSearch}" FontSize="12" VerticalContentAlignment="Center"
                         Padding="6,0"/>
                <Button Content="{conv:Localize BtnFind}" Command="{Binding ApplySearchCommand}" Padding="10,4" Margin="5,0,20,0"
                        Style="{StaticResource ToolButton}" FontSize="12"/>

                <!-- Stats Badge Row -->
                <Border Background="#E3F2FD" CornerRadius="6" Padding="12,5" Margin="0,0,8,0"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="{conv:Localize StatsTotal}" Foreground="#78909C"/><Run Text="{Binding TotalCount}" FontWeight="SemiBold" Foreground="#37474F"/>
                        </TextBlock>
                        <Border Width="1" Height="14" Background="#BBDEFB" Margin="10,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{conv:Localize StatsTranslated}" Foreground="#78909C"/><Run Text="{Binding TranslatedCount}" FontWeight="SemiBold" Foreground="#1976D2"/>
                        </TextBlock>
                        <Border Width="1" Height="14" Background="#BBDEFB" Margin="10,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{conv:Localize StatsFailed}" Foreground="#78909C"/><Run Text="{Binding FailedCount}" FontWeight="SemiBold" Foreground="#E53935"/>
                        </TextBlock>
                        <Border Width="1" Height="14" Background="#BBDEFB" Margin="10,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{conv:Localize StatsGlossary}" Foreground="#78909C"/><Run Text="{Binding GlossaryHitCount}" FontWeight="SemiBold" Foreground="#E65100"/>
                        </TextBlock>
                        <Border Width="1" Height="14" Background="#BBDEFB" Margin="10,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{conv:Localize StatsCache}" Foreground="#78909C"/><Run Text="{Binding CacheHitCount}" FontWeight="SemiBold" Foreground="#78909C"/>
                        </TextBlock>
                        <Border Width="1" Height="14" Background="#BBDEFB" Margin="10,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{conv:Localize StatsVisible}" Foreground="#78909C"/><Run Text="{Binding VisibleCount}" FontWeight="SemiBold" Foreground="#37474F"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- License Status Badge -->
                <Border Background="#FFF3E0" CornerRadius="6" Padding="12,5" BorderBrush="#FFE0B2" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F511;" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center">
                            <Run Text="{Binding LicenseStatusText}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Progress Bar with operation label -->
        <Grid Grid.Row="3" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="0" Padding="8,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding OperationLabel}" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="..." FontSize="11" Foreground="#1565C0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCancellationRequested}" Value="True">
                                        <Setter Property="Text" Value="{conv:Localize ProgressCancelling}"/>
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <ProgressBar Grid.Column="1" Height="4"
                         Value="{Binding ProgressValue}" Maximum="100"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Foreground="#4CAF50" Background="#E8E8E8"/>
            <TextBlock Grid.Column="2" Margin="6,0" FontSize="11" Foreground="#78909C" VerticalAlignment="Center">
                <TextBlock.Text>
                    <Binding Path="ProgressValue" StringFormat="{}{0:0}%"/>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <!-- Data Grid -->
        <DataGrid Grid.Row="4" Margin="10,5,10,5"
                  ItemsSource="{Binding FilteredEntities}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  RowStyle="{StaticResource TranslationRowStyle}"
                  AlternationCount="2"
                  CanUserResizeColumns="True"
                  EnableRowVirtualization="True"
                  IsReadOnly="False"
                  RowHeight="32"
                  FontSize="12"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="#ECEFF1"
                  BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#37474F"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="70" IsReadOnly="True"
                                    CanUserSort="True" SortMemberPath="Handle">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellStyle}">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="#78909C"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="{conv:Localize ColType}" Binding="{Binding EntityType}" Width="80" IsReadOnly="True"
                                    CanUserSort="True" SortMemberPath="EntityType"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>

                <DataGridTextColumn Header="{conv:Localize ColOriginal}" Binding="{Binding PlainText}" Width="2*" MinWidth="150" IsReadOnly="True"
                                    CanUserSort="True" SortMemberPath="PlainText"
                                    ElementStyle="{StaticResource WrapCellStyle}"/>

                <DataGridTemplateColumn Header="{conv:Localize ColTranslation}" Width="2*" MinWidth="150" SortMemberPath="TranslatedText" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TranslatedText, UpdateSourceTrigger=LostFocus}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"
                                     BorderBrush="#E0E0E0" Background="Transparent"
                                     FontSize="12" VerticalContentAlignment="Center"
                                     Padding="4,2"
                                     ToolTip="{conv:Localize TipEditTranslation}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{conv:Localize ColGlossary}" Width="55" SortMemberPath="GlossaryHit" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                                       ToolTip="{conv:Localize TipGlossaryMatch}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlossaryHit}" Value="True">
                                                <Setter Property="Text" Value="&#x2714;"/>
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{conv:Localize ColStatus}" Width="90" SortMemberPath="Status" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" Margin="2,0"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                    ToolTip="{Binding Status}">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{conv:Localize ColBlock}" Binding="{Binding BlockName}" Width="*" MinWidth="80" IsReadOnly="True"
                                    CanUserSort="True" SortMemberPath="BlockName"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>

                <DataGridTextColumn Header="{conv:Localize ColNotes}" Binding="{Binding Notes}" Width="*" MinWidth="80" IsReadOnly="False"
                                    CanUserSort="True" SortMemberPath="Notes"
                                    ElementStyle="{StaticResource WrapCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Log Viewer Panel (collapsible) -->
        <views:LogViewerPanel Grid.Row="5" x:Name="LogPanel"
                              DataContext="{Binding LogViewModel}"
                              MaxHeight="280"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- Status Bar -->
        <Border Grid.Row="6" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="0">
            <StatusBar Background="Transparent" Margin="0">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Processing spinner indicator -->
                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#FF9800"/>
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                            From="#FF9800" To="#1976D2" Duration="0:0:0.8"
                                                            AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#546E7A"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock Text="{Binding GlossaryStatsText}" Foreground="#90A4AE" FontSize="11" Margin="0,0,15,0"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock Text="{Binding LicenseStatusText}" Foreground="#E65100" FontSize="11" Margin="0,0,15,0" FontWeight="SemiBold"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="3">
                    <TextBlock Text="DWG Translator v2.1" Foreground="#B0BEC5" FontSize="10"/>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>
