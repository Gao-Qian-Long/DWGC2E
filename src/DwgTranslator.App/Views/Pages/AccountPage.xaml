<UserControl x:Class="DwgTranslator.App.Views.Pages.AccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:pages="clr-namespace:DwgTranslator.App.Views.Pages" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 环形用量图中心的比例文案（已用占比；低于 0.1% 显示 <0.1%，不伪造成 0%） -->
        <pages:UsagePercentTextConverter x:Key="Account.UsagePercentText"/>
        <!-- 「本周期额度重置时间」文案：后台未给 ResetAt 时返回空串，
             由该 TextBlock 自己的 DataTrigger（Text == ""）整行收起，不显示占位符。 -->
        <pages:QuotaResetTextConverter x:Key="Account.QuotaResetText"/>
        <Style x:Key="Account.Card" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="{DynamicResource Spacing.16}"/>
        </Style>
        <!-- 墨色反白会员横幅（暖色手作杂志风·深色反白区块）：墨底 + 墨色硬影 + 琥珀高光 -->
        <Style x:Key="Account.InkCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}"/>
            <Setter Property="Padding" Value="{DynamicResource Spacing.16}"/>
            <Setter Property="Effect" Value="{StaticResource Shadow.HardPrimary}"/>
        </Style>
        <!-- §B4 深色横幅上的按钮（用户批注「这两个按钮的样式很奇怪」）：
             「刷新权益」原用 Button.Secondary —— 奶白底 + 浅边框 + 深灰字，压在墨色横幅上就是一颗
             系统默认白按钮；「账号操作」原用 Button.Tertiary —— 无边框裸文字。两者风格割裂，
             也都游离于暖色手作杂志风之外。统一改成墨底上的描边 ghost 按钮：琥珀描边 + 琥珀文字
             （Brush.OnInkAccent #E8933F，即色板中专用于墨底的琥珀），次操作沿用同一形状但降到
             Brush.OnInkMuted / Brush.InkBorder，于是"同一风格、主次分明"；圆角走 CornerRadius.Medium
             令牌，两者同高（Size.ButtonCompact）同 MinWidth，热区一致。
             悬停反馈仅使用 RenderTransform 与硬偏移阴影：视觉抬升不参与测量，不会改变按钮热区或挤动相邻内容。 -->
        <Style x:Key="Account.InkButton" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Size.ButtonCompact}"/>
            <!-- 文案在「刷新权益」与「同步中…」之间切换（§A3 原地 loading 态）：钉住 MinWidth
                 后两种文案等宽，按钮尺寸不变，不会把同一行里的相邻元素推走。 -->
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInkAccent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnInkAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InkBd" CornerRadius="{DynamicResource CornerRadius.Medium}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InkBd" Property="Background" Value="{DynamicResource Brush.OnInkTrack}"/>
                                <Setter TargetName="InkBd" Property="Effect" Value="{StaticResource Shadow.OnInkHover}"/>
                                <Setter TargetName="InkBd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InkBd" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="InkBd" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="InkBd" Property="RenderTransform"><Setter.Value><TranslateTransform X="2" Y="2"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InkBd" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 次操作变体：同一形状、同一热区、同一圆角，只把琥珀降到墨底上的弱化灰米色 -->
        <Style x:Key="Account.InkButton.Quiet" TargetType="Button" BasedOn="{StaticResource Account.InkButton}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInkMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.InkBorder}"/>
        </Style>
        <!-- 用户反馈「更换布局思路」：常用入口由一行裸文字按钮改成一整块可点的导航磁贴
             （圆形图标 + 标题 + 一行说明 + 悬停反馈），三块等宽成组，读起来是导航而不是残留按钮。
             颜色一律沿用现有 Brush.* 令牌，不新增色值。 -->
        <Style x:Key="Account.NavTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="{DynamicResource Spacing.12}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                                <Setter TargetName="Tile" Property="Effect" Value="{StaticResource Shadow.HardHover}"/>
                                <Setter TargetName="Tile" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="Tile" Property="RenderTransform"><Setter.Value><TranslateTransform X="2" Y="2"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:PageHeader x:Name="WorkspaceHeader" Header="会员中心" WaveVariant="4" Description="查看当前套餐、剩余额度、有效期与订单。" />
        <!-- 用户反馈「在这个上面显示就行了」：套餐 / 字符额度 / 会员有效期三项不再单独占一排卡片，
             全部并入身份卡成为一条「身份 + 权益」卡；下半页用环形用量图与圆形导航图标补足可视化。
             合并后的结构约 222 + 详情 194 + 导航 80 ≈ 512 DIP，1500×820（可用体高约 606）与
             1366×768（约 554）都不出现纵向滚动。 -->
        <Grid Grid.Row="1">
        <ScrollViewer x:Name="AccountScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" SizeChanged="AccountScroll_SizeChanged">
        <!-- Stretch the account canvas to the same page edges as translation and tasks.
             A 1200-DIP cap centred the entire membership view on maximized windows;
             the viewport-width breakpoints below still reflow its cards on narrow ones. -->
        <StackPanel x:Name="AccountContentRoot" HorizontalAlignment="Stretch">
            <!-- §D7 未登录的登录卡已移到 ScrollViewer 的同级覆盖层「登录舞台」里，
                 在那里做上下左右居中并铺杂志风背景；已登录内容从这里开始。 -->
            <StackPanel Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}">
                <!-- 身份 + 权益卡（用户标注：三项权益显示在账户卡上）：
                     上行 = 头像 + 名称 + 邮箱 + 账号操作；下行 = 三项权益明细（原三张指标卡） + 额度环形用量图。
                     分组靠留白（§26 不加分隔线），卡片阴影向外溢出 3 DIP 由 Spacing.StackWide 的余量吸收。 -->
                <Border Style="{StaticResource Account.InkCard}" Margin="{DynamicResource Spacing.StackWide}">
                    <Grid x:Name="AccountIdentityLayout" SizeChanged="AccountIdentityLayout_SizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <!-- 外网格：左列放「身份 + 三项权益」，右列放「操作按钮 + 环形用量图」竖排。
                             §B5 用户批注按钮"内缩、没和卡片右缘对齐"：按钮原先是左列的第 3 个 Auto 列，
                             右缘只到左列边界，而右列（环 136 + Spacing.InlineLeading 的 20 右外边距）
                             整个横在按钮右侧 —— 按钮因此离卡片右缘差出一大截（截图实测约 78 DIP）。
                             把按钮移到右列顶端、右列整体右对齐并去掉那 20 DIP 右外边距后，
                             按钮右缘 = 卡片内边距右缘，与上方卡片同一条右边界。
                             代价：右列由 136 变 32+12+136=180，卡片内容高 170→180（+10 DIP），
                             整页约 512→522，1366×768 的可用体高 554 仍不出现纵向滚动。 -->
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid x:Name="AccountIdentityHeader" Grid.Column="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <!-- 头像：琥珀圆底 + 墨色衬线首字母（墨底横幅上的品牌高光） -->
                            <Grid Width="46" Height="46" Margin="{DynamicResource Spacing.InlineLoose}">
                                <Ellipse Fill="{DynamicResource Brush.Amber}"/>
                                <TextBlock Text="{Binding AccountAvatarText}" FontFamily="{DynamicResource FontFamily.Display}" Foreground="{DynamicResource Brush.Ink}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountDisplayNameText}" FontFamily="{DynamicResource FontFamily.Display}" Foreground="{DynamicResource Brush.OnInk}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountDisplayNameText}"/>
                                <TextBlock Text="{Binding AccountEmailText}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.OnInkMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountEmailText}" Margin="{DynamicResource Spacing.BlockTopTight}"/>
                            </StackPanel>
                            <!-- §B5 两个操作按钮已移到卡片右列顶端（右缘与卡片对齐），此处不再占第 3 列 -->
                        </Grid>
                        <Grid x:Name="AccountBenefits" Grid.Row="1" Grid.Column="0" Margin="{DynamicResource Spacing.BlockTopWide}">
                            <!-- 三项权益：标签固定列宽，数值列吃掉剩余宽度；超额时省略号 + ToolTip 兜底 -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="当前套餐" Style="{StaticResource InfoLabel}" Foreground="{DynamicResource Brush.OnInkMuted}" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineLoose}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OnlinePlanText}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}" TextTrimming="CharacterEllipsis" ToolTip="以当前账号同步权益为准" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="字符额度" Style="{StaticResource InfoLabel}" Foreground="{DynamicResource Brush.OnInkMuted}" VerticalAlignment="Top" Margin="{DynamicResource Spacing.InlineLoose}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock x:Name="QuotaText" Text="{Binding OnlineQuotaText}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnInk}" TextTrimming="CharacterEllipsis" ToolTip="此处显示云端 AI 翻译额度；本机写回方式不代表可以离线调用 AI。" VerticalAlignment="Center"/>
                                    <!-- Let the quota rail shrink to the available column width instead of forcing the whole card wider. -->
                                    <Grid HorizontalAlignment="Left" Width="360" Margin="{DynamicResource Spacing.BlockTopTight}">
                                        <ProgressBar x:Name="QuotaProgress" HorizontalAlignment="Stretch" Minimum="0" Maximum="{Binding OnlineUsage.MonthlyQuota}" Value="{Binding OnlineUsage.Remaining, Mode=OneWay}" Foreground="{DynamicResource Brush.Amber}" Background="{DynamicResource Brush.OnInkTrack}" Height="5"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding OnlineUsage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding OnlineUsage.MonthlyQuota}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="会员有效期" Style="{StaticResource InfoLabel}" Foreground="{DynamicResource Brush.OnInkMuted}" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineLoose}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnlineMembershipExpiryText}" FontFamily="{DynamicResource FontFamily.Mono}" Foreground="{DynamicResource Brush.OnInk}" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="购买后刷新，可同步最新权益" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <!-- §B4/§B5 卡片右列：操作按钮在上、环形用量图在下，整列右对齐。
                             按钮的 Content 必须保持纯字符串绑定（RefreshAccountButtonText）——
                             冒烟用 Equals(b.Content,"刷新权益") / "同步中…" 断言，塞进图标面板会失配；
                             同理这里不加旋转 spinner：本文件下方已记录 Forever 动画被孤儿化后
                             永久 tick、饿死 ApplicationIdle 的事故，busy 态改由"文案切换 + 禁用降透明
                             + MinWidth 锁定尺寸"表达，全程零动画。 -->
                        <StackPanel x:Name="AccountActionColumn" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="{DynamicResource Spacing.LeftGap}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 手作装饰：八芒星火花从卡片右上角移进操作行当引导符
                                     （原位置 Grid.Column=1 Right/Top 现在被按钮占用，留着会叠在一起） -->
                                <Path Data="{StaticResource Icon.Deco.Spark}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.OnInkAccent}" Opacity="0.85" VerticalAlignment="Center" Margin="{DynamicResource Spacing.Inline}" IsHitTestVisible="False"/>
                                <Button Content="{Binding RefreshAccountButtonText}" Command="{Binding RefreshAccountCommand}" IsEnabled="{Binding IsAccountRefreshing, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource Account.InkButton}" ToolTip="重新同步账户、会员与额度"/>
                                <Button Content="账号操作" ToolTip="重新验证会话或退出登录" Click="AccountMenu_Click" Style="{StaticResource Account.InkButton.Quiet}" Margin="{DynamicResource Spacing.LeftGap}"><Button.ContextMenu><ContextMenu><MenuItem Header="重新验证会话" Command="{Binding RefreshAccountCommand}"/><MenuItem Header="退出登录" Command="{Binding LogoutAccountCommand}"/></ContextMenu></Button.ContextMenu></Button>
                            </StackPanel>
                        <!-- 额度环形用量图（已用占比）：额度未知（OnlineUsage 为空或额度为 0）时整块收起，
                             收起时它的上外边距一并消失，按钮行直接贴到列底，不留空洞。 -->
                        <Grid x:Name="QuotaRingPanel" HorizontalAlignment="Center" Margin="{DynamicResource Spacing.BlockTopWide}" VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnlineUsage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding OnlineUsage.MonthlyQuota}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <pages:QuotaRing x:Name="QuotaRingChart" Width="136" Height="136" RingThickness="11" Used="{Binding OnlineUsage.Used}" Quota="{Binding OnlineUsage.MonthlyQuota}" TrackBrush="{DynamicResource Brush.OnInkTrack}" FillBrush="{DynamicResource Brush.Amber}" ToolTip="{Binding OnlineQuotaText}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding OnlineUsage, Converter={StaticResource Account.UsagePercentText}}" FontFamily="{DynamicResource FontFamily.Display}" FontSize="{DynamicResource FontSize.Kpi}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}" HorizontalAlignment="Center"/>
                                <TextBlock Text="额度已用" FontSize="{DynamicResource FontSize.KpiLabel}" Foreground="{DynamicResource Brush.OnInkMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="MembershipDetails" SizeChanged="MembershipDetails_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="PlansCard" Style="{StaticResource Account.Card}" Margin="{DynamicResource Spacing.StackWide}" VerticalAlignment="Top">
                        <!-- 用户反馈「卡片内部有大片未填充空白」：不再把主按钮钉在卡片底边去和右侧设备卡凑等高，
                             而是让卡片贴合自身内容（VerticalAlignment=Top），空白不再出现在卡片内部。 -->
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="PLANS · ORDERS" Style="{StaticResource Kicker}"/>
                                <TextBlock Text="套餐与订单" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="选择会员或补充额度" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/>
                                <!-- 与左侧设备卡等高时填补卡片中段的空白：给一条真实的本周期额度重置时间
                                     （后台未提供时整行收起，不显示占位符）。 -->
                                <TextBlock Text="{Binding OnlineUsage, Converter={StaticResource Account.QuotaResetText}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                            <Setter Property="Margin" Value="{DynamicResource Spacing.BlockTopTight}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button x:Name="MembershipPlansButton" Grid.Row="1" Content="查看套餐价格 / 续费与订单" Command="{Binding OpenMembershipCheckoutCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="{DynamicResource Spacing.BlockTopSection}"/>
                        </Grid>
                    </Border>
                    <Border x:Name="DevicesCard" Grid.Column="1" Style="{StaticResource Account.Card}" Margin="{DynamicResource Spacing.StackWide}"><StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DeviceCountText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBlock Text="登录设备" Style="{StaticResource SectionTitleStyle}"/></DockPanel>
                        <TextBlock Text="设备绑定超过 20 天后才可解绑换绑；不认识的设备请及时核查，退出登录不会自动解绑。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.Stack}"/>
                        <controls:EmptyState Header="暂无设备记录" Description="刷新账户信息后查看已绑定设备。"><controls:EmptyState.Style><Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DeviceCountText}" Value="已绑定 0 台设备"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style></controls:EmptyState>
                        <!-- 设备列表是整页唯一没有上界的块：每多一台设备就 +约 85 DIP，会把底部三块
                             导航磁贴顶出视口（用户批注「第三张只露一半」）。给它一个有界滚动区：
                             1 台设备（实测 85）仍完整显示，更多设备时在卡内滚动，页面总高不再随
                             设备数增长，磁贴永不被裁。MaxHeight 96 = 1 行设备 85 + 一点可滚动提示。
                             这里不裁内容（列表仍可滚动查看），也不改配色与命令语义。 -->
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OnlineDevices}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,1,0,0" Padding="0,6" Margin="{DynamicResource Spacing.StackTight}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="{DynamicResource Spacing.InlineWide}"><TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"/><TextBlock Text="当前设备" Foreground="{DynamicResource Brush.Primary}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" Margin="{DynamicResource Spacing.BlockTopTight}"/><TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                                <Button Grid.Column="1" Content="移除设备" VerticalAlignment="Center" IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource Button.Secondary}" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="仅可移除满足解绑条件的非当前设备" ToolTipService.ShowOnDisabled="True"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                    </StackPanel></Border>
                </Grid>
                <!-- 导航磁贴：三块等宽，整块可点，圆形图标 + 一行职责说明（Command / CommandParameter 与原按钮完全一致）。
                     §C6 用户批注三块磁贴的右缘比上方「登录设备」卡内缩、没填满：原来三块都挂着
                     Spacing.InlineLoose(0,0,16,0)，而外边距在列内部，于是第 3 块右缘少 16 DIP，
                     并且三块并不真的等宽（第 3 块比前两块宽 16）。改成 * / 槽 / * / 槽 / * 五列、
                     磁贴放 0/2/4 列且不带任何外边距 —— 三等分真正相等，左右两端都与上方卡片齐平，
                     槽宽 Size.CardGutter=16 与 MembershipDetails 两卡之间的列距一致。 -->
                <Grid x:Name="AccountNavTiles" SizeChanged="AccountNavTiles_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="AccountNavColumn0" Width="*"/><ColumnDefinition x:Name="AccountNavColumn1" Width="{StaticResource Size.CardGutter}"/><ColumnDefinition x:Name="AccountNavColumn2" Width="*"/><ColumnDefinition x:Name="AccountNavColumn3" Width="{StaticResource Size.CardGutter}"/><ColumnDefinition x:Name="AccountNavColumn4" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="TranslateNavTile" Style="{StaticResource Account.NavTile}" Command="{Binding NavigateToCommand}" CommandParameter="translate" ToolTip="打开图纸翻译" MinWidth="0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/><Path Data="{StaticResource Icon.NavTranslate}" Width="{DynamicResource Size.IconInline}" Height="{DynamicResource Size.IconInline}" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="{DynamicResource Size.Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="图纸翻译" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="导入图纸 · 翻译 · 写回" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="GlossaryNavTile" Grid.Column="2" Style="{StaticResource Account.NavTile}" Command="{Binding NavigateToCommand}" CommandParameter="glossary" ToolTip="打开术语库" MinWidth="0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/><Path Data="{StaticResource Icon.NavGlossary}" Width="{DynamicResource Size.IconInline}" Height="{DynamicResource Size.IconInline}" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="{DynamicResource Size.Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="管理术语" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="术语库、分类与云端核对" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="OutputNavTile" Grid.Column="4" Style="{StaticResource Account.NavTile}" Command="{Binding NavigateToCommand}" CommandParameter="output-settings" ToolTip="打开输出设置" MinWidth="0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="{DynamicResource Spacing.InlineWide}" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Brush.PrimaryLight}"/><Path Data="{StaticResource Icon.NavSettings}" Width="{DynamicResource Size.IconInline}" Height="{DynamicResource Size.IconInline}" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="{DynamicResource Size.Stroke}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="输出设置" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="导出模式与文件命名" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="{DynamicResource Spacing.BlockTopTight}"/></StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <!-- §D7 未登录「登录舞台」（用户批注「这个登录页面也是太偏左了，不能居中吗？上下居中，
             左右居中，可以做一个好看的登录背景，和当前APP搭配一点 不要太突兀」）。
             做成 AccountScroll 的同级覆盖层：铺满 Grid.Row=1 的整块可用区，登录卡在水平与垂直两个
             方向都居中（原来它是左对齐 StackPanel 的第一个子元素，只能贴在左上角）。
             已登录时整层 Collapsed，对 ScrollViewer 的内容高度零影响
             （冒烟断言刷新前后 content.ActualHeight 差 < 0.5）。
             背景刻意不重复铺纸纹：Brush.PaperNoise 与 Brush.WarmGlow 已由 MainWindow 铺在整个内容列上，
             再叠一层会让 α 翻倍、把奶白底压脏。这里只补一层更明显的暖光晕（复用同一个
             Brush.WarmGlow 径向渐变令牌）与既有 Deco.* 手作装饰：虚线圈、波浪线、八芒星、
             柔琥珀色块 —— 全部是现成资源与 Brush.* 令牌，不新增任何色值，也不引入位图。
             装饰一律 IsHitTestVisible=False，不挡表单输入；卡片本身沿用既有 Section.Surface
             卡片语言（奶白面 + 1px 边框 + 硬偏移阴影），控件、绑定、事件处理器与 x:Name 原样搬移，
             仍在同一个 XAML 名字作用域里，冒烟 FindName("PasswordInput"/"LoginButton") 照常取到。 -->
        <Grid Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
            <Border Background="{DynamicResource Brush.WarmGlow}" IsHitTestVisible="False"/>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.AmberSoft}" Opacity="0.45" IsHitTestVisible="False"/>
            <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource Brush.AmberSoft}" Opacity="0.28" IsHitTestVisible="False"/>
            <Ellipse Style="{StaticResource Deco.DashedRing.Amber}" Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.45" IsHitTestVisible="False"/>
            <Ellipse Style="{StaticResource Deco.DashedRing}" Width="128" Height="128" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{DynamicResource Spacing.48}" Opacity="0.7" IsHitTestVisible="False"/>
            <Path Style="{StaticResource Deco.WaveRule}" Width="224" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource Spacing.48}" Opacity="0.5" IsHitTestVisible="False"/>
            <Path Style="{StaticResource Deco.Spark}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{DynamicResource Spacing.40}" Opacity="0.55" IsHitTestVisible="False"/>
            <Path Style="{StaticResource Deco.Spark.Small}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{DynamicResource Spacing.20}" Opacity="0.6" IsHitTestVisible="False"/>
            <Grid x:Name="LoginCardHost" MaxWidth="600" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border x:Name="LoginCard" Style="{StaticResource Section.Surface}" Margin="20,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="登录账号" FontFamily="{DynamicResource FontFamily.Display}" FontSize="16" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Stack}" />
                    <TextBlock Text="可以先浏览软件；云端翻译需要登录。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.StackSection}" />
                    <TextBlock Text="账号" Margin="{DynamicResource Spacing.StackTight}" />
                    <TextBox x:Name="AccountInput" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="登录账号" />
                    <TextBlock Text="密码" Margin="{DynamicResource Spacing.RowInset}" />
                    <PasswordBox x:Name="PasswordInput" MinHeight="{DynamicResource Size.Control}" Padding="8" KeyDown="Password_KeyDown" AutomationProperties.Name="登录密码" />
                    <Button x:Name="LoginButton" Content="登录" Margin="{DynamicResource Spacing.BlockTopSection}" Click="Login_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="RegisterLinkButton" Content="还没有账号？前往官网注册" Command="{Binding OpenRegisterCommand}"
                            Style="{StaticResource Button.Compact.Tertiary}" HorizontalAlignment="Left"
                            AutomationProperties.Name="前往官网注册" Margin="{DynamicResource Spacing.BlockTopTight}" />
                    <Border Margin="{DynamicResource Spacing.BlockTopLoose}" Padding="12,8" Background="{DynamicResource Brush.InfoLight}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Small}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding AccountFeedback}" Value="账户信息已同步。"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AccountFeedback}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <Button x:Name="SavedSessionRecoveryButton" Content="{Binding SavedSessionRecoveryButtonText}" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Tertiary}" HorizontalAlignment="Left" Margin="{DynamicResource Spacing.BlockTop}" IsEnabled="{Binding IsAccountRefreshing, Converter={StaticResource InverseBoolConverter}}" Visibility="{Binding HasSavedAccountSession, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!-- §D11 用户批注「不要这个加载条」：原先这里有一条 x:Name="AccountRefreshIndicator"
             的 2 DIP 琥珀细线（内层 4 DIP 琥珀 Border + 外层透明底衬），作为刷新覆盖层贴顶显示。
             它虽然不占布局高度，但在页面顶端读起来就是"插进来一条横条"——
             截图实测 150% 缩放下为 #D97728（= Brush.Amber）的 3 px 实心带，
             横跨整个内容视口（x=48..2231），比身份卡（x=48..1840）还宽，非常显眼。
             整条指示器已删除。过程语义改由既有的两处承担，不再新增任何元素：
             ① 横幅内按钮原地变「同步中…」并禁用（见下方 RefreshAccountButtonText 绑定，
                MinWidth 锁定尺寸所以不挤动任何元素）；
             ② 右下角 toast（MainWindow 的 Toasts 是 Grid.Row=1/Column=1 的 Bottom-Right
                覆盖层，本身不占布局行），成功时的「账户信息已同步」与失败告警走的就是这条通道。
             顶栏（MainWindow.xaml）未增删任何元素。 -->
        </Grid>
    </Grid>
</UserControl>
