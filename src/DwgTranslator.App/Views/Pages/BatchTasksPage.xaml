<UserControl x:Class="DwgTranslator.App.Views.Pages.BatchTasksPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18,14,18,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="0"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*" MinWidth="300"/></Grid.ColumnDefinitions>
  <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
   <TextBlock Text="批量任务" Style="{StaticResource PageTitleStyle}"/>
   <TextBlock Text="集中管理任务，检查并校对翻译结果。" Style="{StaticResource PageSubtitleStyle}"/>
  </StackPanel>
  <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
   <WrapPanel>
    <Button Content="添加图纸" Command="{Binding ImportDwgCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,4"/>
    <Button Content="开始全部" Command="{Binding TranslateCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,4"/>
    <Button Content="停止任务" Command="{Binding CancelTranslateCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,4"/>
    <Button Content="重试失败" Command="{Binding RetryFailedCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,4"/>
    <Button Content="导出结果" Command="{Binding ExportDwgCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,16,4"/>
    <TextBlock Text="目标语言" VerticalAlignment="Center" Margin="0,0,8,4"/>
    <ComboBox Width="150" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName"
     SelectedValuePath="Code" SelectedValue="{Binding CurrentTargetLang, Mode=TwoWay}" Margin="0,0,0,4"/>
   </WrapPanel>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource ContentCardNoPad}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardHeaderBar}">
     <DockPanel>
      <TextBlock Text="{Binding DrawingFiles.Count, StringFormat='共 {0} 张图纸'}" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextMuted}"/>
      <TextBlock Text="任务队列" Style="{StaticResource CardTitleStyle}"/>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <DataGrid ItemsSource="{Binding DrawingFiles}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                      HeadersVisibility="Column" RowHeight="32" FontSize="13"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46" IsReadOnly="True"
                                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*" MinWidth="180"
                                                        IsReadOnly="True" ElementStyle="{StaticResource WrapCellStyle}"/>

                                    <DataGridTemplateColumn Header="状态" Width="120" IsReadOnly="True"
                                                            SortMemberPath="StatusText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
                                                                <Style.Triggers>
                                                                    <!-- 任务层的 10 态：处理中的阶段统一主色，失败/取消/暂停用告警色，
                                                                         用户一眼能看出「在跑 / 跑完了 / 出问题了」，不必逐字读状态名。 -->
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="解析中">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="提取文本">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="翻译中">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="排版优化">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="写回中">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="部分失败">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="完成（含失败）">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已暂停">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已取消">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="导入失败">
                                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                                               ToolTip="{Binding SummaryText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="文本数量" Binding="{Binding TextCountText}" Width="90"
                                                        IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>

                                    <DataGridTemplateColumn Header="进度" Width="150" IsReadOnly="True"
                                                            SortMemberPath="ProgressPercent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="6" VerticalAlignment="Center"
                                                                 Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Brush.Primary}"
                                                                 Background="{DynamicResource Brush.BackgroundAlt}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                               FontSize="12" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="80"
                                                        IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>

                                    <DataGridTemplateColumn Width="150" IsReadOnly="True">
                                         <DataGridTemplateColumn.Header>
                                             <StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding DataContext.IsAllDrawingsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" ToolTip="全选/取消全选导出图纸" Margin="0,0,6,0"/><TextBlock Text="操作"/></StackPanel>
                                         </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsIncludedForExport, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              ToolTip="勾选的图纸参与批量导出"
                                                              AutomationProperties.Name="参与导出"/>
                                                    <Button Style="{StaticResource CompactToolButton}"
                                                            Command="{Binding DataContext.OpenDrawingFileItemsCommand,
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="查看该图纸的文本条目">
                                                        <TextBlock Text="条目"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
     <Border Background="{DynamicResource Brush.Surface}" Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
       <TextBlock Text="还没有图纸任务" Style="{StaticResource EmptyState.Title}"/>
       <TextBlock Text="点击「添加图纸」或拖入 DWG / DXF 文件开始。" Style="{StaticResource EmptyState.Description}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>
  <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Brush.BorderLight}"/>
  <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ContentCardNoPad}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardHeaderBar}">
     <DockPanel>
      <TextBlock Text="{Binding SelectedDrawingFile.FileName, TargetNullValue=全部图纸}" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextMuted}"/>
      <TextBlock Text="译文校对" Style="{StaticResource CardTitleStyle}"/>
     </DockPanel>
    </Border>
    <DataGrid Grid.Row="1" ToolTip="双击译文编辑；Enter 保存，Esc 取消。" ItemsSource="{Binding FilteredEntities}" AutoGenerateColumns="False"
     IsReadOnly="{Binding IsProcessing}" CellEditEnding="TranslationGrid_CellEditEnding" CanUserAddRows="False" BorderThickness="0" RowHeight="32"
     ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="句柄" ElementStyle="{StaticResource CenteredCellStyle}" IsReadOnly="True" Binding="{Binding Handle}" Width="90"/>
      <DataGridTextColumn Header="原文" IsReadOnly="True" Binding="{Binding PlainText}" Width="*" ElementStyle="{StaticResource WrapCellStyle}"/>
      <DataGridTextColumn Header="译文" Binding="{Binding TranslatedText, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Width="*" ElementStyle="{StaticResource WrapCellStyle}"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Border>
  <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card.Inset}" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,8"/>

   </StackPanel>
  </Border>
 </Grid>
</UserControl>

