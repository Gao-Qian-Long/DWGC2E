                                                   Text="在「输入激活码」区域粘贴您收到的激活码"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Style="{StaticResource StepBadge}">
                                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="点击「立即激活」按钮"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <Border Style="{StaticResource StepBadge}">
                                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="激活成功后，授权状态会立即更新"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Machine binding -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="机器绑定说明"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="激活码与您的电脑绑定（一机一码），以防止盗版。如果您需要更换电脑使用，请按以下步骤操作："/>
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Text="1. 在授权管理窗口中，点击「复制机器码」按钮"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="2. 将机器码发送给客服"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="3. 客服会为您生成新的激活码"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="4. 在新电脑上输入新的激活码即可"/>
                                </StackPanel>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="#1565C0">
                                        <Run FontWeight="Bold">提示：</Run>授权管理窗口中的「机器标识」是您电脑的唯一标识，客服可能会要求您提供此信息。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{conv:Localize BtnClose}" Width="80" Height="32" Click="Close_Click"
                    Background="#1976D2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
