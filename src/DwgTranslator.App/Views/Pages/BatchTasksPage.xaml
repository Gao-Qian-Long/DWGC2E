                        <TextBox Grid.Column="0" Style="{StaticResource Search.Input}" MinWidth="180" Margin="{DynamicResource Spacing.Inline}" Tag="搜索原文或译文" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
