<UserControl x:Class="DwgTranslator.App.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 窗口控制（最小化 / 最大化 / 关闭）。

         第二轮 UI 优化后的分工：
           · 这里只保留窗口控制（§9），窗口置顶 / 设置 / 帮助等入口移到右上角用户下拉菜单；
           · 三个按钮同尺寸 46×40，描边统一 1.5，关闭按钮 hover 才变红。 -->
    <UserControl.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Brush.BackgroundAlt}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Brush.Danger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphPath" TargetType="Path">
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="{DynamicResource Size.Stroke}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="{DynamicResource Spacing.InlineTight}">
        <Button x:Name="MinimizeButton" ToolTip="最小化"
                AutomationProperties.AutomationId="MinimizeButton"
                AutomationProperties.Name="最小化"
                Click="MinimizeButton_Click" Style="{StaticResource WindowButtonStyle}">
            <Path Style="{StaticResource GlyphPath}" Fill="Transparent" Data="M 0,5 L 10,5"/>
        </Button>

        <Button x:Name="MaxRestoreButton" ToolTip="最大化 / 还原"
                AutomationProperties.AutomationId="MaximizeButton"
                AutomationProperties.Name="最大化"
                Click="MaximizeButton_Click" Style="{StaticResource WindowButtonStyle}">
            <Path x:Name="MaximizeGlyph" Style="{StaticResource GlyphPath}" Fill="Transparent"
                  Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
        </Button>

        <Button x:Name="CloseButton" ToolTip="关闭"
                AutomationProperties.AutomationId="CloseButton"
                AutomationProperties.Name="关闭"
                Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}">
            <Path Style="{StaticResource GlyphPath}" Fill="Transparent" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
        </Button>
    </StackPanel>
</UserControl>
