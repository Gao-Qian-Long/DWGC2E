<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <!-- ═══════════════════════════════════════════════════════════════════════
         公共组件样式（按钮 / 卡片 / 表格 / 输入 / 浮层）。

         第二轮 UI 优化后收敛为：
           按钮 4 档（Primary / Secondary / Tertiary / Danger）+ Icon / Compact
           卡片 3 种（Card / CardNoPad / Card.Inset）
           表格 1 套（DataGridHeaderStyle / DataGridCellStyle / TranslationRowStyle）
         旧的键名保留为别名（BasedOn），页面可以逐页迁移而不用一次性大改。
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Global typography: controls inherit one family and one body size. -->
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
    </Style>
    <!-- ── 转换器与效果（页面与控件通过 StaticResource 引用，键名不能变）── -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <conv:IndexToVisibilityConverter x:Key="IndexToVis"/>
    <conv:StatusToBrushConverter x:Key="StatusBrush"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="#0F1F3A"/>
    <!-- ───────────────────────── 按钮 ───────────────────────── -->

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Size.Button}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary：一个页面最多一个 -->
    <!-- 主按钮与次按钮同高：同一个工具栏里不出现两种高度（§27），权重差异只靠颜色与字重 -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Secondary：白底 + 浅边框 -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Tertiary：纯文字 / 图标，视觉权重最低 -->
    <Style x:Key="Button.Tertiary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 危险但非主操作（退出登录之类） -->
    <Style x:Key="Button.DangerText" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="{DynamicResource Size.Control}"/>
        <Setter Property="Height" Value="{DynamicResource Size.Control}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 次按钮 + 危险文字：停止 / 暂停这类非主操作，与同排按钮同高但不高饱和 -->
    <Style x:Key="Button.SecondaryDanger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>

    <!-- 行内图标按钮：表格行、卡片角标里用（28px，比工具栏按钮小一档，不进工具栏） -->
    <Style x:Key="Button.IconSmall" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- 表格行内 / 卡片角落的小按钮 -->
    <Style x:Key="Button.Compact.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}"/>
    </Style>

    <Style x:Key="Button.Compact.Primary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}"/>
    </Style>

    <Style x:Key="Button.Compact.Tertiary" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}"/>
    </Style>

    <Style x:Key="Button.Compact.Danger" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}"/>
    </Style>

    <!-- ── 旧键名别名（页面历史引用，逐步迁移）── -->
    <Style x:Key="RibbonPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}"/>
    <Style x:Key="DialogSaveButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinWidth" Value="88"/>
    </Style>
    <Style x:Key="RibbonSecondaryButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
    <Style x:Key="DialogCancelButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinWidth" Value="88"/>
    </Style>
    <Style x:Key="RibbonTertiaryButton" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}"/>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Button.Danger}"/>
    <Style x:Key="CompactToolButton" TargetType="Button" BasedOn="{StaticResource Button.Compact.Secondary}"/>
    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Compact.Primary}"/>
    <Style x:Key="CompactDangerButton" TargetType="Button" BasedOn="{StaticResource Button.Compact.Danger}"/>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}"/>
    <Style x:Key="RibbonDivider" TargetType="Border" BasedOn="{StaticResource Divider.Vertical}"/>

    <!-- ───────────────────────── 卡片 ───────────────────────── -->

    <!-- 标准卡片：白底 + 1px 浅边框（不用阴影） -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Large}"/>
        <Setter Property="Padding" Value="{DynamicResource Spacing.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 承载表格的卡片：内边距为 0，由表格自己控制 -->
    <Style x:Key="CardNoPad" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- 卡片内的次级色块（表单分组、提示条），不要再套一层边框 -->
    <Style x:Key="Card.Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 卡片头部条：用底色和留白分组，不加分隔线（§26） -->
    <Style x:Key="CardHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource Spacing.CardHeader}"/>
    </Style>

    <!-- 旧键名别名 -->
    <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="ContentCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="ContentCardNoPad" TargetType="Border" BasedOn="{StaticResource CardNoPad}"/>
    <Style x:Key="ToolbarCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="StripCard" TargetType="Border" BasedOn="{StaticResource Card.Inset}"/>
    <Style x:Key="StatsBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Small}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="StatInlineText" TargetType="Run">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ───────────────────────── 表格 ───────────────────────── -->

    <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGridHeader}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.TableHeader}"/>
        <Setter Property="Height" Value="{DynamicResource Size.TableHeader}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 行：状态用「点 + 彩字」表达，整行不再染色（§25） -->
    <Style x:Key="TranslationRowStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="{DynamicResource Size.TableRow}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="WrapCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- 全局表格默认值：新加的表格自动一致 -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="{DynamicResource Size.TableRow}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.BorderLight}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridHeaderStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource TranslationRowStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ───────────────────────── 输入控件 ───────────────────────── -->

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.PrimarySoft}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource CornerRadius.Small}"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.SurfaceAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 下拉框：扁平白底 + 自绘箭头 + 带阴影的浮层（§27 / §29）════════════
         注意：这里必须是完整 ControlTemplate，只设属性会退回系统默认 3D 外观
         （上一轮就是因此把下拉框退回成"旧版"观感）。 -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="{DynamicResource Size.Control}"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadius.Small}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <!-- 必须用完整 Binding：TemplateBinding 不跟踪 SelectionBoxItem* 的后续更新，
                                     否则 DisplayMemberPath 不生效、下拉框里显示成类型名 -->
                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  SnapsToDevicePixels="True"/>
                                <Path Grid.Column="1" Data="{StaticResource Icon.Caret}" Width="10" Height="6"
                                      Stretch="Uniform" Fill="{DynamicResource Brush.TextMuted}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False" StaysOpen="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadius.Medium}" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{StaticResource CardShadow}">
                                <ScrollViewer Margin="0,4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.SurfaceAlt}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Margin="4,1"
                            CornerRadius="{DynamicResource CornerRadius.Small}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.PrimaryLight}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.PrimaryLight}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ───────────────────────── 浮层（菜单 / Tooltip / 滚动条 / 进度）───────────────────────── -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadius.Small}"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="#0F1F3A"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12" Color="#0F1F3A"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════ 兜底与滚动条（保留原有实现，仅换用新令牌）════ -->

    <!-- 兜底：没显式指定样式的按钮一律走 Tertiary，避免冒出系统默认按钮 -->
    <Style TargetType="Button" BasedOn="{StaticResource Button.Tertiary}"/>

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.ScrollThumb}"
                            CornerRadius="4" Margin="2,0" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageUp" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageDown" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageRightCommand"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>


