<UserControl x:Class="DwgTranslator.App.Views.EnvironmentCheckPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="132"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxWidth" Value="360"/>
        </Style>
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

<StackPanel><TextBlock Text="环境状态" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,20"/><DockPanel Margin="0,0,0,12" LastChildFill="True"><Ellipse x:Name="AppLamp" Style="{StaticResource Lamp}"/><TextBlock Text="DWGC2E" Style="{StaticResource RowLabel}"/><TextBlock x:Name="AppVersionText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><DockPanel Margin="0,0,0,12" LastChildFill="True"><Ellipse x:Name="RuntimeLamp" Style="{StaticResource Lamp}"/><TextBlock Text="运行环境" Style="{StaticResource RowLabel}"/><TextBlock x:Name="RuntimeText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><DockPanel Margin="0,0,0,12" LastChildFill="True"><Button DockPanel.Dock="Right" Content="打开" Click="OpenDataDir_Click" Style="{StaticResource Button.Tertiary}" Margin="8,0,0,0"/><Ellipse x:Name="PathsLamp" Style="{StaticResource Lamp}"/><TextBlock Text="数据目录" Style="{StaticResource RowLabel}"/><TextBlock x:Name="DataPathText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><DockPanel Margin="0,0,0,12" LastChildFill="True"><Button DockPanel.Dock="Right" Content="重新检测" Click="Detect_Click" Style="{StaticResource Button.Tertiary}" Margin="8,0,0,0"/><Ellipse x:Name="CadLamp" Style="{StaticResource Lamp}"/><TextBlock Text="CAD" Style="{StaticResource RowLabel}"/><TextBlock x:Name="CadProductText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><DockPanel Margin="0,0,0,12" LastChildFill="True"><Ellipse x:Name="PluginLamp" Style="{StaticResource Lamp}"/><TextBlock Text="CAD 插件" Style="{StaticResource RowLabel}"/><TextBlock x:Name="PluginStatusText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><DockPanel Margin="0,0,0,12" LastChildFill="True"><Ellipse x:Name="AutoLoadLamp" Style="{StaticResource Lamp}"/><TextBlock Text="自动加载" Style="{StaticResource RowLabel}"/><TextBlock x:Name="AutoLoadText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><WrapPanel Margin="0,4,0,12"><Button x:Name="InstallButton" Content="安装 / 修复插件" Click="Install_Click" Style="{StaticResource Button.Secondary}"/><Button x:Name="UninstallButton" Content="卸载插件" Click="Uninstall_Click" Style="{StaticResource Button.Tertiary}" Margin="8,0"/></WrapPanel><Expander Header="检测与安装记录"><TextBox x:Name="LogText" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/></Expander><Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="翻译服务" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/><DockPanel Margin="0,0,0,12" LastChildFill="True"><Ellipse x:Name="ApiLamp" Style="{StaticResource Lamp}"/><TextBlock Text="云端翻译服务" Style="{StaticResource RowLabel}"/><TextBlock x:Name="ApiEndpointText" Style="{StaticResource RowValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><TextBlock Text="{Binding AccountFeedback}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/><Button Content="重新检测服务" Command="{Binding CheckServiceCommand}" HorizontalAlignment="Left" Style="{StaticResource Button.Tertiary}" Margin="0,8"/></StackPanel></Border></StackPanel>
</UserControl>