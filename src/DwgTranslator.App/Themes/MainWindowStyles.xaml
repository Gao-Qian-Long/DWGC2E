<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <!-- ═══════════════════════════════════════════════════════════════════════
         公共组件样式（按钮 / 卡片 / 表格 / 输入 / 浮层）。

         第二轮 UI 优化后收敛为：
           按钮 4 档（Primary / Secondary / Tertiary / Danger）+ Icon / Compact
           卡片 3 种（Card / CardNoPad / Card.Inset）
           表格 1 套（DataGridHeaderStyle / DataGridCellStyle / TranslationRowStyle）
         旧的键名保留为别名（BasedOn），页面可以逐页迁移而不用一次性大改。
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- One compact header across all five workspaces. The action slot keeps page commands out of filters. -->
    <Style TargetType="controls:PageHeader">
        <Setter Property="MinHeight" Value="{DynamicResource Size.PageHeader}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Border x:Name="HeaderBorder" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <!-- 品牌签名：衬线页标题 + 琥珀手绘波浪线（暖色手作杂志风） -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource PageTitleStyle}" />
                                    <Path x:Name="HeaderWaveInline" Data="{StaticResource Icon.Deco.Wave}" Width="56" Height="5" Stretch="Fill"
                                          Stroke="{DynamicResource Brush.Amber}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Bottom" Margin="12,0,0,7" IsHitTestVisible="False" />
                                </StackPanel>
                                <!-- 副标题强制单行：它的长度随运行状态变化（TranslatePage 是 MultiBinding），
                                     换行会顶破 MinHeight 定下的页头节奏；省略号 + ToolTip 既保高度也不吞信息。 -->
                                <TextBlock x:Name="HeaderDescription" Text="{TemplateBinding Description}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Description}" />
                                <!-- 品牌签名：标题下的琥珀手绘波浪线（暖色手作杂志风） -->
                                <Path x:Name="HeaderWave" Style="{StaticResource Deco.WaveRule}" Width="56" Margin="2,5,0,0" />
                            </StackPanel>
                            <ContentPresenter x:Name="HeaderActions" Grid.Column="1" VerticalAlignment="Center" ContentSource="Content" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers><DataTrigger Binding="{Binding Path=IsStacked, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="HeaderActions" Property="Grid.Row" Value="1"/><Setter TargetName="HeaderActions" Property="Grid.Column" Value="0"/><Setter TargetName="HeaderActions" Property="Grid.ColumnSpan" Value="2"/><Setter TargetName="HeaderActions" Property="Margin" Value="0,8,0,0"/></DataTrigger><DataTrigger Binding="{Binding Path=(controls:ResponsiveLayout.IsShort), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,0,0,8"/><Setter TargetName="HeaderDescription" Property="Visibility" Value="Collapsed"/><Setter TargetName="HeaderBorder" Property="Padding" Value="0,0,0,8"/></DataTrigger><DataTrigger Binding="{Binding Path=WaveVariant, RelativeSource={RelativeSource Self}}" Value="2"><Setter TargetName="HeaderWaveInline" Property="Data" Value="{StaticResource Icon.Deco.Wave2}"/><Setter TargetName="HeaderWave" Property="Data" Value="{StaticResource Icon.Deco.Wave2}"/></DataTrigger><DataTrigger Binding="{Binding Path=WaveVariant, RelativeSource={RelativeSource Self}}" Value="3"><Setter TargetName="HeaderWaveInline" Property="Data" Value="{StaticResource Icon.Deco.Wave3}"/><Setter TargetName="HeaderWave" Property="Data" Value="{StaticResource Icon.Deco.Wave3}"/></DataTrigger><DataTrigger Binding="{Binding Path=WaveVariant, RelativeSource={RelativeSource Self}}" Value="4"><Setter TargetName="HeaderWaveInline" Property="Data" Value="{StaticResource Icon.Deco.Wave4}"/><Setter TargetName="HeaderWave" Property="Data" Value="{StaticResource Icon.Deco.Wave4}"/></DataTrigger><DataTrigger Binding="{Binding Path=WaveVariant, RelativeSource={RelativeSource Self}}" Value="5"><Setter TargetName="HeaderWaveInline" Property="Data" Value="{StaticResource Icon.Deco.Wave5}"/><Setter TargetName="HeaderWave" Property="Data" Value="{StaticResource Icon.Deco.Wave5}"/></DataTrigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Workspace.Toolbar" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Workspace.InfoStrip" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
    </Style>
    <!-- Global typography: controls inherit one family and one body size. -->
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Body}" />
    </Style>
    <!-- ── 转换器与效果（页面与控件通过 StaticResource 引用，键名不能变）── -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    <conv:IndexToVisibilityConverter x:Key="IndexToVis" />
    <conv:StatusToBrushConverter x:Key="StatusBrush" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="#0F1F3A" />
    <!-- 网站的立体感来自硬边偏移阴影（css/theme.css 的 box-shadow:3px 3px 0），而不是模糊柔影。
         卡片与控件用沙色，主按钮用墨色，与 .btn / .btn-primary 对应。
         CardShadow 以上那一个留给浮层（ToolTip / ContextMenu / Toast）——那里柔影才是对的。

         §H 全局柔化（用户批注：「这种立体式卡片的效果好像并不好，能全局优化下吗？」）。
         审计用 before / after（只动这两个令牌即全局生效：Shadow.Hard 被 Card / CardNoPad /
         Section.Surface / AccountPage.xaml:13 Account.Card 使用；Shadow.HardPrimary 被
         Button.Primary 与 AccountPage.xaml:21 Account.InkCard 使用）：
           Shadow.Hard         before BlurRadius 0 / ShadowDepth 3 / Direction 315 / #DED2BC / Opacity 1
           Shadow.Hard         after  BlurRadius 0 / ShadowDepth 2 / Direction 315 / #DED2BC / Opacity 0.55
           Shadow.HardPrimary  before BlurRadius 0 / ShadowDepth 4 / Direction 315 / #262521 / Opacity 1
           Shadow.HardPrimary  after  BlurRadius 0 / ShadowDepth 2 / Direction 315 / #262521 / Opacity 0.55
           CardShadow          不动（10 / 2 / 0.10 / #0F1F3A，在档约定只留给浮层）
         三个取舍理由：
         ① 保留 BlurRadius=0 —— 硬边偏移是本项目"印刷卡片"的身份语言（对齐网站 box-shadow:3px 3px 0）。
            加模糊会把身份从硬边印刷换成 Material 柔影，那是比用户诉求大得多的一次改版，且模糊会让阴影
            向四周扩散、反而增加被容器裁掉的风险。用户嫌的是"厚重"，不是"硬"。
         ② 只降 ShadowDepth 与 Opacity —— 变近 + 变浅。沙色影在页面底 #F5F1E8 上由实色 #DED2BC
            降到混合后约 #E8E0D0，墨色影由近黑降到约 #93918B；两者都仍清晰可见（没有变纯平），
            但视觉重量约减半，主次层级也保留（墨色影仍强于沙色影）。
         ③ 不叠加细边框 —— 四个 Shadow.Hard 使用点本来就都有 1px Brush.Border，柔化后卡片轮廓不丢；
            两个 Shadow.HardPrimary 使用点是 BorderThickness=0 的实心色块（Primary / Ink），
            给它们加边框会让 Button.Base 的 IsKeyboardFocused 触发器从 0→2 变成 1→2、并让按钮实宽 +2，
            波及所有按 MinWidth 排布的工具栏与 ActualWidth 断言，代价远大于收益。
         Effect 不参与布局，故 ActualWidth / ActualHeight / TranslatePoint 一律不变，
         冒烟的几何断言不受影响；ShadowDepth 由 3/4 降到 2 还让 :259 提到的右下溢出余量需求变小。
         回退方式：把上面 after 的两个值改回 before 即可，无其它连带改动。 -->
    <DropShadowEffect x:Key="Shadow.Hard" BlurRadius="0" ShadowDepth="2" Direction="315" Color="#DED2BC" Opacity="0.55" />
    <DropShadowEffect x:Key="Shadow.HardPrimary" BlurRadius="0" ShadowDepth="2" Direction="315" Color="#262521" Opacity="0.55" />
    <!-- ───────────────────────── 按钮 ───────────────────────── -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Size.Button}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource CornerRadius.Medium}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停位移：对应网站 .btn:hover{transform:translateY(-2px)} 与 :active{translate(2px,2px)}。
                             用 RenderTransform 而非 Margin —— 前者不参与布局，按钮抬起时不会把相邻元素推走。
                             注意：位移必须作为 Bd 的 RenderTransform 属性设置，不能给 TranslateTransform 起名再用
                             TargetName 引用——XAML 编译器不把 RenderTransform 里的 Freezable 当作可寻址的模板元素（MC4111）。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.84" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Primary：一个页面最多一个 -->
    <!-- 主按钮与次按钮同高：同一个工具栏里不出现两种高度（§27），权重差异只靠颜色与字重 -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- 印刷式硬偏移阴影：对应网站 .btn-primary 的 box-shadow:3px 3px 0 墨色；
             禁用态收掉阴影，避免"能点"的错觉。 -->
        <Setter Property="Effect" Value="{StaticResource Shadow.HardPrimary}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Secondary：白底 + 浅边框 -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Tertiary：纯文字 / 图标，视觉权重最低 -->
    <Style x:Key="Button.Tertiary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 危险但非主操作（退出登录之类） -->
    <Style x:Key="Button.DangerText" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="{DynamicResource Size.Control}" />
        <Setter Property="Height" Value="{DynamicResource Size.Control}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Title-bar icon: no text padding or mouse-persistent focus border.
         FocusVisualStyle retains the keyboard-only focus adorner. -->
    <Style x:Key="Button.TitleBarIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconSurface" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IconSurface" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="IconSurface" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 次按钮 + 危险文字：停止 / 暂停这类非主操作，与同排按钮同高但不高饱和 -->
    <Style x:Key="Button.SecondaryDanger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <!-- 行内图标按钮：表格行、卡片角标里用（28px，比工具栏按钮小一档，不进工具栏） -->
    <Style x:Key="Button.IconSmall" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <!-- 表格行内 / 卡片角落的小按钮 -->
    <Style x:Key="Button.Compact.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
    </Style>
    <Style x:Key="Button.Compact.Primary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
    </Style>
    <Style x:Key="Button.Compact.Tertiary" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
    </Style>
    <Style x:Key="Button.Compact.Danger" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
        <Setter Property="Height" Value="{DynamicResource Size.ButtonCompact}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
    </Style>
    <!-- ── 旧键名别名（页面历史引用，逐步迁移）── -->
    <Style x:Key="RibbonPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}" />
    <Style x:Key="DialogSaveButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinWidth" Value="88" />
    </Style>
    <Style x:Key="RibbonSecondaryButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />
    <Style x:Key="DialogCancelButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinWidth" Value="88" />
    </Style>
    <Style x:Key="RibbonTertiaryButton" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}" />
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}" />
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Button.Danger}" />
    <Style x:Key="CompactToolButton" TargetType="Button" BasedOn="{StaticResource Button.Compact.Secondary}" />
    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Compact.Primary}" />
    <Style x:Key="CompactDangerButton" TargetType="Button" BasedOn="{StaticResource Button.Compact.Danger}" />
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}" />
    <Style x:Key="RibbonDivider" TargetType="Border" BasedOn="{StaticResource Divider.Vertical}" />
    <!-- ───────────────────────── 卡片 ───────────────────────── -->
    <!-- 标准卡片：白底 + 1px 浅边框 + 硬边偏移阴影（对齐网站的印刷卡片观感）。
         阴影不参与布局，但会向右下溢出 2 DIP（§H 柔化前是 3），容器要给卡片留出这点余量否则会被裁掉。 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Hard}" />
    </Style>
    <!-- 承载表格的卡片：内边距为 0，由表格自己控制 -->
    <Style x:Key="CardNoPad" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- 卡片内的次级色块（表单分组、提示条），不要再套一层边框 -->
    <Style x:Key="Card.Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- 卡片头部条：用底色和留白分组，不加分隔线（§26） -->
    <Style x:Key="CardHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.CardHeader}" />
    </Style>
    <!-- 旧键名别名 -->
    <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource Card}" />
    <Style x:Key="ContentCard" TargetType="Border" BasedOn="{StaticResource Card}" />
    <Style x:Key="ContentCardNoPad" TargetType="Border" BasedOn="{StaticResource CardNoPad}" />
    <Style x:Key="ToolbarCard" TargetType="Border" BasedOn="{StaticResource Card}" />
    <Style x:Key="StripCard" TargetType="Border" BasedOn="{StaticResource Card.Inset}" />
    <Style x:Key="StatsBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Small}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="StatInlineText" TargetType="Run">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- ───────────────────────── 表格 ───────────────────────── -->
    <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGridHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.TableHeader}" />
        <Setter Property="Height" Value="{DynamicResource Size.TableHeader}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Stretch" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 行：状态用「点 + 彩字」表达，整行不再染色（§25） -->
    <Style x:Key="TranslationRowStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="{DynamicResource Size.TableRow}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="WrapCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- 全局表格默认值：新加的表格自动一致 -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="{DynamicResource Size.TableRow}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Table}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.BorderLight}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource TranslationRowStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
        <Setter Property="controls:ResponsiveLayout.HandoffMouseWheelAtBoundary" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <!-- ───────────────────────── 输入控件 ───────────────────────── -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource Size.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.PrimarySoft}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource CornerRadius.Small}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ════════════ 下拉框：扁平白底 + 自绘箭头 + 带阴影的浮层（§27 / §29）════════════
         注意：这里必须是完整 ControlTemplate，只设属性会退回系统默认 3D 外观
         （上一轮就是因此把下拉框退回成"旧版"观感）。 -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="{DynamicResource Size.Control}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- 2026-10-02：左内边距 11→10、箭头列 30→28——「全部时间」这类四字项在 116-128 宽
             列里被右侧截断（用户反馈）。配合 ComboBoxItem 模板去掉外边距，闭合框文字总占位
             从 ~25px 缩到 ~20px，四字项 + 箭头在 128 列宽内完整显示。 -->
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CornerRadius.Small}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <!-- 必须用完整 Binding：TemplateBinding 不跟踪 SelectionBoxItem* 的后续更新，
                                     否则 DisplayMemberPath 不生效、下拉框里显示成类型名 -->
                                <ContentPresenter x:Name="SelectionPresenter" Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}" ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Left" SnapsToDevicePixels="True" />
                                <Path Grid.Column="1" Data="{StaticResource Icon.Caret}" Width="10" Height="6" Stretch="Uniform" Fill="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Focusable="True" Background="Transparent" BorderThickness="0" Margin="7,1,30,1" Padding="0" MinWidth="0" Height="Auto" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Effect="{StaticResource CardShadow}">
                                <ScrollViewer Margin="0,4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <!-- 上下 7→6：闭合框里选中项被克隆显示，7+7+行高超过 30px 内容高会竖向裁切（"没居中"的成因之一） -->
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <!-- Margin 4,1→0：克隆进闭合框时这圈外边距会把文字再推离左边 4px 并挤占宽度 -->
                    <Border x:Name="Bd" Background="Transparent" Margin="0" CornerRadius="{DynamicResource CornerRadius.Small}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- ───────────────────────── 浮层（菜单 / Tooltip / 滚动条 / 进度）───────────────────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Small}" Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="#0F1F3A" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12" Color="#0F1F3A" />
                        </Border.Effect>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <!-- Scoped toolbar dropdown templates: retain native keyboard and command behavior, not native chrome. -->
    <Style x:Key="Menu.Command" TargetType="MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuSurface" Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Menu.ToolbarDropdown" TargetType="MenuItem">
        <Setter Property="Height" Value="{DynamicResource Size.Button}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Menu.Command}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Grid>
                <Border x:Name="DropdownSurface" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Width="8" Height="4" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="None">
                    <Border x:Name="DropdownPanel" MinWidth="160" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="DropdownSurface" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" /></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="DropdownSurface" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                    <Setter TargetName="DropdownSurface" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropdownSurface" Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LoadingPulse"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="0.25" To="0.85" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="LoadingPulse" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ════ 兜底与滚动条（保留原有实现，仅换用新令牌）════ -->
    <!-- 兜底：没显式指定样式的按钮一律走 Tertiary，避免冒出系统默认按钮 -->
    <Style TargetType="Button" BasedOn="{StaticResource Button.Tertiary}" />
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.ScrollThumb}" CornerRadius="4" Margin="2,0" SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageUp" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageDown" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 页面区块容器。旧写法是「透明底 + 只有一条顶线」，那是分区而不是卡片，
         也是用户说「没有框架、很乱」的直接来源。现在与 Card 同为印刷卡片。
         §L14 用户反馈「文字太靠近左边边框」：Padding 从 16 的妥协值回到 Spacing.Card(20)。
         冒烟对高度的断言全是下界（≥40/≥64/≥120…），加 4 DIP 内边距只会更安全。 -->
    <Style x:Key="Section.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Hard}" />
    </Style>
    <Style x:Key="Drawer.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="{DynamicResource Size.Drawer}" />
        <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"/>
        <Style.Triggers><DataTrigger Binding="{Binding Path=(controls:ResponsiveLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="Focus.Outline" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="1" StrokeDashArray="2 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>
<Style TargetType="controls:EmptyState">
 <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MaxWidth" Value="440"/><Setter Property="Margin" Value="20"/><Setter Property="Focusable" Value="False"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:EmptyState"><StackPanel>
 <Path Data="M4,1 L17,1 L24,8 L24,31 L4,31 Z M17,1 L17,8 L24,8 M9,15 L19,15 M9,21 L19,21" Style="{StaticResource EmptyState.Icon}" Width="32" Height="38" HorizontalAlignment="Center" Margin="0,0,0,16"/>
 <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource EmptyState.Title}" TextWrapping="Wrap"/>
 <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource EmptyState.Description}" TextWrapping="Wrap" Margin="0,4,0,16"/>
 <ContentPresenter HorizontalAlignment="Center" ContentSource="Content"/>
 </StackPanel></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Settings.NavigationItem" TargetType="ListBoxItem">
 <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,4"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/></Trigger>
 <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/></Trigger>
 <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Search.Input" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="0,0,10,0" />
    <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox">
            <Border x:Name="SearchBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Icon.Search}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5" IsHitTestVisible="False"/>
                    <Grid Grid.Column="1">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SearchBorder" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Setter.Value></Setter>
</Style>
<Style x:Key="Callout.Error" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSize.Body}" />
</Style>
</ResourceDictionary>
