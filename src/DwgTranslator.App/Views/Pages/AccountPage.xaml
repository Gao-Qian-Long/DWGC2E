<UserControl x:Class="DwgTranslator.App.Views.Pages.AccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18">
      <TextBlock Text="账号中心" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="登录、套餐与设备管理" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,18" />
      <Border Style="{StaticResource Card}" HorizontalAlignment="Left" Width="430" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
        <StackPanel>
          <TextBlock Text="登录账号" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Text="可以先浏览软件；云端翻译需要登录。" TextWrapping="Wrap" Margin="0,0,0,20" />
          <TextBlock Text="账号" Margin="0,0,0,6" />
          <TextBox x:Name="AccountInput" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" AutomationProperties.Name="登录账号" />
          <TextBlock Text="密码" Margin="0,14,0,6" />
          <PasswordBox x:Name="PasswordInput" MinHeight="34" Padding="8" KeyDown="Password_KeyDown" AutomationProperties.Name="登录密码" />
          <Button Content="登录" Style="{StaticResource Button.Primary}" Margin="0,20,0,0" Click="Login_Click" IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding AccountFeedback}" TextWrapping="Wrap" Margin="0,14,0,14" Foreground="{DynamicResource Brush.TextSecondary}" />
      <Button Content="重新验证会话" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Tertiary}" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding HasSavedAccountSession, Converter={StaticResource BoolToVis}}" />
    <StackPanel Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="刷新" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0" />
              <Button Content="退出登录" Command="{Binding LogoutAccountCommand}" Style="{StaticResource Button.Tertiary}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding AccountDisplayNameText}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountEmailText}" />
              <TextBlock Text="{Binding OnlinePlanText}" Margin="0,10,0,2" />
              <TextBlock Text="{Binding OnlineQuotaText}" />
              <TextBlock Text="{Binding OnlineMembershipExpiryText}" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Pro 会员 · 开通与续费" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="登录官网即可购买或续费，当前价格与权益以官网套餐为准。付款后返回此处刷新会员信息。" TextWrapping="Wrap" Margin="0,8,0,12" />
            <Button Content="前往官网开通 / 续费" Command="{Binding OpenMembershipCheckoutCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" />
            <TextBlock Text="请在官网登录相同账号。付款后点击上方“刷新”，同步会员有效期和额度。" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="登录设备" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
        <TextBlock Text="{Binding DeviceCountText}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding OnlineDevices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="移除设备" Style="{StaticResource Button.Secondary}" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  <StackPanel>
                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource Brush.TextMuted}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>