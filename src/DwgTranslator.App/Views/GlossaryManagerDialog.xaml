<Window x:Class="DwgTranslator.App.Views.GlossaryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Title="{conv:Localize GlossaryManagerTitle}"
        Width="650" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}"
        MaxHeight="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="{conv:Localize GlossaryDesc}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" x:Name="GlossaryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  SelectionMode="Extended"
                  Margin="0,0,0,8"
                  FontSize="12"
                  RowHeight="28"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Brush.BorderLight}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#37474F"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{conv:Localize GlossaryColSource}" Binding="{Binding Source}" Width="220"/>
                <DataGridTextColumn Header="{conv:Localize GlossaryColTarget}" Binding="{Binding Target}" Width="220"/>
                <DataGridTextColumn Header="{conv:Localize GlossaryColCategory}" Binding="{Binding Category}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="+ 新增术语" Padding="10,5" Margin="0,0,6,0"
                    Click="AddRow_Click" Cursor="Hand" FontSize="12"
                    Background="{DynamicResource Brush.Success}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button x:Name="DeleteSelectedButton" Content="删除选中" Padding="10,5"
                    Click="DeleteSelected_Click" Cursor="Hand" FontSize="12"
                    Background="{DynamicResource Brush.Danger}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="{conv:Localize BtnSaveGlossary}" Padding="14,6" Margin="0,0,8,0"
                    Background="{DynamicResource Brush.Primary}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                    Click="Save_Click" Cursor="Hand" BorderThickness="0"/>
            <Button Content="{conv:Localize BtnCancel}" Padding="14,6" FontSize="12"
                    Click="Cancel_Click" Cursor="Hand" Background="{DynamicResource Brush.BackgroundAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
