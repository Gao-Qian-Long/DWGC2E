<Window x:Class="DwgTranslator.App.Views.BillingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:conv="clr-namespace:DwgTranslator.App.Converters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True" SnapsToDevicePixels="True" Title="会员购买与订单" Width="1020" Height="700" MinWidth="820" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Microsoft YaHei UI, Segoe UI">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BillingPresentationConverter x:Key="BillingDisplay"/>
        <Style x:Key="OrderActionHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="OrderActionCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><DockPanel><controls:TitleBarControl DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True"/><StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.LeftGap}"><Border Background="{DynamicResource Brush.Primary}" CornerRadius="4" Width="24" Height="24"><TextBlock Text="D" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="会员购买与订单" Margin="{DynamicResource Spacing.LeftGap}" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>

        <!-- Purchase on the left, order history on the right: the history table is the surface the
             user returns to after paying, so it owns the flexible height instead of a fixed 150. -->
        <Grid Grid.Row="1" Margin="{DynamicResource Spacing.24}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="套餐与订单" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="Account" Margin="{DynamicResource Spacing.CardInset}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Entitlements" Margin="{DynamicResource Spacing.StackLoose}" TextWrapping="Wrap" />
                    <TextBlock Text="套餐与金额以服务器为准 · 本次购买绑定上述账号" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource Brush.BackgroundAlt}" Padding="12" Margin="{DynamicResource Spacing.Vertical}">
                        <TextBlock x:Name="PurchaseAvailability" Text="正在检查购买服务…" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                    <ComboBox x:Name="Plans" DisplayMemberPath="Label" Margin="{DynamicResource Spacing.Vertical}" />
                    <TextBlock Text="新购买支付方式：目前仅支持支付宝。下方二维码属于所显示的订单，不会因套餐选择而更换。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Stack}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <StackPanel x:Name="PaymentMethods" Orientation="Horizontal" Margin="{DynamicResource Spacing.Vertical}">
                        <RadioButton x:Name="Alipay" Content="支付宝" IsChecked="True" Margin="{DynamicResource Spacing.InlineLeading}" />
                        <RadioButton x:Name="WechatPay" Content="微信支付（暂未开通）" IsEnabled="False" ToolTip="微信支付通道尚未接入，当前仅支持支付宝。" ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                    <WrapPanel Margin="{DynamicResource Spacing.Vertical}">
                        <Button Style="{StaticResource Button.Primary}" x:Name="Buy" Content="确认套餐并获取二维码" Click="Buy_Click" Padding="14,0" IsEnabled="False" />
                        <Button Style="{StaticResource Button.Secondary}" Content="刷新订单与会员" Click="Refresh_Click" Padding="14,0" Margin="{DynamicResource Spacing.LeftGap}" />
                    </WrapPanel>
                    <TextBlock x:Name="Message" Text="正在加载…" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock x:Name="OrderDetails" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" />
                    <TextBlock x:Name="QrStatus" Text="尚未选择订单。可从历史订单查看付款状态。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <Image x:Name="Qr" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />
                    <TextBlock Text="二维码展示期限结束不代表平台关单。已付款请勿再次支付，系统将继续确认。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="历史订单（选择可查看）" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="{DynamicResource Spacing.Stack}">
                    <DataGrid x:Name="Orders" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Orders_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="订单" Binding="{Binding OrderNo, Converter={StaticResource BillingDisplay}, ConverterParameter=Order}" Width="*" />
                            <DataGridTextColumn Header="套餐" Binding="{Binding PlanName}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding DisplayState, Converter={StaticResource BillingDisplay}}" Width="120" />
                            <DataGridTextColumn Header="金额" Binding="{Binding PayableCents, Converter={StaticResource BillingDisplay}, ConverterParameter=Amount}" Width="85" />
                            <DataGridTemplateColumn Header="操作" Width="80" MinWidth="80" HeaderStyle="{StaticResource OrderActionHeader}" CellStyle="{StaticResource OrderActionCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="复制" AutomationProperties.Name="复制订单号" ToolTip="{Binding OrderNo}" Click="CopyOrder_Click" Tag="{Binding OrderNo}"
                                                Style="{StaticResource Button.Compact.Tertiary}" Width="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState x:Name="EmptyOrders" Header="暂无订单" Description="当前账号尚无历史订单。" Visibility="Collapsed"/>
                </Grid>
                <Button Style="{StaticResource Button.Tertiary}" x:Name="More" Grid.Row="2" Content="更多订单" Click="More_Click" HorizontalAlignment="Left" Padding="12,0" IsEnabled="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
