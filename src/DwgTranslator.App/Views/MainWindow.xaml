<Window x:Class="DwgTranslator.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:DwgTranslator.App.Converters" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:pages="clr-namespace:DwgTranslator.App.Views.Pages" xmlns:views="clr-namespace:DwgTranslator.App.Views" Title="{conv:Localize AppTitle}" Height="820" Width="1500" MinHeight="360" MinWidth="600" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True" Icon="pack://application:,,,/DwgTranslator;component/icon.ico" WindowStartupLocation="CenterScreen" Topmost="False" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDragLeave="OnPreviewDragLeave" PreviewDrop="OnPreviewDrop" Background="{DynamicResource Brush.Background}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <!-- Keyboard shortcuts: F1 帮助 / Ctrl+E 环境自检 / Ctrl+L 日志 … -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportDwgCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportDwgCommand}" />
        <KeyBinding Key="F5" Command="{Binding TranslateCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ShowEnvironmentCheckCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLogViewerCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- Sidebar uses the shared warm accent and retains keyboard focus. -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{DynamicResource Size.NavItem}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 保留键盘焦点提示。 -->
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Outline}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Margin="-8,2,0,2" CornerRadius="2" Background="Transparent" />
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Size.Sidebar}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- 会员状态：只显示真实授权状态（后端未接通时不伪造套餐/额度） -->
                    <Border Style="{StaticResource Badge.Accent}" Padding="9,3" Margin="0,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.StatPin}" Width="12" Height="12" Stretch="Uniform" Fill="Transparent" Margin="0,0,5,0" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
                            <TextBlock Text="{Binding LicenseStatusText}" Style="{StaticResource Badge.AccentText}" />
                        </StackPanel>
                    </Border>
                    <!-- 用户入口：账号 / 置顶 / 环境自检 / 帮助 -->
                    <Button x:Name="TopmostButton" Command="{Binding ToggleTopmostCommand}" Width="36" Height="36" WindowChrome.IsHitTestVisibleInChrome="True" >
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.TitleBarIcon}">
                            <Setter Property="ToolTip" Value="固定窗口"/>
                            <Setter Property="AutomationProperties.Name" Value="固定窗口"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                <Setter Property="ToolTip" Value="取消固定"/>
                                <Setter Property="AutomationProperties.Name" Value="取消固定"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                        <Grid Width="16" Height="18"><Path Data="M 3,1 L 13,1 L 11,4 L 11,8 L 15,12 L 1,12 L 5,8 L 5,4 Z M 8,12 L 8,17" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent" /><Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path></Grid>
                    </Button>

                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Divider.Vertical}" />
                <controls:TitleBarControl Grid.Column="2" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Brush.StatusBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,0" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ShellStatusText}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <!-- 任务层当前阶段（例：[3/6] 总装配图.dwg 正在翻译文本 42%）：状态栏直接说清
                             "在做什么"，而不是只给一个百分比。无任务阶段时自动隐藏。 -->
                    <TextBlock Text="{Binding ProgressDetailText}" FontSize="12" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="460" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressDetailText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ProgressBar Grid.Column="1" Margin="20,0" MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center" Value="{Binding ProgressValue}" Maximum="100" Foreground="{DynamicResource Brush.Primary}" Background="{DynamicResource Brush.BackgroundAlt}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="2" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" Text="{Binding EtaText}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersionText}" ToolTip="{Binding AppVersionText}" TextTrimming="CharacterEllipsis" MaxWidth="330" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- ═══════════ 左侧导航 ═══════════ -->
        <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,24,16,24">
                    <Border Width="32" Height="32" CornerRadius="{DynamicResource CornerRadius.Medium}" Margin="0,0,12,0" Background="{DynamicResource Brush.Primary}">
                        <TextBlock Text="D" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DWGC2E" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="DWG Translation" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>
                <!-- 页面导航 -->
                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0" SelectedValuePath="Tag" SelectedValue="{Binding CurrentPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="translate" AutomationProperties.Name="图纸翻译">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.NavTranslate}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="0,0,12,0" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.3" />
                            <TextBlock Text="图纸翻译" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="batch" AutomationProperties.Name="批量任务">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.NavBatch}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="0,0,12,0" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.3" />
                            <TextBlock Text="批量任务" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="glossary" AutomationProperties.Name="术语库">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.NavGlossary}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="0,0,12,0" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.3" />
                            <TextBlock Text="术语库" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="account" AutomationProperties.Name="会员中心">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.NavAccount}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="0,0,12,0" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.3" />
                            <TextBlock Text="会员中心" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.NavSettings}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.3" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,1,0,0" Margin="16,0,16,12">
                    <Button x:Name="AccountMenuButton" ToolTip="{Binding AccountEntryText}" Style="{StaticResource Button.Tertiary}" Height="64" HorizontalAlignment="Stretch" Padding="12,0" Click="GlobalAccount_Click">
                        <Button.Content>
                            <Grid Width="152">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AccountAvatarText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountEntryText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OnlinePlanText}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="会员中心" Command="{Binding LoginAccountCommand}" />
                                <MenuItem Header="退出登录" Command="{Binding LogoutAccountCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <!-- ═══════════ 内容列 ═══════════ -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}">
            <!-- 顶部 Header（52px）：会员状态 · 用户入口 · 窗口控制（§9） -->
            <!-- 页面宿主：五页常驻，切换只改可见性，编辑状态不丢 -->
            <ScrollViewer x:Name="PageViewport" SizeChanged="PageViewport_SizeChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PageHost" MinWidth="700" MinHeight="640">
                    <pages:TranslatePage Visibility="{Binding IsTranslatePage, Converter={StaticResource BoolToVis}}" />
                    <pages:BatchTasksPage Visibility="{Binding IsBatchPage, Converter={StaticResource BoolToVis}}" />
                    <pages:GlossaryPage Visibility="{Binding IsGlossaryPage, Converter={StaticResource BoolToVis}}" />
                    <pages:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
                    <pages:AccountPage Visibility="{Binding IsAccountPage, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>
            <!-- 底栏：当前任务 + 总进度 + 预计剩余时间 -->
        </Grid>
        <Border x:Name="ModalScrim" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#660F172A" Panel.ZIndex="99" Visibility="Collapsed" />
        <!-- 操作结果 Toast 浮层（§29）：右下角堆叠，不阻塞操作 -->
        <controls:ToastHost x:Name="Toasts" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="19" />
        <!-- 拖入提示覆盖层（IsHitTestVisible=False 保证拖放事件回到窗口本身） -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Color.DropScrim}" Opacity="0.55" />
            </Border.Background>
            <Border Width="540" Padding="30,26" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2">
                <StackPanel>
                    <Path x:Name="DropOverlayIcon" Data="{StaticResource Icon.EmptySheet}" Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock Text="{conv:Localize DropHintTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{conv:Localize DropHintDesc}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                    <TextBlock x:Name="DropOverlayFiles" FontSize="12" Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>