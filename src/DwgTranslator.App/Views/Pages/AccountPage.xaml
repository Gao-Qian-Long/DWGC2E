<UserControl x:Class="DwgTranslator.App.Views.Pages.AccountPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
 MinWidth="640">
 <UserControl.Resources><conv:BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid Margin="18,14,18,10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="会员中心" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="账号、套餐与设备管理" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
    <TextBlock Text="DWGC2E" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
   </Border>
  </Grid>

  <!-- 唯一账号入口，页面内不再重复渲染登录卡片 -->
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.PrimarySoft}" VerticalAlignment="Center">
     <TextBlock Text="{Binding AccountAvatarText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding AccountDisplayNameText}" Style="{StaticResource CardTitleStyle}" FontSize="14"/>
     <TextBlock Text="{Binding AccountEmailText}" Style="{StaticResource CaptionStyle}" Margin="0,1,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="登录账号" Command="{Binding LoginAccountCommand}" Style="{StaticResource Button.Primary}" Padding="13,5" Margin="0,0,5,0" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
     <Button Content="刷新" Command="{Binding RefreshAccountCommand}" Style="{StaticResource Button.Tertiary}" Padding="9,5" Margin="0,0,3,0" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolVisibility}}"/>
     <Button Content="退出" Command="{Binding LogoutAccountCommand}" Style="{StaticResource Button.Tertiary}" Padding="9,5" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="13" Margin="0,0,5,5">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="当前套餐" Style="{StaticResource CardTitleStyle}"/>
     <TextBlock Grid.Row="1" Text="{Binding OnlinePlanText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,5,0,0"/>
     <TextBlock Grid.Row="2" Text="{Binding OnlineQuotaText}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
    </Grid>
   </Border>

   <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="13" Margin="5,0,0,5">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="当前设备" Style="{StaticResource CardTitleStyle}"/>
     <TextBlock Grid.Row="1" Text="{Binding MachineName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Text="{Binding DeviceCountText}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
    </Grid>
   </Border>

   <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="13" Margin="0,5,5,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="授权与服务" Style="{StaticResource CardTitleStyle}"/>
     <TextBlock Grid.Row="1" Text="{Binding AccountSessionText}" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0"/>
     <Button Grid.Row="2" Content="打开设置" Command="{Binding NavigateToCommand}" CommandParameter="settings" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Padding="11,5" Margin="0,8,0,0"/>
    </Grid>
   </Border>

   <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="13" Margin="5,5,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="设备管理" Style="{StaticResource CardTitleStyle}"/>
     <TextBlock Grid.Row="1" Text="已登录设备可在此查看与移除" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0"/>
     <Button Grid.Row="2" Content="环境检查" Command="{Binding ShowEnvironmentCheckCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Padding="11,5" Margin="0,8,0,0"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>



