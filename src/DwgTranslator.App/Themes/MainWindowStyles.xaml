<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DwgTranslator.App.Converters">

    <!-- ============================================================
         DWG Translator — Shared Styles
         All colors reference ColorTokens.xaml via DynamicResource
         ============================================================ -->

    <!-- Converters -->
    <conv:StatusToBrushConverter x:Key="StatusBrush"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

    <!-- Drop Shadow Effect -->
    <DropShadowEffect x:Key="CardShadow" ShadowDepth="1" BlurRadius="12" Opacity="0.07" Direction="270"/>

    <!-- ── ToolButton (Ghost/Transparent) ── -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary Action Button ── -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource CardShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Danger Button ── -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource CardShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Dialog Footer Buttons ── -->
    <Style x:Key="DialogSaveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
    <Style x:Key="DialogCancelButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>

    <!-- ── Section Header ── -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ── Card Border ── -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Large}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- ── Input Label ── -->
    <Style x:Key="InputLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>

    <!-- ── Description Text ── -->
    <Style x:Key="DescriptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── DataGrid Header ── -->
    <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGridHeader}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
    </Style>

    <!-- ── DataGrid Cell ── -->
    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── DataGrid Row (Translation) ── -->
    <Style x:Key="TranslationRowStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="0">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            </Trigger>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FAFBFB"/>
            </Trigger>
            <DataTrigger Binding="{Binding Status}" Value="Translated">
                <Setter Property="Background" Value="#F5FBF8"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Reviewed">
                <Setter Property="Background" Value="#F0F9F5"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="TranslationFailed">
                <Setter Property="Background" Value="#FFF7F7"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                <Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding GlossaryHit}" Value="True">
                <Setter Property="Background" Value="#FFFDF6"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Cell Styles ── -->
    <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WrapCellStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ── Stats Badge ── -->
    <Style x:Key="StatsBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Small}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════
         Card-System Styles
         ════════════════════════════════════════════════════════ -->

    <!-- Card header label — small, muted, for card title bars -->
    <Style x:Key="CardHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Toolbar card group — compact card for grouping related toolbar buttons -->
    <Style x:Key="ToolbarCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- Content card — full card wrapper for major content areas -->
    <Style x:Key="ContentCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Large}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- Card with no padding — for wrapping DataGrid edge-to-edge -->
    <Style x:Key="ContentCardNoPad" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Large}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- Thin strip card for progress / status -->
    <Style x:Key="StripCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Small}"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <!-- Card header bar — thin accent strip with bottom border -->
    <Style x:Key="CardHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <!-- Vertical divider between toolbar card groups -->
    <Style x:Key="ToolbarDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- ═══ Ribbon-Style Styles ═══ -->

    <!-- Ribbon primary button — large filled CTA for Translate -->
    <Style x:Key="RibbonPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource CardShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon secondary button — outlined for file actions -->
    <Style x:Key="RibbonSecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon tertiary button — ghost/icon+text for tools -->
    <Style x:Key="RibbonTertiaryButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon divider — vertical 1px line between groups -->
    <Style x:Key="RibbonDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Margin" Value="12,6"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- Stat inline text — monospace numbers -->
    <Style x:Key="StatInlineText" TargetType="Run">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Compact tool button for inside cards -->
    <Style x:Key="CompactToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Compact primary button for inside cards -->
    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Compact danger button for inside cards -->
    <Style x:Key="CompactDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="1"/>
    </Style>

</ResourceDictionary>
