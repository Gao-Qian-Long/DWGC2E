<Window x:Class="DwgTranslator.App.Views.LoginDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="登录账号" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{DynamicResource Brush.Surface}" FontFamily="Microsoft YaHei UI, Segoe UI">
 <StackPanel Margin="28">
  <TextBlock Text="登录账号" Style="{StaticResource PageTitleStyle}"/>
  <TextBlock Text="使用已配置的 Worker 服务登录。" Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,24"/>
  <TextBlock Text="账号" Margin="0,0,0,8"/>
  <TextBox x:Name="Account" AutomationProperties.Name="账号" Margin="0,0,0,16"/>
  <TextBlock Text="密码" Margin="0,0,0,8"/>
  <PasswordBox x:Name="Password" AutomationProperties.Name="密码" Height="36" Padding="10,6"
   BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
  <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button Content="取消" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
   <Button x:Name="Submit" Content="登录" IsDefault="True" Click="Login_Click" Style="{StaticResource Button.Primary}"/>
  </StackPanel>
 </StackPanel>
</Window>
