<UserControl x:Class="DwgTranslator.App.Views.Pages.TranslatePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:PageHeader x:Name="WorkspaceHeader" Header="图纸翻译" Description="翻译图纸文字，保持结构与版式；完成后显式导出新图纸。">
            <Button Content="添加图纸" Command="{Binding ImportDwgCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDrawingFiles}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </controls:PageHeader>
        <Border Grid.Row="1" x:Name="AccountStrip" Style="{StaticResource Workspace.InfoStrip}" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="查看套餐" Command="{Binding NavigateToCommand}" CommandParameter="account" Style="{StaticResource Button.Tertiary}" />
                <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OnlinePlanText}" Margin="0,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding OnlineQuotaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OnlineQuotaText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Grid>
            </DockPanel>
        </Border>
<ScrollViewer x:Name="TranslationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition x:Name="QueueAreaRow" Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>        <Grid Grid.Row="0">
        <Border x:Name="EmptyDropZone" MaxHeight="360" MinHeight="160" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0" Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}, ConverterParameter=false}">
            <Grid x:Name="DropZoneCenter" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Path Data="{StaticResource Icon.Log}" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16"/>
<TextBlock Grid.Row="1" Text="将 DWG / DXF 文件拖到此处" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
<TextBlock Grid.Row="2" Text="支持 .dwg / .dxf，可一次添加多个文件" Style="{StaticResource CaptionStyle}" TextAlignment="Center" Margin="0,8,0,16"/>
<Button Grid.Row="3" Content="选择文件" HorizontalAlignment="Center" MinWidth="120" Command="{Binding ImportDwgCommand}" Style="{StaticResource Button.Secondary}"/>
</Grid>
        </Border>
        </Grid>
        <Grid Grid.Row="0" x:Name="QueueWorkspace" Visibility="{Binding HasDrawingFiles, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="队列操作" Click="QueueMenu_Click" Style="{StaticResource Button.Tertiary}" ToolTip="选择与清空队列">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="全部选为导出" Command="{Binding SelectAllDrawingOutputsCommand}" />
                                <MenuItem Header="取消全部导出选择" Command="{Binding ClearDrawingOutputsCommand}" />
                                <Separator />
                                <MenuItem Header="清空队列…" Command="{Binding ClearAllCommand}" Foreground="{DynamicResource Brush.Danger}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DrawingFiles.Count, StringFormat=共 {0} 张}" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="文件队列" Style="{StaticResource SectionTitleStyle}" />
            </DockPanel>
            <Grid Grid.Row="1">
                <DataGrid x:Name="DrawingQueue" ItemsSource="{Binding DrawingFiles}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" RowHeight="{DynamicResource Size.TableRow}" FontSize="13" GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="导出" Binding="{Binding IsIncludedForExport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*" MinWidth="180" IsReadOnly="True" ElementStyle="{StaticResource WrapCellStyle}" />
                        <DataGridTemplateColumn Header="状态" Width="120" IsReadOnly="True" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}" />
                                                    <Style.Triggers>
                                                        <!-- 任务层的 10 态：处理中的阶段统一主色，失败/取消/暂停用告警色，
                                                                         用户一眼能看出「在跑 / 跑完了 / 出问题了」，不必逐字读状态名。 -->
                                                        <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="解析中">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="提取文本">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="翻译中">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="排版优化">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="写回中">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="部分失败">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="完成（含失败）">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="已暂停">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="已取消">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="导入失败">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" ToolTip="{Binding SummaryText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="文本数量" Binding="{Binding TextCountText}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}" />
                        <DataGridTemplateColumn Header="进度" Width="150" IsReadOnly="True" SortMemberPath="ProgressPercent">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Height="4" VerticalAlignment="Center" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{DynamicResource Brush.Primary}" Background="{DynamicResource Brush.BackgroundAlt}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}" />
                        <DataGridTemplateColumn Header="操作" Width="180" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource CompactToolButton}" Command="{Binding DataContext.OpenDrawingFileItemsCommand,&#xA;                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="查看该图纸的文本条目">
                                            <TextBlock Text="校对" />
                                        </Button>
                                        <Button Content="打开" Style="{StaticResource Button.Compact.Secondary}" Margin="8,0,0,0" Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.OpenDrawingOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <Border x:Name="TranslationSettingsSection" Grid.Row="1" Style="{StaticResource Section.Surface}" Margin="0,12,0,0" Padding="0,16,0,0">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="翻译设置" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="48"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="源语言" Style="{StaticResource InfoLabel}"/><ComboBox Height="34" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding CurrentSourceLang, Mode=TwoWay}"/></StackPanel>
   <Button Grid.Column="1" Content="⇄" ToolTip="交换语言" Command="{Binding SwapLanguagesCommand}" Style="{StaticResource Button.Tertiary}" Width="40" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
   <StackPanel Grid.Column="2"><TextBlock Text="目标语言" Style="{StaticResource InfoLabel}"/><ComboBox Height="34" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding CurrentTargetLang, Mode=TwoWay}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="术语库" FontWeight="SemiBold"/><TextBlock Text="{Binding GlossaryStatsText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="管理术语库" Command="{Binding NavigateToCommand}" CommandParameter="glossary" Style="{StaticResource Button.Tertiary}"/></Grid>
 </Grid>
</Border>
<Border x:Name="OutputSection" Grid.Row="2" Style="{StaticResource Section.Surface}" Margin="0,12,0,0" Padding="0,16,0,0">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="输出" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding OutputDirectoryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectoryText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="打开输出目录" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource Button.Tertiary}" Margin="12,0"/><Button Grid.Column="2" Content="输出设置" Command="{Binding NavigateToCommand}" CommandParameter="settings" Style="{StaticResource Button.Tertiary}"/></Grid></Grid>
</Border>
<Expander Grid.Row="3" x:Name="WorkspaceLog" Header="运行日志" Margin="0,8,0,0">
            <Grid Height="170" Background="{DynamicResource Brush.BackgroundAlt}" DataContext="{Binding LogViewModel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制" Command="{Binding CopyLogsCommand}" Style="{StaticResource Button.Tertiary}" />
                    <Button Content="清空" Command="{Binding ClearLogsCommand}" Style="{StaticResource Button.Tertiary}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CompactDisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Expander></Grid></ScrollViewer><Border x:Name="TranslationActionBar" Grid.Row="3" Style="{StaticResource Section.Surface}" Margin="0,12,0,0" Padding="0,12,0,0">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ExportSelectionButton" Content="导出所选图纸" Command="{Binding ExportDwgCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding TranslatedCount}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding HasDrawingFiles}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="取消导出" Command="{Binding CancelExportCommand}" Style="{StaticResource Button.Danger}" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button IsEnabled="{Binding HasDrawingFiles}" Content="开始翻译" Command="{Binding TranslateCommand}" Style="{StaticResource Button.Primary}" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}, ConverterParameter=false}"/><Button Content="正在翻译…" IsEnabled="False" Style="{StaticResource Button.Primary}" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"/><Button Content="取消任务" Command="{Binding CancelTranslateCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"/></StackPanel></Grid>
</Border>
    </Grid>
</UserControl>


