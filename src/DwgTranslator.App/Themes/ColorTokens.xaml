<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════════════════════
         浅色工程软件配色（第二轮 UI 优化后的唯一颜色来源）。

         规则（与设计基线一致）：
           棕橙 = 主操作 / 当前选中 / 信息      绿 = 成功
           橙 = 会员 / 警告 / 待确认          红 = 错误 / 危险
           灰 = 次级 / 禁用 / 等待
         不要在页面里写十六进制字面量：新增语义请在这里加键。
         键名保持不变（历史页面全部通过 DynamicResource 引用），只调整色值。
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Brand mapping: D:/DWGC2E_Website/css/theme.css (:root); desktop sizes remain productivity-oriented. -->
    <SolidColorBrush x:Key="Brush.BrandAccent" Color="#D97728" />
    <!-- 主色（网站 primary / brand-deep） -->
    <SolidColorBrush x:Key="Brush.Primary" Color="#974719" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#843C16" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="#854018" />
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="#F2E3D8" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#F2E3D8" />
    <!-- 表面与底色 -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFCF5" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F7F5F0" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#F7F5F0" />
    <SolidColorBrush x:Key="Brush.Background" Color="#F5F1E8" />
    <SolidColorBrush x:Key="Brush.BackgroundAlt" Color="#EEEAE3" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFCF5" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFCF5" />
    <SolidColorBrush x:Key="Brush.ToolBar" Color="#FFFCF5" />
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#FFFCF5" />
    <!-- 文字层级：主 / 次 / 说明 / 禁用 -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#262521" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#60594F" />
    <!-- 2026-09-19 杂志风重构：#777168 在纸面上对比度 4.4:1 低于 WCAG 4.5，加深。 -->
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E675D" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#6E675D" />
    <!-- 边框：常用 / 更浅（卡片分隔） / 更强（输入框 hover） -->
    <SolidColorBrush x:Key="Brush.Border" Color="#DED2BC" />
    <SolidColorBrush x:Key="Brush.BorderLight" Color="#EDE6D8" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#B7AB96" />
    <!-- 状态色（只表达状态，不做装饰） -->
    <SolidColorBrush x:Key="Brush.Success" Color="#4E765E" />
    <SolidColorBrush x:Key="Brush.SuccessLight" Color="#EAF0E9" />
    <!-- Deep enough to stay readable on paper and warning-light surfaces. -->
    <Color x:Key="Color.Warning">#835D27</Color>
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningLight" Color="#F3ECDF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#A34E49" />
    <SolidColorBrush x:Key="Brush.DangerLight" Color="#F5E9E6" />
    <SolidColorBrush x:Key="Brush.Info" Color="#974719" />
    <SolidColorBrush x:Key="Brush.InfoLight" Color="#F2E3D8" />
    <!-- 橙色强调：会员标识 / 警告 / 待确认 -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#974719" />
    <SolidColorBrush x:Key="Brush.AccentLight" Color="#F2E3D8" />
    <!-- 浮层与滚动条（阴影只给浮层/菜单/弹窗用） -->
    <SolidColorBrush x:Key="Brush.Overlay" Color="#801E1E1B" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#B7AB96" />
    <Color x:Key="Color.DropScrim">#262521</Color>
    <SolidColorBrush x:Key="Brush.TitleBarBackground" Color="#FFFCF5" />
    <SolidColorBrush x:Key="Brush.DataGridHeader" Color="#F7F5F0" />
    <!-- 全局统一为 2px 纸卡方角，与网站印刷式轮廓一致。 -->
    <CornerRadius x:Key="CornerRadius.Small" TopLeft="2" TopRight="2" BottomLeft="2" BottomRight="2" />
    <CornerRadius x:Key="CornerRadius.Medium" TopLeft="2" TopRight="2" BottomLeft="2" BottomRight="2" />
    <CornerRadius x:Key="CornerRadius.Large" TopLeft="2" TopRight="2" BottomLeft="2" BottomRight="2" />
    <CornerRadius x:Key="CornerRadius.Pill" TopLeft="2" TopRight="2" BottomLeft="2" BottomRight="2" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         暖色手作杂志风（2026-09-19 重构新增；键名可增不可改，规则同上）。
         品牌宪法：奶白纸底＋墨色反白分区＋琥珀橙高光＋沙土米辅助。
         · 墨色 Ink：深色反白区块（侧栏/会员横幅/页脚条），文字用 OnInk 系。
         · 琥珀 Amber #D97728 只做装饰/大图形/墨底上的高光——它在纸面上
           对比度仅 3.0:1，禁止用作浅底小号文字；浅底上的琥珀系文字一律
           用 Brush.Primary（#974719，6.1:1）。
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 墨色反白分区
         2026-10-02 用户反馈：深灰黑对比度太高看着不舒服。整体提亮一档（相当于降低"墨浓度"）：
         Ink #262521→#34312A、InkAlt #322E26→#403B30、InkBorder #45402F→#544D3B。
         反白文字对比度仍达标：OnInk 11.5:1、OnInkMuted(#B4AB99) 5.7:1。 -->
    <SolidColorBrush x:Key="Brush.Ink" Color="#34312A" />
    <SolidColorBrush x:Key="Brush.InkAlt" Color="#403B30" />
    <SolidColorBrush x:Key="Brush.InkBorder" Color="#544D3B" />
    <SolidColorBrush x:Key="Brush.OnInk" Color="#F7F2E7" />
    <SolidColorBrush x:Key="Brush.OnInkMuted" Color="#B4AB99" />
    <SolidColorBrush x:Key="Brush.OnInkAccent" Color="#E8933F" />
    <!-- 琥珀装饰（波浪线/八芒星/虚线环/票据） -->
    <SolidColorBrush x:Key="Brush.Amber" Color="#D97728" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="#F6E8D5" />
    <!-- 暖色径向光斑：纸面右上角落一层极淡的琥珀光，弱化屏幕冰冷感 -->
    <RadialGradientBrush x:Key="Brush.WarmGlow" GradientOrigin="0.86,0.04" Center="0.86,0.04" RadiusX="0.62" RadiusY="0.72">
        <GradientStop Offset="0" Color="#16D97728" />
        <GradientStop Offset="1" Color="#00D97728" />
    </RadialGradientBrush>
    <!-- 墨底上的进度/分隔（随 Ink 一起提亮，保持"比底色亮一档"的关系） -->
    <SolidColorBrush x:Key="Brush.OnInkTrack" Color="#4A4437" />
</ResourceDictionary>
