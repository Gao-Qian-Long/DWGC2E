<UserControl x:Class="DwgTranslator.App.Views.Pages.GlossaryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" PreviewKeyDown="Workspace_KeyDown">
 <UserControl.Resources>
  <Style x:Key="TermCellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="TermMetaText" TargetType="TextBlock" BasedOn="{StaticResource TermCellText}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
  <Style x:Key="TermSourceText" TargetType="TextBlock" BasedOn="{StaticResource TermMetaText}"><Setter Property="ToolTip" Value="{Binding SourceText}"/></Style>
  <Style x:Key="TermToggle" TargetType="CheckBox"><Setter Property="Focusable" Value="False"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource Brush.BorderStrong}"><Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource Brush.Surface}"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- One state style keeps every toolbar action disabled consistently while the glossary is busy. -->
  <Style x:Key="WorkspaceToolbarState" TargetType="Grid">
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsTermDrawerOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    <DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    <DataTrigger Binding="{Binding IsGlossaryLoading}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    <DataTrigger Binding="{Binding IsWorkspaceSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    <DataTrigger Binding="{Binding IsCloudGlossarySyncing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- 用户反馈「勾选后才出现」：批量操作条常显，无选中项时整条置灰（Tag=Empty 由 Selection_Changed 维护），
       与 WorkspaceToolbarState 的忙碌禁用叠加，不覆盖后者。 -->
  <Style x:Key="SelectionToolbarState" TargetType="Grid" BasedOn="{StaticResource WorkspaceToolbarState}">
   <Style.Triggers>
    <Trigger Property="Tag" Value="Empty"><Setter Property="IsEnabled" Value="False"/></Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="{DynamicResource Spacing.Page}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <controls:PageHeader x:Name="WorkspaceHeader" Header="术语库" Description="管理工程术语、翻译规则及启用状态"><Button Content="＋ 添加术语" Command="{Binding AddTermCommand}" Style="{StaticResource Button.Primary}" ToolTip="新增术语 (Ctrl+N)"/></controls:PageHeader>

  <!-- Fixed grid rows replace business-level WrapPanels. Normal desktop widths keep every control visible. -->
  <Grid Grid.Row="1" Grid.RowSpan="3" Margin="{DynamicResource Spacing.BlockTopTight}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- 用户反馈「移到上面去啊」：批量操作条常驻工具区首行（原先排在常规工具条之下），
        整条不再插入/移除；无选中项或忙时仍由 SelectionToolbarState 统一置灰。 -->
   <Grid x:Name="SelectionToolbar" Grid.Row="0" Margin="{DynamicResource Spacing.BlockTopTight}" Style="{StaticResource SelectionToolbarState}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SelectionCount" Grid.Column="0" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineWide}"/>
    <Button Grid.Column="1" Content="上传所选" Click="UploadSelected_Click" Style="{StaticResource Button.Compact.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <Button Grid.Column="2" Content="指定方向" Click="BatchDirection_Click" Style="{StaticResource Button.Compact.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <Button Grid.Column="3" Content="启用" Tag="True" Click="BatchEnabled_Click" Style="{StaticResource Button.Compact.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <Button Grid.Column="4" Content="停用" Tag="False" Click="BatchEnabled_Click" Style="{StaticResource Button.Compact.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <!-- 用户反馈批量条里的分类显示成「custom-c…」：分类名允许到 128 字（MainViewModel.GlossaryStorage.cs:29），
     任何固定宽度都装不下，所以让它优雅降级——选中框按可用宽省略号截断，悬停给出完整名称。 -->
    <ComboBox x:Name="BatchCategory" Grid.Column="5" SelectedIndex="0" ItemsSource="{Binding TermCategories}" ToolTip="选择或输入分类" Margin="{DynamicResource Spacing.InlineTight}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button Grid.Column="6" Content="修改分类" Click="BatchCategory_Click" Style="{StaticResource Button.Compact.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <Button Grid.Column="7" Content="导出" Click="Export_Click" Style="{StaticResource Button.Compact.Secondary}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <!-- §L12 「删除本机」是破坏性操作（移除本机术语），用危险色；「停用」不是 -->
    <Button Grid.Column="8" x:Name="DeleteSelectionButton" Content="删除本机" Click="Delete_Click" Style="{StaticResource Button.SecondaryDanger}" Margin="{DynamicResource Spacing.InlineTight}"/>
    <Button Grid.Column="9" Content="取消选择" Click="ClearSelection_Click" Style="{StaticResource Button.Compact.Secondary}" HorizontalAlignment="Left" Margin="{DynamicResource Spacing.InlineTight}"/>
   </Grid>

   <Grid Grid.Row="1" Margin="{DynamicResource Spacing.BlockTop}">
    <!-- 用户反馈「右上控件被裁」：筛选行只留筛选。搜索框独占弹性列并向下限 200 收缩，
         其余三个下拉按能完整显示「全部来源 / 全部分类 / 全部状态」的自然宽度取值；
         「详细列」是视图选项而非筛选条件，已移到下一行工具区，右端依赖因此缩短约 72 DIP。 -->
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="116"/><ColumnDefinition Width="124"/><ColumnDefinition Width="128"/>
    </Grid.ColumnDefinitions>
    <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding TermSearch, UpdateSourceTrigger=PropertyChanged}" Tag="搜索原文或译文" Style="{StaticResource Search.Input}" ToolTip="搜索原文、译文、分类 (Ctrl+F)" Margin="{DynamicResource Spacing.Inline}"/>
    <ComboBox Grid.Column="1" SelectedIndex="{Binding TermSourceFilter}" AutomationProperties.Name="来源" Margin="{DynamicResource Spacing.Inline}"><ComboBoxItem Content="全部来源"/><ComboBoxItem Content="系统术语"/><ComboBoxItem Content="企业术语"/><ComboBoxItem Content="用户术语"/><ComboBoxItem Content="关联云端"/></ComboBox>
    <ComboBox Grid.Column="2" ItemsSource="{Binding TermCategoryFilters}" SelectedItem="{Binding TermCategoryFilter}" ToolTip="分类" AutomationProperties.Name="分类" Margin="{DynamicResource Spacing.Inline}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value=""><Setter Property="Text" Value="全部分类"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <ComboBox Grid.Column="3" SelectedValuePath="Tag" SelectedValue="{Binding TermStatusFilter}" AutomationProperties.Name="状态" Margin="{DynamicResource Spacing.Inline}"><ComboBoxItem Content="全部状态" Tag="All"/><ComboBoxItem Content="已启用" Tag="Enabled"/><ComboBoxItem Content="已停用" Tag="Disabled"/><ComboBoxItem Content="有冲突" Tag="Conflict"/></ComboBox>
   </Grid>

   <!-- 用户反馈「勾选后才出现，希望常显、不可操作时置灰」（2026-09-19 截图）：
        批量操作条常驻且不再插入/移除（表格位置因此固定）；本次又按「移到上面去啊」
        把它提到工具区首行，常规工具条顺次下移一行。两条工具条的置灰都由各自 Style 决定。 -->
   <Grid x:Name="NormalToolbar" Grid.Row="2" Margin="{DynamicResource Spacing.BlockTop}" Style="{StaticResource WorkspaceToolbarState}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="导入" Command="{Binding ImportGlossaryCommand}" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline}"/>
    <Button Grid.Column="1" Content="导出" Click="Export_Click" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline}"/>
    <!-- §L12 工具栏按钮补显式样式，避免落到隐式兜底 Button.Tertiary -->
    <Button Grid.Column="2" Content="分类管理" Click="Categories_Click" Style="{StaticResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline}"/>
    <!-- 用户反馈「右上控件被裁」：视图选项（列显示）从筛选行移入工具区，筛选行只留筛选条件。 -->
    <CheckBox x:Name="DetailColumns" Grid.Column="3" Content="详细列" VerticalAlignment="Center" Checked="DetailColumns_Changed" Unchecked="DetailColumns_Changed"/>
    <Button Grid.Column="5" x:Name="CloudSyncMenu" Content="云端管理" Command="{Binding DownloadTermsCommand}" Style="{StaticResource Button.Secondary}"/>
   </Grid>

   <Grid Grid.Row="3" Margin="{DynamicResource Spacing.BlockTop}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="{Binding AllTermsLabel}" Tag="All" Click="Status_Click" Margin="{DynamicResource Spacing.InlineTight}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding TermStatusFilter}" Value="All"><Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Grid.Column="1" Content="{Binding EnabledTermsLabel}" Tag="Enabled" Click="Status_Click" Margin="{DynamicResource Spacing.InlineTight}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding TermStatusFilter}" Value="Enabled"><Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Grid.Column="2" Content="{Binding DisabledTermsLabel}" Tag="Disabled" Click="Status_Click" Margin="{DynamicResource Spacing.InlineTight}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding TermStatusFilter}" Value="Disabled"><Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Grid.Column="3" Content="{Binding ConflictTermsLabel}" Tag="Conflict" Click="Status_Click" Margin="{DynamicResource Spacing.InlineLoose}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding TermStatusFilter}" Value="Conflict"><Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   </Grid>
  </Grid>
  <Grid Grid.Row="4">
   <!-- 表格「自适应视图宽度」的真实症结不是列太宽，而是星号列与纵向滚动条的测量竞态：
        DataGrid 先按「还没有纵向滚动条」的整宽（1102）把原文/译文算好，滚动条随后出现，
        列宽不再重算，于是总列宽比视口（1092）多出滚动条那 10 DIP。结果是 1366 下凭空多出
        一条横向滚动条，并且「操作」列右缘被顶到视口外、行内「⋯」看起来贴着边被裁。
        纵向滚动条常驻后，视口宽度在第一次测量前就已确定，星号列按真视口分配，不再溢出；
        横向滚动条仍保留 Auto，只在窗口窄到星号列触底（约 1150 以下）时作为兜底出现。 -->
   <DataGrid x:Name="TermList" ItemsSource="{Binding TermView}" SelectedItem="{Binding SelectedTerm}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False" HeadersVisibility="Column" BorderThickness="0" RowHeight="{DynamicResource Size.TableRow}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" LoadingRow="TermRow_Loading" MouseDoubleClick="TermList_DoubleClick" SelectionChanged="Selection_Changed" BeginningEdit="BeginningEdit" CellEditEnding="CellEditEnding">
    <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding IsTermDrawerOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsGlossaryLoading}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsWorkspaceSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsCloudGlossarySyncing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="40" MinWidth="40" MaxWidth="40" IsReadOnly="True">
      <DataGridTemplateColumn.Header><CheckBox x:Name="SelectAll" IsThreeState="True" Click="SelectAll_Click" ToolTip="选择当前结果 (Ctrl+A)" AutomationProperties.Name="选择全部术语"/></DataGridTemplateColumn.Header>
      <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox PreviewMouseLeftButtonDown="SelectionCheckbox_MouseDown" PreviewKeyDown="SelectionCheckbox_KeyDown" AutomationProperties.Name="选择术语" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <controls:WorkspaceTextColumn ElementStyle="{StaticResource TermCellText}" Header="原文" SortMemberPath="Source" Binding="{Binding Source, UpdateSourceTrigger=Explicit}" Width="1.2*" MinWidth="155" MaxWidth="520"/>
     <controls:WorkspaceTextColumn ElementStyle="{StaticResource TermCellText}" Header="译文" SortMemberPath="Target" Binding="{Binding Target, UpdateSourceTrigger=Explicit}" Width="1.45*" MinWidth="155" MaxWidth="560"/>
     <DataGridTemplateColumn Header="分类" Width="156" MinWidth="152" MaxWidth="184" IsReadOnly="True">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <ComboBox Height="28" MinHeight="28" Padding="6,0" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" ToolTip="{Binding Category}" ItemsSource="{Binding DataContext.TermCategories, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Category, Mode=OneWay}" SelectionChanged="Category_Changed">
        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding SourceText}" Value="用户术语"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
       </ComboBox>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <!-- 用户反馈「待确认方向」被截断：该值 5 个汉字约 64 px，加上单元格 12+12 内边距，
          88 只剩 64 可用宽，正好差 1 px 落到省略号。加宽到 96 留出 8 px 余量；
          分类列 156 被 RefinementSmoke 的编辑器可读宽断言锁死，来源/启用列已无余量
          （来源 56 减内边距只剩 32，「用户」两字刚好占满），因此宽度由星号列让出。 -->
     <DataGridTextColumn Header="适用方向" Binding="{Binding DirectionText}" Width="96" MinWidth="92" MaxWidth="128" ElementStyle="{StaticResource TermMetaText}" IsReadOnly="True"/>
     <DataGridTextColumn Header="同步状态" Binding="{Binding SyncStatus}" Width="84" MinWidth="80" Visibility="Collapsed" ElementStyle="{StaticResource TermMetaText}" IsReadOnly="True"/>
     <DataGridTextColumn Header="来源" Binding="{Binding SourceShortText}" Width="56" MinWidth="52" ElementStyle="{StaticResource TermSourceText}" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="启用" Width="56" MinWidth="54" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource TermToggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" ToolTip="即时保存到本机 (Space)" AutomationProperties.Name="启用术语"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <!-- 用户反馈「按钮下部分边框没显示出来」：行高 40 − 水平网格线 1 − 单元格上下 padding(4+4) = 31，
          装不下 32 高的 Secondary 按钮，底边框被压掉。该列垂直 padding 归零，把内容高度还给行内按钮。 -->
     <DataGridTemplateColumn Header="操作" Width="166" MinWidth="160" IsReadOnly="True">
      <DataGridTemplateColumn.CellStyle>
       <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
        <Setter Property="Padding" Value="12,0"/>
       </Style>
      </DataGridTemplateColumn.CellStyle>
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <!-- §L7 行内按钮不再锁死 Width（DPI 缩放/字体回退时会裁字），只给 MinWidth 让内容撑开 -->
        <Button Click="Edit_Click" MinWidth="48" Height="32" MinHeight="32" Padding="8,0" Margin="{DynamicResource Spacing.InlineTight}" ToolTip="打开术语详情 (Enter)" AutomationProperties.Name="打开术语详情">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Content" Value="详情"/><Style.Triggers><DataTrigger Binding="{Binding SourceText}" Value="用户术语"><Setter Property="Content" Value="编辑"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Content" Value="冲突"/><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button Content="复制" Click="Copy_Click" MinWidth="44" Height="32" MinHeight="32" Padding="8,0" Margin="{DynamicResource Spacing.InlineTight}" ToolTip="复制为自定义术语" AutomationProperties.Name="复制为自定义术语"/>
        <Button Content="⋯" Click="More_Click" MinWidth="32" Height="32" MinHeight="32" Padding="0" ToolTip="更多操作" AutomationProperties.Name="术语更多操作"/>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="文件夹" Binding="{Binding Folder}" Width="100" Visibility="Collapsed" IsReadOnly="True"/><DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="85" Visibility="Collapsed" IsReadOnly="True"/><DataGridTextColumn Header="最近命中" Binding="{Binding LastHitAt, StringFormat=yyyy-MM-dd}" Width="100" Visibility="Collapsed" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
   <controls:EmptyState Header="没有匹配的术语" Description="调整筛选条件，或添加工程术语。" Visibility="{Binding TermView.IsEmpty, Converter={StaticResource BoolToVis}}"><Button Content="清除筛选" Click="ClearFilters_Click"/></controls:EmptyState>
   <Border x:Name="MergeDrawer" Style="{StaticResource Drawer.Surface}" Visibility="Collapsed"/>
  </Grid>
  <!-- 用户反馈「位置太乱、信息杂乱、没有条理」：底部收敛为一行状态带。
       左＝状态（条目数 → 本机 → 云端，细竖线分隔，层级由重到轻）；中＝最近一次操作反馈（为空时整段收起）；
       右＝草稿操作。文案不再重复「云端需手动同步」——它只出现在云端状态与悬浮说明中。 -->
  <Grid Grid.Row="5" Margin="{DynamicResource Spacing.BlockTop}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding TermCountText}" FontSize="{DynamicResource FontSize.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
    <Border Style="{StaticResource ToolbarDivider}" Height="12" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding TermLocalStatus}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" ToolTip="本机编辑即时保存到本地术语库"/>
    <Border Style="{StaticResource ToolbarDivider}" Height="12" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding TermCloudStatus}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" ToolTip="云端术语不与本机自动同步；需要时用「云端管理」"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding TermFeedback}" MaxWidth="{DynamicResource Size.StatusTextMax}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TermFeedback}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="{DynamicResource Spacing.InlineLoose}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding TermFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowTermDraftActions, Converter={StaticResource BoolToVis}}"><Button Content="放弃草稿" Command="{Binding DiscardTermsCommand}" Margin="{DynamicResource Spacing.Inline}"/><Button Content="保存草稿到本机" Command="{Binding SaveTermsCommand}"/></StackPanel>
  </Grid>
   <Border x:Name="TermEditorDrawer" Grid.RowSpan="6" Panel.ZIndex="20" Style="{StaticResource Drawer.Surface}" Visibility="{Binding IsTermDrawerOpen, Converter={StaticResource BoolToVis}}" controls:DrawerFocusBehavior.IsEnabled="True" controls:DrawerFocusBehavior.FocusOnOpen="{Binding ElementName=TermDrawerCancelButton}" controls:DrawerFocusBehavior.RestoreFocusFallback="{Binding ElementName=TermList}">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="术语详情 / 编辑" Style="{StaticResource SectionTitleStyle}" Margin="{DynamicResource Spacing.StackWide}"/><WrapPanel DockPanel.Dock="Bottom" Margin="{DynamicResource Spacing.BlockTopLoose}"><Button x:Name="TermDrawerCancelButton" Content="取消" Click="CancelDrawer_Click" Margin="{DynamicResource Spacing.Inline}"/><Button Content="保存到本机" IsEnabled="{Binding HasUnsavedTerms}" Command="{Binding FinishTermEditCommand}" Style="{StaticResource Button.Primary}"/></WrapPanel>
    <controls:ToastHost DockPanel.Dock="Bottom" IsScoped="True" MaximumVisible="1"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" controls:ResponsiveLayout.HandoffMouseWheelAtBoundary="True"><StackPanel>

     <StackPanel IsEnabled="{Binding CanEditSelectedContent}">
      <TextBlock Text="原文" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedTerm.Source, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="译文" Margin="{DynamicResource Spacing.CardInset}"/><TextBox Text="{Binding SelectedTerm.Target, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="分类" Margin="{DynamicResource Spacing.CardInset}"/><ComboBox ItemsSource="{Binding TermCategories}" SelectedItem="{Binding SelectedTerm.Category}"/>
      <TextBlock Text="适用方向（待确认的词条不参与翻译）" Margin="{DynamicResource Spacing.CardInset}"/><ComboBox ItemsSource="{Binding TermLanguages}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding SelectedTerm.SourceLang}"/><ComboBox ItemsSource="{Binding TermLanguages}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding SelectedTerm.TargetLang}"/><TextBlock Text="备注" Margin="{DynamicResource Spacing.CardInset}"/><TextBox Text="{Binding SelectedTerm.CloudNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
      <Expander Header="高级属性" Margin="{DynamicResource Spacing.BlockTopWide}"><StackPanel><TextBlock Text="文件夹"/><TextBox Text="{Binding SelectedTerm.Folder, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding SelectedTerm.HitCount, StringFormat=命中次数：{0}}"/><TextBlock Text="{Binding SelectedTerm.CloudId, StringFormat=云端标识：{0}}"/><TextBlock Text="{Binding SelectedTerm.LastHitAt, StringFormat=最近命中：{0:yyyy-MM-dd}}"/></StackPanel></Expander>
     </StackPanel>
     <TextBlock Text="{Binding SelectedTerm.SourceText, StringFormat=来源：{0}}" Margin="{DynamicResource Spacing.CardInset}"/>
     <CheckBox Content="启用" IsChecked="{Binding SelectedTerm.Enabled}" Margin="0,6,0,12"/>
     <TextBlock Text="同原文的其它译法（选择后仍需保存）" TextWrapping="Wrap"/>
     <ItemsControl ItemsSource="{Binding SelectedTermConflicts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="{DynamicResource Spacing.Vertical}"><TextBlock Text="{Binding Target}" TextWrapping="Wrap"/><CheckBox Content="启用此译法" IsChecked="{Binding Enabled}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

     <TextBlock Text="系统及企业术语内容只读，可停用或复制为自定义。云端需手动同步。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.BlockTopWide}" Foreground="{DynamicResource Brush.TextSecondary}"/>
    </StackPanel></ScrollViewer></DockPanel>
   </Border>
 </Grid>
</UserControl>
