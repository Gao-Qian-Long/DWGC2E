<Window x:Class="DwgTranslator.App.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Translator 使用帮助" Height="650" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="DWG Translator 使用帮助" FontWeight="Bold" FontSize="20" Foreground="#1976D2"/>
            <TextBlock Text="v2.1 — 图纸中英文互译工具" FontSize="12" Foreground="#78909C" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Section 1: Basic Workflow -->
                <TextBlock Text="一、基本使用流程" FontWeight="Bold" FontSize="14" Foreground="#37474F" Margin="0,0,0,8"/>

                <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.06" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="1. 导入 DWG" FontWeight="Bold" Margin="0,0,0,4" Foreground="#1976D2"/>
                        <TextBlock Text="点击「导入 DWG」按钮，选择一个或多个 DWG 文件。程序会自动提取其中的文本实体。"
                                   TextWrapping="Wrap" Foreground="#616161" Margin="8,0,0,8"/>

                        <TextBlock Text="2. 翻译" FontWeight="Bold" Margin="0,0,0,4" Foreground="#1976D2"/>
                        <TextBlock Text="点击「翻译」按钮，使用 AI 进行批量翻译。可通过 ⇄ 按钮切换翻译方向（中文→英文 / 英文→中文）。5 路并发，速度约 5 倍于串行。"
                                   TextWrapping="Wrap" Foreground="#616161" Margin="8,0,0,8"/>

                        <TextBlock Text="3. 校对" FontWeight="Bold" Margin="0,0,0,4" Foreground="#1976D2"/>
                        <TextBlock Text="在译文列双击可直接编辑翻译。也可「导出 Excel」在 Excel 中校对后「导入 Excel」回传。"
                                   TextWrapping="Wrap" Foreground="#616161" Margin="8,0,0,8"/>

                        <TextBlock Text="4. 导出 DWG" FontWeight="Bold" Margin="0,0,0,4" Foreground="#1976D2"/>
                        <TextBlock Text="点击「导出 DWG」，选择回写模式（见下方说明），生成翻译后的图纸文件。程序会自动优化文字宽度和字高，避免溢出和干涉。"
                                   TextWrapping="Wrap" Foreground="#616161" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Writeback Modes -->
                <TextBlock Text="二、回写模式说明" FontWeight="Bold" FontSize="14" Foreground="#37474F" Margin="0,5,0,8"/>

                <Border Background="#E8F5E9" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="AutoCAD 精确回写（推荐）" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                   Text="在 AutoCAD 进程内完成精确的文字替换，支持图框检测、几何碰撞避免、智能宽度调整和自动缩放排版。"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#D32F2F" Margin="0,8,0,0" FontWeight="Bold" FontSize="13">
                            <Run Text="&#x26A0; 重要：AutoCAD 必须提前启动！"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,4,0,0"
                                   Text="程序通过 COM 控制正在运行的 AutoCAD 进程。"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF3E0" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="离线回写" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                   Text="不需要 AutoCAD。使用 ACadSharp 库直接修改 DWG 文件。包含智能宽度和字高缩放，但无法进行碰撞检测。适用于没有安装 AutoCAD 的电脑。"/>
                    </StackPanel>
                </Border>

                <!-- Section 3: Text Layout Optimization -->
                <TextBlock Text="三、文字排版优化" FontWeight="Bold" FontSize="14" Foreground="#37474F" Margin="0,5,0,8"/>

                <Border Background="#E3F2FD" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,6"
                                   Text="DWG Translator v2.1 对文字排版进行了全面优化："/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,4"
                                   Text="&#x2022; 固定宽度 MText：翻译后自动调整矩形宽度，防止单词间距过大"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,4"
                                   Text="&#x2022; 自由宽度 MText：保守设置宽度，保持紧凑排列"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,4"
                                   Text="&#x2022; 碰撞检测：自动检测翻译后文字与线条/图形的干涉，缩小字高避免重叠"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,0"
                                   Text="&#x2022; 图框约束：在图框内自动寻找最佳字高，防止溢出"/>
                    </StackPanel>
                </Border>

                <!-- Section 4: License -->
                <TextBlock Text="四、授权方案" FontWeight="Bold" FontSize="14" Foreground="#37474F" Margin="0,5,0,8"/>

                <Border Background="#F3E5F5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,6"
                                   Text="DWG Translator 提供三种授权方案："/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,4">
                            <Run FontWeight="Bold" Text="体验版（免费）："/>3 次翻译导出，完整功能体验
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,4">
                            <Run FontWeight="Bold" Text="买断制（¥699）："/>一次性付费，永久使用当前大版本
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161" Margin="0,0,0,0">
                            <Run FontWeight="Bold" Text="订阅制（¥49/月，¥399/年）："/>持续获得更新和技术支持
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Section 5: FAQ -->
                <TextBlock Text="五、常见问题" FontWeight="Bold" FontSize="14" Foreground="#37474F" Margin="0,5,0,8"/>

                <Border Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Q: 翻译后文字间距太大怎么办？" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                   Text="A: v2.1 已优化固定宽度 MText 的处理逻辑，会自动缩小过宽的矩形宽度。如果仍有问题，可以在 AutoCAD 中手动调整 MText 的定义宽度。"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Q: 翻译后文字与线条重叠怎么办？" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                   Text="A: AutoCAD 精确回写模式下，程序会自动检测碰撞并缩小字高。离线模式暂不支持碰撞检测，建议使用 AutoCAD 模式。"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Q: 导出 DWG 时提示「找不到 DwgTranslator.Cad.dll」？" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                   Text="A: 在「设置」→「AutoCAD 配置」→「插件路径」中指定 DwgTranslator.Cad.dll 的完整路径。"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Q: AutoCAD 弹出「是否加载来自非信任路径的程序集」？" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#616161"
                                   Text="A: 请点击「始终加载」。这是 AutoCAD 的安全提示，首次加载 .NET 插件时会出现。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="80" Height="32" Click="Close_Click"
                    Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
