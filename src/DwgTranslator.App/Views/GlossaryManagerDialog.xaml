<Window x:Class="DwgTranslator.App.Views.GlossaryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DwgTranslator.App.Converters"
        Title="术语库管理" Width="900" Height="600" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Text="术语保存在本机，可按文件夹整理；需要时可选择上传到云端。" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="✕" Width="32" Height="30" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand" ToolTip="关闭" Command="{x:Static SystemCommands.CloseWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="＋ 新建文件夹" Height="32" Margin="0,10,0,0" Click="NewFolder_Click" Cursor="Hand"/>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10"><TextBlock Text="本地术语库" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="按文件夹管理，术语只保存在本机" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    <ListBox x:Name="FolderList" BorderThickness="0" Background="Transparent" SelectionChanged="FolderList_SelectionChanged" FontSize="13" Padding="0,2"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.BackgroundAlt}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle></ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,10,10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="当前文件夹中的术语" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                        <Button Grid.Column="1" Content="＋ 新增条目" Padding="10,5" Margin="8,0,6,0" Click="AddRow_Click" Cursor="Hand"/>
                        <Button Grid.Column="2" x:Name="UploadCloudButton" Content="↑ 上传云端" Padding="10,5" Margin="0,0,6,0" Click="UploadCloud_Click" Cursor="Hand" ToolTip="覆盖云端术语库"/>
                        <Button Grid.Column="3" x:Name="DownloadCloudButton" Content="↓ 下载云端" Padding="10,5" Margin="0,0,6,0" Click="DownloadCloud_Click" Cursor="Hand" ToolTip="用云端术语替换当前编辑内容"/>
                        <Button Grid.Column="4" x:Name="DeleteSelectedButton" Content="删除选中" Padding="10,5" Click="DeleteSelected_Click" Cursor="Hand"/>
                    </Grid>
                    <DataGrid x:Name="GlossaryGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" FontSize="12" RowHeight="32" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0" Margin="0,0,0,4">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Brush.DataGridHeader}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="34"/></Style>
                            <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,2"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/></Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="原文" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            <DataGridTextColumn Header="译文" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="1.1*"/>
                            <DataGridTextColumn Header="文件夹" Binding="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Width="1.1*"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Bottom" Text="支持批量选择删除；保存后立即用于本机翻译。" Foreground="{DynamicResource Brush.TextMuted}" Margin="10,0,10,8" FontSize="11"/>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="保存到本机" Padding="16,7" Margin="0,0,8,0" Background="{DynamicResource Brush.Primary}" Foreground="White" FontWeight="SemiBold" Click="Save_Click" Cursor="Hand" BorderThickness="0"/>
            <Button Content="取消" Padding="16,7" Click="Cancel_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>

