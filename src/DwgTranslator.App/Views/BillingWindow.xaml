<Window x:Class="DwgTranslator.App.Views.BillingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DwgTranslator.App.Views.Controls" xmlns:conv="clr-namespace:DwgTranslator.App.Converters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True" SnapsToDevicePixels="True" Title="会员购买与订单" Width="1020" Height="700" MinWidth="900" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Microsoft YaHei UI, Segoe UI">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BillingPresentationConverter x:Key="BillingDisplay"/>
        <Style x:Key="OrderActionHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="OrderActionCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- 单元格文本：一个共用的省略号基样式，每列再派生一份，好让 ToolTip 说明被截掉的是哪个值。
             订单／套餐是星号列（按 1 : 1.4 分配剩余宽度），状态／金额是 Auto 列（按内容取宽，
             金额因此永不被打点）；所以截断只可能发生在套餐名与订单号上——这里是它们的兜底，
             避免再出现「最后一个字被硬裁掉」（DataGridCellStyle 自身不裁剪也不打点）。 -->
        <Style x:Key="OrderCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OrderNoCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding OrderNo}"/>
        </Style>
        <Style x:Key="PlanCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding PlanName}"/>
        </Style>
        <Style x:Key="StateCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding DisplayState, Converter={StaticResource BillingDisplay}}"/>
        </Style>
        <Style x:Key="AmountCellText" TargetType="TextBlock" BasedOn="{StaticResource OrderCellText}">
            <Setter Property="ToolTip" Value="{Binding PayableCents, Converter={StaticResource BillingDisplay}, ConverterParameter=Amount}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><DockPanel><controls:TitleBarControl DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True"/><StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.LeftGap}"><Border Background="{DynamicResource Brush.Primary}" CornerRadius="4" Width="24" Height="24"><TextBlock Text="D" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="会员购买与订单" Margin="{DynamicResource Spacing.LeftGap}" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>

        <!-- 左栏购买、右栏订单历史。右栏按内容取高（不撑满整行），「更多订单」因此紧贴表格下方，
             不再孤零零悬在窗口底部；两栏之间用一条通高的分隔线明确分界。
             列宽核算（FontSize.Table = 14）：900(MinWidth) - 48(页边距) - 370(左栏) - 24(间隔) = 458，
             再减去表格内部竖滚动条 17 余 441。订单 * (MinWidth 84) + 套餐 1.4* (MinWidth 112)
             + 状态 Auto(≈66) + 金额 Auto(≈69~100) + 操作 80 = 最少 411 <= 441，
             所以最小宽度下金额不会被打点，也不会出现横向滚动条。
             无订单时表格由 code-behind 收起（BillingWindow.xaml.cs 的 LoadOrders）：
             只留居中的「暂无订单」，避免表头与空状态叠在一起。 -->
        <Grid Grid.Row="1" Margin="{DynamicResource Spacing.24}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="套餐与订单" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="Account" Margin="{DynamicResource Spacing.CardInset}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="Entitlements" Margin="{DynamicResource Spacing.StackLoose}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="套餐与金额以服务器为准 · 本次购买绑定上述账号" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <Border Background="{DynamicResource Brush.BackgroundAlt}" Padding="12" Margin="{DynamicResource Spacing.Vertical}">
                        <TextBlock x:Name="PurchaseAvailability" Text="正在检查购买服务…" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" />
                    </Border>
                    <ComboBox x:Name="Plans" DisplayMemberPath="Label" Margin="{DynamicResource Spacing.Vertical}" />
                    <TextBlock Text="新购买支付方式：目前仅支持支付宝。下方二维码属于所显示的订单，不会因套餐选择而更换。" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextMuted}" Margin="{DynamicResource Spacing.Stack}" />
                    <StackPanel x:Name="PaymentMethods" Orientation="Horizontal" Margin="{DynamicResource Spacing.Vertical}">
                        <RadioButton x:Name="Alipay" Content="支付宝" IsChecked="True" Margin="{DynamicResource Spacing.InlineLeading}" />
                        <RadioButton x:Name="WechatPay" Content="微信支付（暂未开通）" IsEnabled="False" ToolTip="微信支付通道尚未接入，当前仅支持支付宝。" ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                    <WrapPanel Margin="{DynamicResource Spacing.Vertical}">
                        <Button Style="{StaticResource Button.Primary}" x:Name="Buy" Content="确认套餐并获取二维码" Click="Buy_Click" Padding="14,0" IsEnabled="False" />
                        <Button Style="{StaticResource Button.Secondary}" Content="刷新订单与会员" Click="Refresh_Click" Padding="14,0" Margin="{DynamicResource Spacing.LeftGap}" />
                    </WrapPanel>
                    <TextBlock x:Name="Message" Text="正在加载…" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" FontWeight="SemiBold" />
                    <TextBlock x:Name="OrderDetails" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" />
                    <TextBlock x:Name="QrStatus" Text="尚未选择订单。可从历史订单查看付款状态。" TextWrapping="Wrap" Margin="{DynamicResource Spacing.Vertical}" FontSize="{DynamicResource FontSize.Secondary}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <!-- 二维码框的可见性与图片同步：二维码隐藏或缺失时整块塌缩，不留固定占位高度。 -->
                    <Border Visibility="{Binding Visibility, ElementName=Qr}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Padding="12" HorizontalAlignment="Left">
                        <Image x:Name="Qr" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />
                    </Border>
                    <Border Background="{DynamicResource Brush.WarningLight}" Padding="12" Margin="{DynamicResource Spacing.BlockTopWide}">
                        <TextBlock Text="二维码展示期限结束不代表平台关单。已付款请勿再次支付，系统将继续确认。" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Brush.Border}" SnapsToDevicePixels="True" />

            <Grid Grid.Column="2" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="历史订单（选择可查看）" FontSize="{DynamicResource FontSize.SectionTitle}" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="{DynamicResource Spacing.Stack}">
                    <DataGrid x:Name="Orders" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Orders_SelectionChanged" MaxHeight="360" VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="订单" Binding="{Binding OrderNo, Converter={StaticResource BillingDisplay}, ConverterParameter=Order}" Width="*" MinWidth="84" ElementStyle="{StaticResource OrderNoCellText}" />
                            <DataGridTextColumn Header="套餐" Binding="{Binding PlanName}" Width="1.4*" MinWidth="112" ElementStyle="{StaticResource PlanCellText}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding DisplayState, Converter={StaticResource BillingDisplay}}" Width="Auto" ElementStyle="{StaticResource StateCellText}" />
                            <DataGridTextColumn Header="金额" Binding="{Binding PayableCents, Converter={StaticResource BillingDisplay}, ConverterParameter=Amount}" Width="Auto" ElementStyle="{StaticResource AmountCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="80" MinWidth="80" HeaderStyle="{StaticResource OrderActionHeader}" CellStyle="{StaticResource OrderActionCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="复制" AutomationProperties.Name="复制订单号" ToolTip="{Binding OrderNo}" Click="CopyOrder_Click" Tag="{Binding OrderNo}"
                                                Style="{StaticResource Button.Compact.Tertiary}" Width="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState x:Name="EmptyOrders" Header="暂无订单" Description="当前账号尚无历史订单。" Visibility="Collapsed"/>
                </Grid>
                <Button Style="{StaticResource Button.Tertiary}" x:Name="More" Grid.Row="2" Content="更多订单" Click="More_Click" HorizontalAlignment="Left" Padding="12,0" IsEnabled="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
