<UserControl x:Class="DwgTranslator.App.Views.Controls.TranslationDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DwgTranslator.App.Converters">
    <UserControl.Resources>
        <Style x:Key="DrawingItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.PrimarySoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TranslationEditor" TargetType="TextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/></Trigger></Style.Triggers></Style>
    </UserControl.Resources>
    <Border Style="{StaticResource ContentCardNoPad}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,0,0,1" Padding="15,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="27" Height="27" CornerRadius="7" Background="{DynamicResource Brush.PrimaryLight}" Margin="0,0,9,0"><Path Data="{StaticResource Icon.Cad}" Width="14" Height="14" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="翻译内容" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="{Binding SelectedFilePath}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="520"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"><Run Text="{Binding VisibleCount, StringFormat='显示 {0} / '}"/><Run Text="{Binding TotalCount, StringFormat='共 {0} 条'}"/></TextBlock></Border>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="270" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0,0,1,0" Visibility="{Binding HasMultipleDrawingFiles, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="2,2,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="图纸队列" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="双击图纸进入编辑" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="查看全部" Command="{Binding ShowAllDrawingFilesCommand}" Style="{StaticResource RibbonTertiaryButton}" Padding="9,0" Height="28"/></Grid>
                        <ListBox x:Name="DrawingFileList" Grid.Row="1" ItemsSource="{Binding DrawingFiles}" SelectedItem="{Binding SelectedDrawingFile, Mode=OneWay}" MouseDoubleClick="DrawingFileList_MouseDoubleClick" ItemContainerStyle="{StaticResource DrawingItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsIncludedForExport, Mode=TwoWay}" Margin="0,3,9,0" VerticalAlignment="Top" ToolTip="勾选后参与批量导出"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding SummaryText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Background="{DynamicResource Brush.PrimaryLight}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0"><TextBlock Text="勾选图纸后，点击顶部“批量导出”" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Primary}"/></Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <DataGrid ItemsSource="{Binding FilteredEntities}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True" GridLinesVisibility="Horizontal" RowStyle="{StaticResource TranslationRowStyle}" AlternationCount="2" CanUserResizeColumns="True" EnableRowVirtualization="True" IsReadOnly="False" RowHeight="46" FontSize="12" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle}" HorizontalGridLinesBrush="{DynamicResource Brush.BorderLight}" BorderThickness="0" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Handle}" Width="125" MinWidth="105" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellStyle}"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding EntityTypeText}" Width="92" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="原文" Binding="{Binding PlainText}" Width="2*" MinWidth="180" IsReadOnly="True" ElementStyle="{StaticResource WrapCellStyle}"/>
                            <DataGridTemplateColumn Header="译文（可直接编辑）" Width="2.25*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource TranslationEditor}" Text="{Binding TranslatedText, UpdateSourceTrigger=LostFocus}" LostFocus="TranslationTextBox_LostFocus" ToolTip="单击后直接修改译文"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="术语" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="—"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/><Style.Triggers><DataTrigger Binding="{Binding GlossaryHit}" Value="True"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Status, Converter={StaticResource StatusBrush}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="White"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="所属块" Binding="{Binding BlockName}" Width="110" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid x:Name="EmptyStatePanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"><Border Width="440" Padding="34" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><Border Width="58" Height="58" CornerRadius="15" Background="{DynamicResource Brush.PrimaryLight}" HorizontalAlignment="Center" Margin="0,0,0,16"><Path x:Name="EmptyStateIcon" Data="{StaticResource Icon.EmptySheet}" Width="28" Height="28" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyStateTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateDescription" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="330" Margin="0,8,0,20"/><Button x:Name="EmptyStatePrimaryButton" Style="{StaticResource PrimaryButton}" Padding="22,9" HorizontalAlignment="Center"/><Button x:Name="EmptyStateSecondaryButton" Visibility="Collapsed"/></StackPanel></Border></Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
